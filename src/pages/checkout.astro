---
import { getOfficialExchangeRate } from '../adapters/rates';
import { fetchStoresMap } from '../adapters/stores';
import LocationModal from '../components/LocationModal.astro';
import '../styles/global.css';

const bcvRate = await getOfficialExchangeRate();
const storesLookup = await fetchStoresMap();
---

<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Confirmar Pedido Multi-Tienda | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-36 antialiased selection:bg-[#FF7A00] selection:text-white">
    
    <header class="bg-white/90 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40 px-4 py-3.5">
      <div class="max-w-2xl mx-auto flex items-center justify-between">
        <a href="/" class="w-10 h-10 rounded-full bg-gray-50 hover:bg-gray-100 flex items-center justify-center text-gray-800 transition-colors active:scale-95">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="text-center">
          <h1 class="text-base font-extrabold text-gray-900 leading-tight">Finalizar Pedido</h1>
          <span class="text-[10px] font-bold text-emerald-600">Tasa Oficial BCV: {bcvRate.toFixed(2)} Bs/$</span>
        </div>
        <a href="/" class="text-[11px] font-extrabold text-[#FF5A00] hover:underline">
          + Tiendas
        </a>
      </div>
    </header>

    <main class="flex-1 max-w-2xl mx-auto px-4 py-5 w-full space-y-4">
      
      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-gray-400">Dirección y Contacto de Entrega</span>
          <button id="btn-change-checkout-address" type="button" class="text-xs font-bold text-[#FF7A00] hover:underline cursor-pointer">
            Cambiar en Mapa
          </button>
        </div>
        <div class="flex items-center gap-3 pb-3 border-b border-gray-50">
          <div class="w-10 h-10 rounded-2xl bg-orange-50 text-[#FF7A00] flex items-center justify-center text-lg shrink-0">
            📍
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-gray-900 truncate">Punto de Entrega Confirmado</h3>
            <p id="checkout-address" class="text-xs text-gray-500 truncate">Av. Andrés Eloy Blanco, Higuerote</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
          <div>
            <label for="customer-name" class="block text-[10px] font-extrabold uppercase tracking-wider text-gray-400 mb-1">
              Quien Recibe
            </label>
            <input
              id="customer-name"
              type="text"
              value="Freddy Campos"
              placeholder="Nombre y Apellido"
              class="w-full h-10 px-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-gray-900 focus:outline-none focus:bg-white focus:border-[#FF7A00]"
            />
          </div>
          <div>
            <label for="customer-phone" class="block text-[10px] font-extrabold uppercase tracking-wider text-gray-400 mb-1">
              Teléfono / WhatsApp
            </label>
            <input
              id="customer-phone"
              type="tel"
              value="+58 412 890 1234"
              placeholder="Ej. 0412-8901234"
              class="w-full h-10 px-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-gray-900 focus:outline-none focus:bg-white focus:border-[#FF7A00]"
            />
          </div>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0">
            ⚡
          </div>
          <div>
            <h4 class="text-xs font-bold text-gray-900">Despacho Express Multi-Tienda</h4>
            <p id="checkout-eta-label" class="text-[11px] text-gray-400">Estimado: 15-25 minutos</p>
          </div>
        </div>
        <span id="checkout-distance-badge" class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-bold text-[10px]">
          Tarifa calculada por GPS
        </span>
      </section>

      <div id="multi-store-banner" class="hidden rounded-2xl bg-gradient-to-r from-indigo-950 to-slate-900 text-white p-3.5 flex items-center justify-between gap-3 shadow-sm">
        <div class="flex items-center gap-2.5">
          <span class="text-lg">🏬</span>
          <div>
            <p class="text-xs font-black">Carrito Multi-Tienda Activo</p>
            <p id="multi-store-banner-sub" class="text-[10px] text-slate-300 font-medium">Tus artículos se despacharán desde cada comercio oficial simultáneamente</p>
          </div>
        </div>
        <span id="multi-store-count-pill" class="px-2.5 py-1 rounded-full bg-[#FF5A00] text-white text-[10px] font-black shrink-0">
          2 Tiendas
        </span>
      </div>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Tu Pedido por Comercio</h3>
          <button id="clear-cart-btn" class="text-[11px] font-bold text-gray-400 hover:text-red-500 transition-colors cursor-pointer">
            Vaciar Carrito
          </button>
        </div>
        <div id="cart-items-container" class="space-y-4">
          <div class="text-center py-8 text-gray-400 text-xs">Cargando productos del carrito...</div>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs">
        <label for="order-notes" class="block text-xs font-extrabold uppercase tracking-wider text-gray-400 mb-1">
          Notas de Entrega y Especificaciones
        </label>
        <p class="text-[11px] text-gray-400 font-medium mb-2">Instrucciones para el repartidor o la tienda (ej. referencia de casa, color, modelo)</p>
        <textarea 
          id="order-notes"
          rows="2"
          placeholder="Escribe aquí indicaciones especiales sobre tu entrega o productos..."
          class="w-full p-3 bg-gray-50 border border-gray-100 rounded-2xl text-xs text-gray-800 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all resize-none"
        ></textarea>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400 mb-3">Método de Pago</h3>
        <div class="space-y-2.5" id="payment-options">
          <label class="payment-option flex items-center justify-between p-3.5 rounded-2xl border-2 border-[#FF7A00] bg-orange-50/30 cursor-pointer transition-all" data-value="mobile_pay">
            <div class="flex items-center gap-3">
              <span class="text-xl">📱</span>
              <div>
                <h4 class="text-xs font-bold text-gray-900">Pago Móvil / Transferencia BCV</h4>
                <p class="text-[10px] text-gray-500">Confirmación inmediata a tasa oficial ({bcvRate.toFixed(2)} Bs/$)</p>
              </div>
            </div>
            <input type="radio" name="payment" value="mobile_pay" checked class="text-[#FF7A00] focus:ring-[#FF7A00] w-4 h-4 accent-[#FF7A00]" />
          </label>

          <div id="mobile-pay-details" class="p-4 rounded-2xl bg-orange-50/50 border border-orange-200 space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-orange-100 text-xs">
              <span class="font-extrabold text-[#FF7A00] uppercase text-[10px] tracking-wider">Datos Pago Móvil Oficial</span>
              <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[9px] font-black">Cuenta Verificada</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <span class="text-[10px] text-gray-400 block font-semibold">Banco Destino:</span>
                <strong class="text-gray-900">Banesco (0134)</strong>
              </div>
              <div>
                <span class="text-[10px] text-gray-400 block font-semibold">Teléfono:</span>
                <strong class="text-gray-900">0412-8901234</strong>
              </div>
              <div>
                <span class="text-[10px] text-gray-400 block font-semibold">RIF / C.I.:</span>
                <strong class="text-gray-900">J-50123456-7</strong>
              </div>
              <div>
                <span class="text-[10px] text-gray-400 block font-semibold">Monto exacto en Bs:</span>
                <strong id="mobile-pay-exact-bs" class="text-[#FF5A00] font-black">Bs. 0,00</strong>
              </div>
            </div>
            <div class="pt-2 border-t border-orange-100 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div>
                <label for="mobile-pay-bank" class="block text-[10px] font-black uppercase tracking-wider text-gray-600 mb-1">
                  Banco Emisor
                </label>
                <select 
                  id="mobile-pay-bank"
                  class="w-full h-11 px-3 bg-white border border-gray-200 rounded-xl text-xs font-bold text-gray-900 focus:outline-none focus:border-[#FF7A00]"
                >
                  <option value="0134">Banesco (0134)</option>
                  <option value="0102">Banco de Venezuela (0102)</option>
                  <option value="0105">Mercantil (0105)</option>
                  <option value="0108">BBVA Provincial (0108)</option>
                  <option value="0191">BNC (0191)</option>
                  <option value="0172">Bancamiga (0172)</option>
                  <option value="0114">Bancaribe (0114)</option>
                  <option value="0174">Banplus (0174)</option>
                </select>
              </div>
              <div>
                <label for="mobile-pay-ref" class="block text-[10px] font-black uppercase tracking-wider text-gray-600 mb-1">
                  Referencia (últimos 6 dígitos)
                </label>
                <input 
                  type="text" 
                  id="mobile-pay-ref"
                  placeholder="Ej. 849201" 
                  maxlength="12"
                  class="w-full h-11 px-3.5 bg-white border border-gray-200 rounded-xl text-xs font-mono font-bold text-gray-900 focus:outline-none focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
                />
              </div>
            </div>
          </div>

          <label class="payment-option flex items-center justify-between p-3.5 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white cursor-pointer transition-all" data-value="cash">
            <div class="flex items-center gap-3">
              <span class="text-xl">💵</span>
              <div>
                <h4 class="text-xs font-bold text-gray-900">Efectivo contra entrega</h4>
                <p class="text-[10px] text-gray-400">Pagas en dólares o bolívares al recibir tu pedido</p>
              </div>
            </div>
            <input type="radio" name="payment" value="cash" class="text-[#FF7A00] focus:ring-[#FF7A00] w-4 h-4 accent-[#FF7A00]" />
          </label>

          <label class="payment-option flex items-center justify-between p-3.5 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white cursor-pointer transition-all" data-value="card">
            <div class="flex items-center gap-3">
              <span class="text-xl">💳</span>
              <div>
                <h4 class="text-xs font-bold text-gray-900">Tarjeta de Débito / Crédito</h4>
                <p class="text-[10px] text-gray-400">Visa, Mastercard o Maestro Nacional</p>
              </div>
            </div>
            <input type="radio" name="payment" value="card" class="text-[#FF7A00] focus:ring-[#FF7A00] w-4 h-4 accent-[#FF7A00]" />
          </label>

          <div id="card-pay-details" class="hidden p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-2.5">
            <div>
              <label for="card-number" class="block text-[10px] font-black uppercase tracking-wider text-gray-500 mb-1">Número de Tarjeta</label>
              <input id="card-number" type="text" maxlength="19" placeholder="4532 •••• •••• 8910" class="w-full h-10 px-3 bg-white border border-gray-200 rounded-xl text-xs font-mono font-bold text-gray-900 focus:outline-none focus:border-[#FF7A00]" />
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label for="card-exp" class="block text-[10px] font-black uppercase tracking-wider text-gray-500 mb-1">Vencimiento</label>
                <input id="card-exp" type="text" maxlength="5" placeholder="08/28" class="w-full h-10 px-3 bg-white border border-gray-200 rounded-xl text-xs font-mono font-bold text-gray-900 focus:outline-none focus:border-[#FF7A00]" />
              </div>
              <div>
                <label for="card-cvv" class="block text-[10px] font-black uppercase tracking-wider text-gray-500 mb-1">CVV</label>
                <input id="card-cvv" type="password" maxlength="4" placeholder="•••" class="w-full h-10 px-3 bg-white border border-gray-200 rounded-xl text-xs font-mono font-bold text-gray-900 focus:outline-none focus:border-[#FF7A00]" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Propina para el Repartidor</h3>
            <p class="text-[11px] text-gray-500 font-medium">100% íntegra para tu repartidor asignado</p>
          </div>
          <span class="text-xl">🛵</span>
        </div>
        <div class="grid grid-cols-4 gap-2" id="tip-options">
          <button 
            type="button" 
            data-tip="0" 
            class="btn-tip py-2.5 px-2 rounded-2xl border-2 border-[#FF7A00] bg-orange-50/40 text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer"
          >
            <span>Sin propina</span>
            <span class="text-[9px] text-gray-400 font-bold">$0.00</span>
          </button>
          <button 
            type="button" 
            data-tip="0.5" 
            class="btn-tip py-2.5 px-2 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer"
          >
            <span>$0.50</span>
            <span class="text-[9px] text-gray-400 font-bold">Pequeña</span>
          </button>
          <button 
            type="button" 
            data-tip="1.0" 
            class="btn-tip py-2.5 px-2 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer"
          >
            <span>$1.00</span>
            <span class="text-[9px] text-gray-400 font-bold">Estándar</span>
          </button>
          <button 
            type="button" 
            data-tip="2.0" 
            class="btn-tip py-2.5 px-2 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer"
          >
            <span>$2.00</span>
            <span class="text-[9px] text-gray-400 font-bold">Generosa</span>
          </button>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-xs space-y-2 text-xs">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400 mb-2">Desglose de Pago</h3>
        <div class="flex justify-between text-gray-500">
          <span>Subtotal de Productos</span>
          <div class="text-right">
            <span id="breakdown-subtotal" class="font-bold text-gray-800">$0.00</span>
            <span id="breakdown-subtotal-bs" class="block text-[10px] text-gray-400 font-semibold"></span>
          </div>
        </div>
        <div class="flex justify-between text-gray-500">
          <span id="breakdown-delivery-label">Costo de Envío</span>
          <div class="text-right">
            <span id="breakdown-delivery" class="font-bold text-gray-800">$1.50</span>
            <span id="breakdown-delivery-bs" class="block text-[10px] text-gray-400 font-semibold"></span>
          </div>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Tarifa de Servicio y Plataforma</span>
          <div class="text-right">
            <span id="breakdown-service" class="font-bold text-gray-800">$0.50</span>
            <span id="breakdown-service-bs" class="block text-[10px] text-gray-400 font-semibold"></span>
          </div>
        </div>
        <div id="breakdown-tip-row" class="hidden justify-between text-gray-500">
          <span>Propina al Repartidor</span>
          <div class="text-right">
            <span id="breakdown-tip" class="font-bold text-emerald-600">$0.00</span>
            <span id="breakdown-tip-bs" class="block text-[10px] text-gray-400 font-semibold"></span>
          </div>
        </div>
        <div class="pt-3 border-t border-gray-100 flex justify-between items-center text-sm font-black text-gray-950">
          <div>
            <span>Total a Pagar</span>
            <span id="breakdown-total-bs" class="block text-[11px] text-emerald-700 font-extrabold mt-0.5"></span>
          </div>
          <span id="breakdown-total" class="text-xl text-[#FF7A00] font-black">$0.00</span>
        </div>
      </section>

    </main>

    <div class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-white/95 backdrop-blur-md border-t border-gray-100 shadow-xl shadow-gray-200/50">
      <div class="max-w-2xl mx-auto">
        <button 
          id="btn-confirm-order"
          type="button"
          class="w-full h-14 rounded-2xl bg-gradient-to-r from-[#FF7A00] to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white font-black text-sm flex items-center justify-center gap-2 shadow-xl shadow-orange-600/30 active:scale-98 transition-all disabled:opacity-50 disabled:pointer-events-none cursor-pointer"
        >
          <span id="btn-text">Confirmar y Enviar Pedido</span>
          <span>•</span>
          <span id="btn-total">$0.00</span>
        </button>
      </div>
    </div>

    <script is:inline define:vars={{ bcvRate, storesLookup }}>
      (() => {
        const CART_STORAGE_KEY = 'traigalo_cart';
        const API_ORDERS_URL = 'https://api.traigalo.org/v2/orders';
        const API_PAYMENTS_URL = 'https://api.traigalo.org/v2/payments/receipts';
        const STORE_MAP = storesLookup || {};

        let baseDeliveryFeePerStore = 1.50;
        const SERVICE_FEE = 0.50;
        let currentDriverTip = 0.0;

        try {
          const rawUser = localStorage.getItem('traigalo_user');
          if (rawUser) {
            const parsedUser = JSON.parse(rawUser);
            const nameInput = document.getElementById('customer-name');
            const phoneInput = document.getElementById('customer-phone');
            if (parsedUser.name && nameInput) nameInput.value = parsedUser.name;
            if (parsedUser.phone && phoneInput) phoneInput.value = parsedUser.phone;
          }
        } catch {}

        const tipButtons = document.querySelectorAll('.btn-tip');
        tipButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const val = parseFloat(btn.getAttribute('data-tip') || '0');
            currentDriverTip = val;

            tipButtons.forEach(b => {
              b.className = 'btn-tip py-2.5 px-2 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer';
            });
            btn.className = 'btn-tip py-2.5 px-2 rounded-2xl border-2 border-[#FF7A00] bg-orange-50/40 text-gray-900 text-xs font-extrabold flex flex-col items-center justify-center transition-all cursor-pointer';

            renderCart();
          });
        });

        function getCart() {
          try {
            const raw = localStorage.getItem(CART_STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
          } catch {
            return [];
          }
        }

        function saveCart(cart) {
          try {
            localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
          } catch {}
          renderCart();
        }

        function formatBs(usd) {
          const val = (usd || 0) * (bcvRate || 896.12);
          const formatted = new Intl.NumberFormat('es-VE', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }).format(val);
          return `~ Bs. ${formatted} @ BCV`;
        }

        function groupCartByStore(cart) {
          const map = new Map();
          cart.forEach(item => {
            const sid = item.storeId || Object.keys(STORE_MAP)[0] || '';
            const storeInfo = STORE_MAP[sid] || {};
            const sname = item.storeName || storeInfo.name || 'Comercio Oficial';
            if (!map.has(sid)) {
              map.set(sid, {
                storeId: sid,
                storeName: sname,
                logo: storeInfo.logo_url || '/brand-icon.webp',
                items: []
              });
            }
            map.get(sid).items.push(item);
          });
          return Array.from(map.values());
        }

        async function refreshDynamicDeliveryEstimate() {
          const cart = getCart();
          const storeId = (cart[0] && cart[0].storeId) ? cart[0].storeId : '46a0baf0-4100-465d-934a-f2d14f004ba5';
          let lat = 10.4842;
          let lng = -66.0990;

          const savedLoc = localStorage.getItem('traigalo_location');
          if (savedLoc) {
            try {
              const parsed = JSON.parse(savedLoc);
              if (parsed.latitude && parsed.longitude) {
                lat = parsed.latitude;
                lng = parsed.longitude;
              }
            } catch {}
          }

          try {
            const res = await fetch(`${API_ORDERS_URL}/estimate?store-id=${encodeURIComponent(storeId)}&lat=${lat}&lng=${lng}`);
            if (res.ok) {
              const est = await res.json();
              if (est.delivery_fee_usd) {
                baseDeliveryFeePerStore = Number(est.delivery_fee_usd);
              }
              const etaEl = document.getElementById('checkout-eta-label');
              const distBadge = document.getElementById('checkout-distance-badge');
              if (etaEl && est.eta_minutes) {
                etaEl.textContent = `Estimado: ${est.eta_minutes}-${est.eta_minutes + 10} minutos`;
              }
              if (distBadge && typeof est.distance_km === 'number') {
                distBadge.textContent = `${est.distance_km.toFixed(1)} km • $${baseDeliveryFeePerStore.toFixed(2)}/tienda`;
              }
              renderCart();
            }
          } catch {}
        }

        function getSelectedPayment() {
          const checked = document.querySelector('input[name="payment"]:checked');
          return checked ? checked.value : 'mobile_pay';
        }

        function updatePaymentStyles() {
          const mobileDetails = document.getElementById('mobile-pay-details');
          const cardDetails = document.getElementById('card-pay-details');
          const selected = getSelectedPayment();

          if (mobileDetails) {
            mobileDetails.classList.toggle('hidden', selected !== 'mobile_pay');
          }
          if (cardDetails) {
            cardDetails.classList.toggle('hidden', selected !== 'card');
          }

          document.querySelectorAll('.payment-option').forEach(label => {
            const radio = label.querySelector('input[type="radio"]');
            if (radio && radio.checked) {
              label.className = 'payment-option flex items-center justify-between p-3.5 rounded-2xl border-2 border-[#FF7A00] bg-orange-50/30 cursor-pointer transition-all';
            } else {
              label.className = 'payment-option flex items-center justify-between p-3.5 rounded-2xl border border-gray-100 hover:border-gray-200 bg-white cursor-pointer transition-all';
            }
          });
        }

        document.querySelectorAll('input[name="payment"]').forEach(radio => {
          radio.addEventListener('change', updatePaymentStyles);
        });

        function changeQty(productId, delta) {
          let cart = getCart();
          const item = cart.find(i => i.id === productId);
          if (!item) return;

          item.qty = (item.qty || 1) + delta;
          if (item.qty <= 0) {
            cart = cart.filter(i => i.id !== productId);
          }
          saveCart(cart);
        }

        const clearBtn = document.getElementById('clear-cart-btn');
        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            saveCart([]);
          });
        }

        function renderCart() {
          const cart = getCart();
          const storeGroups = groupCartByStore(cart);
          const container = document.getElementById('cart-items-container');
          const confirmBtn = document.getElementById('btn-confirm-order');
          const btnText = document.getElementById('btn-text');
          const subtotalEl = document.getElementById('breakdown-subtotal');
          const subtotalBsEl = document.getElementById('breakdown-subtotal-bs');
          const deliveryLabelEl = document.getElementById('breakdown-delivery-label');
          const deliveryEl = document.getElementById('breakdown-delivery');
          const deliveryBsEl = document.getElementById('breakdown-delivery-bs');
          const serviceEl = document.getElementById('breakdown-service');
          const serviceBsEl = document.getElementById('breakdown-service-bs');
          const tipRowEl = document.getElementById('breakdown-tip-row');
          const tipEl = document.getElementById('breakdown-tip');
          const tipBsEl = document.getElementById('breakdown-tip-bs');
          const totalEl = document.getElementById('breakdown-total');
          const totalBsEl = document.getElementById('breakdown-total-bs');
          const btnTotal = document.getElementById('btn-total');
          const exactBsEl = document.getElementById('mobile-pay-exact-bs');
          const multiBanner = document.getElementById('multi-store-banner');
          const multiCountPill = document.getElementById('multi-store-count-pill');

          if (!container) return;

          if (cart.length === 0) {
            if (multiBanner) multiBanner.classList.add('hidden');
            container.innerHTML = `
              <div class="py-8 text-center">
                <span class="text-3xl block mb-2">🛒</span>
                <p class="text-xs font-bold text-gray-500">Tu carrito está vacío</p>
                <a href="/" class="inline-block mt-3 px-4 py-2 rounded-xl bg-orange-50 text-[#FF7A00] font-black text-xs hover:bg-orange-100 transition-colors">
                  Explorar Catálogo y Tiendas Oficiales
                </a>
              </div>
            `;
            if (confirmBtn) confirmBtn.disabled = true;
            if (subtotalEl) subtotalEl.textContent = '$0.00';
            if (subtotalBsEl) subtotalBsEl.textContent = formatBs(0);
            if (deliveryBsEl) deliveryBsEl.textContent = formatBs(baseDeliveryFeePerStore);
            if (serviceBsEl) serviceBsEl.textContent = formatBs(SERVICE_FEE);
            if (tipRowEl) tipRowEl.classList.add('hidden');
            if (totalEl) totalEl.textContent = '$0.00';
            if (totalBsEl) totalBsEl.textContent = formatBs(0);
            if (btnTotal) btnTotal.textContent = '$0.00';
            if (exactBsEl) exactBsEl.textContent = 'Bs. 0,00';
            return;
          }

          if (confirmBtn) confirmBtn.disabled = false;

          const storeCount = Math.max(1, storeGroups.length);
          if (multiBanner) {
            if (storeCount > 1) {
              multiBanner.classList.remove('hidden');
              if (multiCountPill) multiCountPill.textContent = `${storeCount} Tiendas`;
              if (btnText) btnText.textContent = `Confirmar ${storeCount} Pedidos Multi-Tienda`;
            } else {
              multiBanner.classList.add('hidden');
              if (btnText) btnText.textContent = 'Confirmar y Enviar Pedido';
            }
          }

          const subtotal = cart.reduce((acc, it) => acc + (Number(it.price) * (it.qty || 1)), 0);
          const totalDeliveryFee = baseDeliveryFeePerStore * storeCount;
          const total = subtotal + totalDeliveryFee + SERVICE_FEE + currentDriverTip;

          if (deliveryLabelEl) {
            deliveryLabelEl.textContent = storeCount > 1 ? `Costo de Envío (${storeCount} tiendas)` : 'Costo de Envío';
          }
          if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
          if (subtotalBsEl) subtotalBsEl.textContent = formatBs(subtotal);
          if (deliveryEl) deliveryEl.textContent = `$${totalDeliveryFee.toFixed(2)}`;
          if (deliveryBsEl) deliveryBsEl.textContent = formatBs(totalDeliveryFee);
          if (serviceEl) serviceEl.textContent = `$${SERVICE_FEE.toFixed(2)}`;
          if (serviceBsEl) serviceBsEl.textContent = formatBs(SERVICE_FEE);

          if (tipRowEl && tipEl && tipBsEl) {
            if (currentDriverTip > 0) {
              tipRowEl.classList.remove('hidden');
              tipRowEl.classList.add('flex');
              tipEl.textContent = `$${currentDriverTip.toFixed(2)}`;
              tipBsEl.textContent = formatBs(currentDriverTip);
            } else {
              tipRowEl.classList.add('hidden');
              tipRowEl.classList.remove('flex');
            }
          }

          if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
          if (totalBsEl) totalBsEl.textContent = formatBs(total);
          if (btnTotal) btnTotal.textContent = `$${total.toFixed(2)}`;
          if (exactBsEl) {
            const exactBs = total * (bcvRate || 896.12);
            exactBsEl.textContent = `Bs. ${new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(exactBs)}`;
          }

          container.innerHTML = storeGroups.map(group => {
            const groupSubtotal = group.items.reduce((acc, it) => acc + (Number(it.price) * (it.qty || 1)), 0);
            const groupItemsCount = group.items.reduce((acc, it) => acc + (it.qty || 1), 0);
            return `
              <div class="rounded-2xl border border-gray-100 bg-[#FAFAFC] p-3.5 space-y-3">
                <div class="flex items-center justify-between pb-2.5 border-b border-gray-200/70">
                  <div class="flex items-center gap-2.5">
                    <img src="${group.logo}" alt="${group.storeName}" class="w-8 h-8 rounded-xl object-cover border border-gray-200" />
                    <div>
                      <div class="flex items-center gap-1.5">
                        <h4 class="text-xs font-black text-gray-900">${group.storeName}</h4>
                        <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[9px] font-black">Oficial</span>
                      </div>
                      <span class="text-[10px] font-bold text-gray-400">${groupItemsCount} ${groupItemsCount === 1 ? 'artículo' : 'artículos'} • Subtotal: $${groupSubtotal.toFixed(2)}</span>
                    </div>
                  </div>
                  <a href="/stores/${group.storeId}" class="text-[10px] font-extrabold text-[#FF5A00] hover:underline">
                    + Agregar más
                  </a>
                </div>
                <div class="space-y-2.5">
                  ${group.items.map(item => `
                    <div class="flex items-center justify-between gap-3 bg-white p-2.5 rounded-xl border border-gray-100">
                      <div class="w-12 h-12 rounded-xl overflow-hidden bg-gray-50 shrink-0 p-1 border border-gray-100">
                        <img src="${item.image || ''}" alt="${item.name}" class="w-full h-full object-contain" />
                      </div>
                      <div class="flex-1 min-w-0">
                        <h5 class="text-xs font-bold text-gray-900 truncate">${item.name}</h5>
                        ${item.notes ? `<p class="text-[10px] text-gray-400 truncate">Nota: ${item.notes}</p>` : ''}
                        <div class="flex items-baseline gap-1.5 mt-0.5">
                          <span class="text-xs font-black text-[#FF7A00]">$${(Number(item.price) * (item.qty || 1)).toFixed(2)}</span>
                          <span class="text-[9px] text-gray-400 font-semibold">${formatBs(Number(item.price) * (item.qty || 1))}</span>
                        </div>
                      </div>
                      <div class="flex items-center gap-2 bg-gray-50 rounded-xl px-2 py-1 border border-gray-200/60">
                        <button data-action="minus" data-id="${item.id}" class="btn-qty text-xs font-black text-gray-600 hover:text-[#FF7A00] w-5 h-5 flex items-center justify-center cursor-pointer">-</button>
                        <span class="text-xs font-black text-gray-900">${item.qty}</span>
                        <button data-action="plus" data-id="${item.id}" class="btn-qty text-xs font-black text-gray-600 hover:text-[#FF7A00] w-5 h-5 flex items-center justify-center cursor-pointer">+</button>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          }).join('');

          container.querySelectorAll('.btn-qty').forEach(btn => {
            btn.addEventListener('click', () => {
              const pid = btn.getAttribute('data-id');
              const act = btn.getAttribute('data-action');
              changeQty(pid, act === 'plus' ? 1 : -1);
            });
          });
        }

        async function handleCheckout() {
          const cart = getCart();
          if (cart.length === 0) {
            alert('El carrito está vacío');
            return;
          }

          const storeGroups = groupCartByStore(cart);
          const paymentMethod = getSelectedPayment();
          const refInput = document.getElementById('mobile-pay-ref');
          const bankSelect = document.getElementById('mobile-pay-bank');
          const bankRef = refInput ? refInput.value.trim() : '';
          const bankOrigin = bankSelect ? bankSelect.value : '0134';

          if (paymentMethod === 'mobile_pay' && (!bankRef || bankRef.length < 4)) {
            alert('Por favor introduce los últimos dígitos del número de referencia de tu Pago Móvil.');
            if (refInput) refInput.focus();
            return;
          }

          const confirmBtn = document.getElementById('btn-confirm-order');
          const btnText = document.getElementById('btn-text');
          if (confirmBtn) confirmBtn.disabled = true;
          if (btnText) btnText.textContent = 'Procesando Pedido...';

          let deliveryLat = 10.4852;
          let deliveryLng = -66.0965;
          let addressText = document.getElementById('checkout-address') ? document.getElementById('checkout-address').textContent : 'Av. Andrés Eloy Blanco, Higuerote';

          const savedLoc = localStorage.getItem('traigalo_location');
          if (savedLoc) {
            try {
              const parsedLoc = JSON.parse(savedLoc);
              if (parsedLoc.latitude && parsedLoc.longitude) {
                deliveryLat = parsedLoc.latitude;
                deliveryLng = parsedLoc.longitude;
              }
              if (parsedLoc.address) {
                addressText = parsedLoc.address;
              }
            } catch {}
          }

          let customerId = '44444444-4444-4444-4444-444444444444';
          const customerName = document.getElementById('customer-name') ? document.getElementById('customer-name').value.trim() : 'Freddy Campos';
          const customerPhone = document.getElementById('customer-phone') ? document.getElementById('customer-phone').value.trim() : '+58 412 890 1234';

          const rawUser = localStorage.getItem('traigalo_user');
          if (rawUser) {
            try {
              const parsedUser = JSON.parse(rawUser);
              if (parsedUser.id) customerId = parsedUser.id;
            } catch {}
          }

          const orderNotesInput = document.getElementById('order-notes');
          const rawNotes = orderNotesInput ? orderNotesInput.value.trim() : '';
          const contactPrefix = customerName ? `Recibe: ${customerName} (${customerPhone})` : '';
          const combinedNotes = [contactPrefix, rawNotes].filter(Boolean).join(' • ');
          const finalDeliveryAddress = bankRef ? `${addressText} (Ref PagoMóvil: ${bankRef})` : addressText;

          const createdOrderIds = [];
          const tipPerOrder = storeGroups.length > 0 ? Number((currentDriverTip / storeGroups.length).toFixed(2)) : 0;
          const servicePerOrder = storeGroups.length > 0 ? Number((SERVICE_FEE / storeGroups.length).toFixed(2)) : SERVICE_FEE;

          try {
            for (const group of storeGroups) {
              const groupSubtotal = group.items.reduce((acc, it) => acc + (Number(it.price) * (it.qty || 1)), 0);
              const groupTotalUSD = groupSubtotal + baseDeliveryFeePerStore + servicePerOrder + tipPerOrder;
              const groupTotalBS = groupTotalUSD * (bcvRate || 896.12);

              const payload = {
                customer_id: customerId,
                store_id: group.storeId,
                delivery_latitude: deliveryLat,
                delivery_longitude: deliveryLng,
                delivery_address: finalDeliveryAddress,
                instructions: combinedNotes,
                notes: combinedNotes,
                payment_method: paymentMethod,
                delivery_fee: baseDeliveryFeePerStore,
                service_fee: servicePerOrder,
                tip: tipPerOrder,
                items: group.items.map(item => ({
                  product_id: item.id,
                  quantity: item.qty || 1,
                  unit_price: Number(item.price),
                  notes: item.notes || ''
                }))
              };

              const res = await fetch(API_ORDERS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });

              if (!res.ok) {
                throw new Error(`Error en el servidor: ${res.status}`);
              }

              const createdOrder = await res.json();
              if (createdOrder && createdOrder.id) {
                createdOrderIds.push(createdOrder.id);

                if (paymentMethod === 'mobile_pay' && bankRef) {
                  await fetch(API_PAYMENTS_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      order_id: createdOrder.id,
                      payment_method: 'pago_movil',
                      reference_number: bankRef,
                      bank_origin: bankOrigin,
                      bank_destination: '0134',
                      amount_bs: parseFloat(groupTotalBS.toFixed(2)),
                      exchange_rate: bcvRate || 896.12
                    })
                  }).catch(() => {});
                }
              }
            }

            localStorage.removeItem(CART_STORAGE_KEY);
            const primaryOrderId = createdOrderIds[0] || '';
            window.location.href = `/orders/track?id=${primaryOrderId}`;
          } catch (err) {
            alert('No se pudo procesar la orden. Intente nuevamente.');
            if (confirmBtn) confirmBtn.disabled = false;
            if (btnText) btnText.textContent = 'Confirmar y Enviar Pedido';
          }
        }

        const confirmBtn = document.getElementById('btn-confirm-order');
        if (confirmBtn) {
          confirmBtn.addEventListener('click', handleCheckout);
        }

        const changeAddressBtn = document.getElementById('btn-change-checkout-address');
        if (changeAddressBtn) {
          changeAddressBtn.addEventListener('click', () => {
            if (typeof window.openLocationModal === 'function') {
              window.openLocationModal();
            }
          });
        }

        function updateCheckoutAddressDisplay() {
          const addressEl = document.getElementById('checkout-address');
          const savedLoc = localStorage.getItem('traigalo_location');
          if (savedLoc) {
            try {
              const parsed = JSON.parse(savedLoc);
              if (parsed.address && addressEl) {
                addressEl.textContent = parsed.address;
              }
            } catch {}
          } else {
            const savedAddr = localStorage.getItem('traigalo_address');
            if (savedAddr && addressEl) {
              addressEl.textContent = savedAddr;
            }
          }
        }

        window.addEventListener('traigalo:location-changed', (e) => {
          if (e.detail && e.detail.address) {
            const addressEl = document.getElementById('checkout-address');
            if (addressEl) addressEl.textContent = e.detail.address;
            refreshDynamicDeliveryEstimate();
          }
        });

        updatePaymentStyles();
        updateCheckoutAddressDisplay();
        renderCart();
        refreshDynamicDeliveryEstimate();
      })();
    </script>
    <LocationModal />
  </body>
</html>
