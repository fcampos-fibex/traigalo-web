---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();

function cleanProductName(rawName: string): string {
  return String(rawName || '')
    .replace(/^Ariculares/i, 'Auriculares')
    .replace(/^5-Sprinng\s*(CHEST\s*PULL)?/i, '5-Spring Chest Pull')
    .replace(/^Abdominal musclw/i, 'Abdominal Muscle Trainer')
    .replace(/^Aceite de resino/i, 'Aceite de Ricino')
    .replace(/^After chave/i, 'After Shave Profesional')
    .replace(/^Back pain need hellp/i, 'Soporte Lumbar Back Pain')
    .replace(/^Brocha de ljo/i, 'Brocha de Lujo');
}

let orders: any[] = [];
try {
  const res = await fetch(`${API_BASE}/orders?size=20`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      orders = await Promise.all(
        data.map(async (ord) => {
          if (Array.isArray(ord.items) && ord.items.length > 0) return ord;
          try {
            const dRes = await fetch(`${API_BASE}/orders/${ord.id}`);
            if (dRes.ok) {
              const detail = await dRes.json();
              if (detail && Array.isArray(detail.items)) {
                return { ...ord, items: detail.items };
              }
            }
          } catch {}
          return ord;
        })
      );
    }
  }
} catch {}

const productNamesMap: Record<string, string> = {};
try {
  const pRes = await fetch(`${API_BASE}/products`);
  if (pRes.ok) {
    const pList = await pRes.json();
    if (Array.isArray(pList)) {
      for (const p of pList) {
        if (p.id && p.name) productNamesMap[p.id] = cleanProductName(p.name);
      }
    }
  }
} catch {}

const statusBadges: Record<string, { label: string; class: string }> = {
  placed: { label: 'Confirmado', class: 'bg-amber-100 text-amber-800' },
  accepted_by_store: { label: 'Aceptado en Tienda', class: 'bg-blue-100 text-blue-800' },
  preparing: { label: 'Preparando Pedido', class: 'bg-blue-100 text-blue-800' },
  ready_for_pickup: { label: 'Listo p/ Despacho', class: 'bg-emerald-100 text-emerald-800' },
  driver_assigned: { label: 'Repartidor Asignado', class: 'bg-purple-100 text-purple-800' },
  driver_in_transit: { label: 'En Camino', class: 'bg-orange-100 text-[#FF7A00]' },
  in_transit: { label: 'En Camino', class: 'bg-orange-100 text-[#FF7A00]' },
  delivered: { label: 'Entregado', class: 'bg-emerald-100 text-emerald-800' },
  cancelled: { label: 'Cancelado', class: 'bg-rose-100 text-rose-800' }
};

function formatPaymentMethod(pm: string): string {
  const norm = String(pm || '').toLowerCase();
  if (norm === 'mobile_pay' || norm === 'pago_movil') return 'Pago Móvil BCV';
  if (norm === 'cash' || norm === 'efectivo') return 'Efectivo contra entrega';
  if (norm === 'card' || norm === 'tarjeta') return 'Tarjeta Débito / Crédito';
  return pm || 'Pago Móvil BCV';
}
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Mis Pedidos | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-6 w-full space-y-6">
      
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Mis Pedidos</h1>
          <p class="text-xs text-gray-400 mt-0.5">Historial multi-tienda y rastreo satelital de entregas activas</p>
        </div>
        <span class="text-xs font-black text-[#FF7A00] bg-orange-50 px-3 py-1.5 rounded-full">
          {orders.length} pedidos
        </span>
      </div>

      <div class="space-y-4">
        {orders.length === 0 ? (
          <div class="bg-white rounded-3xl p-10 text-center border border-gray-100 shadow-sm">
            <span class="text-4xl block mb-2">🛍️</span>
            <h3 class="text-sm font-extrabold text-gray-900">Aún no tienes pedidos registrados</h3>
            <p class="text-xs text-gray-400 mt-1 mb-4">Descubre los comercios oficiales de tu zona</p>
            <a href="/" class="inline-flex px-5 py-2.5 rounded-2xl bg-[#FF7A00] text-white text-xs font-black shadow-md shadow-orange-600/20 active:scale-95 transition-all">
              Explorar Catálogo
            </a>
          </div>
        ) : (
          orders.map((ord) => {
            const totalUSD = Number(ord.total) || 0;
            const totalBsFormatted = formatBs(totalUSD, bcvRate);
            const statusInfo = statusBadges[ord.status] || { label: ord.status, class: 'bg-gray-100 text-gray-700' };
            const isLive = ord.status === 'in_transit' || ord.status === 'driver_in_transit' || ord.status === 'driver_assigned' || ord.status === 'preparing' || ord.status === 'accepted_by_store';
            const isBarbero = ord.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f';
            const storeName = isBarbero ? 'El Sitio del Barbero' : 'WILY VIDEO';
            const storeLogo = isBarbero ? '/stores/barbero-logo.webp' : '/stores/wily-logo.webp';
            const orderItems = Array.isArray(ord.items) ? ord.items : [];

            return (
              <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-xs hover:shadow-md transition-all space-y-3.5">
                <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                  <div class="flex items-center gap-2.5">
                    <img src={storeLogo} alt={storeName} class="w-9 h-9 rounded-xl object-cover border border-gray-200" />
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-black text-gray-900">{storeName}</span>
                        <span class="text-xs font-bold text-gray-400 font-mono">#{ord.order_number || ord.id.slice(0, 8)}</span>
                      </div>
                      <span class="text-[11px] text-gray-400 font-medium block">{new Date(ord.placed_at || Date.now()).toLocaleDateString('es-VE', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                    </div>
                  </div>
                  <span class={`text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider ${statusInfo.class}`}>
                    {statusInfo.label}
                  </span>
                </div>

                {orderItems.length > 0 && (
                  <div class="bg-gray-50 rounded-2xl p-3 border border-gray-100 space-y-1">
                    {orderItems.map((it: any) => {
                      const pName = productNamesMap[it.product_id] || cleanProductName(it.name || '') || 'Artículo de Catálogo Oficial';
                      return (
                        <div class="flex items-center justify-between text-xs">
                          <span class="font-bold text-gray-800"><strong class="text-[#FF7A00] font-black">{Number(it.quantity) || 1}x</strong> {pName}</span>
                          <span class="font-bold text-gray-500">${((Number(it.unit_price) || 0) * (Number(it.quantity) || 1)).toFixed(2)}</span>
                        </div>
                      );
                    })}
                  </div>
                )}

                <div class="flex items-start justify-between gap-4 text-xs">
                  <div>
                    <span class="text-[10px] text-gray-400 uppercase font-black tracking-wider block">Dirección de Entrega</span>
                    <p class="font-bold text-gray-800 mt-0.5">{ord.delivery_address || 'Higuerote, Estado Miranda'}</p>
                    <span class="text-[11px] text-gray-500 font-medium block mt-1">Método: <strong class="text-gray-700">{formatPaymentMethod(ord.payment_method)}</strong></span>
                  </div>

                  <div class="text-right shrink-0">
                    <span class="text-base font-black text-gray-950">${totalUSD.toFixed(2)}</span>
                    <span class="text-[10px] text-gray-400 font-semibold block">{totalBsFormatted}</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-gray-50 flex items-center justify-between">
                  <div class="text-[11px] text-gray-400 font-medium">
                    {isLive ? (
                      <span class="inline-flex items-center gap-1.5 text-emerald-600 font-bold">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        Seguimiento GPS en Vivo Activo
                      </span>
                    ) : (
                      <span>Orden verificada en sistema</span>
                    )}
                  </div>

                  <div class="flex items-center gap-2">
                    <a
                      href={`/stores/${ord.store_id || '46a0baf0-4100-465d-934a-f2d14f004ba5'}`}
                      class="px-3 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-extrabold text-xs transition-colors"
                    >
                      Ver Tienda
                    </a>
                    <a 
                      href={`/orders/track?id=${ord.id}`}
                      class="px-4 py-2 rounded-xl bg-orange-50 hover:bg-orange-100 text-[#FF7A00] font-black text-xs active:scale-95 transition-all flex items-center gap-1.5"
                    >
                      <span>Rastrear Pedido</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>

    </main>

    <Footer />
    <BottomNav />
  </body>
</html>
