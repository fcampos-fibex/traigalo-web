---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();

let orders: any[] = [];
try {
  const res = await fetch(`${API_BASE}/orders?size=20`);
  if (res.ok) {
    orders = await res.json();
  }
} catch {}

const statusBadges: Record<string, { label: string; class: string }> = {
  placed: { label: 'Nuevo Pedido', class: 'bg-amber-100 text-amber-800' },
  accepted_by_store: { label: 'Aceptado', class: 'bg-blue-100 text-blue-800' },
  preparing: { label: 'En Cocina', class: 'bg-blue-100 text-blue-800' },
  ready_for_pickup: { label: 'Listo p/ Despacho', class: 'bg-emerald-100 text-emerald-800' },
  driver_assigned: { label: 'Repartidor Asignado', class: 'bg-purple-100 text-purple-800' },
  in_transit: { label: 'En Camino', class: 'bg-orange-100 text-[#FF7A00]' },
  delivered: { label: 'Entregado', class: 'bg-emerald-100 text-emerald-800' },
  cancelled: { label: 'Cancelado', class: 'bg-rose-100 text-rose-800' }
};
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Mis Pedidos | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-6 w-full space-y-6">
      
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Mis Pedidos</h1>
          <p class="text-xs text-gray-400 mt-0.5">Historial y rastreo de entregas activas</p>
        </div>
        <span class="text-xs font-black text-[#FF7A00] bg-orange-50 px-3 py-1.5 rounded-full">
          {orders.length} pedidos
        </span>
      </div>

      <div class="space-y-4">
        {orders.length === 0 ? (
          <div class="bg-white rounded-3xl p-10 text-center border border-gray-100 shadow-sm">
            <span class="text-4xl block mb-2">🛍️</span>
            <h3 class="text-sm font-extrabold text-gray-900">Aún no tienes pedidos registrados</h3>
            <p class="text-xs text-gray-400 mt-1 mb-4">Descubre los mejores comercios de tu zona</p>
            <a href="/" class="inline-flex px-5 py-2.5 rounded-2xl bg-[#FF7A00] text-white text-xs font-black shadow-md shadow-orange-600/20 active:scale-95 transition-all">
              Explorar Catálogo
            </a>
          </div>
        ) : (
          orders.map((ord) => {
            const totalUSD = Number(ord.total) || 0;
            const totalBsFormatted = formatBs(totalUSD, bcvRate);
            const statusInfo = statusBadges[ord.status] || { label: ord.status, class: 'bg-gray-100 text-gray-700' };
            const isLive = ord.status === 'in_transit' || ord.status === 'driver_assigned' || ord.status === 'preparing';

            return (
              <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-xs hover:shadow-md transition-all space-y-3.5">
                <div class="flex items-center justify-between pb-3 border-b border-gray-50">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-black text-gray-900 font-mono">#{ord.order_number || ord.id.slice(0, 8)}</span>
                    <span class="text-xs text-gray-400 font-medium">• {new Date(ord.placed_at || Date.now()).toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                  <span class={`text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider ${statusInfo.class}`}>
                    {statusInfo.label}
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4 text-xs">
                  <div>
                    <span class="text-[10px] text-gray-400 uppercase font-black tracking-wider block">Dirección de Entrega</span>
                    <p class="font-bold text-gray-800 mt-0.5">{ord.delivery_address || 'Av. Libertador 102, Caracas'}</p>
                    <span class="text-[11px] text-gray-500 capitalize block mt-1">Método: {ord.payment_method || 'Pago Móvil'}</span>
                  </div>

                  <div class="text-right shrink-0">
                    <span class="text-sm font-black text-gray-950">${totalUSD.toFixed(2)}</span>
                    <span class="text-[10px] text-gray-400 font-semibold block">{totalBsFormatted}</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-gray-50 flex items-center justify-between">
                  <div class="text-[11px] text-gray-400 font-medium">
                    {isLive ? (
                      <span class="inline-flex items-center gap-1.5 text-emerald-600 font-bold">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        Seguimiento en Vivo Activo
                      </span>
                    ) : (
                      <span>Entrega finalizada</span>
                    )}
                  </div>

                  <a 
                    href={`/orders/track?id=${ord.id}`}
                    class="px-4 py-2 rounded-xl bg-orange-50 hover:bg-orange-100 text-[#FF7A00] font-black text-xs active:scale-95 transition-all flex items-center gap-1.5"
                  >
                    <span>Rastrear Pedido</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            );
          })
        )}
      </div>

    </main>

    <Footer />
    <BottomNav />
  </body>
</html>
