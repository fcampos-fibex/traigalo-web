---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import { fetchStoresMap } from '../../adapters/stores';
import '../../styles/global.css';
import '../../styles/pages/orders.css';

const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();
const storesMap = await fetchStoresMap();

function cleanProductName(rawName: string): string {
  return String(rawName || '')
    .replace(/^Ariculares/i, 'Auriculares')
    .replace(/^5-Sprinng\s*(CHEST\s*PULL)?/i, '5-Spring Chest Pull')
    .replace(/^Abdominal musclw/i, 'Abdominal Muscle Trainer')
    .replace(/^Aceite de resino/i, 'Aceite de Ricino')
    .replace(/^After chave/i, 'After Shave Profesional')
    .replace(/^Back pain need hellp/i, 'Soporte Lumbar Back Pain')
    .replace(/^Brocha de ljo/i, 'Brocha de Lujo');
}

let orders: any[] = [];
try {
  const res = await fetch(`${API_BASE}/orders?size=20`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      orders = await Promise.all(
        data.map(async (ord) => {
          if (Array.isArray(ord.items) && ord.items.length > 0) return ord;
          try {
            const dRes = await fetch(`${API_BASE}/orders/${ord.id}`);
            if (dRes.ok) {
              const detail = await dRes.json();
              if (detail && Array.isArray(detail.items)) {
                return { ...ord, items: detail.items };
              }
            }
          } catch {}
          return ord;
        })
      );
    }
  }
} catch {}

const productNamesMap: Record<string, string> = {};
try {
  const pRes = await fetch(`${API_BASE}/products`);
  if (pRes.ok) {
    const pList = await pRes.json();
    if (Array.isArray(pList)) {
      for (const p of pList) {
        if (p.id && p.name) productNamesMap[p.id] = cleanProductName(p.name);
      }
    }
  }
} catch {}

const statusBadges: Record<string, { label: string; tone: string }> = {
  placed: { label: 'Confirmado', tone: 'wait' },
  accepted_by_store: { label: 'Aceptado por la tienda', tone: 'work' },
  preparing: { label: 'Preparando pedido', tone: 'work' },
  ready_for_pickup: { label: 'Listo para despacho', tone: 'work' },
  driver_assigned: { label: 'Repartidor asignado', tone: 'move' },
  driver_in_transit: { label: 'En camino', tone: 'move' },
  in_transit: { label: 'En camino', tone: 'move' },
  delivered: { label: 'Entregado', tone: 'done' },
  cancelled: { label: 'Cancelado', tone: 'bad' }
};

function formatPaymentMethod(pm: string): string {
  const norm = String(pm || '').toLowerCase();
  if (norm === 'mobile_pay' || norm === 'pago_movil') return 'Pago Móvil BCV';
  if (norm === 'cash' || norm === 'efectivo') return 'Efectivo contra entrega';
  if (norm === 'card' || norm === 'tarjeta') return 'Tarjeta de débito o crédito';
  return pm || 'Pago Móvil BCV';
}
---


<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis pedidos | Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher currentRole="client" />
      <Header />

      <main class="tg-wrap tg-main ord-wrap">
        <section class="tg-section" aria-labelledby="orders-title">
          <div class="tg-head">
            <div>
              <h1 id="orders-title">Mis pedidos</h1>
              <p>Tus pedidos de todas las tiendas y el rastreo de las entregas activas.</p>
            </div>
            <span class="ord-count">{orders.length === 1 ? '1 pedido' : `${orders.length} pedidos`}</span>
          </div>

          {orders.length === 0 ? (
            <div class="tg-empty">
              <h3>Aún no tienes pedidos</h3>
              <p>Descubre las tiendas de tu zona y haz tu primer pedido.</p>
              <div class="tg-empty-actions">
                <a href="/" class="tg-btn tg-btn--primary tg-btn--sm">Explorar tiendas</a>
              </div>
            </div>
          ) : (
            <ul class="ord-list">
              {orders.map((ord) => {
                const totalUSD = Number(ord.total) || 0;
                const totalBsFormatted = formatBs(totalUSD, bcvRate);
                const statusInfo = statusBadges[ord.status] || { label: ord.status, tone: 'none' };
                const isLive = ord.status === 'in_transit' || ord.status === 'driver_in_transit' || ord.status === 'driver_assigned' || ord.status === 'preparing' || ord.status === 'accepted_by_store';
                const storeMeta = storesMap[ord.store_id] || null;
                const storeName = storeMeta?.name || 'Comercio oficial';
                const storeLogo = storeMeta?.logo_url || '/brand-icon.webp';
                const orderItems = Array.isArray(ord.items) ? ord.items : [];

                return (
                  <li class="ord-card" data-tone={statusInfo.tone}>
                    <div class="ord-card-top">
                      <div class="ord-store">
                        <img src={storeLogo} alt="" width="44" height="44" loading="lazy" />
                        <div>
                          <h2 class="ord-store-name">{storeName}</h2>
                          <div class="ord-meta">
                            <span class="ord-num">Pedido {ord.order_number || ord.id.slice(0, 8)}</span>
                            <span>{new Date(ord.placed_at || Date.now()).toLocaleDateString('es-VE', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                          </div>
                        </div>
                      </div>
                      <span class="ord-status">{statusInfo.label}</span>
                    </div>

                    {orderItems.length > 0 && (
                      <ul class="ord-items">
                        {orderItems.map((it: any) => {
                          const pName = productNamesMap[it.product_id] || cleanProductName(it.name || '') || 'Artículo del catálogo';
                          return (
                            <li class="ord-item">
                              <span><b>{Number(it.quantity) || 1}x</b>{pName}</span>
                              <span class="ord-item-price">${((Number(it.unit_price) || 0) * (Number(it.quantity) || 1)).toFixed(2)}</span>
                            </li>
                          );
                        })}
                      </ul>
                    )}

                    <div class="ord-facts">
                      <dl>
                        <dt>Dirección de entrega</dt>
                        <dd>{ord.delivery_address || 'Higuerote, estado Miranda'}</dd>
                        <dt>Método de pago</dt>
                        <dd>{formatPaymentMethod(ord.payment_method)}</dd>
                      </dl>
                      <div class="ord-total">
                        <span class="tg-price">${totalUSD.toFixed(2)}</span>
                        <span class="tg-price-bs">{totalBsFormatted}</span>
                      </div>
                    </div>

                    <div class="ord-card-foot">
                      {isLive ? (
                        <span class="ord-note ord-note--live"><span class="ord-pulse" aria-hidden="true"></span>Seguimiento en vivo activo</span>
                      ) : (
                        <span class="ord-note">Pedido verificado</span>
                      )}
                      <div class="ord-actions">
                        <a
                          href={`/stores/${ord.store_id || '46a0baf0-4100-465d-934a-f2d14f004ba5'}`}
                          class="tg-btn tg-btn--quiet tg-btn--sm"
                        >
                          Ver tienda
                        </a>
                        <a
                          href={`/orders/track?id=${ord.id}`}
                          class="tg-btn tg-btn--primary tg-btn--sm"
                        >
                          Rastrear pedido
                        </a>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </main>

      <Footer />
      <BottomNav />
    </div>
  </body>
</html>
