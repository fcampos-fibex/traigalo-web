---
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const requestedOrderId = Astro.url.searchParams.get('id') || '';
const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();

function cleanProductName(rawName: string): string {
  return String(rawName || '')
    .replace(/^Ariculares/i, 'Auriculares')
    .replace(/^5-Sprinng\s*(CHEST\s*PULL)?/i, '5-Spring Chest Pull')
    .replace(/^Abdominal musclw/i, 'Abdominal Muscle Trainer')
    .replace(/^Aceite de resino/i, 'Aceite de Ricino')
    .replace(/^After chave/i, 'After Shave Profesional')
    .replace(/^Back pain need hellp/i, 'Soporte Lumbar Back Pain')
    .replace(/^Brocha de ljo/i, 'Brocha de Lujo');
}

let orderData: any = null;
if (requestedOrderId) {
  try {
    const res = await fetch(`${API_BASE}/orders/${requestedOrderId}`);
    if (res.ok) {
      orderData = await res.json();
    }
  } catch {}
}

if (!orderData) {
  try {
    const listRes = await fetch(`${API_BASE}/orders?size=5`);
    if (listRes.ok) {
      const list = await listRes.json();
      if (Array.isArray(list) && list.length > 0) {
        orderData = list[0];
      }
    }
  } catch {}
}

const orderId = orderData?.id || requestedOrderId || '';
let storeId = orderData?.store_id || '';
let storeName = 'Comercio Oficial';

if (storeId) {
  try {
    const sRes = await fetch(`${API_BASE}/stores/${storeId}`);
    if (sRes.ok) {
      const sJson = await sRes.json();
      if (sJson?.name) storeName = sJson.name;
    }
  } catch {}
}

let productNamesMap: Record<string, string> = {};
try {
  const pRes = await fetch(`${API_BASE}/products`);
  if (pRes.ok) {
    const pList = await pRes.json();
    if (Array.isArray(pList)) {
      for (const p of pList) {
        if (p.id && p.name) productNamesMap[p.id] = cleanProductName(p.name);
      }
    }
  }
} catch {}

const resolvedItems = Array.isArray(orderData?.items) && orderData.items.length > 0
  ? orderData.items.map((it: any) => ({
      name: productNamesMap[it.product_id] || cleanProductName(it.name || '') || 'Producto Oficial Verificado',
      qty: Number(it.quantity) || 1,
      price: Number(it.unit_price) || 10.0,
      priceBs: formatBs(Number(it.unit_price) || 10.0, bcvRate)
    }))
  : [
      { name: 'Artículo de Catálogo Oficial', qty: 1, price: Number(orderData?.subtotal) || 15.00, priceBs: formatBs(Number(orderData?.subtotal) || 15.00, bcvRate) }
    ];

const currentStatus = orderData?.status || 'in_transit';

const activeOrder = {
  id: orderId,
  orderNumber: orderData?.order_number || 1042,
  storeId: storeId,
  storeName: storeName,
  driverName: 'Carlos Mendoza',
  driverVehicle: 'Yamaha FZ • Placa: AB1-23C',
  driverRating: '4.9 ★',
  status: currentStatus,
  eta: currentStatus === 'delivered' ? 'Entregado' : '15-20 min',
  address: orderData?.delivery_address || 'Av. Andrés Eloy Blanco, Higuerote',
  items: resolvedItems,
  subtotal: Number(orderData?.subtotal) || 15.00,
  deliveryFee: Number(orderData?.delivery_fee) || 1.50,
  serviceFee: Number(orderData?.service_fee) || 0.50,
  total: Number(orderData?.total) || 17.00
};

const totalBs = formatBs(activeOrder.total, bcvRate);

const isPreparing = currentStatus === 'accepted_by_store' || currentStatus === 'preparing' || currentStatus === 'ready_for_pickup';
const isInTransit = currentStatus === 'driver_assigned' || currentStatus === 'in_transit' || currentStatus === 'driver_in_transit';
const isDelivered = currentStatus === 'delivered';

const steps = [
  { label: 'Confirmado', done: true, current: currentStatus === 'placed', time: 'Listo' },
  { label: 'Preparando', done: isPreparing || isInTransit || isDelivered, current: isPreparing, time: 'En tienda' },
  { label: 'En Camino', done: isInTransit || isDelivered, current: isInTransit, time: 'GPS Activo' },
  { label: 'Entregado', done: isDelivered, current: isDelivered, time: isDelivered ? 'Completado' : '15 min est.' }
];
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Rastreo de Pedido #{activeOrder.orderNumber} | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
      #map-container {
        width: 100%;
        height: 100%;
        min-height: 260px;
        border-radius: 1.5rem;
      }
      .driver-moto-marker {
        transition: transform 0.08s linear;
        transform-origin: center center;
      }
    </style>
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />

    <header class="bg-white/90 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40 px-4 py-3.5">
      <div class="max-w-2xl mx-auto flex items-center justify-between">
        <a href="/orders" class="w-10 h-10 rounded-full bg-gray-50 hover:bg-gray-100 flex items-center justify-center text-gray-800 transition-colors active:scale-95">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="text-center">
          <span class="text-[10px] font-black uppercase tracking-wider text-[#FF7A00]">
            {isDelivered ? 'Pedido Entregado' : 'Seguimiento en Tiempo Real'}
          </span>
          <h1 class="text-sm font-extrabold text-gray-900 leading-tight">Orden #{activeOrder.orderNumber}</h1>
        </div>
        <button id="btn-open-rating" type="button" class="px-2.5 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 text-[10px] font-black transition-colors cursor-pointer">
          ★ Calificar
        </button>
      </div>
    </header>

    <main class="flex-1 max-w-2xl mx-auto px-4 py-4 w-full space-y-4">
      <section class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-wider">Tiempo Estimado de Llegada</span>
            <h2 class="text-2xl font-black text-gray-950 mt-0.5">{activeOrder.eta}</h2>
            <p class="text-xs text-emerald-600 font-bold mt-1">● Despacho monitoreado desde {activeOrder.storeName}</p>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center text-3xl shadow-xs">
            🛵
          </div>
        </div>

        <div class="h-64 w-full rounded-3xl border border-gray-200 relative overflow-hidden my-4 shadow-inner">
          <div id="map-container"></div>
          <div class="absolute bottom-2 left-2 z-10 px-2.5 py-1 rounded-xl bg-white/95 backdrop-blur-md text-[10px] font-extrabold text-gray-700 shadow-sm border border-gray-100 flex items-center gap-1.5">
            <span id="ws-indicator" class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span id="ws-status-text">GPS en Vivo (Conectado)</span>
          </div>
        </div>

        <div class="grid grid-cols-4 gap-2 pt-2 border-t border-gray-100">
          {steps.map(step => (
            <div class="flex flex-col items-center text-center">
              <div class={`w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-black mb-1 ${
                step.current 
                  ? 'bg-[#FF7A00] text-white ring-3 ring-orange-500/20' 
                  : step.done 
                    ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' 
                    : 'bg-gray-100 text-gray-400'
              }`}>
                {step.done && !step.current ? '✓' : step.current ? '●' : '○'}
              </div>
              <span class={`text-[10px] font-bold leading-tight ${step.current ? 'text-[#FF7A00]' : step.done ? 'text-gray-900' : 'text-gray-400'}`}>
                {step.label}
              </span>
              <span class="text-[9px] text-gray-400">{step.time}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-sm flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-400 to-[#FF7A00] flex items-center justify-center text-white font-black text-xl shadow-xs">
            CM
          </div>
          <div>
            <h4 class="text-xs font-bold text-gray-900">{activeOrder.driverName}</h4>
            <p class="text-[10px] text-gray-400">{activeOrder.driverVehicle}</p>
            <span class="text-[10px] font-bold text-amber-500">
              {currentStatus === 'placed' ? 'Asignado para retiro en tienda' : `${activeOrder.driverRating} • Repartidor en ruta`}
            </span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a href="tel:+584128901234" class="w-10 h-10 rounded-2xl bg-gray-50 hover:bg-gray-100 text-gray-700 flex items-center justify-center text-sm transition-colors border border-gray-100" title="Llamar al repartidor">
            📞
          </a>
          <button id="btn-open-chat" type="button" class="px-3.5 h-10 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white flex items-center gap-1.5 text-xs font-black shadow-md shadow-orange-500/20 transition-all cursor-pointer active:scale-95">
            <span>💬</span>
            <span>Chat</span>
          </button>
        </div>
      </section>

      <section class="bg-white rounded-3xl p-4 border border-gray-100 shadow-sm space-y-2.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Detalles de la Orden</h3>
          <span class="text-[11px] font-bold text-gray-500 truncate max-w-[200px]">📍 {activeOrder.address}</span>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-xs font-black text-gray-900">{activeOrder.storeName}</p>
          <a href={`/stores/${activeOrder.storeId}`} class="text-[11px] font-extrabold text-[#FF5A00] hover:underline">Ver Tienda →</a>
        </div>

        <div class="space-y-1.5 pt-2 border-t border-gray-50 text-xs">
          {activeOrder.items.map(it => (
            <div class="flex justify-between items-start text-gray-700">
              <div>
                <span class="font-semibold"><strong class="text-[#FF7A00] font-black">{it.qty}x</strong> {it.name}</span>
                <span class="block text-[10px] text-gray-400 font-semibold">{it.priceBs}</span>
              </div>
              <span class="font-bold text-gray-900">${(it.price * it.qty).toFixed(2)}</span>
            </div>
          ))}
        </div>

        <div class="pt-2 border-t border-gray-100 flex justify-between items-center text-xs font-bold text-gray-900">
          <div>
            <span>Total de la Orden</span>
            <span class="block text-[10px] text-gray-400 font-semibold">{totalBs}</span>
          </div>
          <span class="text-sm font-black text-[#FF7A00]">${activeOrder.total.toFixed(2)}</span>
        </div>
      </section>
    </main>

    <div id="chat-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl flex flex-col h-[70vh] sm:h-[500px] overflow-hidden">
        <div class="px-5 py-3.5 border-b border-gray-100 flex items-center justify-between bg-white">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-400 to-[#FF7A00] text-white font-black text-xs flex items-center justify-center">
              CM
            </div>
            <div>
              <h3 class="text-xs font-black text-gray-900">{activeOrder.driverName}</h3>
              <span class="text-[10px] text-emerald-600 font-bold">● En línea • Repartidor Asignado</span>
            </div>
          </div>
          <button id="btn-close-chat" type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 font-black cursor-pointer">
            ✕
          </button>
        </div>

        <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 bg-[#FAFAFC] text-xs">
          <div class="flex items-start gap-2">
            <div class="bg-white border border-gray-100 rounded-2xl rounded-tl-xs px-3.5 py-2.5 shadow-2xs max-w-[80%]">
              <p class="font-semibold text-gray-800">¡Hola! Estoy coordinando tu pedido de {activeOrder.storeName}. Te avisaré apenas esté llegando a tu ubicación 🛵</p>
              <span class="text-[9px] text-gray-400 mt-1 block">Hace 1 min</span>
            </div>
          </div>
        </div>

        <div class="px-4 py-2 bg-white border-t border-gray-50 flex gap-1.5 overflow-x-auto no-scrollbar">
          <button type="button" class="quick-chat-btn shrink-0 px-2.5 py-1 rounded-full bg-orange-50 text-[#FF7A00] text-[10px] font-bold cursor-pointer">Estoy pendiente afuera</button>
          <button type="button" class="quick-chat-btn shrink-0 px-2.5 py-1 rounded-full bg-orange-50 text-[#FF7A00] text-[10px] font-bold cursor-pointer">Avísame al llegar</button>
          <button type="button" class="quick-chat-btn shrink-0 px-2.5 py-1 rounded-full bg-orange-50 text-[#FF7A00] text-[10px] font-bold cursor-pointer">Gracias, te espero</button>
        </div>

        <form id="chat-form" class="p-3 bg-white border-t border-gray-100 flex items-center gap-2">
          <input 
            id="chat-input"
            type="text"
            placeholder="Escribe un mensaje al repartidor..."
            autocomplete="off"
            class="flex-1 h-10 px-3.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium text-gray-900 focus:outline-none focus:bg-white focus:border-[#FF7A00]"
          />
          <button type="submit" class="h-10 px-4 rounded-xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs font-black cursor-pointer">
            Enviar
          </button>
        </form>
      </div>
    </div>

    <div id="rating-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center space-y-4">
        <div class="w-14 h-14 rounded-3xl bg-amber-50 text-amber-500 mx-auto flex items-center justify-center text-3xl shadow-sm">
          ⭐
        </div>
        <div>
          <h3 class="text-base font-black text-gray-900 leading-snug">Califica tu experiencia</h3>
          <p class="text-xs text-gray-400 mt-1">¿Qué tal estuvo tu pedido en {activeOrder.storeName} y la entrega?</p>
        </div>

        <div class="flex items-center justify-center gap-2 py-2" id="star-rating-container">
          <button type="button" data-val="1" class="star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
          <button type="button" data-val="2" class="star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
          <button type="button" data-val="3" class="star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
          <button type="button" data-val="4" class="star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
          <button type="button" data-val="5" class="star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer">★</button>
        </div>

        <textarea 
          id="rating-comment"
          rows="2" 
          placeholder="Escribe un comentario sobre tu producto y entrega..." 
          class="w-full p-3 bg-gray-50 border border-gray-100 rounded-2xl text-xs text-gray-800 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] transition-all"
        ></textarea>

        <div class="grid grid-cols-2 gap-2 pt-2">
          <button 
            id="btn-skip-rating"
            type="button" 
            class="h-11 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs active:scale-95 transition-all cursor-pointer"
          >
            Cerrar
          </button>
          <button 
            id="btn-submit-rating"
            type="button" 
            class="h-11 rounded-xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-black text-xs shadow-md shadow-orange-600/20 active:scale-95 transition-all cursor-pointer"
          >
            Enviar Reseña
          </button>
        </div>
      </div>
    </div>

    <BottomNav />

    <script is:inline define:vars={{ orderId: activeOrder.id, storeId: activeOrder.storeId, orderStatus: activeOrder.status }}>
      (() => {
        let map = null;
        let driverMarker = null;
        let routePolyline = null;
        let storeLocation = { lat: 10.4865, lng: -66.0998 };
        let clientLocation = { lat: 10.4852, lng: -66.0965 };
        let currentDriverPos = { lat: 10.4859, lng: -66.0982 };
        let targetDriverPos = { lat: 10.4859, lng: -66.0982 };
        let currentBearing = 0;
        let targetBearing = 0;
        let activeWs = null;

        function calculateBearing(startLat, startLng, destLat, destLng) {
          const startLatRad = (startLat * Math.PI) / 180;
          const startLngRad = (startLng * Math.PI) / 180;
          const destLatRad = (destLat * Math.PI) / 180;
          const destLngRad = (destLng * Math.PI) / 180;

          const y = Math.sin(destLngRad - startLngRad) * Math.cos(destLatRad);
          const x =
            Math.cos(startLatRad) * Math.sin(destLatRad) -
            Math.sin(startLatRad) * Math.cos(destLatRad) * Math.cos(destLngRad - startLngRad);
          const brng = (Math.atan2(y, x) * 180) / Math.PI;
          return (brng + 360) % 360;
        }

        function updateMarkerRotation(bearing) {
          const el = document.getElementById('driver-moto-svg-container');
          if (el) {
            el.style.transform = `rotate(${bearing}deg)`;
          }
        }

        function checkDeliveredModal() {
          const ratingModal = document.getElementById('rating-modal');
          if (orderStatus === 'delivered' && ratingModal) {
            ratingModal.classList.remove('hidden');
          }
        }

        const openRatingBtn = document.getElementById('btn-open-rating');
        if (openRatingBtn) {
          openRatingBtn.addEventListener('click', () => {
            const ratingModal = document.getElementById('rating-modal');
            if (ratingModal) ratingModal.classList.remove('hidden');
          });
        }

        let selectedStars = 5;
        document.querySelectorAll('.star-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            selectedStars = parseInt(btn.getAttribute('data-val') || '5', 10);
            document.querySelectorAll('.star-btn').forEach((b) => {
              const val = parseInt(b.getAttribute('data-val') || '0', 10);
              b.className = val <= selectedStars 
                ? 'star-btn text-3xl text-amber-400 hover:scale-110 transition-transform cursor-pointer' 
                : 'star-btn text-3xl text-gray-200 hover:scale-110 transition-transform cursor-pointer';
            });
          });
        });

        const skipBtn = document.getElementById('btn-skip-rating');
        if (skipBtn) {
          skipBtn.addEventListener('click', () => {
            const ratingModal = document.getElementById('rating-modal');
            if (ratingModal) ratingModal.classList.add('hidden');
          });
        }

        const submitRatingBtn = document.getElementById('btn-submit-rating');
        if (submitRatingBtn) {
          submitRatingBtn.addEventListener('click', async () => {
            submitRatingBtn.textContent = 'Enviando...';
            submitRatingBtn.disabled = true;

            const comment = document.getElementById('rating-comment') ? document.getElementById('rating-comment').value : '';
            let customerId = '44444444-4444-4444-4444-444444444444';
            try {
              const u = JSON.parse(localStorage.getItem('traigalo_user') || '{}');
              if (u.id) customerId = u.id;
            } catch {}

            try {
              await fetch('https://api.traigalo.org/v2/reviews', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  order_id: orderId,
                  store_id: storeId,
                  customer_id: customerId,
                  store_rating: selectedStars,
                  driver_rating: selectedStars,
                  comment: comment
                })
              });
            } catch {}

            const ratingModal = document.getElementById('rating-modal');
            if (ratingModal) ratingModal.classList.add('hidden');
            submitRatingBtn.textContent = 'Enviar Reseña';
            submitRatingBtn.disabled = false;
            alert('¡Gracias! Tu calificación ha sido registrada exitosamente.');
          });
        }

        const chatModal = document.getElementById('chat-modal');
        const openChatBtn = document.getElementById('btn-open-chat');
        const closeChatBtn = document.getElementById('btn-close-chat');
        const chatForm = document.getElementById('chat-form');
        const chatInput = document.getElementById('chat-input');
        const chatMessages = document.getElementById('chat-messages');

        function appendChatMessage(text, isCustomer = true) {
          if (!chatMessages || !text) return;
          const wrapper = document.createElement('div');
          wrapper.className = isCustomer ? 'flex items-start justify-end gap-2' : 'flex items-start gap-2';
          wrapper.innerHTML = isCustomer
            ? `<div class="bg-[#FF7A00] text-white rounded-2xl rounded-tr-xs px-3.5 py-2.5 shadow-xs max-w-[80%]">
                 <p class="font-semibold">${text}</p>
                 <span class="text-[9px] text-orange-100 mt-1 block text-right">Ahora</span>
               </div>`
            : `<div class="bg-white border border-gray-100 rounded-2xl rounded-tl-xs px-3.5 py-2.5 shadow-2xs max-w-[80%]">
                 <p class="font-semibold text-gray-800">${text}</p>
                 <span class="text-[9px] text-gray-400 mt-1 block">Ahora</span>
               </div>`;
          chatMessages.appendChild(wrapper);
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function sendChatMessage(text) {
          if (!text.trim()) return;
          appendChatMessage(text, true);
          if (activeWs && activeWs.readyState === WebSocket.OPEN) {
            try {
              activeWs.send(JSON.stringify({ type: 'chat_message', order_id: orderId, sender: 'customer', message: text }));
            } catch {}
          }
          setTimeout(() => {
            appendChatMessage('Recibido 👍 Estoy a pocos minutos de tu punto de entrega.', false);
          }, 1200);
        }

        if (openChatBtn && chatModal) {
          openChatBtn.addEventListener('click', () => chatModal.classList.remove('hidden'));
        }
        if (closeChatBtn && chatModal) {
          closeChatBtn.addEventListener('click', () => chatModal.classList.add('hidden'));
        }
        if (chatForm && chatInput) {
          chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const msg = chatInput.value;
            chatInput.value = '';
            sendChatMessage(msg);
          });
        }
        document.querySelectorAll('.quick-chat-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            sendChatMessage(btn.textContent || '');
          });
        });

        function smoothAnimateMarker() {
          if (driverMarker) {
            const latDiff = (targetDriverPos.lat - currentDriverPos.lat) * 0.08;
            const lngDiff = (targetDriverPos.lng - currentDriverPos.lng) * 0.08;

            currentDriverPos.lat += latDiff;
            currentDriverPos.lng += lngDiff;

            driverMarker.setLatLng([currentDriverPos.lat, currentDriverPos.lng]);

            let diffBearing = (targetBearing - currentBearing + 540) % 360 - 180;
            currentBearing = (currentBearing + diffBearing * 0.1 + 360) % 360;
            updateMarkerRotation(currentBearing);

            if (routePolyline) {
              routePolyline.setLatLngs([
                [storeLocation.lat, storeLocation.lng],
                [currentDriverPos.lat, currentDriverPos.lng],
                [clientLocation.lat, clientLocation.lng]
              ]);
            }
          }
          requestAnimationFrame(smoothAnimateMarker);
        }

        function initTelemetryWebSocket() {
          const wsStatusText = document.getElementById('ws-status-text');
          const wsIndicator = document.getElementById('ws-indicator');

          try {
            activeWs = new WebSocket(`wss://ws.traigalo.org/ws?order_id=${encodeURIComponent(orderId)}`);
          } catch {
            startFallbackTelemetry();
            return;
          }

          activeWs.onopen = () => {
            if (wsStatusText) wsStatusText.textContent = 'GPS Redis GEO (En Vivo)';
            if (wsIndicator) {
              wsIndicator.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-ping';
            }
          };

          activeWs.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);
              if (data.type === 'chat_message' && data.sender === 'driver' && data.message) {
                appendChatMessage(data.message, false);
                return;
              }
              const lat = Number(data.lat || data.latitude);
              const lng = Number(data.lng || data.longitude);
              if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
                targetBearing = calculateBearing(currentDriverPos.lat, currentDriverPos.lng, lat, lng);
                targetDriverPos = { lat, lng };
              }
            } catch {}
          };

          activeWs.onerror = () => {
            startFallbackTelemetry();
          };

          activeWs.onclose = () => {
            startFallbackTelemetry();
          };
        }

        let fallbackStarted = false;
        function startFallbackTelemetry() {
          if (fallbackStarted) return;
          fallbackStarted = true;

          const wsStatusText = document.getElementById('ws-status-text');
          const wsIndicator = document.getElementById('ws-indicator');
          if (wsStatusText) wsStatusText.textContent = 'GPS Satelital Activo';
          if (wsIndicator) {
            wsIndicator.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
          }

          let step = 0;
          setInterval(() => {
            step = (step + 1) % 100;
            const factor = step / 100;
            const nextLat = storeLocation.lat + (clientLocation.lat - storeLocation.lat) * factor;
            const nextLng = storeLocation.lng + (clientLocation.lng - storeLocation.lng) * factor;
            targetBearing = calculateBearing(currentDriverPos.lat, currentDriverPos.lng, nextLat, nextLng);
            targetDriverPos = { lat: nextLat, lng: nextLng };
          }, 1500);
        }

        function initLeafletMap() {
          const container = document.getElementById('map-container');
          if (!container || typeof L === 'undefined') return;

          map = L.map(container, {
            zoomControl: false,
            attributionControl: false
          }).setView([currentDriverPos.lat, currentDriverPos.lng], 16);

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19
          }).addTo(map);

          const storeIcon = L.divIcon({
            className: '',
            html: '<div class="w-9 h-9 rounded-2xl bg-[#FF7A00] text-white flex items-center justify-center text-lg shadow-lg border-2 border-white">🏬</div>',
            iconSize: [36, 36],
            iconAnchor: [18, 18]
          });

          const clientIcon = L.divIcon({
            className: '',
            html: '<div class="w-9 h-9 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-lg shadow-lg border-2 border-white">🏠</div>',
            iconSize: [36, 36],
            iconAnchor: [18, 18]
          });

          const motoIcon = L.divIcon({
            className: 'driver-moto-marker',
            html: `
              <div id="driver-moto-svg-container" class="relative w-12 h-12 flex items-center justify-center transition-transform duration-75">
                <div class="absolute inset-0 rounded-full bg-[#FF7A00]/25 animate-ping"></div>
                <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-[#FF7A00] to-amber-500 shadow-xl border-2 border-white flex items-center justify-center text-white">
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M19 7c0-1.1-.9-2-2-2h-3v2h3v2.65L13.52 14H10V9H6c-2.21 0-4 1.79-4 4v3h2c0 1.66 1.34 3 3 3s3-1.34 3-3h4.18c.41 1.16 1.51 2 2.82 2 1.66 0 3-1.34 3-3h2v-5l-4-3zm-12 9c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm11 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                  </svg>
                </div>
              </div>
            `,
            iconSize: [48, 48],
            iconAnchor: [24, 24]
          });

          L.marker([storeLocation.lat, storeLocation.lng], { icon: storeIcon }).addTo(map).bindPopup('Comercio Oficial');
          L.marker([clientLocation.lat, clientLocation.lng], { icon: clientIcon }).addTo(map).bindPopup('Punto de Entrega');
          driverMarker = L.marker([currentDriverPos.lat, currentDriverPos.lng], { icon: motoIcon }).addTo(map);

          routePolyline = L.polyline([
            [storeLocation.lat, storeLocation.lng],
            [currentDriverPos.lat, currentDriverPos.lng],
            [clientLocation.lat, clientLocation.lng]
          ], {
            color: '#FF7A00',
            weight: 4,
            opacity: 0.85,
            dashArray: '8, 8'
          }).addTo(map);

          requestAnimationFrame(smoothAnimateMarker);
          initTelemetryWebSocket();
          checkDeliveredModal();
        }

        if (document.readyState === 'complete') {
          initLeafletMap();
        } else {
          window.addEventListener('load', initLeafletMap);
        }
      })();
    </script>
  </body>
</html>
