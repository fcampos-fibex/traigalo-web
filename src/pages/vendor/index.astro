---
import "../../styles/global.css";
import RoleSwitcher from "../../components/RoleSwitcher.astro";

const orders = [
  {
    id: "TRG-7821",
    time: "Hace 4 min",
    customer: "Valeria Gómez",
    items: [
      { name: "Crispy Supreme Smash", qty: 2, notes: "Sin cebolla" },
      { name: "Papas Rústicas Trufadas", qty: 1, notes: "Extra salsa BBQ" },
      { name: "Kombucha Frutos Rojos", qty: 2, notes: "" }
    ],
    status: "incoming",
    total: 34.50,
    paymentMethod: "Apple Pay (Pagado)"
  },
  {
    id: "TRG-7819",
    time: "Hace 12 min",
    customer: "Carlos Méndez",
    items: [
      { name: "Smoked Bacon BBQ Melt", qty: 1, notes: "Término medio" },
      { name: "Batido Artesanal Vainilla", qty: 1, notes: "" }
    ],
    status: "kitchen",
    total: 19.80,
    paymentMethod: "Tarjeta Débito (Pagado)"
  },
  {
    id: "TRG-7814",
    time: "Hace 22 min",
    customer: "Santiago R.",
    items: [
      { name: "Double Cheese Truffle", qty: 3, notes: "" },
      { name: "Aros de Cebolla Crujientes", qty: 2, notes: "" }
    ],
    status: "ready",
    driver: "Luis Mendoza (En camino - 2 min)",
    total: 48.00,
    paymentMethod: "Efectivo al recibir"
  }
];

const menuInventory = [
  { id: "p1", name: "Crispy Supreme Smash", price: 14.50, active: true, stock: 18 },
  { id: "p2", name: "Smoked Bacon BBQ Melt", price: 15.00, active: true, stock: 9 },
  { id: "p3", name: "Double Cheese Truffle", price: 16.50, active: false, stock: 0 },
  { id: "p4", name: "Papas Rústicas Trufadas", price: 5.50, active: true, stock: 35 }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Traigalo KDS | Portal Comercio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F8F9FA] text-[#121212] font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#FF7A00] selection:text-white pb-28">
    <RoleSwitcher currentRole="vendor" />

    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-gray-100 px-5 py-4">
      <div class="max-w-md mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#FF7A00] to-[#FFA726] flex items-center justify-center text-white shadow-md shadow-orange-500/20">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1 class="text-base font-extrabold text-gray-900 leading-tight">Burger Crave KDS</h1>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <p class="text-xs text-gray-500 font-medium">Comercio ID: <span class="font-mono text-gray-700">#TRG-VEN-01</span></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" checked class="sr-only peer" id="store-toggle">
            <div class="w-12 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
          <span class="text-xs font-bold text-emerald-600">Abierto</span>
        </div>
      </div>
    </header>

    <main class="max-w-md mx-auto px-5 pt-4 space-y-5">
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Hoy</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">$384.20</p>
          <span class="text-[10px] font-semibold text-emerald-600">+14% vs ayer</span>
        </div>
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Despachos</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">28</p>
          <span class="text-[10px] font-semibold text-emerald-600">100% a tiempo</span>
        </div>
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Tiempo Cocina</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">14 m</p>
          <span class="text-[10px] font-semibold text-gray-500">Promedio</span>
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h2 class="text-base font-extrabold text-gray-900">Comandas en Cocina</h2>
            <span class="bg-[#FF7A00] text-white text-[11px] font-black px-2 py-0.5 rounded-full">3</span>
          </div>
          <button class="text-xs font-bold text-[#FF7A00] hover:underline">Sonido Alerta: ON</button>
        </div>

        {orders.map((order) => (
          <div class={`bg-white rounded-3xl p-4 border transition-all ${
            order.status === 'incoming' 
              ? 'border-orange-200 shadow-lg shadow-orange-500/5 ring-1 ring-orange-500/20' 
              : 'border-gray-100 shadow-sm'
          }`}>
            <div class="flex items-center justify-between pb-3 border-b border-gray-100">
              <div class="flex items-center gap-2">
                <span class="text-sm font-extrabold text-gray-900">{order.id}</span>
                <span class="text-xs text-gray-400 font-medium">• {order.time}</span>
              </div>
              <span class={`text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider ${
                order.status === 'incoming' ? 'bg-amber-100 text-amber-700' :
                order.status === 'kitchen' ? 'bg-blue-100 text-blue-700' :
                'bg-emerald-100 text-emerald-700'
              }`}>
                {order.status === 'incoming' ? 'Nuevo Pedido' :
                 order.status === 'kitchen' ? 'En Cocina' :
                 'Listo p/ Entrega'}
              </span>
            </div>

            <div class="py-3 space-y-2 border-b border-gray-100">
              <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Cliente: <strong class="text-gray-900 font-bold">{order.customer}</strong></span>
                <span class="font-medium">{order.paymentMethod}</span>
              </div>
              <div class="space-y-1.5 pt-1">
                {order.items.map((it) => (
                  <div class="flex items-baseline justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <span class="w-5 h-5 rounded-lg bg-gray-100 text-gray-800 text-[11px] font-extrabold flex items-center justify-center">{it.qty}</span>
                      <span class="font-bold text-gray-800">{it.name}</span>
                    </div>
                    {it.notes && (
                      <span class="text-[10px] font-semibold text-rose-500 bg-rose-50 px-1.5 py-0.5 rounded-md">{it.notes}</span>
                    )}
                  </div>
                ))}
              </div>
            </div>

            {order.driver && (
              <div class="pt-2 pb-1 text-xs text-emerald-700 flex items-center gap-1.5 font-medium">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>Repartidor: <strong>{order.driver}</strong></span>
              </div>
            )}

            <div class="pt-3 flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold text-gray-900">${order.total.toFixed(2)}</span>
              {order.status === 'incoming' && (
                <div class="flex items-center gap-2">
                  <button class="px-3 py-2 rounded-xl border border-gray-200 text-xs font-bold text-gray-600 hover:bg-gray-50 active:scale-95">Rechazar</button>
                  <button class="px-4 py-2 rounded-xl bg-[#FF7A00] text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all">Aceptar y Cocinar</button>
                </div>
              )}
              {order.status === 'kitchen' && (
                <button class="w-full py-2.5 rounded-xl bg-blue-600 text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Marcar como Listo para Despacho
                </button>
              )}
              {order.status === 'ready' && (
                <button class="w-full py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  Entregado a Repartidor
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-extrabold text-gray-900">Control de Menú y Stock</h3>
            <p class="text-xs text-gray-400">Pausa productos agotados al instante</p>
          </div>
          <button class="text-xs font-bold text-[#FF7A00] hover:underline">+ Producto</button>
        </div>

        <div class="space-y-2.5">
          {menuInventory.map((item) => (
            <div class="flex items-center justify-between p-2.5 rounded-2xl bg-gray-50 border border-gray-100">
              <div class="flex-1 min-w-0 pr-3">
                <p class="text-xs font-extrabold text-gray-900 truncate">{item.name}</p>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-[11px] font-bold text-gray-500">${item.price.toFixed(2)}</span>
                  <span class={`text-[10px] font-semibold px-1.5 py-0.2 rounded ${item.stock > 0 ? 'bg-gray-200 text-gray-700' : 'bg-rose-100 text-rose-600'}`}>
                    Stock: {item.stock}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class={`text-[10px] font-bold ${item.active ? 'text-emerald-600' : 'text-gray-400'}`}>
                  {item.active ? 'Visible' : 'Pausado'}
                </span>
                <input type="checkbox" checked={item.active} class="w-4 h-4 rounded text-[#FF7A00] focus:ring-[#FF7A00]" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>
