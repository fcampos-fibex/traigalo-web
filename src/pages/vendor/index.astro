---
import "../../styles/global.css";
import RoleSwitcher from "../../components/RoleSwitcher.astro";
import { getOfficialExchangeRate, formatBs } from "../../adapters/rates";

const API_BASE = "https://api.traigalo.org/v2";
const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
try {
  const sRes = await fetch(`${API_BASE}/stores`);
  if (sRes.ok) {
    stores = await sRes.json();
  }
} catch {}

const currentStore = stores.find((s) => s.id === "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa") || stores[0] || {
  id: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
  name: "Burger Crave"
};

let storeOrders: any[] = [];
try {
  const oRes = await fetch(`${API_BASE}/orders?store-id=${currentStore.id}&size=50`);
  if (oRes.ok) {
    storeOrders = await oRes.json();
  }
} catch {}

if (storeOrders.length === 0) {
  try {
    const allRes = await fetch(`${API_BASE}/orders?size=50`);
    if (allRes.ok) {
      storeOrders = await allRes.json();
    }
  } catch {}
}

let storeProducts: any[] = [];
try {
  const pRes = await fetch(`${API_BASE}/stores/${currentStore.id}/products`);
  if (pRes.ok) {
    storeProducts = await pRes.json();
  }
} catch {}

const todayGmvUSD = storeOrders.reduce((acc, o) => acc + (Number(o.total) || 0), 0);
const todayGmvBs = formatBs(todayGmvUSD, bcvRate);
const totalOrdersCount = storeOrders.length;
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Traigalo KDS | Portal Comercio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F8F9FA] text-[#121212] font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#FF7A00] selection:text-white pb-28">
    <RoleSwitcher currentRole="vendor" />

    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-gray-100 px-5 py-4">
      <div class="max-w-md mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#FF7A00] to-[#FFA726] flex items-center justify-center text-white shadow-md shadow-orange-500/20">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1 class="text-base font-extrabold text-gray-900 leading-tight">{currentStore.name} KDS</h1>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <p class="text-xs text-gray-500 font-medium">Comercio ID: <span class="font-mono text-gray-700">#{currentStore.id.slice(0, 8)}</span></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div class="text-right hidden sm:block">
            <span class="text-[10px] text-gray-400 block font-semibold">Tasa BCV</span>
            <span class="text-xs font-black text-gray-800">{bcvRate.toFixed(2)} Bs/$</span>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" checked class="sr-only peer" id="store-toggle">
            <div class="w-12 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
      </div>
    </header>

    <main class="max-w-md mx-auto px-5 pt-4 space-y-5">
      <div id="incoming-order-alert" class="hidden p-4 rounded-3xl bg-[#FF7A00] text-white shadow-xl shadow-orange-600/30 animate-pulse flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl animate-bounce">🔔</span>
          <div>
            <h4 class="text-xs font-black uppercase tracking-wider">¡Nueva Orden Entrante!</h4>
            <p class="text-[11px] text-white/90 font-medium">Tienes pedidos pendientes por aceptar en cocina</p>
          </div>
        </div>
        <button id="btn-silence-alert" class="px-3 py-1.5 rounded-xl bg-white text-[#FF7A00] font-black text-xs active:scale-95 shadow-sm">
          Atender
        </button>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Hoy USD</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">${todayGmvUSD.toFixed(2)}</p>
          <span class="text-[9px] font-semibold text-gray-500 block truncate">{todayGmvBs}</span>
        </div>
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Órdenes</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">{totalOrdersCount}</p>
          <span class="text-[10px] font-semibold text-emerald-600">En sistema</span>
        </div>
        <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm text-center">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Productos</p>
          <p class="text-lg font-black text-gray-900 mt-0.5">{storeProducts.length}</p>
          <span class="text-[10px] font-semibold text-gray-500">En catálogo</span>
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h2 class="text-base font-extrabold text-gray-900">Comandas en Cocina</h2>
            <span id="order-count-badge" class="bg-[#FF7A00] text-white text-[11px] font-black px-2 py-0.5 rounded-full">{storeOrders.length}</span>
          </div>
          <button id="refresh-orders-btn" class="text-xs font-bold text-[#FF7A00] hover:underline flex items-center gap-1">
            <span>🔄</span>
            <span>Actualizar</span>
          </button>
        </div>

        <div id="orders-container" class="space-y-3">
          {storeOrders.map((order) => {
            const totalUSD = Number(order.total) || 0;
            const totalBsFormatted = formatBs(totalUSD, bcvRate);
            const statusLabel = 
              order.status === 'placed' ? 'Nuevo Pedido' :
              order.status === 'accepted_by_store' ? 'Aceptado' :
              order.status === 'preparing' ? 'En Cocina' :
              order.status === 'ready_for_pickup' ? 'Listo p/ Despacho' :
              order.status === 'driver_assigned' ? 'Repartidor Asignado' :
              order.status === 'in_transit' ? 'En Camino' :
              order.status === 'delivered' ? 'Entregado' : order.status;

            const isIncoming = order.status === 'placed';
            const isAccepted = order.status === 'accepted_by_store';
            const isPreparing = order.status === 'preparing';
            const isReady = order.status === 'ready_for_pickup';

            return (
              <div class={`bg-white rounded-3xl p-4 border transition-all ${
                isIncoming 
                  ? 'border-orange-300 shadow-lg shadow-orange-500/10 ring-2 ring-orange-500/20' 
                  : 'border-gray-100 shadow-sm'
              }`} data-order-id={order.id}>
                <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-extrabold text-gray-900 font-mono">#{order.order_number || order.id.slice(0, 8)}</span>
                    <span class="text-xs text-gray-400 font-medium">• {new Date(order.placed_at || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                  <span class={`text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider ${
                    isIncoming ? 'bg-amber-100 text-amber-800' :
                    isAccepted || isPreparing ? 'bg-blue-100 text-blue-800' :
                    isReady ? 'bg-emerald-100 text-emerald-800' :
                    'bg-gray-100 text-gray-700'
                  }`}>
                    {statusLabel}
                  </span>
                </div>

                <div class="py-3 space-y-2 border-b border-gray-100">
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <span>Destino: <strong class="text-gray-900 font-bold truncate max-w-[180px] inline-block align-bottom">{order.delivery_address || 'Dirección no especificada'}</strong></span>
                    <span class="font-medium capitalize">{order.payment_method || 'Pago Móvil'}</span>
                  </div>
                </div>

                <div class="pt-3 flex items-center justify-between gap-2">
                  <div class="flex flex-col">
                    <span class="text-sm font-black text-gray-900">${totalUSD.toFixed(2)}</span>
                    <span class="text-[10px] text-gray-400 font-semibold">{totalBsFormatted}</span>
                  </div>

                  <div class="flex items-center gap-2">
                    {isIncoming && (
                      <button 
                        data-action="accept" 
                        data-order-id={order.id}
                        class="btn-order-action px-4 py-2 rounded-xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all"
                      >
                        Aceptar Pedido
                      </button>
                    )}

                    {isAccepted && (
                      <button 
                        data-action="prepare" 
                        data-order-id={order.id}
                        class="btn-order-action px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all"
                      >
                        Comenzar Cocina
                      </button>
                    )}

                    {isPreparing && (
                      <button 
                        data-action="ready" 
                        data-order-id={order.id}
                        class="btn-order-action px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold shadow-sm active:scale-95 transition-all"
                      >
                        Marcar Listo p/ Despacho
                      </button>
                    )}

                    {isReady && (
                      <span class="text-xs font-bold text-emerald-600 flex items-center gap-1">
                        <span>✓</span>
                        <span>Listo en barra</span>
                      </span>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-extrabold text-gray-900">Control de Menú y Precios</h3>
            <p class="text-xs text-gray-400">Precios duales actualizados con BCV</p>
          </div>
          <span class="text-xs font-bold text-[#FF7A00]">Catálogo Oficial</span>
        </div>

        <div class="space-y-2.5">
          {storeProducts.map((item) => {
            const priceUSD = Number(item.base_price) || 0;
            const priceBs = formatBs(priceUSD, bcvRate);
            return (
              <div class="flex items-center justify-between p-2.5 rounded-2xl bg-gray-50 border border-gray-100">
                <div class="flex-1 min-w-0 pr-3">
                  <p class="text-xs font-extrabold text-gray-900 truncate">{item.name}</p>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[11px] font-bold text-gray-900">${priceUSD.toFixed(2)}</span>
                    <span class="text-[10px] font-semibold text-gray-400">{priceBs}</span>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class={`text-[10px] font-bold ${item.is_available ? 'text-emerald-600' : 'text-gray-400'}`}>
                    {item.is_available ? 'Disponible' : 'Pausado'}
                  </span>
                  <input type="checkbox" checked={item.is_available} class="w-4 h-4 rounded text-[#FF7A00] focus:ring-[#FF7A00]" />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </main>

    <script is:inline>
      const API_ORDERS = "https://api.traigalo.org/v2/orders";

      async function triggerOrderAction(orderId, actionName) {
        try {
          const res = await fetch(`${API_ORDERS}/${orderId}/actions`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: actionName })
          });

          if (!res.ok) {
            throw new Error(`Error en servidor: ${res.status}`);
          }

          window.location.reload();
        } catch (err) {
          alert(`No se pudo ejecutar la acción '${actionName}': ${err.message}`);
        }
      }

      function attachActionHandlers() {
        document.querySelectorAll(".btn-order-action").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const orderId = btn.getAttribute("data-order-id");
            const action = btn.getAttribute("data-action");
            if (orderId && action) {
              btn.disabled = true;
              btn.textContent = "Procesando...";
              await triggerOrderAction(orderId, action);
            }
          });
        });
      }

      const refreshBtn = document.getElementById("refresh-orders-btn");
      if (refreshBtn) {
        refreshBtn.addEventListener("click", () => window.location.reload());
      }

      function playAlertChime() {
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const ctx = new AudioContext();

          const now = ctx.currentTime;
          const osc1 = ctx.createOscillator();
          const osc2 = ctx.createOscillator();
          const gain = ctx.createGain();

          osc1.type = 'triangle';
          osc1.frequency.setValueAtTime(587.33, now); // D5
          osc1.frequency.exponentialRampToValueAtTime(880.00, now + 0.15); // A5

          osc2.type = 'sine';
          osc2.frequency.setValueAtTime(880.00, now + 0.15);
          osc2.frequency.exponentialRampToValueAtTime(1174.66, now + 0.35); // D6

          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

          osc1.connect(gain);
          osc2.connect(gain);
          gain.connect(ctx.destination);

          osc1.start(now);
          osc1.stop(now + 0.2);
          osc2.start(now + 0.15);
          osc2.stop(now + 0.5);
        } catch {}
      }

      function checkIncomingOrders() {
        const hasIncoming = document.querySelector('.btn-order-action[data-action="accept"]') !== null;
        const alertBanner = document.getElementById('incoming-order-alert');
        if (hasIncoming) {
          if (alertBanner) alertBanner.classList.remove('hidden');
          playAlertChime();
        } else {
          if (alertBanner) alertBanner.classList.add('hidden');
        }
      }

      const silenceBtn = document.getElementById('btn-silence-alert');
      if (silenceBtn) {
        silenceBtn.addEventListener('click', () => {
          const alertBanner = document.getElementById('incoming-order-alert');
          if (alertBanner) alertBanner.classList.add('hidden');
        });
      }

      window.addEventListener('load', () => {
        checkIncomingOrders();
      });

      attachActionHandlers();
    </script>
  </body>
</html>
