---
import "../../styles/global.css";
import "../../styles/pages/vendor.css";
import RoleSwitcher from "../../components/RoleSwitcher.astro";
import { getOfficialExchangeRate, formatBs } from "../../adapters/rates";
import { fetchActiveStores } from "../../adapters/stores";

const API_BASE = "https://api.traigalo.org/v2";
const bcvRate = await getOfficialExchangeRate();
const selectedStoreParam = Astro.url.searchParams.get("store_id") || "";

function cleanProductName(rawName: string): string {
  return String(rawName || '')
    .replace(/^Ariculares/i, 'Auriculares')
    .replace(/^5-Sprinng\s*(CHEST\s*PULL)?/i, '5-Spring Chest Pull')
    .replace(/^Abdominal musclw/i, 'Abdominal Muscle Trainer')
    .replace(/^Aceite de resino/i, 'Aceite de Ricino')
    .replace(/^After chave/i, 'After Shave Profesional')
    .replace(/^Back pain need hellp/i, 'Soporte Lumbar Back Pain')
    .replace(/^Brocha de ljo/i, 'Brocha de Lujo');
}

const stores = await fetchActiveStores();

const currentStore = stores.find((s) => s.id === selectedStoreParam) || stores[0] || {
  id: "",
  name: "Comercio Oficial",
  logo_url: "/brand-icon.webp"
};

const storeLogo = currentStore.logo_url || "/brand-icon.webp";

let storeOrders: any[] = [];
try {
  const oRes = await fetch(`${API_BASE}/orders?store-id=${currentStore.id}&size=50`);
  if (oRes.ok) {
    const oData = await oRes.json();
    if (Array.isArray(oData)) {
      const filtered = oData.filter((o) => !o.store_id || o.store_id === currentStore.id);
      storeOrders = await Promise.all(
        filtered.map(async (ord) => {
          if (Array.isArray(ord.items) && ord.items.length > 0) return ord;
          try {
            const dRes = await fetch(`${API_BASE}/orders/${ord.id}`);
            if (dRes.ok) {
              const detail = await dRes.json();
              if (detail && Array.isArray(detail.items)) {
                return { ...ord, items: detail.items };
              }
            }
          } catch {}
          return ord;
        })
      );
    }
  }
} catch {}

let storeProducts: any[] = [];
try {
  const pRes = await fetch(`${API_BASE}/stores/${currentStore.id}/products`);
  if (pRes.ok) {
    const pData = await pRes.json();
    if (Array.isArray(pData)) storeProducts = pData;
  }
} catch {}

const productNamesMap: Record<string, string> = {};
for (const p of storeProducts) {
  if (p.id && p.name) {
    productNamesMap[p.id] = cleanProductName(p.name);
  }
}

try {
  const allPRes = await fetch(`${API_BASE}/products`);
  if (allPRes.ok) {
    const allPData = await allPRes.json();
    if (Array.isArray(allPData)) {
      for (const p of allPData) {
        if (p.id && p.name && !productNamesMap[p.id]) {
          productNamesMap[p.id] = cleanProductName(p.name);
        }
      }
    }
  }
} catch {}

const todayGmvUSD = storeOrders.reduce((acc, o) => acc + (Number(o.total) || 0), 0);
const todayGmvBs = formatBs(todayGmvUSD, bcvRate);
const totalOrdersCount = storeOrders.length;

function formatPaymentMethod(pm: string): string {
  const norm = String(pm || '').toLowerCase();
  if (norm === 'mobile_pay' || norm === 'pago_movil') return 'Pago Móvil BCV';
  if (norm === 'cash' || norm === 'efectivo') return 'Efectivo';
  if (norm === 'card' || norm === 'tarjeta') return 'Tarjeta';
  return pm || 'Pago Móvil BCV';
}
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{currentStore.name} | Portal comercio Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="vd-body">
    <RoleSwitcher currentRole="vendor" />

    <header class="vd-top tg-glass">
      <div class="vd-top-inner">
        <div class="vd-identity">
          <a href={`/stores/${currentStore.id}`} class="vd-logo">
            <img src={storeLogo} alt={currentStore.name} width="48" height="48" />
          </a>
          <div class="vd-identity-text">
            <div class="vd-name-row">
              <h1 class="vd-name">{currentStore.name}</h1>
              <span class="vd-live" aria-hidden="true"></span>
            </div>
            <p class="vd-meta">Comercio verificado · <span class="vd-mono">#{currentStore.id.slice(0, 8)}</span></p>
          </div>
        </div>

        <div class="vd-top-tools">
          <div class="vd-rate">
            <span class="vd-rate-label">Tasa BCV</span>
            <span class="vd-rate-value">{bcvRate.toFixed(2)} Bs/$</span>
          </div>
          <label class="vd-switch" title="Estado de tienda">
            <input type="checkbox" checked class="vd-switch-input" id="store-toggle" aria-label="Tienda abierta">
            <span class="vd-switch-track" aria-hidden="true"></span>
          </label>
        </div>
      </div>

      {stores.length > 1 && (
        <nav class="vd-stores" aria-label="Tus tiendas">
          {stores.map((st) => (
            <a
              href={`/vendor?store_id=${st.id}`}
              class={`vd-store-tab ${st.id === currentStore.id ? "is-active" : ""}`}
              aria-current={st.id === currentStore.id ? "page" : undefined}
            >
              <img src={st.logo_url || "/brand-icon.webp"} alt="" width="16" height="16" />
              <span>{st.name}</span>
            </a>
          ))}
        </nav>
      )}
    </header>

    <main class="vd-main">
      <div id="incoming-order-alert" class="vd-alert hidden" role="status">
        <div class="vd-alert-body">
          <svg class="vd-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          <div>
            <h4 class="vd-alert-title">Nueva orden entrante</h4>
            <p class="vd-alert-text">Tienes pedidos pendientes por preparar y despachar</p>
          </div>
        </div>
        <button id="btn-silence-alert" class="vd-alert-btn" type="button">Atender</button>
      </div>

      <section class="vd-stats" aria-label="Resumen">
        <div class="vd-stat vd-stat--lead">
          <p class="vd-stat-label">Ventas USD</p>
          <p class="vd-stat-value">${todayGmvUSD.toFixed(2)}</p>
          <span class="vd-stat-sub">{todayGmvBs}</span>
        </div>
        <div class="vd-stat">
          <p class="vd-stat-label">Órdenes</p>
          <p class="vd-stat-value">{totalOrdersCount}</p>
          <span class="vd-stat-sub">De esta tienda</span>
        </div>
        <div class="vd-stat">
          <p class="vd-stat-label">Catálogo</p>
          <p class="vd-stat-value">{storeProducts.length}</p>
          <span class="vd-stat-sub">Artículos</span>
        </div>
      </section>

      <div class="vd-columns">
      <section class="vd-orders" aria-labelledby="vd-orders-title">
        <div class="vd-section-head">
          <div class="vd-section-title">
            <h2 id="vd-orders-title">Órdenes de {currentStore.name}</h2>
            <span id="order-count-badge" class="vd-badge">{storeOrders.length}</span>
          </div>
          <button id="refresh-orders-btn" class="vd-link-btn" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
            <span>Actualizar</span>
          </button>
        </div>

        <div id="orders-container" class="vd-order-list">
          {storeOrders.length === 0 ? (
            <div class="vd-empty">
              <svg class="vd-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>
              <h3 class="vd-empty-title">Sin órdenes pendientes para {currentStore.name}</h3>
              <p class="vd-empty-text">
                Las órdenes creadas por clientes para <strong>{currentStore.name}</strong> aparecerán aquí en tiempo real con su detalle de productos.
              </p>
              <a href={`/stores/${currentStore.id}`} class="vd-empty-link">
                <span>Ver vitrina de {currentStore.name}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </a>
            </div>
          ) : (
            storeOrders.map((order) => {
              const totalUSD = Number(order.total) || 0;
              const totalBsFormatted = formatBs(totalUSD, bcvRate);
              const statusLabel =
                order.status === 'placed' ? 'Nuevo pedido' :
                order.status === 'accepted_by_store' ? 'Aceptado' :
                order.status === 'preparing' ? 'Preparando pedido' :
                order.status === 'ready_for_pickup' ? 'Listo p/ despacho' :
                order.status === 'driver_assigned' ? 'Repartidor asignado' :
                order.status === 'driver_in_transit' || order.status === 'in_transit' ? 'En camino' :
                order.status === 'delivered' ? 'Entregado' : order.status;

              const isIncoming = order.status === 'placed';
              const isAccepted = order.status === 'accepted_by_store';
              const isPreparing = order.status === 'preparing';
              const isReady = order.status === 'ready_for_pickup';
              const isPaid = order.payment_status === 'paid';
              const orderItems = Array.isArray(order.items) ? order.items : [];
              const tone = isIncoming ? 'new' : (isAccepted || isPreparing) ? 'work' : isReady ? 'ready' : 'idle';

              return (
                <article class={`vd-order vd-order--${tone}`} data-order-id={order.id}>
                  <div class="vd-order-head">
                    <div class="vd-order-id">
                      <span class="vd-mono vd-order-num">#{order.order_number || order.id.slice(0, 8)}</span>
                      <span class="vd-order-time">{new Date(order.placed_at || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                    </div>
                    <span class={`vd-status vd-status--${tone}`}>{statusLabel}</span>
                  </div>

                  <div class="vd-items">
                    <span class="vd-items-label">Artículos a empacar ({orderItems.length || 1})</span>
                    {orderItems.length > 0 ? (
                      orderItems.map((it: any) => {
                        const pName = productNamesMap[it.product_id] || cleanProductName(it.name || '') || `Artículo #${String(it.product_id || '').slice(0, 6)}`;
                        const qty = Number(it.quantity) || 1;
                        const unitPrice = Number(it.unit_price) || 0;
                        return (
                          <div class="vd-item">
                            <span class="vd-item-name"><strong class="vd-qty">{qty}x</strong> {pName}</span>
                            <span class="vd-num">${(unitPrice * qty).toFixed(2)}</span>
                          </div>
                        );
                      })
                    ) : (
                      <div class="vd-item">
                        <span class="vd-item-name"><strong class="vd-qty">1x</strong> Pedido de catálogo ({currentStore.name})</span>
                        <span class="vd-num">${(Number(order.subtotal) || totalUSD).toFixed(2)}</span>
                      </div>
                    )}
                    {(order.notes || order.instructions) && (
                      <p class="vd-note">{order.notes || order.instructions}</p>
                    )}
                  </div>

                  <div class="vd-order-meta">
                    <span class="vd-dest">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      <span>Destino: <strong>{order.delivery_address || 'Higuerote, Miranda'}</strong></span>
                    </span>
                    <span class={`vd-pay ${isPaid ? 'is-paid' : ''}`}>
                      {isPaid ? 'Pagado' : formatPaymentMethod(order.payment_method)}
                    </span>
                  </div>

                  <div class="vd-order-foot">
                    <div class="vd-total">
                      <span class="vd-total-usd">${totalUSD.toFixed(2)}</span>
                      <span class="vd-total-bs">{totalBsFormatted}</span>
                    </div>
                    <div class="vd-actions">
                      {isIncoming && (
                        <button type="button" data-action="accept" data-order-id={order.id} class="btn-order-action vd-act vd-act--accept">Aceptar pedido</button>
                      )}
                      {isAccepted && (
                        <button type="button" data-action="prepare" data-order-id={order.id} class="btn-order-action vd-act vd-act--prepare">Comenzar preparación</button>
                      )}
                      {isPreparing && (
                        <button type="button" data-action="ready" data-order-id={order.id} class="btn-order-action vd-act vd-act--ready">Marcar listo p/ despacho</button>
                      )}
                      {isReady && (
                        <span class="vd-ready">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                          <span>Listo p/ retiro</span>
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              );
            })
          )}
        </div>
      </section>

      <section class="vd-catalog" aria-labelledby="vd-catalog-title">
        <div class="vd-section-head">
          <div>
            <h2 id="vd-catalog-title" class="vd-catalog-title">Control de catálogo y disponibilidad</h2>
            <p class="vd-catalog-sub">{storeProducts.length} productos sincronizados a tasa BCV</p>
          </div>
          <span class="vd-chip">{currentStore.name}</span>
        </div>

        <div class="vd-search">
          <input
            id="vendor-catalog-search"
            type="search"
            placeholder={`Buscar entre los ${storeProducts.length} productos de ${currentStore.name}...`}
            class="vd-search-input"
            aria-label="Buscar productos"
          />
          <svg class="vd-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <div class="vd-product-list" id="vendor-catalog-list">
          {storeProducts.map((item) => {
            const priceUSD = Number(item.base_price) || 0;
            const priceBs = formatBs(priceUSD, bcvRate);
            const displayName = cleanProductName(item.name);
            return (
              <div class="vendor-product-row vd-product" data-name={displayName.toLowerCase()}>
                <div class="vd-product-info">
                  <p class="vd-product-name">{displayName}</p>
                  <div class="vd-product-price">
                    <span class="vd-price-usd">${priceUSD.toFixed(2)}</span>
                    <span class="vd-price-bs">{priceBs}</span>
                  </div>
                </div>
                <label class="vd-avail">
                  <span class="avail-status-text">
                    {item.is_available !== false ? 'Disponible' : 'Pausado'}
                  </span>
                  <input
                    type="checkbox"
                    checked={item.is_available !== false}
                    data-product-id={item.id}
                    class="product-avail-checkbox vd-check"
                  />
                </label>
              </div>
            );
          })}
        </div>
      </section>
      </div>
    </main>

    <script is:inline>
      (() => {
        const API_ORDERS = "https://api.traigalo.org/v2/orders";
        const API_DISPATCH = "https://api.traigalo.org/v2/dispatch/assign";
        const API_PRODUCTS = "https://api.traigalo.org/v2/products";

        async function triggerOrderAction(orderId, actionName) {
          try {
            const res = await fetch(`${API_ORDERS}/${orderId}/actions`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: actionName })
            });

            if (!res.ok) {
              throw new Error(`Error en servidor: ${res.status}`);
            }

            if (actionName === "ready") {
              await fetch(API_DISPATCH, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ order_id: orderId })
              }).catch(() => {});
            }

            window.location.reload();
          } catch (err) {
            alert(`No se pudo ejecutar la acción '${actionName}': ${err.message}`);
          }
        }

        function attachActionHandlers() {
          document.querySelectorAll(".btn-order-action").forEach((btn) => {
            btn.addEventListener("click", async () => {
              const orderId = btn.getAttribute("data-order-id");
              const action = btn.getAttribute("data-action");
              if (orderId && action) {
                btn.disabled = true;
                btn.textContent = "Procesando...";
                await triggerOrderAction(orderId, action);
              }
            });
          });
        }

        const refreshBtn = document.getElementById("refresh-orders-btn");
        if (refreshBtn) {
          refreshBtn.addEventListener("click", () => window.location.reload());
        }

        const catalogSearch = document.getElementById("vendor-catalog-search");
        if (catalogSearch) {
          catalogSearch.addEventListener("input", () => {
            const q = (catalogSearch.value || "").toLowerCase().trim();
            document.querySelectorAll(".vendor-product-row").forEach((row) => {
              const name = row.getAttribute("data-name") || "";
              row.style.display = (!q || name.includes(q)) ? "flex" : "none";
            });
          });
        }

        document.querySelectorAll(".product-avail-checkbox").forEach((checkbox) => {
          checkbox.addEventListener("change", async () => {
            const pid = checkbox.getAttribute("data-product-id");
            const isAvail = checkbox.checked;
            const label = checkbox.closest("label")?.querySelector(".avail-status-text");
            if (label) {
              label.textContent = isAvail ? "Disponible" : "Pausado";
              label.className = `avail-status-text text-[10px] font-bold ${isAvail ? "text-emerald-600" : "text-gray-400"}`;
            }
            if (pid) {
              fetch(`${API_PRODUCTS}/${pid}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ is_available: isAvail })
              }).catch(() => {});
            }
          });
        });

        function playAlertChime() {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();

            const now = ctx.currentTime;
            const osc1 = ctx.createOscillator();
            const osc2 = ctx.createOscillator();
            const gain = ctx.createGain();

            osc1.type = 'triangle';
            osc1.frequency.setValueAtTime(587.33, now);
            osc1.frequency.exponentialRampToValueAtTime(880.00, now + 0.15);

            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(880.00, now + 0.15);
            osc2.frequency.exponentialRampToValueAtTime(1174.66, now + 0.35);

            gain.gain.setValueAtTime(0.3, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

            osc1.connect(gain);
            osc2.connect(gain);
            gain.connect(ctx.destination);

            osc1.start(now);
            osc1.stop(now + 0.2);
            osc2.start(now + 0.15);
            osc2.stop(now + 0.5);
          } catch {}
        }

        function checkIncomingOrders() {
          const hasIncoming = document.querySelector('.btn-order-action[data-action="accept"]') !== null;
          const alertBanner = document.getElementById('incoming-order-alert');
          if (hasIncoming) {
            if (alertBanner) alertBanner.classList.remove('hidden');
            playAlertChime();
          } else {
            if (alertBanner) alertBanner.classList.add('hidden');
          }
        }

        const silenceBtn = document.getElementById('btn-silence-alert');
        if (silenceBtn) {
          silenceBtn.addEventListener('click', () => {
            const alertBanner = document.getElementById('incoming-order-alert');
            if (alertBanner) alertBanner.classList.add('hidden');
          });
        }

        window.addEventListener('load', () => {
          checkIncomingOrders();
        });

        attachActionHandlers();
      })();
    </script>
  </body>
</html>
