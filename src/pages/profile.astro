---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import RoleSwitcher from "../components/RoleSwitcher.astro";
import LocationModal from "../components/LocationModal.astro";
import { getOfficialExchangeRate, formatBs } from "../adapters/rates";

const API_BASE = "https://api.traigalo.org/v2";
const bcvRate = await getOfficialExchangeRate();

let recentOrders: any[] = [];
try {
  const oRes = await fetch(`${API_BASE}/orders?size=5`);
  if (oRes.ok) {
    const list = await oRes.json();
    if (Array.isArray(list)) recentOrders = list.slice(0, 5);
  }
} catch {}

function formatStatusLabel(st: string): string {
  if (st === "placed") return "Confirmado";
  if (st === "accepted_by_store") return "Aceptado en Tienda";
  if (st === "preparing") return "Preparando";
  if (st === "ready_for_pickup") return "Listo p/ Despacho";
  if (st === "driver_assigned") return "Repartidor Asignado";
  if (st === "driver_in_transit" || st === "in_transit") return "En Camino";
  if (st === "delivered") return "Entregado";
  if (st === "cancelled") return "Cancelado";
  return st || "Confirmado";
}

const user = {
  name: "Freddy Campos",
  email: "freddy@traigalo.com",
  phone: "+58 412 890 1234",
  addresses: [
    { title: "Ubicación Principal", address: "Av. Andrés Eloy Blanco, Higuerote, Miranda", isDefault: true }
  ],
  paymentMethods: [
    { brand: "Pago Móvil BCV", last4: "Banesco (0134) • Verificado", isDefault: true },
    { brand: "Tarjeta Débito / Crédito", last4: "Internacional / Nacional", isDefault: false },
    { brand: "Efectivo USD / Bs", last4: "Contra entrega", isDefault: false }
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Mi Perfil | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#121212] font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#FF7A00] selection:text-white pb-32">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="max-w-2xl mx-auto px-4 sm:px-6 pt-5 space-y-5 w-full flex-1">
      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
        <div id="profile-avatar" class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#FF7A00] to-amber-500 flex items-center justify-center text-white text-2xl font-black shadow-md shadow-orange-500/20">
          FC
        </div>
        <div class="flex-1 min-w-0">
          <h2 id="profile-name" class="text-base font-extrabold text-gray-900 leading-snug">{user.name}</h2>
          <p id="profile-email" class="text-xs text-gray-500 truncate">{user.email} • {user.phone}</p>
          <div class="mt-1 flex items-center gap-1.5">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[10px] font-black border border-amber-200/60">
              ⭐ Cuenta Verificada Traigalo
            </span>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black uppercase tracking-wider text-gray-400">Dirección de Entrega</h3>
          <button id="btn-profile-change-address" type="button" class="text-xs font-bold text-[#FF7A00] hover:underline cursor-pointer">Cambiar en Mapa</button>
        </div>
        <div class="space-y-2.5">
          {user.addresses.map((addr) => (
            <div class="p-3 rounded-2xl bg-[#FAFAFC] border border-gray-100 flex items-start gap-3">
              <div class="w-8 h-8 rounded-xl bg-orange-100 text-[#FF7A00] flex items-center justify-center shrink-0 mt-0.5">
                📍
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="text-xs font-extrabold text-gray-900">{addr.title}</p>
                  {addr.isDefault && (
                    <span class="text-[9px] font-bold bg-[#FF7A00] text-white px-1.5 py-0.5 rounded-md">Activa</span>
                  )}
                </div>
                <p id="profile-saved-address" class="text-xs text-gray-500 truncate mt-0.5">{addr.address}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black uppercase tracking-wider text-gray-400">Métodos de Pago Habilitados</h3>
          <span class="text-xs font-bold text-emerald-600">Tasa BCV: {bcvRate.toFixed(2)} Bs/$</span>
        </div>
        <div class="space-y-2">
          {user.paymentMethods.map((pm) => (
            <div class="p-3 rounded-2xl bg-[#FAFAFC] border border-gray-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-gray-100 text-gray-700 flex items-center justify-center font-black text-xs">
                  💳
                </div>
                <div>
                  <p class="text-xs font-extrabold text-gray-900">{pm.brand}</p>
                  <p class="text-[11px] text-gray-400">{pm.last4}</p>
                </div>
              </div>
              {pm.isDefault && (
                <span class="text-xs text-emerald-600 font-bold">Preferido</span>
              )}
            </div>
          ))}
        </div>
      </div>

      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black uppercase tracking-wider text-gray-400">Pedidos Recientes</h3>
          <a href="/orders" class="text-xs font-bold text-[#FF7A00] hover:underline">Ver todos</a>
        </div>
        <div class="space-y-2.5">
          {recentOrders.map((ord) => {
            const storeLabel = ord.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f' ? 'El Sitio del Barbero' : 'WILY VIDEO';
            const totalUsd = Number(ord.total) || 0;
            return (
              <div class="p-3 rounded-2xl bg-[#FAFAFC] border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs font-extrabold text-gray-900">{storeLabel}</p>
                    <p class="text-[11px] text-gray-500">Orden #{ord.order_number || ord.id.slice(0, 8)} • <strong class="text-[#FF7A00]">{formatStatusLabel(ord.status)}</strong></p>
                  </div>
                  <div class="text-right">
                    <span class="text-xs font-black text-gray-900">${totalUsd.toFixed(2)}</span>
                    <span class="block text-[9px] text-gray-400 font-semibold">{formatBs(totalUsd, bcvRate)}</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                  <span class="text-[11px] text-gray-500 truncate max-w-[200px]">📍 {ord.delivery_address || 'Higuerote, Miranda'}</span>
                  <a href={`/orders/track?id=${ord.id}`} class="text-xs font-bold text-[#FF7A00] hover:underline">Rastrear →</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </main>

    <Footer />
    <BottomNav />
    <LocationModal />

    <script is:inline>
      (() => {
        try {
          const rawUser = localStorage.getItem("traigalo_user");
          if (rawUser) {
            const u = JSON.parse(rawUser);
            const nameEl = document.getElementById("profile-name");
            const emailEl = document.getElementById("profile-email");
            const avatarEl = document.getElementById("profile-avatar");
            if (u.name && nameEl) nameEl.textContent = u.name;
            if (u.email && emailEl) emailEl.textContent = u.email;
            if (u.name && avatarEl) {
              avatarEl.textContent = u.name.split(" ").map((w) => w[0]).slice(0, 2).join("").toUpperCase();
            }
          }
          const rawLoc = localStorage.getItem("traigalo_location");
          if (rawLoc) {
            const loc = JSON.parse(rawLoc);
            const addrEl = document.getElementById("profile-saved-address");
            if (loc.address && addrEl) addrEl.textContent = loc.address;
          }
        } catch {}

        const changeAddrBtn = document.getElementById("btn-profile-change-address");
        if (changeAddrBtn) {
          changeAddrBtn.addEventListener("click", () => {
            if (typeof window.openLocationModal === "function") {
              window.openLocationModal();
            }
          });
        }

        window.addEventListener("traigalo:location-changed", (e) => {
          if (e.detail && e.detail.address) {
            const addrEl = document.getElementById("profile-saved-address");
            if (addrEl) addrEl.textContent = e.detail.address;
          }
        });
      })();
    </script>
  </body>
</html>
