---
import "../styles/global.css";
import "../styles/pages/account.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import RoleSwitcher from "../components/RoleSwitcher.astro";
import LocationModal from "../components/LocationModal.astro";
import { getOfficialExchangeRate, formatBs } from "../adapters/rates";
import { fetchStoresMap } from "../adapters/stores";

const API_BASE = "https://api.traigalo.org/v2";
const bcvRate = await getOfficialExchangeRate();
const storesMap = await fetchStoresMap();

let recentOrders: any[] = [];
try {
  const oRes = await fetch(`${API_BASE}/orders?size=5`);
  if (oRes.ok) {
    const list = await oRes.json();
    if (Array.isArray(list)) recentOrders = list.slice(0, 5);
  }
} catch {}

function formatStatusLabel(st: string): string {
  if (st === "placed") return "Confirmado";
  if (st === "accepted_by_store") return "Aceptado en tienda";
  if (st === "preparing") return "Preparando";
  if (st === "ready_for_pickup") return "Listo para despacho";
  if (st === "driver_assigned") return "Repartidor asignado";
  if (st === "driver_in_transit" || st === "in_transit") return "En camino";
  if (st === "delivered") return "Entregado";
  if (st === "cancelled") return "Cancelado";
  return st || "Confirmado";
}

const user = {
  name: "Freddy Campos",
  email: "freddy@traigalo.com",
  phone: "+58 412 890 1234",
  addresses: [
    { title: "Ubicación principal", address: "Av. Andrés Eloy Blanco, Higuerote, Miranda", isDefault: true }
  ],
  paymentMethods: [
    { brand: "Pago móvil", last4: "Banesco (0134)", isDefault: true },
    { brand: "Tarjeta de débito o crédito", last4: "Nacional o internacional", isDefault: false },
    { brand: "Efectivo en dólares o bolívares", last4: "Contra entrega", isDefault: false }
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tu cuenta | Traigalo</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher currentRole="client" />
      <Header />

      <main class="tg-wrap tg-main acc-narrow">
        <section class="acc-identity" aria-labelledby="profile-name">
          <div id="profile-avatar" class="acc-avatar" aria-hidden="true">FC</div>
          <div class="acc-identity-text">
            <h1 id="profile-name">{user.name}</h1>
            <p id="profile-email">{user.email}</p>
            <p class="acc-meta">{user.phone}</p>
          </div>
        </section>

        <section class="acc-group" aria-labelledby="acc-address-title">
          <div class="acc-group-head">
            <h2 id="acc-address-title">Dirección de entrega</h2>
            <button id="btn-profile-change-address" type="button" class="tg-btn tg-btn--quiet tg-btn--sm">Cambiar en el mapa</button>
          </div>
          <ul class="acc-list">
            {user.addresses.map((addr) => (
              <li class="acc-row">
                <svg class="acc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                <div class="acc-row-text">
                  <p class="acc-row-title">{addr.title}</p>
                  <p id="profile-saved-address" class="acc-row-sub">{addr.address}</p>
                </div>
                {addr.isDefault && <span class="acc-tag">Activa</span>}
              </li>
            ))}
          </ul>
        </section>

        <section class="acc-group" aria-labelledby="acc-pay-title">
          <div class="acc-group-head">
            <h2 id="acc-pay-title">Métodos de pago</h2>
            <p class="acc-meta">Tasa BCV {bcvRate.toFixed(2)} Bs por dólar</p>
          </div>
          <ul class="acc-list">
            {user.paymentMethods.map((pm) => (
              <li class="acc-row">
                <svg class="acc-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.8"/></svg>
                <div class="acc-row-text">
                  <p class="acc-row-title">{pm.brand}</p>
                  <p class="acc-row-sub">{pm.last4}</p>
                </div>
                {pm.isDefault && <span class="acc-tag">Preferido</span>}
              </li>
            ))}
          </ul>
        </section>

        <section class="acc-group" aria-labelledby="acc-orders-title">
          <div class="acc-group-head">
            <h2 id="acc-orders-title">Pedidos recientes</h2>
            <a href="/orders" class="tg-btn tg-btn--quiet tg-btn--sm">Ver todos</a>
          </div>
          {recentOrders.length === 0 ? (
            <div class="tg-empty">
              <h3>Todavía no tienes pedidos</h3>
              <p>Tus pedidos aparecerán aquí para que puedas seguirlos.</p>
            </div>
          ) : (
            <ul class="acc-list">
              {recentOrders.map((ord) => {
                const storeLabel = storesMap[ord.store_id]?.name || 'Comercio';
                const totalUsd = Number(ord.total) || 0;
                return (
                  <li class="acc-row acc-order">
                    <div class="acc-row-text">
                      <p class="acc-row-title">{storeLabel}</p>
                      <p class="acc-row-sub">Orden #{ord.order_number || ord.id.slice(0, 8)}, <strong class="acc-status">{formatStatusLabel(ord.status)}</strong></p>
                      <p class="acc-row-sub">{ord.delivery_address || 'Higuerote, Miranda'}</p>
                    </div>
                    <div class="acc-order-side">
                      <span class="tg-price">${totalUsd.toFixed(2)}</span>
                      <span class="tg-price-bs">{formatBs(totalUsd, bcvRate)}</span>
                      <a href={`/orders/track?id=${ord.id}`} class="acc-link">Rastrear pedido</a>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <section class="acc-group acc-exit" aria-label="Sesión">
          <button id="btn-profile-logout" type="button" class="acc-logout">Cerrar sesión</button>
        </section>
      </main>

      <Footer />
      <BottomNav />
    </div>
    <LocationModal />

    <script is:inline>
      (() => {
        try {
          const rawUser = localStorage.getItem("traigalo_user");
          if (rawUser) {
            const u = JSON.parse(rawUser);
            const nameEl = document.getElementById("profile-name");
            const emailEl = document.getElementById("profile-email");
            const avatarEl = document.getElementById("profile-avatar");
            if (u.name && nameEl) nameEl.textContent = u.name;
            if (u.email && emailEl) emailEl.textContent = u.email;
            if (u.name && avatarEl) {
              avatarEl.textContent = u.name.split(" ").map((w) => w[0]).slice(0, 2).join("").toUpperCase();
            }
          }
          const rawLoc = localStorage.getItem("traigalo_location");
          if (rawLoc) {
            const loc = JSON.parse(rawLoc);
            const addrEl = document.getElementById("profile-saved-address");
            if (loc.address && addrEl) addrEl.textContent = loc.address;
          }
        } catch {}

        const changeAddrBtn = document.getElementById("btn-profile-change-address");
        if (changeAddrBtn) {
          changeAddrBtn.addEventListener("click", () => {
            if (typeof window.openLocationModal === "function") {
              window.openLocationModal();
            }
          });
        }

        const profileLogoutBtn = document.getElementById("btn-profile-logout");
        if (profileLogoutBtn) {
          profileLogoutBtn.addEventListener("click", () => {
            const headerLogout = document.getElementById("btn-logout");
            if (headerLogout) headerLogout.click();
          });
        }

        window.addEventListener("traigalo:location-changed", (e) => {
          if (e.detail && e.detail.address) {
            const addrEl = document.getElementById("profile-saved-address");
            if (addrEl) addrEl.textContent = e.detail.address;
          }
        });
      })();
    </script>
  </body>
</html>
