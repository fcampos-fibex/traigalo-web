---
import '../styles/global.css';
import '../styles/pages/auth.css';
import Logo from '../components/Logo.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear Cuenta en Keycloak OIDC | Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page auth-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher />

      <header class="auth-top">
        <a href="/login" class="auth-back tg-glass" aria-label="Volver">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <Logo size="sm" />
        <span class="auth-top-spacer" aria-hidden="true"></span>
      </header>

      <main class="auth-main">
        <div class="auth-intro">
          <span class="auth-badge"><span class="auth-badge-dot" aria-hidden="true"></span><span>Registro OIDC • Keycloak Realm: traigalo</span></span>
          <h1>Únete a Traigalo</h1>
          <p>Tu identidad se aprovisiona en <code>auth.traigalo.org</code></p>
        </div>

        <div class="auth-card">
          <button id="btn-keycloak-register-redirect" type="button" class="auth-sso">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke-width="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke-width="2" stroke-linecap="round" /></svg>
            <span>Registrarse en Portal Keycloak SSO</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <div class="auth-divider"><span>O registro directo OIDC</span></div>

          <div class="auth-field">
            <span class="tg-field-label" id="reg-role-label">Quiero registrarme como</span>
            <div class="auth-roles tg-glass" id="reg-role-selector" role="group" aria-labelledby="reg-role-label">
              <button type="button" data-role="client" class="reg-role-btn border-2">Cliente</button>
              <button type="button" data-role="vendor" class="reg-role-btn">Comercio</button>
              <button type="button" data-role="driver" class="reg-role-btn">Repartidor</button>
            </div>
          </div>

          <div id="reg-status-box" class="hidden auth-status" role="status" aria-live="polite"></div>

          <div class="auth-field">
            <label for="reg-name" class="tg-field-label">Nombre Completo o Razón Social</label>
            <input type="text" id="reg-name" placeholder="Nombre y apellido" autocomplete="name" class="auth-input" />
          </div>

          <div class="auth-field">
            <label for="reg-email" class="tg-field-label">Correo Electrónico</label>
            <input type="email" id="reg-email" placeholder="nombre@correo.com" autocomplete="email" class="auth-input" />
          </div>

          <div class="auth-field">
            <label for="reg-phone" class="tg-field-label">Teléfono Móvil (WhatsApp)</label>
            <input type="tel" id="reg-phone" placeholder="+58 412 123 4567" autocomplete="tel" class="auth-input" />
          </div>

          <div class="auth-field">
            <label for="reg-password" class="tg-field-label">Contraseña</label>
            <input type="password" id="reg-password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" class="auth-input" />
          </div>

          <button id="btn-register-submit" type="button" class="auth-submit">
            <span>Crear Cuenta en Keycloak OIDC</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <p class="auth-alt">
            ¿Ya tienes cuenta?
            <a href="/login">Inicia sesión con Keycloak</a>
          </p>
        </div>
      </main>

      <footer class="auth-foot">
        Al registrarte tu identidad se crea en <code>https://auth.traigalo.org/realms/traigalo</code>
      </footer>
    </div>

    <script is:inline>
    (() => {
      const KEYCLOAK_ISSUER = 'https://auth.traigalo.org/realms/traigalo';
      const KEYCLOAK_CLIENT_ID = 'traigalo-web';
      const API_BASE = 'https://api.traigalo.org/v2';

      let selectedRole = 'client';
      const statusBox = document.getElementById('reg-status-box');
      const ssoRegBtn = document.getElementById('btn-keycloak-register-redirect');

      function showStatus(msg, isError = false) {
        if (!statusBox) return;
        statusBox.textContent = msg;
        statusBox.className = isError
          ? 'p-3 rounded-2xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200'
          : 'p-3 rounded-2xl text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200';
      }

      if (ssoRegBtn) {
        ssoRegBtn.addEventListener('click', () => {
          const redirectUri = `${window.location.origin}/login`;
          const regUrl = `${KEYCLOAK_ISSUER}/protocol/openid-connect/registrations?client_id=${encodeURIComponent(KEYCLOAK_CLIENT_ID)}&response_type=code&scope=${encodeURIComponent('openid profile email')}&redirect_uri=${encodeURIComponent(redirectUri)}`;
          window.location.href = regUrl;
        });
      }

      document.querySelectorAll('.reg-role-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.reg-role-btn').forEach((b) => {
            b.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all cursor-pointer';
          });
          btn.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border-2 border-[#FF7A00] bg-orange-50 text-[#FF7A00] transition-all cursor-pointer';
          selectedRole = btn.getAttribute('data-role') || 'client';
        });
      });

      const submitBtn = document.getElementById('btn-register-submit');
      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          const nameInput = document.getElementById('reg-name');
          const emailInput = document.getElementById('reg-email');
          const phoneInput = document.getElementById('reg-phone');
          const passInput = document.getElementById('reg-password');
          const fullName = nameInput ? nameInput.value.trim() : '';
          const email = emailInput ? emailInput.value.trim() : '';
          const phone = phoneInput ? phoneInput.value.trim() : '';
          const password = passInput ? passInput.value : '';
          if (!fullName || !email || !phone || password.length < 8) {
            showStatus('Completa nombre, correo, teléfono y una contraseña de al menos 8 caracteres.', true);
            return;
          }

          const parts = fullName.split(' ');
          const firstName = parts[0] || 'Usuario';
          const lastName = parts.slice(1).join(' ') || 'Traigalo';

          submitBtn.disabled = true;
          submitBtn.textContent = 'Aprovisionando en Keycloak...';

          try {
            const res = await fetch(`${API_BASE}/auth/register`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email,
                phone,
                first_name: firstName,
                last_name: lastName,
                full_name: fullName,
                password,
                role: selectedRole === 'client' ? 'customer' : selectedRole
              })
            });

            if (res.ok) {
              const data = await res.json();
              if (data.token) {
                showStatus('Cuenta creada en Keycloak Realm traigalo. Redirigiendo...', false);
                localStorage.setItem('traigalo_token', data.token);
                if (data.refresh_token) localStorage.setItem('traigalo_refresh_token', data.refresh_token);
                localStorage.setItem('traigalo_user', JSON.stringify({
                  id: data.user?.id || '',
                  keycloak_id: data.user?.keycloak_id || '',
                  name: data.user?.full_name || fullName,
                  email: data.user?.email || email,
                  role: selectedRole,
                  issuer: KEYCLOAK_ISSUER,
                  auth_provider: 'keycloak_oidc'
                }));

                if (selectedRole === 'vendor') {
                  window.location.href = '/vendor';
                } else if (selectedRole === 'driver') {
                  window.location.href = '/driver';
                } else {
                  window.location.href = '/';
                }
                return;
              }
            }
            const errJson = await res.json().catch(() => ({}));
            showStatus(errJson.error || 'No se pudo registrar el usuario en Keycloak.', true);
          } catch {
            showStatus('Error de red al conectar con Keycloak.', true);
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Crear Cuenta en Keycloak OIDC</span><span>→</span>';
          }
        });
      }
    })();
    </script>
  </body>
</html>
