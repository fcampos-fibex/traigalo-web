---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Crear Cuenta en Keycloak OIDC | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col justify-between antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher />

    <header class="p-4 sm:p-6 flex items-center justify-between max-w-md mx-auto w-full">
      <a href="/login" class="w-10 h-10 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-gray-800 shadow-xs hover:border-gray-200 active:scale-95 transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <Logo size="sm" />
      <div class="w-10"></div>
    </header>

    <main class="flex-1 max-w-md mx-auto px-5 py-4 w-full flex flex-col justify-center">
      <div class="text-center mb-5">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-black uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Registro OIDC • Keycloak Realm: traigalo</span>
        </div>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight">Únete a Traigalo</h1>
        <p class="text-xs text-gray-500 mt-1">Tu identidad se aprovisiona en <code class="text-[#FF7A00] font-bold">auth.traigalo.org</code></p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm space-y-4">
        <button
          id="btn-keycloak-register-redirect"
          type="button"
          class="w-full py-3.5 px-4 rounded-2xl bg-[#0B132B] hover:bg-[#151E38] text-white font-black text-xs sm:text-sm shadow-md flex items-center justify-center gap-2.5 transition-all active:scale-98 cursor-pointer"
        >
          <span>🔐</span>
          <span>Registrarse en Portal Keycloak SSO</span>
          <span>↗</span>
        </button>

        <div class="relative flex py-1 items-center">
          <div class="flex-grow border-t border-gray-100"></div>
          <span class="shrink mx-3 text-[10px] font-black uppercase tracking-wider text-gray-400">O registro directo OIDC</span>
          <div class="flex-grow border-t border-gray-100"></div>
        </div>

        <div>
          <label class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-2">Quiero registrarme como</label>
          <div class="grid grid-cols-3 gap-2" id="reg-role-selector">
            <button type="button" data-role="client" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border-2 border-[#FF7A00] bg-orange-50 text-[#FF7A00] transition-all cursor-pointer">
              Cliente
            </button>
            <button type="button" data-role="vendor" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all cursor-pointer">
              Comercio
            </button>
            <button type="button" data-role="driver" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all cursor-pointer">
              Repartidor
            </button>
          </div>
        </div>

        <div id="reg-status-box" class="hidden p-3 rounded-2xl text-xs font-bold"></div>

        <div>
          <label for="reg-name" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Nombre Completo o Razón Social</label>
          <input 
            type="text" 
            id="reg-name" 
            placeholder="Freddy Campos" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="reg-email" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Correo Electrónico</label>
          <input 
            type="email" 
            id="reg-email" 
            placeholder="freddy@traigalo.com" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="reg-phone" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Teléfono Móvil (WhatsApp)</label>
          <input 
            type="tel" 
            id="reg-phone" 
            placeholder="+58 412 123 4567" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="reg-password" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Contraseña</label>
          <input 
            type="password" 
            id="reg-password" 
            placeholder="Mínimo 8 caracteres" 
            value="Traigalo2026!"
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <button 
          id="btn-register-submit"
          type="button" 
          class="w-full h-13 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-black text-sm shadow-lg shadow-orange-600/25 active:scale-98 transition-all flex items-center justify-center gap-2 mt-2 cursor-pointer"
        >
          <span>Crear Cuenta en Keycloak OIDC</span>
          <span>→</span>
        </button>

        <p class="text-center text-xs text-gray-400 pt-2">
          ¿Ya tienes cuenta? 
          <a href="/login" class="text-[#FF7A00] font-black hover:underline">Inicia sesión con Keycloak</a>
        </p>
      </div>
    </main>

    <footer class="p-6 text-center text-[11px] text-gray-400">
      Al registrarte tu identidad se crea en <code class="text-gray-600 font-bold">https://auth.traigalo.org/realms/traigalo</code>
    </footer>

    <script is:inline>
    (() => {
      const KEYCLOAK_ISSUER = 'https://auth.traigalo.org/realms/traigalo';
      const KEYCLOAK_CLIENT_ID = 'traigalo-web';
      const API_BASE = 'https://api.traigalo.org/v2';

      let selectedRole = 'client';
      const statusBox = document.getElementById('reg-status-box');
      const ssoRegBtn = document.getElementById('btn-keycloak-register-redirect');

      function showStatus(msg, isError = false) {
        if (!statusBox) return;
        statusBox.textContent = msg;
        statusBox.className = isError
          ? 'p-3 rounded-2xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200'
          : 'p-3 rounded-2xl text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
      }

      if (ssoRegBtn) {
        ssoRegBtn.addEventListener('click', () => {
          const redirectUri = `${window.location.origin}/login`;
          const regUrl = `${KEYCLOAK_ISSUER}/protocol/openid-connect/registrations?client_id=${encodeURIComponent(KEYCLOAK_CLIENT_ID)}&response_type=code&scope=${encodeURIComponent('openid profile email')}&redirect_uri=${encodeURIComponent(redirectUri)}`;
          window.location.href = regUrl;
        });
      }

      document.querySelectorAll('.reg-role-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.reg-role-btn').forEach((b) => {
            b.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all cursor-pointer';
          });
          btn.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border-2 border-[#FF7A00] bg-orange-50 text-[#FF7A00] transition-all cursor-pointer';
          selectedRole = btn.getAttribute('data-role') || 'client';
        });
      });

      const submitBtn = document.getElementById('btn-register-submit');
      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          const nameInput = document.getElementById('reg-name');
          const emailInput = document.getElementById('reg-email');
          const phoneInput = document.getElementById('reg-phone');
          const passInput = document.getElementById('reg-password');
          const fullName = nameInput && nameInput.value.trim() ? nameInput.value.trim() : 'Freddy Campos';
          const email = emailInput && emailInput.value.trim() ? emailInput.value.trim() : `usuario_${Date.now()}@traigalo.org`;
          const phone = phoneInput && phoneInput.value.trim() ? phoneInput.value.trim() : '+584128901234';
          const password = passInput && passInput.value ? passInput.value : 'Traigalo2026!';

          const parts = fullName.split(' ');
          const firstName = parts[0] || 'Usuario';
          const lastName = parts.slice(1).join(' ') || 'Traigalo';

          submitBtn.disabled = true;
          submitBtn.textContent = 'Aprovisionando en Keycloak...';

          try {
            const res = await fetch(`${API_BASE}/auth/register`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email,
                phone,
                first_name: firstName,
                last_name: lastName,
                full_name: fullName,
                password,
                role: selectedRole === 'client' ? 'customer' : selectedRole
              })
            });

            if (res.ok) {
              const data = await res.json();
              if (data.token) {
                showStatus('Cuenta creada en Keycloak Realm traigalo. Redirigiendo...', false);
                localStorage.setItem('traigalo_token', data.token);
                if (data.refresh_token) localStorage.setItem('traigalo_refresh_token', data.refresh_token);
                localStorage.setItem('traigalo_user', JSON.stringify({
                  id: data.user?.id || '',
                  keycloak_id: data.user?.keycloak_id || '',
                  name: data.user?.full_name || fullName,
                  email: data.user?.email || email,
                  role: selectedRole,
                  issuer: KEYCLOAK_ISSUER,
                  auth_provider: 'keycloak_oidc'
                }));

                if (selectedRole === 'vendor') {
                  window.location.href = '/vendor';
                } else if (selectedRole === 'driver') {
                  window.location.href = '/driver';
                } else {
                  window.location.href = '/';
                }
                return;
              }
            }
            const errJson = await res.json().catch(() => ({}));
            showStatus(errJson.error || 'No se pudo registrar el usuario en Keycloak.', true);
          } catch {
            showStatus('Error de red al conectar con Keycloak.', true);
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Crear Cuenta en Keycloak OIDC</span><span>→</span>';
          }
        });
      }
    })();
    </script>
  </body>
</html>
