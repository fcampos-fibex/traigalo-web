---
import '../styles/global.css';
import RoleSwitcher from '../components/RoleSwitcher.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Crear Cuenta | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col justify-between antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher />

    <header class="p-4 sm:p-6 flex items-center justify-between max-w-md mx-auto w-full">
      <a href="/login" class="w-10 h-10 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-gray-800 shadow-xs hover:border-gray-200 active:scale-95 transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <span class="text-xs font-black uppercase tracking-wider text-[#FF7A00]">Registro Traigalo</span>
      <div class="w-10"></div>
    </header>

    <main class="flex-1 max-w-md mx-auto px-5 py-4 w-full flex flex-col justify-center">
      <div class="text-center mb-6">
        <div class="w-14 h-14 rounded-3xl bg-gradient-to-tr from-[#FF7A00] to-amber-400 mx-auto flex items-center justify-center text-white text-2xl font-black shadow-lg shadow-orange-500/25 mb-3">
          🚀
        </div>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight">Únete a Traigalo</h1>
        <p class="text-xs text-gray-400 mt-1">Crea tu cuenta empresarial o personal en segundos</p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm space-y-4">
        <div>
          <label class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-2">Quiero registrarme como</label>
          <div class="grid grid-cols-3 gap-2" id="reg-role-selector">
            <button type="button" data-role="client" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border-2 border-[#FF7A00] bg-orange-50 text-[#FF7A00] transition-all">
              Cliente
            </button>
            <button type="button" data-role="vendor" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all">
              Comercio
            </button>
            <button type="button" data-role="driver" class="reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all">
              Repartidor
            </button>
          </div>
        </div>

        <div>
          <label for="reg-name" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Nombre Completo o Razón Social</label>
          <input 
            type="text" 
            id="reg-name" 
            placeholder="Freddy Campos" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="reg-email" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Correo Electrónico</label>
          <input 
            type="email" 
            id="reg-email" 
            placeholder="freddy@traigalo.com" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="reg-phone" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Teléfono Móvil (WhatsApp)</label>
          <input 
            type="tel" 
            id="reg-phone" 
            placeholder="+58 412 123 4567" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <button 
          id="btn-register-submit"
          type="button" 
          class="w-full h-13 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-black text-sm shadow-lg shadow-orange-600/25 active:scale-98 transition-all flex items-center justify-center gap-2 mt-2"
        >
          <span>Crear Mi Cuenta</span>
          <span>→</span>
        </button>

        <p class="text-center text-xs text-gray-400 pt-2">
          ¿Ya tienes cuenta? 
          <a href="/login" class="text-[#FF7A00] font-black hover:underline">Inicia sesión</a>
        </p>
      </div>
    </main>

    <footer class="p-6 text-center text-[11px] text-gray-400">
      Al registrarte aceptas las políticas de privacidad y términos de Traigalo ⚡
    </footer>

    <script is:inline>
      let selectedRole = 'client';

      document.querySelectorAll('.reg-role-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.reg-role-btn').forEach((b) => {
            b.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border border-gray-100 bg-gray-50 text-gray-600 hover:border-gray-200 transition-all';
          });
          btn.className = 'reg-role-btn py-2.5 rounded-2xl text-xs font-extrabold border-2 border-[#FF7A00] bg-orange-50 text-[#FF7A00] transition-all';
          selectedRole = btn.getAttribute('data-role') || 'client';
        });
      });

      const submitBtn = document.getElementById('btn-register-submit');
      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const nameInput = document.getElementById('reg-name');
          const emailInput = document.getElementById('reg-email');
          const name = nameInput && nameInput.value.trim() ? nameInput.value.trim() : 'Freddy Campos';
          const email = emailInput && emailInput.value.trim() ? emailInput.value.trim() : 'usuario@traigalo.org';

          const token = `trg_jwt_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
          const user = {
            id: '44444444-4444-4444-4444-444444444444',
            name: name,
            email: email,
            role: selectedRole
          };

          localStorage.setItem('traigalo_token', token);
          localStorage.setItem('traigalo_user', JSON.stringify(user));

          if (selectedRole === 'vendor') {
            window.location.href = '/vendor';
          } else if (selectedRole === 'driver') {
            window.location.href = '/driver';
          } else {
            window.location.href = '/';
          }
        });
      }
    </script>
  </body>
</html>
