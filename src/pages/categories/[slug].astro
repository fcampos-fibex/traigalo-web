---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import { fetchActiveStores } from '../../adapters/stores';
import '../../styles/global.css';
import '../../styles/pages/account.css';

const { slug } = Astro.params;
const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let categories: any[] = [];
try {
  const catMod = await import('../../data/categories.json');
  categories = catMod.default || [];
} catch {}

let assetMap: Record<string, string> = {};
try {
  const assetMod = await import('../../data/product_assets.json');
  assetMap = assetMod.default || {};
} catch {}

const matchedCategory = categories.find(
  (c) => c.slug === slug || c.id === slug || c.name.toLowerCase().replace(/\s+/g, '-') === slug
) || {
  id: slug || '0',
  name: 'Categoría',
  slug: slug || 'general',
  image_url: 'https://admin.traigalo.org/assets/5ce76a26-f596-4b8b-8ad5-e70d04a8aa7f'
};

const stores = await fetchActiveStores();

const catNameLower = matchedCategory.name.toLowerCase();
let targetStore = stores.find((s) => {
  if (catNameLower.includes('barber') || catNameLower.includes('belleza') || catNameLower.includes('cuidado')) {
    return s.rubroKey === 'barberia';
  }
  return s.rubroKey === 'tecnologia';
}) || stores[0];

let products: any[] = [];
if (targetStore) {
  try {
    const pRes = await fetch(`${API_BASE}/stores/${targetStore.id}/products`);
    if (pRes.ok) {
      const items = await pRes.json();
      products = items.map((it: any) => {
        let img = '';
        if (it.attributes?.image_url) {
          img = it.attributes.image_url;
        } else if (it.attributes?.asset_id) {
          img = `${ASSET_BASE}/${it.attributes.asset_id}`;
        } else if (assetMap[it.name]) {
          img = `${ASSET_BASE}/${assetMap[it.name]}`;
        } else {
          img = FALLBACK_PRODUCT_IMAGE;
        }

        const price = Number(it.base_price) || 0;
        return {
          id: it.id,
          storeId: targetStore.id,
          storeName: targetStore.name,
          name: it.name,
          desc: it.description || '',
          price: price,
          priceBs: formatBs(price, bcvRate),
          image: img
        };
      });
    }
  } catch {}
}
const RUBRO_KEYS = ['restaurantes', 'supermercados', 'farmacias', 'tecnologia', 'barberia', 'mascotas'];
const pageRubro = targetStore && RUBRO_KEYS.includes(targetStore.rubroKey) ? targetStore.rubroKey : undefined;
---

<!doctype html>
<html lang="es" data-rubro={pageRubro}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{matchedCategory.name} | Traigalo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher currentRole="client" />
      <Header />

      <main class="tg-wrap tg-main">
        <nav class="acc-crumbs" aria-label="Ruta">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{matchedCategory.name}</span>
        </nav>

        <section class="tg-section acc-cat-head" aria-labelledby="cat-title">
          <div class="acc-cat-thumb">
            <img
              src={matchedCategory.image_url || 'https://admin.traigalo.org/assets/5ce76a26-f596-4b8b-8ad5-e70d04a8aa7f'}
              alt=""
              width="72"
              height="72"
              onerror="this.onerror=null; this.classList.add('is-broken');"
            />
          </div>
          <div class="acc-cat-text">
            <h1 id="cat-title" class="acc-title">{matchedCategory.name}</h1>
            <p>{products.length} productos de <strong>{targetStore?.name}</strong></p>
          </div>
          {targetStore && (
            <a href={`/stores/${targetStore.id}`} class="tg-btn tg-btn--quiet tg-btn--sm">Visitar la tienda</a>
          )}
        </section>

        <nav class="acc-cat-nav no-scrollbar" aria-label="Otras categorías">
          {categories.slice(0, 10).map((cat) => {
            const isCurrent = cat.slug === slug || cat.id === slug;
            return (
              <a
                href={`/categories/${cat.slug || cat.id}`}
                class="acc-cat-link"
                aria-current={isCurrent ? 'page' : undefined}
              >
                {cat.name}
              </a>
            );
          })}
        </nav>

        <section class="tg-section" aria-label="Productos">
          {products.length === 0 ? (
            <div class="tg-empty">
              <h3>No hay productos en esta categoría por ahora</h3>
              <p>Prueba con otra categoría o vuelve más tarde.</p>
              <div class="tg-empty-actions">
                <a href="/" class="tg-btn tg-btn--primary tg-btn--sm">Volver al inicio</a>
              </div>
            </div>
          ) : (
            <div class="tg-products">
              {products.map((p) => (
                <div class="product-item">
                  <div class="tg-product-img">
                    <img src={p.image} alt={p.name} width="300" height="300" loading="lazy" decoding="async" onerror="this.onerror=null; this.classList.add('is-broken');" />
                  </div>
                  <div>
                    <div class="tg-product-store"><span>{p.storeName}</span></div>
                    <h3 class="tg-product-name">{p.name}</h3>
                  </div>
                  <div class="tg-product-buy">
                    <div>
                      <span class="tg-price">${p.price.toFixed(2)}</span>
                      <span class="tg-price-bs">{p.priceBs}</span>
                    </div>
                    <a href={`/stores/${p.storeId}`} class="btn-home-add" aria-label={`Ver ${p.name} en la tienda`}>+</a>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      </main>

      <Footer />
      <BottomNav />
    </div>
  </body>
</html>
