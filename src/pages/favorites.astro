---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../adapters/rates';
import '../styles/global.css';
import '../styles/pages/account.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";
const bcvRate = await getOfficialExchangeRate();

function cleanProductName(rawName: string): string {
  return String(rawName || '')
    .replace(/^Ariculares/i, 'Auriculares')
    .replace(/^5-Sprinng\s*(CHEST\s*PULL)?/i, '5-Spring Chest Pull')
    .replace(/^Abdominal musclw/i, 'Abdominal Muscle Trainer')
    .replace(/^Aceite de resino/i, 'Aceite de Ricino')
    .replace(/^After chave/i, 'After Shave Profesional')
    .replace(/^Back pain need hellp/i, 'Soporte Lumbar Back Pain')
    .replace(/^Brocha de ljo/i, 'Brocha de Lujo');
}

let assetMap: Record<string, string> = {};
try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

let favoriteStores: any[] = [];
try {
  const sRes = await fetch(`${API_BASE}/stores`);
  if (sRes.ok) {
    const list = await sRes.json();
    favoriteStores = Array.isArray(list)
      ? list.filter((s: any) => s.is_open !== false && s.slug !== 'burger-crave' && s.slug !== 'sushi-omakase')
      : [];
  }
} catch {}

let favoriteProducts: any[] = [];
for (const store of favoriteStores) {
  try {
    const pRes = await fetch(`${API_BASE}/stores/${store.id}/products`);
    if (pRes.ok) {
      const items = await pRes.json();
      if (Array.isArray(items)) {
        const mapped = items.slice(0, 4).map((it: any) => {
          const rawName = String(it.name || '');
          const displayName = cleanProductName(rawName);
          let img = '';
          if (it.attributes?.image_url) {
            img = it.attributes.image_url;
          } else if (it.attributes?.asset_id) {
            img = `${ASSET_BASE}/${it.attributes.asset_id}`;
          } else if (assetMap[rawName]) {
            img = `${ASSET_BASE}/${assetMap[rawName]}`;
          } else if (assetMap[displayName]) {
            img = `${ASSET_BASE}/${assetMap[displayName]}`;
          } else {
            img = FALLBACK_PRODUCT_IMAGE;
          }
          const price = Number(it.base_price) || 0;
          return {
            id: it.id,
            name: displayName,
            storeName: store.name,
            storeId: store.id,
            price,
            priceBs: formatBs(price, bcvRate),
            image: img
          };
        });
        favoriteProducts.push(...mapped);
      }
    }
  } catch {}
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tus favoritos | Traigalo</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher currentRole="client" />
      <Header />

      <main class="tg-wrap tg-main">
        <section class="tg-section acc-intro" aria-labelledby="fav-title">
          <h1 id="fav-title">Tus favoritos</h1>
          <p>Tiendas y artículos a mano para pedir de nuevo en un toque.</p>
        </section>

        <section class="tg-section" aria-labelledby="fav-stores-title">
          <div class="tg-head">
            <h2 id="fav-stores-title">Tiendas guardadas</h2>
          </div>
          {favoriteStores.length === 0 ? (
            <div class="tg-empty">
              <h3>Aún no tienes tiendas guardadas</h3>
              <p>Explora las tiendas de Higuerote y guarda las que más uses.</p>
              <div class="tg-empty-actions">
                <a href="/" class="tg-btn tg-btn--primary tg-btn--sm">Explorar tiendas</a>
              </div>
            </div>
          ) : (
            <div class="acc-stores">
              {favoriteStores.map((store) => {
                const logoUrl = store.logo_url || '/brand-icon.webp';
                const coverUrl = store.cover_url || '/brand-icon.webp';
                return (
                  <a href={`/stores/${store.id}`} class="acc-store">
                    <span class="acc-store-cover">
                      <img src={coverUrl} alt="" width="480" height="160" loading="lazy" decoding="async" onerror="this.onerror=null; this.classList.add('is-broken');" />
                      <span class="tg-cover-tag tg-glass">Abierto</span>
                    </span>
                    <span class="acc-store-body">
                      <img class="acc-store-logo" src={logoUrl} alt="" width="48" height="48" loading="lazy" onerror="this.onerror=null; this.classList.add('is-broken');" />
                      <span class="acc-store-text">
                        <span class="acc-store-name">{store.name}</span>
                        {store.address_line && <span class="acc-store-addr">{store.address_line}</span>}
                      </span>
                    </span>
                  </a>
                );
              })}
            </div>
          )}
        </section>

        <section class="tg-section" aria-labelledby="fav-products-title">
          <div class="tg-head">
            <h2 id="fav-products-title">Artículos guardados</h2>
            <p class="tg-count">{favoriteProducts.length} artículos</p>
          </div>
          {favoriteProducts.length === 0 ? (
            <div class="tg-empty">
              <h3>Tu lista de artículos está vacía</h3>
              <p>Cuando guardes un producto aparecerá aquí, listo para agregarlo al carrito.</p>
              <div class="tg-empty-actions">
                <a href="/" class="tg-btn tg-btn--primary tg-btn--sm">Ver productos</a>
              </div>
            </div>
          ) : (
            <div class="tg-products">
              {favoriteProducts.map((p) => (
                <div class="product-item">
                  <div class="tg-product-img">
                    <img src={p.image} alt={p.name} width="300" height="300" loading="lazy" decoding="async" onerror="this.onerror=null; this.classList.add('is-broken');" />
                  </div>
                  <div>
                    <div class="tg-product-store"><span>{p.storeName}</span></div>
                    <h3 class="tg-product-name">{p.name}</h3>
                  </div>
                  <div class="tg-product-buy">
                    <div>
                      <span class="tg-price">${p.price.toFixed(2)}</span>
                      <span class="tg-price-bs">{p.priceBs}</span>
                    </div>
                    <button
                      type="button"
                      data-id={p.id}
                      data-name={p.name}
                      data-price={p.price}
                      data-image={p.image}
                      data-store-id={p.storeId}
                      data-store-name={p.storeName}
                      class="btn-fav-add-cart btn-home-add"
                      aria-label={`Agregar ${p.name} al carrito`}
                    >+</button>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      </main>

      <div id="fav-cart-bar" class="tg-cartbar acc-cartbar hidden">
        <a href="/checkout">
          <span class="tg-cart-left">
            <span id="fav-cart-count" class="tg-cart-count">0</span>
            <span>
              <span>Ver carrito</span>
              <small>Ir a pagar el pedido</small>
            </span>
          </span>
          <span class="tg-cart-total">
            <span id="fav-cart-total">$0.00</span>
          </span>
        </a>
      </div>

      <Footer />
      <BottomNav />
    </div>

    <script is:inline>
      (() => {
        const CART_KEY = 'traigalo_cart';

        function getCart() {
          try {
            return JSON.parse(localStorage.getItem(CART_KEY) || '[]');
          } catch {
            return [];
          }
        }

        function updateBar() {
          const cart = getCart();
          const bar = document.getElementById('fav-cart-bar');
          const countEl = document.getElementById('fav-cart-count');
          const totalEl = document.getElementById('fav-cart-total');
          if (!bar) return;

          const totalQty = cart.reduce((acc, it) => acc + (it.qty || 1), 0);
          const totalUsd = cart.reduce((acc, it) => acc + (Number(it.price) * (it.qty || 1)), 0);

          if (totalQty > 0) {
            bar.classList.remove('hidden');
            if (countEl) countEl.textContent = String(totalQty);
            if (totalEl) totalEl.textContent = `$${totalUsd.toFixed(2)}`;
          } else {
            bar.classList.add('hidden');
          }
        }

        document.querySelectorAll('.btn-fav-add-cart').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const price = parseFloat(btn.getAttribute('data-price') || '0');
            const image = btn.getAttribute('data-image') || '';
            const storeId = btn.getAttribute('data-store-id') || '';
            const storeName = btn.getAttribute('data-store-name') || '';

            const cart = getCart();
            const existing = cart.find((i) => i.id === id);
            if (existing) {
              existing.qty = (existing.qty || 1) + 1;
            } else {
              cart.push({ id, name, price, image, qty: 1, storeId, storeName });
            }
            localStorage.setItem(CART_KEY, JSON.stringify(cart));
            updateBar();

            const orig = btn.textContent;
            btn.textContent = '✓';
            btn.classList.add('is-added');
            setTimeout(() => {
              btn.textContent = orig;
              btn.classList.remove('is-added');
            }, 650);
          });
        });

        updateBar();
      })();
    </script>
  </body>
</html>
