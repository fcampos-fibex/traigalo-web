---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

const categories = [
  { id: '1', name: 'Todo', icon: '🍽️', active: true },
  { id: '2', name: 'Burgers', icon: '🍔', active: false },
  { id: '3', name: 'Pizza', icon: '🍕', active: false },
  { id: '4', name: 'Sushi', icon: '🍣', active: false },
  { id: '5', name: 'Postres', icon: '🧁', active: false },
  { id: '6', name: 'Bebidas', icon: '🧋', active: false },
];

const popularItems = [
  {
    id: 'f1',
    name: 'Classic Smash Cheeseburger',
    restaurant: 'Black Iron Burger',
    price: 8.50,
    rating: '4.9',
    time: '15-20 min',
    image: 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=500&q=80',
    popular: true
  },
  {
    id: 'f2',
    name: 'Special Salmon Dragon Roll',
    restaurant: 'Sakura Omakase',
    price: 12.00,
    rating: '4.9',
    time: '20-25 min',
    image: 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=500&q=80',
    popular: true
  },
  {
    id: 'f3',
    name: 'Pizza Margherita di Bufala',
    restaurant: 'Napoli Antica',
    price: 10.50,
    rating: '4.8',
    time: '25-30 min',
    image: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=500&q=80',
    popular: false
  },
  {
    id: 'f4',
    name: 'Tacos al Pastor con Piña',
    restaurant: 'Taquería La Original',
    price: 7.20,
    rating: '4.9',
    time: '15-20 min',
    image: 'https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?auto=format&fit=crop&w=500&q=80',
    popular: true
  }
];

const nearbyStores = [
  {
    id: 's1',
    name: 'Black Iron Burger Lab',
    cuisine: 'Americana • Burgers gourmet',
    rating: '4.9',
    reviews: '850',
    time: '15-25 min',
    fee: '$1.50',
    cover: 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=700&q=80',
    promo: '2x1 en Smash Burgers'
  },
  {
    id: 's2',
    name: 'Sakura Omakase Bar',
    cuisine: 'Japonesa • Sushi tradicional',
    rating: '4.9',
    reviews: '1.2k',
    time: '20-30 min',
    fee: 'Gratis',
    cover: 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=700&q=80',
    promo: '15% OFF en Rolls'
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Comida y Delivery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-24 md:pb-12 antialiased selection:bg-orange-500 selection:text-white">
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-4 w-full">
      
      <!-- MINIMAL PROMOTIONAL CARD (FIGMA STYLE) -->
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#FF7A00] to-[#FF9432] p-5 sm:p-7 shadow-lg shadow-orange-500/15 mb-6 text-white">
        <div class="relative z-10 max-w-[65%]">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider mb-2">
            Oferta Especial
          </span>
          <h2 class="text-xl sm:text-2xl font-black leading-tight tracking-tight mb-1">
            30% de Descuento
          </h2>
          <p class="text-xs text-orange-50 leading-relaxed mb-4">
            En tu primer pedido con el código <strong class="underline">TRAIGALO</strong>
          </p>
          <a href="#popular" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-orange-600 text-xs font-bold shadow-md shadow-black/5 hover:bg-orange-50 transition-all active:scale-95">
            Pedir Ahora
          </a>
        </div>

        <div class="absolute -right-4 -bottom-6 w-44 h-44 pointer-events-none select-none">
          <img 
            src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=400&q=80" 
            alt="Delicious burger" 
            class="w-full h-full object-cover rounded-full shadow-2xl ring-4 ring-white/30 transform rotate-12 scale-110" 
            loading="eager"
          />
        </div>
      </section>

      <!-- CATEGORIES HORIZONTAL PILLS -->
      <section class="mb-6">
        <div class="flex items-center justify-between mb-3 px-0.5">
          <h3 class="text-sm font-extrabold text-gray-900 tracking-tight">Categorías</h3>
          <span class="text-xs font-bold text-orange-600 hover:underline cursor-pointer">Ver todas</span>
        </div>

        <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1 -mx-4 px-4 sm:mx-0 sm:px-0">
          {categories.map(cat => (
            <button class={`shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-bold transition-all ${
              cat.active 
                ? 'bg-orange-600 text-white shadow-md shadow-orange-600/25 ring-2 ring-orange-600/20' 
                : 'bg-white border border-gray-100 text-gray-700 hover:border-gray-200 shadow-2xs'
            }`}>
              <span class="text-sm">{cat.icon}</span>
              <span>{cat.name}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- POPULAR ITEMS (2-COLUMN CLEAN GRID - FIGMA CORE ELEMENT) -->
      <section id="popular" class="mb-8">
        <div class="flex items-center justify-between mb-3 px-0.5">
          <h3 class="text-sm font-extrabold text-gray-900 tracking-tight">Más Populares</h3>
          <span class="text-xs font-bold text-orange-600 hover:underline cursor-pointer">Ver todo</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-3.5">
          {popularItems.map(item => (
            <div class="bg-white rounded-3xl p-2.5 border border-gray-100/80 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
              <div>
                <!-- ITEM IMAGE WITH FAVORITE BUTTON -->
                <div class="relative h-32 w-full rounded-2xl overflow-hidden bg-gray-50 mb-2.5">
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                    loading="lazy" 
                  />
                  <!-- RATING BADGE -->
                  <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded-lg bg-white/90 backdrop-blur-md text-[10px] font-bold text-gray-900 flex items-center gap-1 shadow-xs">
                    <span class="text-amber-500">★</span>
                    <span>{item.rating}</span>
                  </div>
                  <!-- FAVORITE HEART -->
                  <button class="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-gray-400 hover:text-red-500 shadow-xs transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  </button>
                </div>

                <!-- INFO -->
                <h4 class="text-xs font-bold text-gray-900 leading-snug line-clamp-1 group-hover:text-orange-600 transition-colors">
                  {item.name}
                </h4>
                <p class="text-[10px] text-gray-400 mt-0.5 line-clamp-1">
                  {item.restaurant} • {item.time}
                </p>
              </div>

              <!-- PRICE + QUICK ADD BUTTON -->
              <div class="mt-3 flex items-center justify-between pt-1">
                <span class="text-sm font-black text-gray-900">
                  ${item.price.toFixed(2)}
                </span>
                <button class="w-8 h-8 rounded-full bg-orange-600 hover:bg-orange-700 active:scale-90 text-white flex items-center justify-center shadow-md shadow-orange-600/20 transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- NEARBY RESTAURANTS -->
      <section class="mb-6">
        <div class="flex items-center justify-between mb-3 px-0.5">
          <div>
            <h3 class="text-sm font-extrabold text-gray-900 tracking-tight">Restaurantes Destacados</h3>
            <p class="text-[10px] text-gray-400">Entrega rápida y sin contacto</p>
          </div>
        </div>

        <div class="space-y-3.5">
          {nearbyStores.map(store => (
            <div class="bg-white rounded-3xl p-3 border border-gray-100 shadow-xs hover:shadow-md transition-all flex items-center gap-3.5 group cursor-pointer">
              <div class="w-24 h-24 rounded-2xl overflow-hidden bg-gray-50 shrink-0 relative">
                <img src={store.cover} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                <span class="absolute bottom-1.5 left-1.5 px-1.5 py-0.5 rounded-md bg-black/70 text-[9px] font-bold text-white">
                  {store.time}
                </span>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <h4 class="text-sm font-extrabold text-gray-900 truncate group-hover:text-orange-600 transition-colors">
                    {store.name}
                  </h4>
                  <div class="flex items-center gap-1 text-[11px] font-bold text-gray-900 shrink-0">
                    <span class="text-amber-500">★</span>
                    <span>{store.rating}</span>
                  </div>
                </div>

                <p class="text-[11px] text-gray-400 mt-0.5 truncate">{store.cuisine}</p>

                <div class="mt-2 flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded-md bg-orange-50 text-orange-600 text-[10px] font-bold">
                    {store.promo}
                  </span>
                  <span class="text-[10px] text-gray-400">
                    Envío {store.fee}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

    </main>

    <Footer />
    <BottomNav />
  </body>
</html>
