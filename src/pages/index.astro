---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../adapters/rates';
import '../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
let assetMap: Record<string, string> = {};
let allProducts: any[] = [];

try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

const EXCLUDED_STORE_SLUGS = ['burger-crave', 'sushi-omakase'];

const NAME_FIXES: Record<string, string> = {
  'Ariculares SZ-771': 'Auriculares SZ-771',
  '5-Sprinng CHEST PULL': '5-Spring Chest Pull',
  'Abdominal musclw': 'Abdominal Muscle Trainer',
  'Aceite de resino': 'Aceite de Ricino',
  'After chave': 'After Shave Profesional',
  'Back pain need hellp': 'Soporte Lumbar Back Pain',
  'Brocha de ljo': 'Brocha de Lujo'
};

function normalizeName(rawName: string): string {
  const trimmed = (rawName || '').trim();
  return NAME_FIXES[trimmed] || trimmed.replace(/\s{2,}/g, ' ');
}

function classifyProductCategory(name: string, storeName: string): string {
  const n = name.toLowerCase();
  const s = storeName.toLowerCase();
  if (n.includes('funda') || n.includes('carcasa') || n.includes('tecno') || n.includes('ufone') || n.includes('phone') || n.includes('móvil') || n.includes('movil')) {
    return 'fundas';
  }
  if (n.includes('gaming') || n.includes('games') || n.includes('mario') || n.includes('batman') || n.includes('iron man') || n.includes('magic q8')) {
    return 'gaming';
  }
  if (n.includes('auricular') || n.includes('audífono') || n.includes('audifono') || n.includes('headset') || n.includes('headphones') || n.includes('stn-28') || s.includes('wily')) {
    return 'audio';
  }
  if (n.includes('training') || n.includes('chest') || n.includes('abdominal') || n.includes('lumbar') || n.includes('back pain')) {
    return 'fitness';
  }
  if (n.includes('cepillo') || n.includes('peine') || n.includes('bigudies')) {
    return 'cepillos';
  }
  if (n.includes('máquina') || n.includes('maquina') || n.includes('plancha') || n.includes('secador') || n.includes('brocha') || n.includes('capa') || n.includes('atomizador') || n.includes('grip')) {
    return 'barberia';
  }
  return 'cuidado';
}

try {
  const storesRes = await fetch(`${API_BASE}/stores`);
  if (storesRes.ok) {
    const list = await storesRes.json();
    stores = Array.isArray(list) 
      ? list.filter((s: any) => s.is_open === true && !EXCLUDED_STORE_SLUGS.includes(s.slug)) 
      : [];
  }
} catch {}

stores.sort((a, b) => (a.name.includes('WILY') ? -1 : 1));

for (const store of stores) {
  const isWily = store.name.toUpperCase().includes('WILY');
  store.bannerUrl = isWily ? '/store-wily-cover.svg' : '/store-barbero-cover.svg';
  store.badgeUrl = isWily ? '/store-wily-logo.svg' : '/store-barbero-logo.svg';
  store.verticalLabel = isWily ? 'Tecnología, Audio & Gaming' : 'Barbería Profesional & Cuidado Personal';
  store.productCount = 0;

  try {
    const prodRes = await fetch(`${API_BASE}/stores/${store.id}/products`);
    if (prodRes.ok) {
      const items = await prodRes.json();
      if (Array.isArray(items)) {
        store.productCount = items.length;
        const mapped = items.map((it: any) => {
          const cleanName = normalizeName(it.name);
          let img = '';
          if (it.attributes?.image_url) {
            img = it.attributes.image_url;
          } else if (it.attributes?.asset_id) {
            img = `${ASSET_BASE}/${it.attributes.asset_id}`;
          } else if (assetMap[it.name]) {
            img = `${ASSET_BASE}/${assetMap[it.name]}`;
          } else if (assetMap[cleanName]) {
            img = `${ASSET_BASE}/${assetMap[cleanName]}`;
          } else {
            img = FALLBACK_PRODUCT_IMAGE;
          }

          const price = Number(it.base_price) || 0;
          const catSlug = classifyProductCategory(cleanName, store.name);
          return {
            id: it.id,
            storeId: store.id,
            name: cleanName,
            desc: it.description || `Disponible en ${store.name} con entrega express garantizada.`,
            storeName: store.name,
            storeBadge: store.badgeUrl,
            category: catSlug,
            price: price,
            priceBs: formatBs(price, bcvRate),
            rating: '4.9',
            time: '15-20 min',
            image: img
          };
        });
        allProducts.push(...mapped);
      }
    }
  } catch {}
}

const curatedCategories = [
  { slug: 'all', name: 'Todo el Catálogo', icon: '⚡' },
  { slug: 'audio', name: 'Audífonos y Audio', icon: '🎧' },
  { slug: 'fundas', name: 'Fundas y Celulares', icon: '📱' },
  { slug: 'gaming', name: 'Gaming y Consolas', icon: '🎮' },
  { slug: 'barberia', name: 'Barbería y Máquinas', icon: '💈' },
  { slug: 'cepillos', name: 'Cepillos y Peines', icon: '🪮' },
  { slug: 'cuidado', name: 'Cuidado Capilar y Barba', icon: '✨' },
  { slug: 'fitness', name: 'Fitness y Bienestar', icon: '🏋️' }
];
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Marketplace Multi-Tienda y Delivery Express</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-8">
      
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#0B132B] via-[#1C2541] to-[#FF5A00] p-6 sm:p-10 shadow-xl shadow-orange-500/10 text-white">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-xs font-black uppercase tracking-wider mb-3 border border-white/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Super-App Multi-Rubro • Higuerote & Miranda</span>
          </div>
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-2.5">
            Todas tus tiendas oficiales en un solo carrito
          </h1>
          <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-5 max-w-xl">
            Compra tecnología, audio, gaming, barbería profesional y cuidado personal de múltiples comercios verificados, o solicita un traslado con Traigalo Rides a tasa oficial BCV.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="#stores" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs sm:text-sm font-black shadow-lg shadow-orange-600/30 active:scale-95 transition-all">
              <span>Ver Tiendas Oficiales</span>
              <span>→</span>
            </a>
            <a href="/rides" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-black active:scale-95 transition-all">
              <span>🚗</span>
              <span>Pedir Taxi / Moto</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex absolute right-10 top-1/2 -translate-y-1/2 items-center gap-3">
          <img src="/brand-icon.webp?v=3" alt="Traigalo" class="w-36 h-36 lg:w-44 lg:h-44 object-contain drop-shadow-2xl" />
        </div>
      </section>

      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <button type="button" data-store-filter="all" class="vertical-card text-left p-4 rounded-3xl bg-white border-2 border-[#FF7A00] shadow-md shadow-orange-500/10 hover:shadow-lg transition-all cursor-pointer flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-orange-50 text-[#FF7A00] flex items-center justify-center text-2xl shrink-0">
            🛍️
          </div>
          <div class="min-w-0">
            <span class="text-[10px] font-black uppercase tracking-wider text-[#FF7A00] block">Multi-Store</span>
            <h3 class="text-xs sm:text-sm font-black text-gray-900 truncate">Todas las Tiendas</h3>
            <p class="text-[10px] text-gray-400 font-semibold">{allProducts.length} artículos</p>
          </div>
        </button>

        <button type="button" data-store-filter="wily" class="vertical-card text-left p-4 rounded-3xl bg-white border-2 border-transparent hover:border-blue-300 shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl shrink-0">
            🎧
          </div>
          <div class="min-w-0">
            <span class="text-[10px] font-black uppercase tracking-wider text-blue-600 block">Tecnología</span>
            <h3 class="text-xs sm:text-sm font-black text-gray-900 truncate">WILY VIDEO</h3>
            <p class="text-[10px] text-gray-400 font-semibold">Audio, Cases & Gaming</p>
          </div>
        </button>

        <button type="button" data-store-filter="barbero" class="vertical-card text-left p-4 rounded-3xl bg-white border-2 border-transparent hover:border-amber-300 shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl shrink-0">
            💈
          </div>
          <div class="min-w-0">
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-600 block">Cuidado Personal</span>
            <h3 class="text-xs sm:text-sm font-black text-gray-900 truncate">El Sitio del Barbero</h3>
            <p class="text-[10px] text-gray-400 font-semibold">Barbería & Estética</p>
          </div>
        </button>

        <a href="/rides" class="p-4 rounded-3xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-md hover:shadow-lg transition-all flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center text-2xl shrink-0">
            🚗
          </div>
          <div class="min-w-0">
            <span class="text-[10px] font-black uppercase tracking-wider text-blue-200 block">Movilidad</span>
            <h3 class="text-xs sm:text-sm font-black text-white truncate">Traigalo Rides</h3>
            <p class="text-[10px] text-blue-100 font-semibold">Taxis, Motos y Fletes</p>
          </div>
        </a>
      </section>

      <section id="stores" class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg sm:text-xl font-black text-gray-900 tracking-tight">Tiendas Oficiales Verificadas</h2>
            <p class="text-xs text-gray-400">Selecciona una tienda para explorar su vitrina exclusiva o combina productos en tu carrito</p>
          </div>
          <span class="text-xs font-extrabold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 shrink-0">
            ● {stores.length} Comercios Activos
          </span>
        </div>

        <div id="stores-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {stores.map(store => (
            <div 
              class="store-item bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between group"
              data-name={store.name.toLowerCase()}
              data-desc={(store.description || '').toLowerCase()}
            >
              <a href={`/stores/${store.id}`} class="block relative h-36 sm:h-44 w-full overflow-hidden bg-gray-900">
                <img src={store.bannerUrl} alt={store.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
                <div class="absolute top-3 left-3 flex items-center gap-2">
                  <span class="px-2.5 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    ● Abierto Ahora
                  </span>
                  <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[10px] font-bold">
                    {store.productCount} Productos
                  </span>
                </div>
                <div class="absolute bottom-3 left-4 right-4 flex items-end gap-3.5">
                  <img src={store.badgeUrl} alt={store.name} class="w-14 h-14 rounded-2xl border-2 border-white shadow-lg bg-white shrink-0" />
                  <div class="text-white min-w-0 flex-1">
                    <span class="text-[10px] font-black uppercase tracking-wider text-orange-300 block">{store.verticalLabel}</span>
                    <h3 class="text-lg sm:text-xl font-black leading-tight truncate">{store.name}</h3>
                    <p class="text-[11px] text-gray-300 truncate">📍 {store.address_line}</p>
                  </div>
                </div>
              </a>

              <div class="p-4 flex items-center justify-between gap-3 bg-white">
                <div class="flex items-center gap-3 text-xs font-bold text-gray-600">
                  <span class="flex items-center gap-1 text-amber-500 font-black">★ 4.9</span>
                  <span>•</span>
                  <span>⚡ 15-25 min</span>
                  <span>•</span>
                  <span class="text-emerald-600 font-extrabold">🛵 Envío $1.50</span>
                </div>

                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    data-filter-store={store.name.toLowerCase().includes('wily') ? 'wily' : 'barbero'}
                    class="btn-store-quickfilter px-3 py-2 rounded-xl bg-gray-100 hover:bg-orange-50 text-gray-700 hover:text-[#FF7A00] text-xs font-extrabold transition-colors cursor-pointer"
                  >
                    Filtrar abajo
                  </button>
                  <a 
                    href={`/stores/${store.id}`}
                    class="px-3.5 py-2 rounded-xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs font-black shadow-sm transition-all active:scale-95"
                  >
                    Entrar a Tienda →
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="catalog-controls" class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg sm:text-xl font-black text-gray-900 tracking-tight">Explorar por Categoría</h2>
            <p class="text-xs text-gray-400">Filtra instantáneamente por tipo de artículo o tienda</p>
          </div>
          <div class="hidden sm:flex items-center gap-1.5">
            <button id="cat-scroll-left" type="button" class="w-8 h-8 rounded-full bg-white border border-gray-200 hover:border-[#FF7A00] text-gray-700 flex items-center justify-center text-xs font-black cursor-pointer shadow-2xs">
              ←
            </button>
            <button id="cat-scroll-right" type="button" class="w-8 h-8 rounded-full bg-white border border-gray-200 hover:border-[#FF7A00] text-gray-700 flex items-center justify-center text-xs font-black cursor-pointer shadow-2xs">
              →
            </button>
          </div>
        </div>

        <div class="flex gap-2.5 overflow-x-auto pb-2 no-scrollbar scroll-smooth" id="categories-bar">
          {curatedCategories.map((c, idx) => (
            <button 
              type="button"
              data-category={c.slug}
              class={`category-btn shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold transition-all cursor-pointer active:scale-95 ${
                idx === 0
                  ? 'bg-[#FF7A00] text-white shadow-md shadow-orange-500/20'
                  : 'bg-white text-gray-800 border border-gray-100 hover:border-orange-300 shadow-2xs'
              }`}
            >
              <span class="text-base" aria-hidden="true">{c.icon}</span>
              <span>{c.name}</span>
            </button>
          ))}
        </div>
      </section>

      <section id="products-section">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <div class="flex items-center gap-2">
            <h2 id="catalog-heading" class="text-lg sm:text-xl font-black text-gray-900 tracking-tight">Catálogo Multi-Tienda</h2>
            <span id="active-filter-pill" class="hidden px-2.5 py-0.5 rounded-full bg-orange-100 text-[#FF7A00] text-xs font-black"></span>
          </div>
          <span id="products-count-badge" class="text-xs sm:text-sm font-bold text-[#FF7A00]">
            Mostrando {allProducts.length} productos
          </span>
        </div>

        <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 sm:gap-5">
          {allProducts.map(p => (
            <div 
              class="product-item bg-white rounded-3xl p-3.5 sm:p-4 border border-gray-100 shadow-sm flex flex-col justify-between group hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              data-id={p.id}
              data-store-id={p.storeId}
              data-store-name={p.storeName}
              data-name={p.name.toLowerCase()}
              data-title={p.name}
              data-desc={p.desc}
              data-price={p.price}
              data-image={p.image}
              data-store={p.storeName.toLowerCase()}
              data-category={p.category}
            >
              <div>
                <div class="relative w-full aspect-square rounded-2xl bg-[#F8F9FA] overflow-hidden mb-3 flex items-center justify-center p-3">
                  <img 
                    src={p.image} 
                    alt={p.name}
                    loading="lazy"
                    class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300"
                    onerror={`this.onerror=null; this.src='${FALLBACK_PRODUCT_IMAGE}';`}
                  />
                  <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-white/95 backdrop-blur-md text-[10px] font-black text-gray-800 shadow-2xs">
                    {p.time}
                  </span>
                </div>

                <div class="flex items-center gap-1.5 mb-1">
                  <img src={p.storeBadge} alt="" class="w-4 h-4 rounded-full object-cover shrink-0" />
                  <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider truncate">{p.storeName}</span>
                </div>

                <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 group-hover:text-[#FF7A00] transition-colors line-clamp-2 leading-snug min-h-[2.5rem]">
                  {p.name}
                </h3>
              </div>

              <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-gray-50">
                <div class="flex flex-col">
                  <span class="text-sm sm:text-base font-black text-gray-950">${p.price.toFixed(2)}</span>
                  <span class="text-[9px] text-gray-400 font-semibold">{p.priceBs}</span>
                </div>
                <button 
                  type="button"
                  aria-label={`Agregar ${p.name} al carrito`}
                  class="btn-home-add w-9 h-9 rounded-full bg-[#FF7A00] hover:bg-[#E66E00] text-white flex items-center justify-center shadow-md shadow-orange-500/25 active:scale-90 transition-all font-black text-lg cursor-pointer"
                >
                  +
                </button>
              </div>
            </div>
          ))}
        </div>

        <div id="no-products-msg" class="hidden text-center py-12 bg-white rounded-3xl border border-gray-100 mt-4">
          <span class="text-3xl block mb-2">🔍</span>
          <p class="text-sm font-bold text-gray-700">No encontramos productos con ese filtro</p>
          <button id="btn-reset-filters" type="button" class="mt-3 px-4 py-2 rounded-xl bg-[#FF7A00] text-white text-xs font-black cursor-pointer">
            Ver todos los productos ({allProducts.length})
          </button>
        </div>
      </section>

    </main>

    <div id="home-product-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div id="home-modal-card" class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl p-5 shadow-2xl transform translate-y-full sm:translate-y-4 transition-transform duration-200 flex flex-col max-h-[90vh]">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <span id="home-modal-store" class="px-2.5 py-0.5 rounded-full bg-orange-50 text-[#FF7A00] text-[10px] font-black uppercase tracking-wider">Tienda Oficial</span>
          </div>
          <button id="home-close-modal" type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 font-black cursor-pointer">
            ✕
          </button>
        </div>
        <div class="overflow-y-auto py-4 space-y-4 flex-1">
          <div class="h-44 w-full rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 flex items-center justify-center p-4">
            <img id="home-modal-img" src="" alt="" class="w-full h-full object-contain" />
          </div>
          <div>
            <h2 id="home-modal-title" class="text-base font-extrabold text-gray-900 leading-snug"></h2>
            <p id="home-modal-desc" class="text-xs text-gray-500 leading-relaxed mt-1"></p>
          </div>
          <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 border border-gray-100">
            <span class="text-xs font-bold text-gray-700">Cantidad</span>
            <div class="flex items-center gap-3 bg-white px-3 py-1.5 rounded-xl border border-gray-200">
              <button id="home-qty-minus" type="button" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-orange-100 text-gray-700 font-black text-sm cursor-pointer">-</button>
              <span id="home-qty-display" class="w-6 text-center text-sm font-black text-gray-950">1</span>
              <button id="home-qty-plus" type="button" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-orange-100 text-gray-700 font-black text-sm cursor-pointer">+</button>
            </div>
          </div>
          <div>
            <label for="home-modal-notes" class="block text-xs font-bold text-gray-700 mb-1">Especificaciones (color, modelo, nota)</label>
            <input id="home-modal-notes" type="text" placeholder="Ej. Color negro, empaque para regalo..." class="w-full h-10 px-3 text-xs rounded-xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-[#FF7A00]" />
          </div>
          <div class="pt-2 flex items-center justify-between border-t border-gray-100">
            <span class="text-xs text-gray-500 font-bold">Subtotal</span>
            <div class="text-right">
              <span id="home-modal-price" class="text-lg font-black text-[#FF7A00] block"></span>
              <span id="home-modal-price-bs" class="text-[10px] text-gray-400 font-semibold block"></span>
            </div>
          </div>
        </div>
        <div class="pt-3 border-t border-gray-100 flex items-center gap-2">
          <a id="home-modal-store-link" href="/stores/46a0baf0-4100-465d-934a-f2d14f004ba5" class="px-4 h-12 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-extrabold text-xs flex items-center justify-center">
            Ir a Tienda
          </a>
          <button id="home-modal-add-btn" type="button" class="flex-1 h-12 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-extrabold text-sm flex items-center justify-center shadow-lg shadow-orange-600/30 cursor-pointer">
            Agregar al Carrito
          </button>
        </div>
      </div>
    </div>

    <div id="home-cart-bar" class="fixed bottom-16 md:bottom-4 left-0 right-0 z-40 px-4 pointer-events-none transition-all duration-300 opacity-0 translate-y-4">
      <div class="max-w-2xl mx-auto pointer-events-auto">
        <a 
          href="/checkout" 
          class="w-full h-14 rounded-2xl bg-gradient-to-r from-[#FF7A00] to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white font-extrabold text-sm px-5 flex items-center justify-between shadow-2xl shadow-orange-600/40 active:scale-98 transition-all"
        >
          <div class="flex items-center gap-2.5">
            <span id="home-cart-count" class="w-7 h-7 rounded-full bg-white/25 flex items-center justify-center text-xs font-black">0</span>
            <div>
              <span class="block leading-tight">Ver Carrito Multi-Tienda</span>
              <span id="home-cart-stores" class="block text-[10px] text-white/85 font-semibold">Listo para pagar</span>
            </div>
          </div>
          <div class="flex items-center gap-2 text-right">
            <div>
              <span id="home-cart-total" class="font-black text-base">$0.00</span>
              <span id="home-cart-total-bs" class="block text-[10px] text-white/85 font-medium"></span>
            </div>
            <span class="text-lg">→</span>
          </div>
        </a>
      </div>
    </div>

    <Footer />
    <BottomNav />

    <script is:inline define:vars={{ bcvRate }}>
    (() => {
      const CART_STORAGE_KEY = 'traigalo_cart';
      let currentFilterCategory = 'all';
      let currentFilterStore = 'all';
      let currentSearchQuery = '';

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateHomeCartBar();
      }

      function addToCart(product, quantity = 1, notes = '') {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id && (item.notes || '') === notes);
        if (existing) {
          existing.qty = (existing.qty || 1) + quantity;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId,
            storeName: product.storeName || 'Tienda Oficial',
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: quantity,
            notes: notes
          });
        }
        saveCart(cart);
      }

      function updateHomeCartBar() {
        const cart = getCart();
        const bar = document.getElementById('home-cart-bar');
        const countEl = document.getElementById('home-cart-count');
        const storesEl = document.getElementById('home-cart-stores');
        const totalEl = document.getElementById('home-cart-total');
        const totalBsEl = document.getElementById('home-cart-total-bs');
        if (!bar || !countEl || !totalEl) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);
        const distinctStores = [...new Set(cart.map(i => i.storeName).filter(Boolean))];

        if (totalQty > 0) {
          countEl.textContent = String(totalQty);
          totalEl.textContent = `$${totalPrice.toFixed(2)}`;
          if (totalBsEl) totalBsEl.textContent = formatBsClient(totalPrice);
          if (storesEl) {
            storesEl.textContent = distinctStores.length > 1
              ? `${distinctStores.length} tiendas (${distinctStores.join(' + ')})`
              : (distinctStores[0] || 'Entrega Express');
          }
          bar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.add('opacity-100', 'translate-y-0');
        } else {
          bar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      function filterCatalog() {
        const productItems = document.querySelectorAll('.product-item');
        const countBadge = document.getElementById('products-count-badge');
        const noProductsMsg = document.getElementById('no-products-msg');
        const activePill = document.getElementById('active-filter-pill');

        let visibleProductsCount = 0;

        productItems.forEach((el) => {
          const name = el.getAttribute('data-name') || '';
          const store = el.getAttribute('data-store') || '';
          const cat = el.getAttribute('data-category') || '';

          const matchesSearch = !currentSearchQuery || 
            name.includes(currentSearchQuery) || 
            store.includes(currentSearchQuery) ||
            cat.includes(currentSearchQuery);

          const matchesCategory = currentFilterCategory === 'all' || cat === currentFilterCategory;
          const matchesStore = currentFilterStore === 'all' || store.includes(currentFilterStore);

          if (matchesSearch && matchesCategory && matchesStore) {
            el.classList.remove('hidden');
            visibleProductsCount++;
          } else {
            el.classList.add('hidden');
          }
        });

        if (countBadge) {
          countBadge.textContent = `Mostrando ${visibleProductsCount} productos`;
        }

        if (activePill) {
          if (currentFilterStore !== 'all') {
            activePill.textContent = currentFilterStore === 'wily' ? 'Tienda: WILY VIDEO' : 'Tienda: El Sitio del Barbero';
            activePill.classList.remove('hidden');
          } else {
            activePill.classList.add('hidden');
          }
        }

        if (noProductsMsg) {
          if (visibleProductsCount === 0) {
            noProductsMsg.classList.remove('hidden');
          } else {
            noProductsMsg.classList.add('hidden');
          }
        }
      }

      const globalSearch = document.getElementById('global-search-input');
      if (globalSearch) {
        globalSearch.addEventListener('input', (e) => {
          currentSearchQuery = e.target.value.trim().toLowerCase();
          filterCatalog();
        });
      }

      document.querySelectorAll('.category-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.category-btn').forEach((b) => {
            b.className = 'category-btn shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold bg-white text-gray-800 border border-gray-100 hover:border-orange-300 shadow-2xs transition-all cursor-pointer active:scale-95';
          });
          btn.className = 'category-btn shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold bg-[#FF7A00] text-white shadow-md shadow-orange-500/20 transition-all cursor-pointer active:scale-95';
          currentFilterCategory = btn.getAttribute('data-category') || 'all';
          filterCatalog();
        });
      });

      function setStoreFilter(storeKey) {
        currentFilterStore = storeKey;
        document.querySelectorAll('.vertical-card').forEach((card) => {
          const k = card.getAttribute('data-store-filter');
          if (k === storeKey) {
            card.classList.add('border-[#FF7A00]', 'shadow-md');
            card.classList.remove('border-transparent');
          } else {
            card.classList.remove('border-[#FF7A00]', 'shadow-md');
            card.classList.add('border-transparent');
          }
        });
        filterCatalog();
      }

      document.querySelectorAll('.vertical-card').forEach((card) => {
        card.addEventListener('click', () => {
          const storeKey = card.getAttribute('data-store-filter') || 'all';
          setStoreFilter(storeKey);
          const prodSec = document.getElementById('products-section');
          if (prodSec && storeKey !== 'all') {
            prodSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      document.querySelectorAll('.btn-store-quickfilter').forEach((btn) => {
        btn.addEventListener('click', () => {
          const storeKey = btn.getAttribute('data-filter-store') || 'all';
          setStoreFilter(storeKey);
          const prodSec = document.getElementById('products-section');
          if (prodSec) prodSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentFilterCategory = 'all';
          currentFilterStore = 'all';
          currentSearchQuery = '';
          if (globalSearch) globalSearch.value = '';
          setStoreFilter('all');
        });
      }

      const catBar = document.getElementById('categories-bar');
      const scrollLeftBtn = document.getElementById('cat-scroll-left');
      const scrollRightBtn = document.getElementById('cat-scroll-right');
      if (catBar && scrollLeftBtn && scrollRightBtn) {
        scrollLeftBtn.addEventListener('click', () => catBar.scrollBy({ left: -280, behavior: 'smooth' }));
        scrollRightBtn.addEventListener('click', () => catBar.scrollBy({ left: 280, behavior: 'smooth' }));
      }

      const modal = document.getElementById('home-product-modal');
      const modalCard = document.getElementById('home-modal-card');
      const modalStore = document.getElementById('home-modal-store');
      const modalImg = document.getElementById('home-modal-img');
      const modalTitle = document.getElementById('home-modal-title');
      const modalDesc = document.getElementById('home-modal-desc');
      const modalPrice = document.getElementById('home-modal-price');
      const modalPriceBs = document.getElementById('home-modal-price-bs');
      const modalQtyDisplay = document.getElementById('home-qty-display');
      const modalQtyMinus = document.getElementById('home-qty-minus');
      const modalQtyPlus = document.getElementById('home-qty-plus');
      const modalNotes = document.getElementById('home-modal-notes');
      const modalAddBtn = document.getElementById('home-modal-add-btn');
      const modalStoreLink = document.getElementById('home-modal-store-link');
      const closeModalBtn = document.getElementById('home-close-modal');

      let activeProduct = null;
      let activeQty = 1;

      function refreshModalTotals() {
        if (!activeProduct) return;
        const sub = Number(activeProduct.price) * activeQty;
        if (modalPrice) modalPrice.textContent = `$${sub.toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(sub);
        if (modalQtyDisplay) modalQtyDisplay.textContent = String(activeQty);
      }

      function openHomeModal(prod) {
        activeProduct = prod;
        activeQty = 1;
        if (modalNotes) modalNotes.value = '';
        if (modalStore) modalStore.textContent = prod.storeName;
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        if (modalStoreLink) modalStoreLink.href = `/stores/${prod.storeId}`;
        refreshModalTotals();

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeHomeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        activeProduct = null;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeHomeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeHomeModal();
        });
      }
      if (modalQtyMinus) {
        modalQtyMinus.addEventListener('click', () => {
          if (activeQty > 1) {
            activeQty--;
            refreshModalTotals();
          }
        });
      }
      if (modalQtyPlus) {
        modalQtyPlus.addEventListener('click', () => {
          if (activeQty < 99) {
            activeQty++;
            refreshModalTotals();
          }
        });
      }
      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (activeProduct) {
            const notes = modalNotes ? modalNotes.value.trim() : '';
            addToCart(activeProduct, activeQty, notes);
            closeHomeModal();
          }
        });
      }

      document.querySelectorAll('.product-item').forEach((card) => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          storeName: card.getAttribute('data-store-name'),
          name: card.getAttribute('data-title'),
          desc: card.getAttribute('data-desc'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image')
        };

        const addBtn = card.querySelector('.btn-home-add');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod, 1, '');
            addBtn.textContent = '✓';
            addBtn.classList.add('bg-emerald-600');
            setTimeout(() => {
              addBtn.textContent = '+';
              addBtn.classList.remove('bg-emerald-600');
            }, 900);
          });
        }

        card.addEventListener('click', () => {
          openHomeModal(prod);
        });
      });

      updateHomeCartBar();
    })();
    </script>
  </body>
</html>
