---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import '../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';

let stores = [];
let popularProducts = [];
let assetMap = {};
let dbCategories = [];

try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch (e) {}

try {
  const catModule = await import('../data/categories.json');
  dbCategories = (catModule.default || []).slice(0, 12);
} catch (e) {}

try {
  const storesRes = await fetch(`${API_BASE}/stores`);
  if (storesRes.ok) {
    stores = await storesRes.json();
  }
} catch (e) {}

const defaultCovers = {
  'WILY VIDEO': 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=700&q=80',
  'El Sitio del Barbero': 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=700&q=80',
  'Burger Crave': 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=700&q=80',
  'Sushi Omakase Roll': 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=700&q=80'
};

const wilyStore = stores.find(s => s.name.includes('WILY'));
if (wilyStore) {
  try {
    const prodRes = await fetch(`${API_BASE}/stores/${wilyStore.id}/products`);
    if (prodRes.ok) {
      const items = await prodRes.json();
      popularProducts = items.map(it => {
        const fileId = assetMap[it.name];
        return {
          id: it.id,
          storeId: wilyStore.id,
          name: it.name,
          storeName: wilyStore.name,
          price: it.base_price,
          rating: '4.9',
          time: '15-20 min',
          image: fileId ? `${ASSET_BASE}/${fileId}` : 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80'
        };
      });
    }
  } catch (e) {}
}

const categories = [
  { id: '1', name: 'Todo', icon: '⚡', active: true },
  { id: '2', name: 'Tecnología', icon: '🎧', active: false },
  { id: '3', name: 'Barbería', icon: '💈', active: false },
  { id: '4', name: 'Comida', icon: '🍔', active: false },
  { id: '5', name: 'Bebidas', icon: '🥤', active: false },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Tiendas y Delivery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-8">
      
      <!-- HERO BANNER (RESPONSIVE DESKTOP & MOBILE) -->
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#FF7A00] via-[#FF8A1E] to-[#FFA726] p-6 sm:p-10 lg:p-12 shadow-xl shadow-orange-500/15 text-white">
        <div class="relative z-10 max-w-xl">
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-black uppercase tracking-wider mb-2.5">
            Llegó Traigalo
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-2">
            Lo que quieras, a tu puerta
          </h2>
          <p class="text-sm sm:text-base text-orange-50 leading-relaxed mb-5 max-w-md">
            Tecnología, cuidado personal y restaurantes oficiales de tu ciudad con delivery express en tiempo real.
          </p>
          <a href="#stores" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white text-[#FF7A00] text-sm font-black shadow-lg hover:bg-orange-50 active:scale-95 transition-all">
            <span>Explorar Tiendas Oficiales</span>
            <span class="text-base">→</span>
          </a>
        </div>
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="hidden sm:block absolute right-12 bottom-6 text-8xl lg:text-9xl select-none opacity-90 drop-shadow-xl animate-pulse">
          🛵
        </div>
      </section>

      <!-- CATEGORIES BAR (CANONICAL FROM TRAIGALO DATABASE) -->
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Categorías Principales</h2>
          <span class="text-xs sm:text-sm font-bold text-[#FF7A00]">{stores.length} comercios verificados</span>
        </div>
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none">
          <button class="shrink-0 flex items-center gap-2.5 px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold bg-[#FF7A00] text-white shadow-md shadow-orange-500/20 active:scale-95 transition-all">
            <span class="text-base sm:text-lg">⚡</span>
            <span>Todo</span>
          </button>
          {dbCategories.map(c => (
            <button class="shrink-0 flex items-center gap-2.5 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold bg-white text-gray-800 border border-gray-100 hover:border-orange-300 shadow-2xs active:scale-95 transition-all">
              {c.image_url ? (
                <img src={c.image_url} alt={c.name} class="w-6 h-6 object-contain rounded-md" />
              ) : (
                <span class="text-base">📦</span>
              )}
              <span>{c.name}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- POPULAR PRODUCTS GRID (RESPONSIVE: 2 cols on mobile, 3 on tablet, 4 on desktop, 5 on wide) -->
      <section>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Productos Destacados</h2>
            <p class="text-xs text-gray-400">Catálogo oficial de WILY VIDEO y tiendas aliadas</p>
          </div>
          <span class="text-xs sm:text-sm font-bold text-[#FF7A00] hover:underline cursor-pointer">Ver todos ({popularProducts.length})</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 sm:gap-5">
          {popularProducts.map(p => (
            <div class="bg-white rounded-3xl p-3.5 sm:p-4 border border-gray-100 shadow-sm flex flex-col justify-between group hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
              <div class="relative w-full aspect-square rounded-2xl bg-[#F8F9FA] overflow-hidden mb-3 flex items-center justify-center p-3">
                <img 
                  src={p.image} 
                  alt={p.name}
                  loading="lazy"
                  class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300"
                  onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80'"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-white/95 backdrop-blur-md text-[10px] font-black text-gray-800 shadow-2xs">
                  {p.time}
                </span>
              </div>

              <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider truncate">{p.storeName}</p>
                <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 line-clamp-2 leading-snug mt-1 min-h-[2.5rem]">
                  {p.name}
                </h3>
              </div>

              <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-gray-50">
                <span class="text-sm sm:text-base font-black text-gray-950">${p.price.toFixed(2)}</span>
                <a 
                  href={`/stores/${p.storeId}`}
                  class="w-9 h-9 rounded-full bg-[#FF7A00] hover:bg-[#E66E00] text-white flex items-center justify-center shadow-md shadow-orange-500/25 active:scale-90 transition-all font-black text-lg"
                >
                  +
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- STORES SECTION (RESPONSIVE GRID) -->
      <section id="stores" class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Tiendas Oficiales</h2>
            <p class="text-xs text-gray-400">Canónico PostgreSQL 16 + PostGIS</p>
          </div>
          <span class="text-xs sm:text-sm font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            ● 100% Operativas
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4">
          {stores.map(store => (
            <a 
              href={`/stores/${store.id}`}
              class="block bg-white rounded-3xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all active:scale-[0.99]"
            >
              <div class="flex items-center gap-4">
                <div class="w-20 h-20 rounded-2xl bg-gray-100 overflow-hidden shrink-0 border border-gray-100 shadow-inner">
                  <img 
                    src={defaultCovers[store.name] || 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=300&q=80'} 
                    alt={store.name}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-extrabold text-gray-900 truncate">{store.name}</h3>
                    {store.is_open && (
                      <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">Abierto</span>
                    )}
                  </div>
                  <p class="text-xs text-gray-500 truncate mt-1">{store.address_line}</p>
                  <div class="flex items-center gap-3 mt-2 text-xs text-gray-400 font-medium">
                    <span class="flex items-center gap-1 text-amber-500 font-bold">
                      ★ 4.9
                    </span>
                    <span>•</span>
                    <span>15-25 min</span>
                    <span>•</span>
                    <span class="text-emerald-600 font-bold">Envío Express</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </main>

    <Footer />
    <BottomNav />
  </body>
</html>
