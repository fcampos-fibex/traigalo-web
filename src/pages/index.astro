---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../adapters/rates';
import { fetchActiveStores } from '../adapters/stores';
import '../styles/global.css';
import '../styles/pages/home.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
let assetMap: Record<string, string> = {};
let allProducts: any[] = [];

try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

const NAME_FIXES: Record<string, string> = {
  'Ariculares SZ-771': 'Auriculares SZ-771',
  '5-Sprinng CHEST PULL': '5-Spring Chest Pull',
  'Abdominal musclw': 'Abdominal Muscle Trainer',
  'Aceite de resino': 'Aceite de Ricino',
  'After chave': 'After Shave Profesional',
  'Back pain need hellp': 'Soporte Lumbar Back Pain',
  'Brocha de ljo': 'Brocha de Lujo'
};

function normalizeName(rawName: string): string {
  const trimmed = (rawName || '').trim();
  return NAME_FIXES[trimmed] || trimmed.replace(/\s{2,}/g, ' ');
}

function classifyProductCategory(name: string, rubroKey: string): string {
  const n = name.toLowerCase();
  if (n.includes('funda') || n.includes('carcasa') || n.includes('tecno') || n.includes('ufone') || n.includes('phone') || n.includes('móvil') || n.includes('movil')) {
    return 'fundas';
  }
  if (n.includes('gaming') || n.includes('games') || n.includes('mario') || n.includes('batman') || n.includes('iron man') || n.includes('magic q8')) {
    return 'gaming';
  }
  if (n.includes('auricular') || n.includes('audífono') || n.includes('audifono') || n.includes('headset') || n.includes('headphones') || n.includes('stn-28') || rubroKey === 'tecnologia') {
    return 'audio';
  }
  if (n.includes('training') || n.includes('chest') || n.includes('abdominal') || n.includes('lumbar') || n.includes('back pain')) {
    return 'fitness';
  }
  if (n.includes('cepillo') || n.includes('peine') || n.includes('bigudies')) {
    return 'cepillos';
  }
  if (n.includes('plancha') || n.includes('secador') || n.includes('rizador')) {
    return 'planchas';
  }
  if (n.includes('máquina') || n.includes('maquina') || n.includes('brocha') || n.includes('capa') || n.includes('atomizador') || n.includes('grip') || n.includes('navaja') || n.includes('cuchilla') || n.includes('tijera')) {
    return 'barberia';
  }
  return 'cuidado';
}

stores = await fetchActiveStores();

const rubroStoreCounts: Record<string, number> = {};
const rubroProductCounts: Record<string, number> = {};

async function loadStoreProducts(store: any): Promise<any[]> {
  try {
    const prodRes = await fetch(`${API_BASE}/stores/${store.id}/products`);
    if (!prodRes.ok) return [];
    const items = await prodRes.json();
    if (!Array.isArray(items)) return [];
    return items.map((it: any, idx: number) => {
      const cleanName = normalizeName(it.name);
      let img = FALLBACK_PRODUCT_IMAGE;
      if (it.attributes?.image_url) {
        img = it.attributes.image_url;
      } else if (it.attributes?.asset_id) {
        img = `${ASSET_BASE}/${it.attributes.asset_id}`;
      } else if (assetMap[it.name]) {
        img = `${ASSET_BASE}/${assetMap[it.name]}`;
      } else if (assetMap[cleanName]) {
        img = `${ASSET_BASE}/${assetMap[cleanName]}`;
      }
      const price = Number(it.base_price) || 0;
      return {
        id: it.id,
        originalOrder: idx,
        storeId: store.id,
        storeKey: store.id,
        rubroKey: store.rubroKey,
        name: cleanName,
        desc: it.description || `Disponible en ${store.name} con entrega express garantizada.`,
        storeName: store.name,
        storeBadge: store.badgeUrl,
        category: classifyProductCategory(cleanName, store.rubroKey),
        price,
        priceBs: formatBs(price, bcvRate),
        rating: '4.9',
        time: '15-20 min',
        image: img
      };
    });
  } catch {
    return [];
  }
}

for (const store of stores) {
  store.bannerUrl = store.cover_url;
  store.badgeUrl = store.logo_url;
  store.verticalLabel = store.description;
  store.addressDisplay = store.address_line;
  rubroStoreCounts[store.rubroKey] = (rubroStoreCounts[store.rubroKey] || 0) + 1;
}

const productsByStore = await Promise.all(stores.map(loadStoreProducts));
stores.forEach((store, i) => {
  const items = productsByStore[i];
  store.productCount = items.length;
  rubroProductCounts[store.rubroKey] = (rubroProductCounts[store.rubroKey] || 0) + items.length;
  allProducts.push(...items);
});

function buildRubroSubtitle(key: string, defaultSubtitle: string): string {
  const sCount = rubroStoreCounts[key] || 0;
  const pCount = rubroProductCounts[key] || 0;
  if (sCount > 0) {
    return `${sCount} tienda${sCount > 1 ? 's' : ''}, ${pCount} artículos`;
  }
  return defaultSubtitle;
}

function doorBadge(key: string, fallback: string): string {
  const count = rubroStoreCounts[key] || 0;
  if (count === 0) return fallback;
  return `${count} abierta${count > 1 ? 's' : ''}`;
}

const storeVerticals = [
  { key: 'all', title: 'Todo', subtitle: `${stores.length} tiendas, ${allProducts.length} productos`, badge: 'Todas', lead: 'Todas las tiendas abiertas en tu zona.' },
  { key: 'restaurantes', title: 'Comida', subtitle: buildRubroSubtitle('restaurantes', 'Restaurantes, pizzas y bebidas'), badge: doorBadge('restaurantes', 'Pronto'), lead: 'Restaurantes de tu zona, a tu puerta.' },
  { key: 'supermercados', title: 'Mercado', subtitle: buildRubroSubtitle('supermercados', 'Víveres, despensa y hogar'), badge: doorBadge('supermercados', 'Pronto'), lead: 'Víveres, despensa y hogar sin salir de casa.' },
  { key: 'farmacias', title: 'Farmacia', subtitle: buildRubroSubtitle('farmacias', 'Medicamentos y primeros auxilios'), badge: doorBadge('farmacias', 'Pronto'), lead: 'Medicamentos y cuidado personal, cuando los necesitas.' },
  { key: 'tecnologia', title: 'Tecnología', subtitle: buildRubroSubtitle('tecnologia', 'Audio, celulares y gaming'), badge: doorBadge('tecnologia', 'Pronto'), lead: 'Audio, celulares, fundas y gaming de tiendas oficiales.' },
  { key: 'barberia', title: 'Belleza', subtitle: buildRubroSubtitle('barberia', 'Cuidado capilar y estética'), badge: doorBadge('barberia', 'Pronto'), lead: 'Barbería, cuidado capilar y estética profesional.' },
  { key: 'mascotas', title: 'Mascotas', subtitle: buildRubroSubtitle('mascotas', 'Alimentos, collares y salud animal'), badge: doorBadge('mascotas', 'Pronto'), lead: 'Alimento, accesorios y salud para tus mascotas.' }
];

const popularStores = [...stores].sort((a, b) => (b.productCount || 0) - (a.productCount || 0));

const categoryCounts: Record<string, number> = { all: allProducts.length };
for (const p of allProducts) {
  categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1;
}

const curatedCategories = [
  {
    slug: 'all',
    rubro: 'all',
    name: 'Todo el Catálogo',
    image: '/brand-icon.webp?v=3',
    count: categoryCounts['all'] || 0
  },
  {
    slug: 'audio',
    rubro: 'tecnologia',
    name: 'Audio y Cornetas',
    image: 'https://admin.traigalo.org/assets/9e27108f-5090-41bf-9df4-2ee25118a259',
    count: categoryCounts['audio'] || 0
  },
  {
    slug: 'fundas',
    rubro: 'tecnologia',
    name: 'Celulares y Fundas',
    image: 'https://admin.traigalo.org/assets/49b91bdf-f812-477c-b64c-f7dfffeebc43',
    count: categoryCounts['fundas'] || 0
  },
  {
    slug: 'gaming',
    rubro: 'tecnologia',
    name: 'Videojuegos y Consolas',
    image: 'https://admin.traigalo.org/assets/5ce76a26-f596-4b8b-8ad5-e70d04a8aa7f',
    count: categoryCounts['gaming'] || 0
  },
  {
    slug: 'barberia',
    rubro: 'barberia',
    name: 'Máquinas y Barbería',
    image: 'https://admin.traigalo.org/assets/6b679a6d-7862-4587-acb5-cf923e220a56',
    count: categoryCounts['barberia'] || 0
  },
  {
    slug: 'cuidado',
    rubro: 'barberia',
    name: 'Cuidado Capilar y Barba',
    image: 'https://admin.traigalo.org/assets/474ed500-f903-4390-8e83-37aeb906e630',
    count: categoryCounts['cuidado'] || 0
  },
  {
    slug: 'cepillos',
    rubro: 'barberia',
    name: 'Cepillos y Peines',
    image: 'https://admin.traigalo.org/assets/7cb72bd0-634e-4a83-b605-b695ffb50f07',
    count: categoryCounts['cepillos'] || 0
  },
  {
    slug: 'planchas',
    rubro: 'barberia',
    name: 'Planchas y Eléctricos',
    image: 'https://admin.traigalo.org/assets/28becd49-0f22-4594-88e6-e22fb477137d',
    count: categoryCounts['planchas'] || 0
  },
  {
    slug: 'fitness',
    rubro: 'barberia',
    name: 'Cuidado Corporal y Fitness',
    image: 'https://admin.traigalo.org/assets/07db9336-702b-4b75-bacf-16843fa8d4da',
    count: categoryCounts['fitness'] || 0
  }
];
---

<!doctype html>
<html lang="es" data-rubro="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Traigalo | Comida, mercado, farmacia, tiendas y taxis en Higuerote</title>
    <meta name="description" content="Pide de varias tiendas de Higuerote en un solo pedido: comida, mercado, farmacia, tecnología y taxis, con precios en dólares y bolívares a tasa BCV." />
    <link rel="canonical" href="https://traigalo.org/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://admin.traigalo.org" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher currentRole="client" />
      <Header />

      <main class="tg-wrap tg-main">

        <section class="tg-section" aria-labelledby="home-title">
          <div class="tg-intro">
            <h1 id="home-title">¿Qué necesitas hoy en Higuerote?</h1>
            <p>Elige un servicio. Todo llega en un mismo carrito.</p>
          </div>
          <div class="tg-module-head" aria-live="polite">
            <h1 id="module-head-title">Comida</h1>
            <p id="module-head-lead">Restaurantes de tu zona, a tu puerta.</p>
            <button id="btn-clear-rubro" type="button" class="tg-btn tg-btn--sm hidden">Volver a todos los servicios</button>
          </div>
        </section>

        <section id="store-verticals" class="tg-section tg-switcher" aria-label="Servicios">
          <div class="tg-rubros">
            {storeVerticals.map((v, idx) => (
              <button
                type="button"
                data-rubro-filter={v.key}
                data-rubro-title={v.title}
                data-rubro-lead={v.lead}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class="rubro-card"
              >
                <span class="tg-door-badge">{v.badge}</span>
                <span>
                  <span class="tg-rubro-title">{v.title}</span>
                  <span class="tg-rubro-sub">{v.subtitle}</span>
                </span>
              </button>
            ))}
            <a href="/rides" class="tg-ride-door">
              <span class="tg-door-badge">En vivo</span>
              <span>
                <span class="tg-rubro-title">Envíos y taxi</span>
                <span class="tg-rubro-sub">Motos, carros y fletes</span>
              </span>
            </a>
          </div>
        </section>

        <section id="catalog-controls" class="tg-section tg-home-cats" aria-labelledby="cats-heading">
          <div class="tg-head">
            <div>
              <h2 id="cats-heading">Explora por categoría</h2>
              <p>Filtra el catálogo de todas las tiendas.</p>
            </div>
            <div class="tg-arrows">
              <button id="cat-scroll-left" type="button" class="tg-arrow" aria-label="Categorías anteriores">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
              </button>
              <button id="cat-scroll-right" type="button" class="tg-arrow" aria-label="Más categorías">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          </div>

          <div class="tg-cats no-scrollbar" id="categories-bar">
            {curatedCategories.map((c, idx) => (
              <button
                type="button"
                data-category={c.slug}
                data-cat-rubro={c.rubro}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class="category-btn"
              >
                <img
                  src={c.image}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  onerror="this.onerror=null; this.classList.add('is-broken');"
                />
                <span>
                  <span class="tg-cat-name">{c.name}</span>
                  <span class="cat-count-label">{c.count} artículos</span>
                </span>
              </button>
            ))}
          </div>
        </section>

        <section id="popular-stores" class="tg-section" aria-labelledby="popular-heading">
          <div class="tg-head">
            <div>
              <h2 id="popular-heading">Tiendas populares</h2>
              <p>Las tiendas con más productos disponibles en tu zona.</p>
            </div>
          </div>
          <div class="tg-pop-row" id="popular-stores-row">
            {popularStores.map((store) => (
              <a href={`/stores/${store.id}`} class="tg-pop-store" data-rubro={store.rubroKey}>
                <span class="tg-pop-cover">
                  <img src={store.bannerUrl} alt="" width="320" height="160" loading="lazy" decoding="async" onerror="this.remove()" />
                </span>
                <span class="tg-pop-body">
                  <img src={store.badgeUrl} alt="" class="tg-pop-logo" width="40" height="40" loading="lazy" onerror="this.onerror=null; this.src='/brand-icon.webp';" />
                  <span class="tg-pop-text">
                    <span class="tg-pop-name">{store.name}</span>
                    <span class="tg-pop-meta">{store.productCount} productos</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section id="products-section" class="tg-section" aria-labelledby="catalog-heading">
          <div class="tg-toolbar">
            <div>
              <div class="tg-title-row">
                <h2 id="catalog-heading">Catálogo</h2>
                <span id="active-filter-pill" class="hidden tg-filter-pill"></span>
              </div>
              <p id="products-count-badge" class="tg-count">
                Mostrando 1–12 de {allProducts.length} productos (Página 1 de {Math.ceil(allProducts.length / 12)})
              </p>
            </div>

            <div class="tg-controls">
              <div class="tg-pills" role="group" aria-label="Filtrar por tienda">
                <button
                  type="button"
                  data-store-pill="all"
                  data-store-rubro="all"
                  data-store-label="Todas las tiendas"
                  aria-pressed="true"
                  class="store-pill-btn"
                >
                  Todas ({allProducts.length})
                </button>
                {stores.map((s) => (
                  <button
                    type="button"
                    data-store-pill={s.id}
                    data-store-rubro={s.rubroKey}
                    data-store-label={s.name}
                    aria-pressed="false"
                    class="store-pill-btn"
                  >
                    <img src={s.badgeUrl} alt="" width="18" height="18" loading="lazy" onerror="this.remove()" />
                    <span>{s.name} ({s.productCount})</span>
                  </button>
                ))}
              </div>

              <select id="catalog-sort-select" aria-label="Ordenar productos" class="tg-select">
                <option value="relevance">Destacados</option>
                <option value="price-asc">Precio: menor a mayor</option>
                <option value="price-desc">Precio: mayor a menor</option>
                <option value="name-asc">Nombre: A a Z</option>
              </select>

              <select id="catalog-pagesize-select" aria-label="Productos por página" class="tg-select">
                <option value="12">12 por página</option>
                <option value="24">24 por página</option>
                <option value="48">48 por página</option>
              </select>
            </div>
          </div>

          <div id="products-grid" class="tg-products">
            {allProducts.map((p, idx) => (
              <div
                class={`product-item ${idx >= 12 ? 'hidden' : ''}`}
                data-id={p.id}
                data-order={p.originalOrder}
                data-store-id={p.storeId}
                data-store-key={p.storeKey}
                data-rubro={p.rubroKey}
                data-store-name={p.storeName}
                data-name={p.name.toLowerCase()}
                data-title={p.name}
                data-desc={p.desc}
                data-price={p.price}
                data-image={p.image}
                data-store={p.storeName.toLowerCase()}
                data-category={p.category}
              >
                <div class="tg-product-img">
                  <img
                    src={p.image}
                    alt={p.name}
                    width="300"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    onerror="this.onerror=null; this.classList.add('is-broken');"
                  />
                  <span class="tg-product-time tg-glass">{p.time}</span>
                </div>
                <div>
                  <div class="tg-product-store">
                    <img src={p.storeBadge} alt="" width="16" height="16" loading="lazy" onerror="this.remove()" />
                    <span>{p.storeName}</span>
                  </div>
                  <h3 class="tg-product-name">{p.name}</h3>
                </div>
                <div class="tg-product-buy">
                  <div>
                    <span class="tg-price">${p.price.toFixed(2)}</span>
                    <span class="tg-price-bs">{p.priceBs}</span>
                  </div>
                  <button type="button" aria-label={`Agregar ${p.name} al carrito`} class="btn-home-add">+</button>
                </div>
              </div>
            ))}
          </div>

          <div id="pagination-container" class="tg-pagination">
            <div id="pagination-summary">
              Página 1 de {Math.ceil(allProducts.length / 12)}, {allProducts.length} artículos en total
            </div>
            <div class="tg-page-btns" id="pagination-buttons"></div>
          </div>

          <div id="no-products-msg" class="hidden tg-empty">
            <h3>No encontramos productos con ese filtro</h3>
            <button id="btn-reset-filters" type="button" class="tg-btn tg-btn--primary tg-btn--sm">
              Ver los {allProducts.length} productos
            </button>
          </div>
        </section>

        <section id="stores" class="tg-section" aria-labelledby="stores-section-heading">
          <div class="tg-head">
            <div>
              <h2 id="stores-section-heading">Todas las tiendas</h2>
              <p id="stores-section-subtitle">Entra a la tienda o mira sus productos en el catálogo.</p>
            </div>
            <span id="stores-active-badge" class="tg-filter-pill">{stores.length} abiertas ahora</span>
          </div>

          <div id="stores-grid" class="tg-stores">
            {stores.map(store => (
              <article
                class="store-item"
                data-name={store.name.toLowerCase()}
                data-desc={(store.description || '').toLowerCase()}
                data-rubro={store.rubroKey}
                data-store-key={store.id}
              >
                <a href={`/stores/${store.id}`} class="tg-store-cover" tabindex="-1" aria-hidden="true">
                  <img src={store.bannerUrl} alt="" width="640" height="320" loading="lazy" decoding="async" onerror="this.remove()" />
                  <span class="tg-cover-tag tg-glass">Abierto ahora</span>
                </a>
                <div class="tg-store-body">
                  <div class="tg-store-id">
                    <img src={store.badgeUrl} alt={`Logo de ${store.name}`} class="tg-store-logo" width="64" height="64" loading="lazy" onerror="this.onerror=null; this.src='/brand-icon.webp';" />
                    <a href={`/stores/${store.id}`}>
                      <h3>{store.name}</h3>
                      <p class="tg-store-desc">{store.verticalLabel}</p>
                    </a>
                  </div>
                  <dl class="tg-store-facts">
                    <div><dt>Entrega</dt><dd>15 a 25 min</dd></div>
                    <div><dt>Envío</dt><dd>$1.50</dd></div>
                    <div><dt>Valoración</dt><dd>4.9</dd></div>
                    <div><dt>Productos</dt><dd>{store.productCount}</dd></div>
                  </dl>
                  <div class="tg-store-actions">
                    <button
                      type="button"
                      data-filter-store={store.id}
                      data-filter-rubro={store.rubroKey}
                      class="btn-store-quickfilter tg-btn tg-btn--sm"
                    >
                      Ver sus {store.productCount} productos
                    </button>
                    <a href={`/stores/${store.id}`} class="tg-btn tg-btn--primary tg-btn--sm">Entrar a la tienda</a>
                  </div>
                </div>
              </article>
            ))}
            <div class="tg-sell">
              <h3>¿Tienes un negocio en Higuerote?</h3>
              <p>Vende en Traigalo y recibe pedidos con repartidores de la zona.</p>
              <a href="/vendor" class="tg-btn tg-btn--quiet tg-btn--sm">Registrar mi comercio</a>
            </div>
          </div>

          <div id="empty-rubro-stores-card" class="hidden tg-empty">
            <span id="empty-rubro-icon" hidden></span>
            <h3 id="empty-rubro-title">Aún no hay comercios abiertos en este rubro en tu zona</h3>
            <p>En este momento no hay comercios activos en esta categoría en tu zona de entrega. Puedes explorar todos los comercios abiertos o afiliar tu negocio hoy mismo.</p>
            <div class="tg-empty-actions">
              <button id="btn-empty-rubro-show-all" type="button" class="tg-btn tg-btn--primary tg-btn--sm">
                Ver los {stores.length} comercios abiertos
              </button>
              <a href="/vendor" class="tg-btn tg-btn--quiet tg-btn--sm">Registrar mi comercio en Traigalo</a>
            </div>
          </div>
        </section>

      </main>

      <div id="home-product-modal" class="tg-modal opacity-0 pointer-events-none" role="dialog" aria-modal="true" aria-labelledby="home-modal-title">
        <div id="home-modal-card" class="tg-modal-card translate-y-full sm:translate-y-4">
          <div class="tg-row">
            <span id="home-modal-store" class="tg-store-chip">Tienda oficial</span>
            <button id="home-close-modal" type="button" class="tg-close" aria-label="Cerrar">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="tg-modal-body">
            <div class="tg-modal-img">
              <img id="home-modal-img" src={FALLBACK_PRODUCT_IMAGE} alt="" />
            </div>
            <div>
              <h2 id="home-modal-title"></h2>
              <p id="home-modal-desc" class="tg-modal-desc"></p>
            </div>
            <div class="tg-row">
              <span class="tg-field-label">Cantidad</span>
              <div class="tg-qty">
                <button id="home-qty-minus" type="button" aria-label="Quitar uno">−</button>
                <span id="home-qty-display" aria-live="polite">1</span>
                <button id="home-qty-plus" type="button" aria-label="Agregar uno">+</button>
              </div>
            </div>
            <div>
              <label for="home-modal-notes" class="tg-field-label">Especificaciones (color, modelo, nota)</label>
              <input id="home-modal-notes" type="text" placeholder="Ej. color negro, empaque para regalo" class="tg-input" />
            </div>
            <div class="tg-row tg-divide">
              <span class="tg-field-label">Subtotal</span>
              <div>
                <span id="home-modal-price" class="tg-modal-price"></span>
                <span id="home-modal-price-bs" class="tg-price-bs"></span>
              </div>
            </div>
          </div>
          <div class="tg-modal-foot">
            <a id="home-modal-store-link" href="/" class="tg-btn tg-btn--quiet">Ir a la tienda</a>
            <button id="home-modal-add-btn" type="button" class="tg-btn tg-btn--primary">Agregar al carrito</button>
          </div>
        </div>
      </div>

      <div id="home-cart-bar" class="tg-cartbar opacity-0 translate-y-4 pointer-events-none">
        <a href="/checkout">
          <span class="tg-cart-left">
            <span id="home-cart-count" class="tg-cart-count">0</span>
            <span>
              <span>Ver carrito</span>
              <small id="home-cart-stores">Listo para pagar</small>
            </span>
          </span>
          <span class="tg-cart-total">
            <span id="home-cart-total">$0.00</span>
            <small id="home-cart-total-bs"></small>
          </span>
        </a>
      </div>

      <Footer />
      <BottomNav />
    </div>

    <script is:inline define:vars={{ bcvRate }}>
    (() => {
      try {
        if (!localStorage.getItem('traigalo_location')) {
          location.replace('/bienvenida');
          return;
        }
      } catch {}

      window.addEventListener('traigalo:rubro-changed', (e) => {
        const rubro = e.detail?.rubro || 'all';
        const popSection = document.getElementById('popular-stores');
        const popHeading = document.getElementById('popular-heading');
        const activeDoor = document.querySelector(`.rubro-card[data-rubro-filter="${rubro}"]`);
        const doorTitle = activeDoor ? activeDoor.getAttribute('data-rubro-title') : '';
        let visiblePop = 0;
        document.querySelectorAll('.tg-pop-store').forEach((el) => {
          const show = rubro === 'all' || el.getAttribute('data-rubro') === rubro;
          el.classList.toggle('hidden', !show);
          if (show) visiblePop++;
        });
        if (popHeading) popHeading.textContent = rubro === 'all' ? 'Tiendas populares' : `Tiendas en ${doorTitle}`;
        if (popSection) popSection.classList.toggle('hidden', visiblePop === 0);
        try {
          const url = new URL(window.location.href);
          if (rubro === 'all') url.searchParams.delete('rubro');
          else url.searchParams.set('rubro', rubro);
          history.replaceState(history.state, '', url.toString());
        } catch {}
      });

      const CART_STORAGE_KEY = 'traigalo_cart';
      let currentRubro = 'all';
      let currentFilterCategory = 'all';
      let currentFilterStore = 'all';
      let currentSearchQuery = '';
      let currentSort = 'relevance';
      let currentPage = 1;
      let pageSize = 12;

      const productsGrid = document.getElementById('products-grid');
      const allProductNodes = Array.from(document.querySelectorAll('.product-item'));

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateHomeCartBar();
      }

      function addToCart(product, quantity = 1, notes = '') {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id && (item.notes || '') === notes);
        if (existing) {
          existing.qty = (existing.qty || 1) + quantity;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId,
            storeName: product.storeName || 'Tienda Oficial',
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: quantity,
            notes: notes
          });
        }
        saveCart(cart);
      }

      function updateHomeCartBar() {
        const cart = getCart();
        const bar = document.getElementById('home-cart-bar');
        const countEl = document.getElementById('home-cart-count');
        const storesEl = document.getElementById('home-cart-stores');
        const totalEl = document.getElementById('home-cart-total');
        const totalBsEl = document.getElementById('home-cart-total-bs');
        if (!bar || !countEl || !totalEl) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);
        const distinctStores = [...new Set(cart.map(i => i.storeName).filter(Boolean))];

        if (totalQty > 0) {
          countEl.textContent = String(totalQty);
          totalEl.textContent = `$${totalPrice.toFixed(2)}`;
          if (totalBsEl) totalBsEl.textContent = formatBsClient(totalPrice);
          if (storesEl) {
            storesEl.textContent = distinctStores.length > 1
              ? `${distinctStores.length} tiendas (${distinctStores.join(' + ')})`
              : (distinctStores[0] || 'Entrega Express');
          }
          bar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.add('opacity-100', 'translate-y-0');
        } else {
          bar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      function syncStorePillsUI() {
        document.querySelectorAll('.store-pill-btn').forEach((btn) => {
          const k = btn.getAttribute('data-store-pill');
          btn.setAttribute('aria-pressed', k === currentFilterStore ? 'true' : 'false');
        });
      }

      function syncRubroUI() {
        const clearBtn = document.getElementById('btn-clear-rubro');
        if (clearBtn) {
          if (currentRubro === 'all') clearBtn.classList.add('hidden');
          else clearBtn.classList.remove('hidden');
        }

        document.querySelectorAll('.rubro-card').forEach((card) => {
          const rKey = card.getAttribute('data-rubro-filter');
          card.setAttribute('aria-pressed', rKey === currentRubro ? 'true' : 'false');
        });

        document.documentElement.setAttribute('data-rubro', currentRubro);
        const moduleCard = document.querySelector(`.rubro-card[data-rubro-filter="${currentRubro}"]`);
        const moduleTitle = document.getElementById('module-head-title');
        const moduleLead = document.getElementById('module-head-lead');
        if (moduleCard && moduleTitle) moduleTitle.textContent = moduleCard.getAttribute('data-rubro-title') || '';
        if (moduleCard && moduleLead) moduleLead.textContent = moduleCard.getAttribute('data-rubro-lead') || '';
        window.dispatchEvent(new CustomEvent('traigalo:rubro-changed', { detail: { rubro: currentRubro } }));

        const storeItems = document.querySelectorAll('.store-item');
        const emptyRubroCard = document.getElementById('empty-rubro-stores-card');
        const emptyRubroTitle = document.getElementById('empty-rubro-title');
        const emptyRubroIcon = document.getElementById('empty-rubro-icon');
        let visibleStores = 0;

        storeItems.forEach((st) => {
          const stRubro = st.getAttribute('data-rubro') || '';
          if (currentRubro === 'all' || stRubro === currentRubro) {
            st.classList.remove('hidden');
            visibleStores++;
          } else {
            st.classList.add('hidden');
          }
        });

        const activeCard = document.querySelector(`.rubro-card[data-rubro-filter="${currentRubro}"]`);
        const rubroTitle = activeCard ? activeCard.getAttribute('data-rubro-title') : 'este rubro';
        
        if (emptyRubroCard) {
          if (visibleStores === 0 && currentRubro !== 'all') {
            emptyRubroCard.classList.remove('hidden');
            if (emptyRubroTitle) {
              emptyRubroTitle.textContent = `Aún no hay comercios abiertos en "${rubroTitle}" en tu zona`;
            }
            if (emptyRubroIcon) {
              emptyRubroIcon.textContent = '';
            }
          } else {
            emptyRubroCard.classList.add('hidden');
          }
        }
      }

      function renderPaginationControls(totalItems, totalPages) {
        const container = document.getElementById('pagination-container');
        const summary = document.getElementById('pagination-summary');
        const btnWrap = document.getElementById('pagination-buttons');
        if (!container || !summary || !btnWrap) return;

        if (totalItems === 0) {
          container.classList.add('hidden');
          return;
        }
        container.classList.remove('hidden');

        const startIdx = (currentPage - 1) * pageSize + 1;
        const endIdx = Math.min(currentPage * pageSize, totalItems);
        summary.textContent = `Página ${currentPage} de ${totalPages}, mostrando ${startIdx}–${endIdx} de ${totalItems} productos`;

        btnWrap.innerHTML = '';

        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.textContent = 'Anterior';
        prevBtn.disabled = currentPage <= 1;
        prevBtn.className = 'tg-page-btn';
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            filterAndPaginateCatalog(true);
          }
        });
        btnWrap.appendChild(prevBtn);

        for (let p = 1; p <= totalPages; p++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.textContent = String(p);
          pageBtn.className = 'tg-page-btn';
          if (p === currentPage) pageBtn.setAttribute('aria-current', 'page');
          pageBtn.addEventListener('click', () => {
            if (currentPage !== p) {
              currentPage = p;
              filterAndPaginateCatalog(true);
            }
          });
          btnWrap.appendChild(pageBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.textContent = 'Siguiente';
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.className = 'tg-page-btn';
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            filterAndPaginateCatalog(true);
          }
        });
        btnWrap.appendChild(nextBtn);
      }

      function filterAndPaginateCatalog(scrollToGrid = false) {
        const countBadge = document.getElementById('products-count-badge');
        const noProductsMsg = document.getElementById('no-products-msg');
        const activePill = document.getElementById('active-filter-pill');

        const matched = allProductNodes.filter((el) => {
          const name = el.getAttribute('data-name') || '';
          const store = el.getAttribute('data-store') || '';
          const storeKey = el.getAttribute('data-store-key') || '';
          const rubro = el.getAttribute('data-rubro') || '';
          const cat = el.getAttribute('data-category') || '';

          const matchesSearch = !currentSearchQuery ||
            name.includes(currentSearchQuery) ||
            store.includes(currentSearchQuery) ||
            cat.includes(currentSearchQuery);

          const matchesRubro = currentRubro === 'all' || rubro === currentRubro;
          const matchesCategory = currentFilterCategory === 'all' || cat === currentFilterCategory;
          const matchesStore = currentFilterStore === 'all' || storeKey === currentFilterStore || store.includes(currentFilterStore);

          return matchesSearch && matchesRubro && matchesCategory && matchesStore;
        });

        matched.sort((a, b) => {
          if (currentSort === 'price-asc') {
            return parseFloat(a.getAttribute('data-price') || '0') - parseFloat(b.getAttribute('data-price') || '0');
          }
          if (currentSort === 'price-desc') {
            return parseFloat(b.getAttribute('data-price') || '0') - parseFloat(a.getAttribute('data-price') || '0');
          }
          if (currentSort === 'name-asc') {
            return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
          }
          return parseInt(a.getAttribute('data-order') || '0', 10) - parseInt(b.getAttribute('data-order') || '0', 10);
        });

        const totalMatched = matched.length;
        const totalPages = Math.max(1, Math.ceil(totalMatched / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = startIdx + pageSize;
        const visibleSet = new Set(matched.slice(startIdx, endIdx));

        allProductNodes.forEach((el) => {
          el.classList.add('hidden');
        });

        if (productsGrid) {
          matched.forEach((el) => {
            productsGrid.appendChild(el);
            if (visibleSet.has(el)) {
              el.classList.remove('hidden');
            }
          });
        }

        if (countBadge) {
          if (totalMatched === 0) {
            countBadge.textContent = '0 productos encontrados con este filtro';
          } else {
            countBadge.textContent = `Mostrando ${startIdx + 1}–${Math.min(endIdx, totalMatched)} de ${totalMatched} productos (Página ${currentPage} de ${totalPages})`;
          }
        }

        if (activePill) {
          const labels = [];
          if (currentRubro !== 'all') {
            const rCard = document.querySelector(`.rubro-card[data-rubro-filter="${currentRubro}"]`);
            if (rCard) labels.push(`Rubro: ${rCard.getAttribute('data-rubro-title')}`);
          }
          if (currentFilterStore !== 'all') {
            const sPill = document.querySelector(`.store-pill-btn[data-store-pill="${currentFilterStore}"]`);
            const sLabel = sPill ? sPill.getAttribute('data-store-label') : currentFilterStore;
            if (sLabel) labels.push(`Tienda: ${sLabel}`);
          }
          if (currentFilterCategory !== 'all') {
            labels.push(`Categoría: ${currentFilterCategory.toUpperCase()}`);
          }
          if (labels.length > 0) {
            activePill.textContent = labels.join(', ');
            activePill.classList.remove('hidden');
          } else {
            activePill.classList.add('hidden');
          }
        }

        if (noProductsMsg) {
          if (totalMatched === 0) {
            noProductsMsg.classList.remove('hidden');
          } else {
            noProductsMsg.classList.add('hidden');
          }
        }

        renderPaginationControls(totalMatched, totalPages);

        if (scrollToGrid) {
          const sec = document.getElementById('products-section');
          if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      const globalSearch = document.getElementById('global-search-input');
      if (globalSearch) {
        globalSearch.addEventListener('input', (e) => {
          currentSearchQuery = e.target.value.trim().toLowerCase();
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      document.querySelectorAll('.rubro-card').forEach((card) => {
        card.addEventListener('click', () => {
          const rKey = card.getAttribute('data-rubro-filter') || 'all';
          currentRubro = rKey;
          currentFilterCategory = 'all';
          currentFilterStore = 'all';

          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);

          const storesSec = document.getElementById('stores');
          if (storesSec && rKey !== 'all') {
            storesSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      const clearRubroBtn = document.getElementById('btn-clear-rubro');
      const emptyShowAllBtn = document.getElementById('btn-empty-rubro-show-all');
      [clearRubroBtn, emptyShowAllBtn].forEach((btn) => {
        if (btn) {
          btn.addEventListener('click', () => {
            currentRubro = 'all';
            currentFilterStore = 'all';
            currentFilterCategory = 'all';
            currentPage = 1;
            syncRubroUI();
            syncStorePillsUI();
            filterAndPaginateCatalog(false);
          });
        }
      });

      document.querySelectorAll('.category-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.category-btn').forEach((b) => {
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          currentFilterCategory = btn.getAttribute('data-category') || 'all';
          const catRubro = btn.getAttribute('data-cat-rubro') || 'all';
          if (currentRubro !== 'all' && catRubro !== 'all' && currentRubro !== catRubro) {
            currentRubro = 'all';
            syncRubroUI();
          }
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      });

      document.querySelectorAll('.store-pill-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilterStore = btn.getAttribute('data-store-pill') || 'all';
          currentRubro = btn.getAttribute('data-store-rubro') || 'all';

          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);
        });
      });

      document.querySelectorAll('.btn-store-quickfilter').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilterStore = btn.getAttribute('data-filter-store') || 'all';
          currentRubro = btn.getAttribute('data-filter-rubro') || 'all';
          currentFilterCategory = 'all';
          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(true);
        });
      });

      const sortSelect = document.getElementById('catalog-sort-select');
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          currentSort = e.target.value || 'relevance';
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      const pageSizeSelect = document.getElementById('catalog-pagesize-select');
      if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', (e) => {
          pageSize = parseInt(e.target.value || '12', 10);
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentRubro = 'all';
          currentFilterCategory = 'all';
          currentFilterStore = 'all';
          currentSearchQuery = '';
          currentSort = 'relevance';
          currentPage = 1;
          if (globalSearch) globalSearch.value = '';
          if (sortSelect) sortSelect.value = 'relevance';
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);
        });
      }

      const catBar = document.getElementById('categories-bar');
      const scrollLeftBtn = document.getElementById('cat-scroll-left');
      const scrollRightBtn = document.getElementById('cat-scroll-right');
      if (catBar && scrollLeftBtn && scrollRightBtn) {
        scrollLeftBtn.addEventListener('click', () => catBar.scrollBy({ left: -280, behavior: 'smooth' }));
        scrollRightBtn.addEventListener('click', () => catBar.scrollBy({ left: 280, behavior: 'smooth' }));
      }

      const modal = document.getElementById('home-product-modal');
      const modalCard = document.getElementById('home-modal-card');
      const modalStore = document.getElementById('home-modal-store');
      const modalImg = document.getElementById('home-modal-img');
      const modalTitle = document.getElementById('home-modal-title');
      const modalDesc = document.getElementById('home-modal-desc');
      const modalPrice = document.getElementById('home-modal-price');
      const modalPriceBs = document.getElementById('home-modal-price-bs');
      const modalQtyDisplay = document.getElementById('home-qty-display');
      const modalQtyMinus = document.getElementById('home-qty-minus');
      const modalQtyPlus = document.getElementById('home-qty-plus');
      const modalNotes = document.getElementById('home-modal-notes');
      const modalAddBtn = document.getElementById('home-modal-add-btn');
      const modalStoreLink = document.getElementById('home-modal-store-link');
      const closeModalBtn = document.getElementById('home-close-modal');

      let activeProduct = null;
      let activeQty = 1;

      function refreshModalTotals() {
        if (!activeProduct) return;
        const sub = Number(activeProduct.price) * activeQty;
        if (modalPrice) modalPrice.textContent = `$${sub.toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(sub);
        if (modalQtyDisplay) modalQtyDisplay.textContent = String(activeQty);
      }

      function openHomeModal(prod) {
        activeProduct = prod;
        activeQty = 1;
        if (modalNotes) modalNotes.value = '';
        if (modalStore) modalStore.textContent = prod.storeName;
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        if (modalStoreLink) modalStoreLink.href = `/stores/${prod.storeId}`;
        refreshModalTotals();

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeHomeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        activeProduct = null;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeHomeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeHomeModal();
        });
      }
      if (modalQtyMinus) {
        modalQtyMinus.addEventListener('click', () => {
          if (activeQty > 1) {
            activeQty--;
            refreshModalTotals();
          }
        });
      }
      if (modalQtyPlus) {
        modalQtyPlus.addEventListener('click', () => {
          if (activeQty < 99) {
            activeQty++;
            refreshModalTotals();
          }
        });
      }
      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (activeProduct) {
            const notes = modalNotes ? modalNotes.value.trim() : '';
            addToCart(activeProduct, activeQty, notes);
            closeHomeModal();
          }
        });
      }

      allProductNodes.forEach((card) => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          storeName: card.getAttribute('data-store-name'),
          name: card.getAttribute('data-title'),
          desc: card.getAttribute('data-desc'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image')
        };

        const addBtn = card.querySelector('.btn-home-add');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod, 1, '');
            addBtn.textContent = '✓';
            addBtn.classList.add('is-added');
            setTimeout(() => {
              addBtn.textContent = '+';
              addBtn.classList.remove('is-added');
            }, 800);
          });
        }

        card.addEventListener('click', () => {
          openHomeModal(prod);
        });
      });

      window.addEventListener('traigalo:select-rubro', (e) => {
        const key = e.detail?.rubro || 'all';
        const targetCard = document.querySelector(`.rubro-card[data-rubro-filter="${key}"]`);
        if (targetCard) targetCard.click();
      });

      const urlParams = new URLSearchParams(window.location.search);
      const rubroParam = urlParams.get('rubro');
      if (rubroParam) {
        const targetCard = document.querySelector(`.rubro-card[data-rubro-filter="${rubroParam}"]`);
        if (targetCard) {
          targetCard.click();
        } else {
          filterAndPaginateCatalog(false);
        }
      } else {
        filterAndPaginateCatalog(false);
      }

      updateHomeCartBar();
    })();
    </script>
  </body>
</html>
