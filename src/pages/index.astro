---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import '../styles/global.css';

const API_BASE = 'http://api.44.217.190.140.sslip.io/v2';
const ASSET_BASE = 'http://directus.44.217.190.140.sslip.io/assets';

let stores = [];
let popularProducts = [];
let assetMap = {};

try {
  const assetModule = await import('../data/directus_assets.json');
  assetMap = assetModule.default || {};
} catch (e) {}

try {
  const storesRes = await fetch(`${API_BASE}/stores`);
  if (storesRes.ok) {
    stores = await storesRes.json();
  }
} catch (e) {}

const defaultCovers = {
  'WILY VIDEO': 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=700&q=80',
  'El Sitio del Barbero': 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=700&q=80',
  'Burger Crave': 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=700&q=80',
  'Sushi Omakase Roll': 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=700&q=80'
};

const wilyStore = stores.find(s => s.name.includes('WILY'));
if (wilyStore) {
  try {
    const prodRes = await fetch(`${API_BASE}/stores/${wilyStore.id}/products`);
    if (prodRes.ok) {
      const items = await prodRes.json();
      popularProducts = items.slice(0, 8).map(it => {
        const fileId = assetMap[it.name];
        return {
          id: it.id,
          storeId: wilyStore.id,
          name: it.name,
          storeName: wilyStore.name,
          price: it.base_price,
          rating: '4.9',
          time: '15-20 min',
          image: fileId ? `${ASSET_BASE}/${fileId}` : 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80'
        };
      });
    }
  } catch (e) {}
}

const categories = [
  { id: '1', name: 'Todo', icon: '⚡', active: true },
  { id: '2', name: 'Tecnología', icon: '🎧', active: false },
  { id: '3', name: 'Barbería', icon: '💈', active: false },
  { id: '4', name: 'Comida', icon: '🍔', active: false },
  { id: '5', name: 'Bebidas', icon: '🥤', active: false },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Tiendas y Delivery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-2xl mx-auto px-4 py-4 w-full space-y-6">
      
      <!-- HERO BANNER -->
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#FF7A00] to-[#FFA726] p-5 shadow-lg shadow-orange-500/15 text-white">
        <div class="relative z-10 max-w-[70%]">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider mb-1.5">
            Llegó Traigalo
          </span>
          <h2 class="text-xl font-black leading-tight tracking-tight mb-1">
            Lo que quieras, a tu puerta
          </h2>
          <p class="text-xs text-orange-50 leading-relaxed mb-3">
            Tecnología, cuidado personal y restaurantes de tu ciudad.
          </p>
          <a href="#stores" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-[#FF7A00] text-xs font-black shadow-md hover:bg-orange-50 active:scale-95 transition-all">
            <span>Explorar Tiendas</span>
            <span>→</span>
          </a>
        </div>
        <div class="absolute -right-4 -bottom-6 w-36 h-36 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
        <div class="absolute right-4 bottom-2 text-6xl select-none opacity-90 drop-shadow-md">
          🛵
        </div>
      </section>

      <!-- HORIZONTAL CATEGORIES -->
      <section>
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-base font-extrabold text-gray-900 tracking-tight">Categorías</h2>
          <span class="text-xs font-bold text-[#FF7A00]">{stores.length} tiendas</span>
        </div>
        <div class="flex gap-2.5 overflow-x-auto pb-2 scrollbar-none -mx-4 px-4">
          {categories.map(c => (
            <button class={`shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-extrabold transition-all active:scale-95 ${
              c.active
                ? 'bg-[#FF7A00] text-white shadow-md shadow-orange-500/20'
                : 'bg-white text-gray-700 border border-gray-100 hover:border-orange-200 shadow-2xs'
            }`}>
              <span class="text-base">{c.icon}</span>
              <span>{c.name}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- POPULAR PRODUCTS WITH OWN S3/DIRECTUS ASSETS -->
      <section>
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 class="text-base font-extrabold text-gray-900 tracking-tight">Productos Destacados</h2>
            <p class="text-[11px] text-gray-400">Desde WILY VIDEO & tiendas oficiales</p>
          </div>
          <span class="text-xs font-bold text-[#FF7A00]">Ver todos</span>
        </div>

        <div class="grid grid-cols-2 gap-3.5">
          {popularProducts.map(p => (
            <div class="bg-white rounded-3xl p-3 border border-gray-100 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
              <div class="relative w-full aspect-square rounded-2xl bg-gray-50 overflow-hidden mb-2.5 flex items-center justify-center p-2">
                <img 
                  src={p.image} 
                  alt={p.name}
                  loading="lazy"
                  class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300"
                  onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80'"
                />
                <span class="absolute top-2 left-2 px-2 py-0.5 rounded-lg bg-white/95 backdrop-blur-md text-[9px] font-black text-gray-800 shadow-2xs">
                  {p.time}
                </span>
              </div>

              <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider truncate">{p.storeName}</p>
                <h3 class="text-xs font-bold text-gray-900 line-clamp-2 leading-tight mt-0.5 min-h-[2rem]">
                  {p.name}
                </h3>
              </div>

              <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-50">
                <span class="text-sm font-black text-gray-950">${p.price.toFixed(2)}</span>
                <a 
                  href={`/stores/${p.storeId}`}
                  class="w-8 h-8 rounded-full bg-[#FF7A00] text-white flex items-center justify-center shadow-md shadow-orange-500/25 active:scale-90 transition-transform font-black text-base"
                >
                  +
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- STORES SECTION (CANONICAL POSTGRESQL + POSTGIS) -->
      <section id="stores" class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-extrabold text-gray-900 tracking-tight">Tiendas Oficiales</h2>
            <p class="text-[11px] text-gray-400">PostgreSQL 16 + PostGIS en Vivo</p>
          </div>
          <span class="text-xs font-bold text-emerald-600">● 100% Operativas</span>
        </div>

        <div class="space-y-3">
          {stores.map(store => (
            <a 
              href={`/stores/${store.id}`}
              class="block bg-white rounded-3xl p-4 border border-gray-100 shadow-sm hover:shadow-md transition-all active:scale-[0.99]"
            >
              <div class="flex items-center gap-3.5">
                <div class="w-16 h-16 rounded-2xl bg-gray-100 overflow-hidden shrink-0 border border-gray-100">
                  <img 
                    src={defaultCovers[store.name] || 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=300&q=80'} 
                    alt={store.name}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-extrabold text-gray-900 truncate">{store.name}</h3>
                    {store.is_open && (
                      <span class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.2 rounded-md">Abierto</span>
                    )}
                  </div>
                  <p class="text-xs text-gray-500 truncate mt-0.5">{store.address_line}</p>
                  <div class="flex items-center gap-3 mt-1.5 text-[11px] text-gray-400 font-medium">
                    <span class="flex items-center gap-1 text-amber-500 font-bold">
                      ★ 4.9
                    </span>
                    <span>•</span>
                    <span>15-25 min</span>
                    <span>•</span>
                    <span class="text-emerald-600 font-bold">Envío Express</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </main>

    <BottomNav />
  </body>
</html>
