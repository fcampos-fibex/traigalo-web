---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../adapters/rates';
import '../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';

const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
let assetMap: Record<string, string> = {};
let dbCategories: any[] = [];
let allProducts: any[] = [];

try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

try {
  const catModule = await import('../data/categories.json');
  dbCategories = (catModule.default || []).slice(0, 12);
} catch {}

try {
  const storesRes = await fetch(`${API_BASE}/stores`);
  if (storesRes.ok) {
    const list = await storesRes.json();
    stores = Array.isArray(list) ? list.filter((s: any) => s.is_open !== false) : [];
  }
} catch {}

for (const store of stores) {
  try {
    const prodRes = await fetch(`${API_BASE}/stores/${store.id}/products`);
    if (prodRes.ok) {
      const items = await prodRes.json();
      const mapped = items.map((it: any) => {
        let img = '';
        if (it.attributes?.image_url) {
          img = it.attributes.image_url;
        } else if (it.attributes?.asset_id) {
          img = `${ASSET_BASE}/${it.attributes.asset_id}`;
        } else if (assetMap[it.name]) {
          img = `${ASSET_BASE}/${assetMap[it.name]}`;
        } else {
          img = `${ASSET_BASE}/e20f2cbd-295f-41ad-be33-56517ab5eff2`;
        }

        const price = Number(it.base_price) || 0;
        return {
          id: it.id,
          storeId: store.id,
          name: it.name,
          storeName: store.name,
          price: price,
          priceBs: formatBs(price, bcvRate),
          rating: '4.9',
          time: '15-20 min',
          image: img
        };
      });
      allProducts.push(...mapped);
    }
  } catch {}
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Tiendas y Delivery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-8">
      
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#FF7A00] via-[#FF8A1E] to-[#FFA726] p-6 sm:p-10 lg:p-12 shadow-xl shadow-orange-500/15 text-white">
        <div class="relative z-10 max-w-xl">
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-black uppercase tracking-wider mb-2.5">
            Llegó Traigalo
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-2">
            Lo que quieras, a tu puerta
          </h2>
          <p class="text-sm sm:text-base text-orange-50 leading-relaxed mb-5 max-w-md">
            Tecnología, cuidado personal y restaurantes oficiales de tu ciudad con delivery express en tiempo real.
          </p>
          <a href="#stores" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white text-[#FF7A00] text-sm font-black shadow-lg hover:bg-orange-50 active:scale-95 transition-all">
            <span>Explorar Tiendas Oficiales</span>
            <span class="text-base">→</span>
          </a>
        </div>
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="hidden sm:block absolute right-12 bottom-6 text-8xl lg:text-9xl select-none opacity-90 drop-shadow-xl animate-pulse">
          🛵
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Categorías Principales</h2>
          <span class="text-xs sm:text-sm font-bold text-[#FF7A00]">{stores.length} comercios verificados</span>
        </div>
        <div class="flex gap-3 overflow-x-auto pb-2 no-scrollbar" id="categories-bar">
          <button 
            data-category="all"
            class="category-btn shrink-0 flex items-center gap-2.5 px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold bg-[#FF7A00] text-white shadow-md shadow-orange-500/20 active:scale-95 transition-all cursor-pointer"
          >
            <span class="text-base sm:text-lg">⚡</span>
            <span>Todo</span>
          </button>
          {dbCategories.map(c => (
            <button 
              data-category={c.name.toLowerCase()}
              data-slug={c.slug}
              class="category-btn shrink-0 flex items-center gap-2.5 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold bg-white text-gray-800 border border-gray-100 hover:border-orange-300 shadow-2xs active:scale-95 transition-all cursor-pointer"
            >
              <img 
                src={c.image_url} 
                alt={c.name} 
                class="w-6 h-6 object-contain rounded-md" 
                onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'24\' height=\'24\' fill=\'none\' stroke=\'%23FF7A00\' stroke-width=\'2\'><rect width=\'22\' height=\'22\' x=\'1\' y=\'1\' rx=\'4\' fill=\'%23FFF3E0\'/><path d=\'M8 12h8M12 8v8\'/></svg>';"
              />
              <span>{c.name}</span>
            </button>
          ))}
        </div>
      </section>

      <section id="products-section">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Productos Destacados</h2>
            <p class="text-xs text-gray-400">Catálogo oficial de tiendas aliadas</p>
          </div>
          <span id="products-count-badge" class="text-xs sm:text-sm font-bold text-[#FF7A00]">
            Mostrando {allProducts.length} productos
          </span>
        </div>

        <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 sm:gap-5">
          {allProducts.map(p => (
            <div 
              class="product-item bg-white rounded-3xl p-3.5 sm:p-4 border border-gray-100 shadow-sm flex flex-col justify-between group hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
              data-name={p.name.toLowerCase()}
              data-store={p.storeName.toLowerCase()}
            >
              <div class="relative w-full aspect-square rounded-2xl bg-[#F8F9FA] overflow-hidden mb-3 flex items-center justify-center p-3">
                <img 
                  src={p.image} 
                  alt={p.name}
                  loading="lazy"
                  class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300"
                  onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'64\' height=\'64\' fill=\'none\' stroke=\'%23FF7A00\' stroke-width=\'2\'><rect width=\'60\' height=\'60\' x=\'2\' y=\'2\' rx=\'12\' fill=\'%23FAFAFC\'/><path d=\'M24 32h16M32 24v16\'/></svg>';"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-white/95 backdrop-blur-md text-[10px] font-black text-gray-800 shadow-2xs">
                  {p.time}
                </span>
              </div>

              <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider truncate">{p.storeName}</p>
                <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 line-clamp-2 leading-snug mt-1 min-h-[2.5rem]">
                  {p.name}
                </h3>
              </div>

              <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-gray-50">
                <div class="flex flex-col">
                  <span class="text-sm sm:text-base font-black text-gray-950">${p.price.toFixed(2)}</span>
                  <span class="text-[9px] text-gray-400 font-semibold">{p.priceBs}</span>
                </div>
                <a 
                  href={`/stores/${p.storeId}`}
                  class="w-9 h-9 rounded-full bg-[#FF7A00] hover:bg-[#E66E00] text-white flex items-center justify-center shadow-md shadow-orange-500/25 active:scale-90 transition-all font-black text-lg"
                >
                  +
                </a>
              </div>
            </div>
          ))}
        </div>

        <div id="no-products-msg" class="hidden text-center py-12">
          <span class="text-3xl block mb-2">🔍</span>
          <p class="text-sm font-bold text-gray-600">No encontramos productos con ese criterio</p>
          <p class="text-xs text-gray-400 mt-1">Intenta con otro término o categoría</p>
        </div>
      </section>

      <section id="stores" class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Tiendas Oficiales</h2>
            <p class="text-xs text-gray-400">Canónico PostgreSQL 16 + PostGIS</p>
          </div>
          <span class="text-xs sm:text-sm font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            ● 100% Operativas
          </span>
        </div>

        <div id="stores-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4">
          {stores.map(store => (
            <a 
              href={`/stores/${store.id}`}
              class="store-item block bg-white rounded-3xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all active:scale-[0.99]"
              data-name={store.name.toLowerCase()}
              data-desc={(store.description || '').toLowerCase()}
            >
              <div class="flex items-center gap-4">
                <div class="w-20 h-20 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-3xl shrink-0 shadow-inner overflow-hidden">
                  {store.logo_url ? (
                    <img src={store.logo_url} alt={store.name} class="w-full h-full object-cover" />
                  ) : store.name.includes('Burger') ? (
                    '🍔'
                  ) : store.name.includes('Barbero') ? (
                    '💈'
                  ) : store.name.includes('Sushi') ? (
                    '🍣'
                  ) : (
                    '🎧'
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-extrabold text-gray-900 truncate">{store.name}</h3>
                    {store.is_open && (
                      <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">Abierto</span>
                    )}
                  </div>
                  <p class="text-xs text-gray-500 truncate mt-1">{store.address_line}</p>
                  <div class="flex items-center gap-3 mt-2 text-xs text-gray-400 font-medium">
                    <span class="flex items-center gap-1 text-amber-500 font-bold">
                      ★ 4.9
                    </span>
                    <span>•</span>
                    <span>15-25 min</span>
                    <span>•</span>
                    <span class="text-emerald-600 font-bold">Envío Express</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </main>

    <Footer />
    <BottomNav />

    <script is:inline>
      let currentFilterCategory = 'all';
      let currentSearchQuery = '';

      function filterCatalog() {
        const productItems = document.querySelectorAll('.product-item');
        const storeItems = document.querySelectorAll('.store-item');
        const countBadge = document.getElementById('products-count-badge');
        const noProductsMsg = document.getElementById('no-products-msg');

        let visibleProductsCount = 0;

        productItems.forEach((el) => {
          const name = el.getAttribute('data-name') || '';
          const store = el.getAttribute('data-store') || '';

          const matchesSearch = !currentSearchQuery || 
            name.includes(currentSearchQuery) || 
            store.includes(currentSearchQuery);

          let matchesCategory = true;
          if (currentFilterCategory !== 'all') {
            const cat = currentFilterCategory.toLowerCase();
            if (cat.includes('video') || cat.includes('audio') || cat.includes('celular') || cat.includes('computac') || cat.includes('tecnología') || cat.includes('tecnologia')) {
              matchesCategory = store.includes('wily');
            } else if (cat.includes('barber') || cat.includes('belleza') || cat.includes('cuidado')) {
              matchesCategory = store.includes('barbero');
            } else if (cat.includes('sushi') || cat.includes('asiat')) {
              matchesCategory = store.includes('sushi');
            } else if (cat.includes('comida') || cat.includes('hamburguesa') || cat.includes('burger')) {
              matchesCategory = store.includes('burger') || store.includes('crave');
            } else {
              matchesCategory = name.includes(cat) || store.includes(cat);
            }
          }

          if (matchesSearch && matchesCategory) {
            el.classList.remove('hidden');
            visibleProductsCount++;
          } else {
            el.classList.add('hidden');
          }
        });

        storeItems.forEach((el) => {
          const sName = el.getAttribute('data-name') || '';
          const sDesc = el.getAttribute('data-desc') || '';

          const matchesSearch = !currentSearchQuery || 
            sName.includes(currentSearchQuery) || 
            sDesc.includes(currentSearchQuery);

          if (matchesSearch) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        if (countBadge) {
          countBadge.textContent = `Mostrando ${visibleProductsCount} productos`;
        }

        if (noProductsMsg) {
          if (visibleProductsCount === 0) {
            noProductsMsg.classList.remove('hidden');
          } else {
            noProductsMsg.classList.add('hidden');
          }
        }
      }

      const searchInput = document.getElementById('global-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearchQuery = e.target.value.trim().toLowerCase();
          filterCatalog();
        });
      }

      document.querySelectorAll('.category-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.category-btn').forEach((b) => {
            b.className = 'category-btn shrink-0 flex items-center gap-2.5 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold bg-white text-gray-800 border border-gray-100 hover:border-orange-300 shadow-2xs active:scale-95 transition-all cursor-pointer';
          });

          btn.className = 'category-btn shrink-0 flex items-center gap-2.5 px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold bg-[#FF7A00] text-white shadow-md shadow-orange-500/20 active:scale-95 transition-all cursor-pointer';
          currentFilterCategory = btn.getAttribute('data-category') || 'all';
          filterCatalog();
        });
      });
    </script>
  </body>
</html>
