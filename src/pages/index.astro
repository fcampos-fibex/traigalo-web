    <script is:inline define:vars={{ bcvRate }}>
    (() => {
      const CART_STORAGE_KEY = 'traigalo_cart';
      let currentRubro = 'all';
      let currentFilterCategory = 'all';
      let currentFilterStore = 'all';
      let currentSearchQuery = '';
      let currentSort = 'relevance';
      let currentPage = 1;
      let pageSize = 12;

      const productsGrid = document.getElementById('products-grid');
      const allProductNodes = Array.from(document.querySelectorAll('.product-item'));

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateHomeCartBar();
      }

      function addToCart(product, quantity = 1, notes = '') {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id && (item.notes || '') === notes);
        if (existing) {
          existing.qty = (existing.qty || 1) + quantity;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId,
            storeName: product.storeName || 'Tienda Oficial',
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: quantity,
            notes: notes
          });
        }
        saveCart(cart);
      }

      function updateHomeCartBar() {
        const cart = getCart();
        const bar = document.getElementById('home-cart-bar');
        const countEl = document.getElementById('home-cart-count');
        const storesEl = document.getElementById('home-cart-stores');
        const totalEl = document.getElementById('home-cart-total');
        const totalBsEl = document.getElementById('home-cart-total-bs');
        if (!bar || !countEl || !totalEl) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);
        const distinctStores = [...new Set(cart.map(i => i.storeName).filter(Boolean))];

        if (totalQty > 0) {
          countEl.textContent = String(totalQty);
          totalEl.textContent = `$${totalPrice.toFixed(2)}`;
          if (totalBsEl) totalBsEl.textContent = formatBsClient(totalPrice);
          if (storesEl) {
            storesEl.textContent = distinctStores.length > 1
              ? `${distinctStores.length} tiendas (${distinctStores.join(' + ')})`
              : (distinctStores[0] || 'Entrega Express');
          }
          bar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.add('opacity-100', 'translate-y-0');
        } else {
          bar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          bar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      function syncStorePillsUI() {
        document.querySelectorAll('.store-pill-btn').forEach((btn) => {
          const k = btn.getAttribute('data-store-pill');
          if (k === currentFilterStore) {
            btn.className = 'store-pill-btn px-3 py-1.5 rounded-xl text-xs font-black bg-[#FF7A00] text-white shadow-xs transition-all cursor-pointer flex items-center gap-1.5';
          } else {
            btn.className = 'store-pill-btn px-3 py-1.5 rounded-xl text-xs font-extrabold text-gray-700 hover:text-gray-950 transition-all cursor-pointer flex items-center gap-1.5';
          }
        });
      }

      function syncRubroUI() {
        const clearBtn = document.getElementById('btn-clear-rubro');
        if (clearBtn) {
          if (currentRubro === 'all') clearBtn.classList.add('hidden');
          else clearBtn.classList.remove('hidden');
        }

        document.querySelectorAll('.rubro-card').forEach((card) => {
          const rKey = card.getAttribute('data-rubro-filter');
          if (rKey === currentRubro) {
            card.classList.add('border-[#FF7A00]', 'shadow-md', 'ring-2', 'ring-[#FF7A00]/15');
            card.classList.remove('border-gray-100');
          } else {
            card.classList.remove('border-[#FF7A00]', 'shadow-md', 'ring-2', 'ring-[#FF7A00]/15');
            card.classList.add('border-gray-100');
          }
        });

        const storeItems = document.querySelectorAll('.store-item');
        const emptyRubroCard = document.getElementById('empty-rubro-stores-card');
        const emptyRubroTitle = document.getElementById('empty-rubro-title');
        const emptyRubroIcon = document.getElementById('empty-rubro-icon');
        let visibleStores = 0;

        storeItems.forEach((st) => {
          const stRubro = st.getAttribute('data-rubro') || '';
          if (currentRubro === 'all' || stRubro === currentRubro) {
            st.classList.remove('hidden');
            visibleStores++;
          } else {
            st.classList.add('hidden');
          }
        });

        const activeCard = document.querySelector(`.rubro-card[data-rubro-filter="${currentRubro}"]`);
        const rubroTitle = activeCard ? activeCard.getAttribute('data-rubro-title') : 'este rubro';
        const rubroIcon = activeCard ? activeCard.getAttribute('data-rubro-icon') : '🏬';

        if (emptyRubroCard) {
          if (visibleStores === 0 && currentRubro !== 'all') {
            emptyRubroCard.classList.remove('hidden');
            if (emptyRubroTitle) {
              emptyRubroTitle.textContent = `Aún no hay comercios abiertos en "${rubroTitle}" en tu zona`;
            }
            if (emptyRubroIcon) {
              emptyRubroIcon.textContent = rubroIcon || '🏬';
            }
          } else {
            emptyRubroCard.classList.add('hidden');
          }
        }
      }

      function renderPaginationControls(totalItems, totalPages) {
        const container = document.getElementById('pagination-container');
        const summary = document.getElementById('pagination-summary');
        const btnWrap = document.getElementById('pagination-buttons');
        if (!container || !summary || !btnWrap) return;

        if (totalItems === 0) {
          container.classList.add('hidden');
          return;
        }
        container.classList.remove('hidden');

        const startIdx = (currentPage - 1) * pageSize + 1;
        const endIdx = Math.min(currentPage * pageSize, totalItems);
        summary.textContent = `Página ${currentPage} de ${totalPages} • Mostrando ${startIdx}–${endIdx} de ${totalItems} productos`;

        btnWrap.innerHTML = '';

        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.textContent = '← Anterior';
        prevBtn.disabled = currentPage <= 1;
        prevBtn.className = `px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all ${
          currentPage <= 1
            ? 'bg-gray-100 text-gray-400 cursor-not-allowed'
            : 'bg-gray-100 hover:bg-orange-50 text-gray-800 hover:text-[#FF7A00] cursor-pointer'
        }`;
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            filterAndPaginateCatalog(true);
          }
        });
        btnWrap.appendChild(prevBtn);

        for (let p = 1; p <= totalPages; p++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.textContent = String(p);
          pageBtn.className = p === currentPage
            ? 'w-9 h-9 rounded-xl text-xs font-black bg-[#FF7A00] text-white shadow-md shadow-orange-500/20 cursor-pointer'
            : 'w-9 h-9 rounded-xl text-xs font-extrabold bg-gray-50 hover:bg-orange-50 text-gray-700 hover:text-[#FF7A00] border border-gray-200/80 cursor-pointer transition-all';
          pageBtn.addEventListener('click', () => {
            if (currentPage !== p) {
              currentPage = p;
              filterAndPaginateCatalog(true);
            }
          });
          btnWrap.appendChild(pageBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.textContent = 'Siguiente →';
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.className = `px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all ${
          currentPage >= totalPages
            ? 'bg-gray-100 text-gray-400 cursor-not-allowed'
            : 'bg-gray-100 hover:bg-orange-50 text-gray-800 hover:text-[#FF7A00] cursor-pointer'
        }`;
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            filterAndPaginateCatalog(true);
          }
        });
        btnWrap.appendChild(nextBtn);
      }

      function filterAndPaginateCatalog(scrollToGrid = false) {
        const countBadge = document.getElementById('products-count-badge');
        const noProductsMsg = document.getElementById('no-products-msg');
        const activePill = document.getElementById('active-filter-pill');

        const matched = allProductNodes.filter((el) => {
          const name = el.getAttribute('data-name') || '';
          const store = el.getAttribute('data-store') || '';
          const storeKey = el.getAttribute('data-store-key') || '';
          const rubro = el.getAttribute('data-rubro') || '';
          const cat = el.getAttribute('data-category') || '';

          const matchesSearch = !currentSearchQuery ||
            name.includes(currentSearchQuery) ||
            store.includes(currentSearchQuery) ||
            cat.includes(currentSearchQuery);

          const matchesRubro = currentRubro === 'all' || rubro === currentRubro;
          const matchesCategory = currentFilterCategory === 'all' || cat === currentFilterCategory;
          const matchesStore = currentFilterStore === 'all' || storeKey === currentFilterStore || store.includes(currentFilterStore);

          return matchesSearch && matchesRubro && matchesCategory && matchesStore;
        });

        matched.sort((a, b) => {
          if (currentSort === 'price-asc') {
            return parseFloat(a.getAttribute('data-price') || '0') - parseFloat(b.getAttribute('data-price') || '0');
          }
          if (currentSort === 'price-desc') {
            return parseFloat(b.getAttribute('data-price') || '0') - parseFloat(a.getAttribute('data-price') || '0');
          }
          if (currentSort === 'name-asc') {
            return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
          }
          return parseInt(a.getAttribute('data-order') || '0', 10) - parseInt(b.getAttribute('data-order') || '0', 10);
        });

        const totalMatched = matched.length;
        const totalPages = Math.max(1, Math.ceil(totalMatched / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = startIdx + pageSize;
        const visibleSet = new Set(matched.slice(startIdx, endIdx));

        allProductNodes.forEach((el) => {
          el.classList.add('hidden');
        });

        if (productsGrid) {
          matched.forEach((el) => {
            productsGrid.appendChild(el);
            if (visibleSet.has(el)) {
              el.classList.remove('hidden');
            }
          });
        }

        if (countBadge) {
          if (totalMatched === 0) {
            countBadge.textContent = '0 productos encontrados con este filtro';
          } else {
            countBadge.textContent = `Mostrando ${startIdx + 1}–${Math.min(endIdx, totalMatched)} de ${totalMatched} productos (Página ${currentPage} de ${totalPages})`;
          }
        }

        if (activePill) {
          const labels = [];
          if (currentRubro !== 'all') {
            const rCard = document.querySelector(`.rubro-card[data-rubro-filter="${currentRubro}"]`);
            if (rCard) labels.push(`Rubro: ${rCard.getAttribute('data-rubro-title')}`);
          }
          if (currentFilterStore !== 'all') {
            labels.push(currentFilterStore === 'wily' ? 'Tienda: WILY VIDEO' : 'Tienda: El Sitio del Barbero');
          }
          if (currentFilterCategory !== 'all') {
            labels.push(`Categoría: ${currentFilterCategory.toUpperCase()}`);
          }
          if (labels.length > 0) {
            activePill.textContent = labels.join(' • ');
            activePill.classList.remove('hidden');
          } else {
            activePill.classList.add('hidden');
          }
        }

        if (noProductsMsg) {
          if (totalMatched === 0) {
            noProductsMsg.classList.remove('hidden');
          } else {
            noProductsMsg.classList.add('hidden');
          }
        }

        renderPaginationControls(totalMatched, totalPages);

        if (scrollToGrid) {
          const sec = document.getElementById('products-section');
          if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      const globalSearch = document.getElementById('global-search-input');
      if (globalSearch) {
        globalSearch.addEventListener('input', (e) => {
          currentSearchQuery = e.target.value.trim().toLowerCase();
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      document.querySelectorAll('.rubro-card').forEach((card) => {
        card.addEventListener('click', () => {
          const rKey = card.getAttribute('data-rubro-filter') || 'all';
          currentRubro = rKey;
          currentFilterCategory = 'all';
          if (rKey === 'tecnologia') currentFilterStore = 'wily';
          else if (rKey === 'barberia') currentFilterStore = 'barbero';
          else currentFilterStore = 'all';

          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);

          const storesSec = document.getElementById('stores');
          if (storesSec && rKey !== 'all') {
            storesSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      const clearRubroBtn = document.getElementById('btn-clear-rubro');
      const emptyShowAllBtn = document.getElementById('btn-empty-rubro-show-all');
      [clearRubroBtn, emptyShowAllBtn].forEach((btn) => {
        if (btn) {
          btn.addEventListener('click', () => {
            currentRubro = 'all';
            currentFilterStore = 'all';
            currentFilterCategory = 'all';
            currentPage = 1;
            syncRubroUI();
            syncStorePillsUI();
            filterAndPaginateCatalog(false);
          });
        }
      });

      document.querySelectorAll('.category-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.category-btn').forEach((b) => {
            b.className = 'category-btn shrink-0 flex items-center gap-3 p-2 pr-4 rounded-2xl text-xs sm:text-sm font-extrabold bg-white text-gray-800 border-2 border-gray-100 hover:border-orange-300 shadow-2xs transition-all cursor-pointer active:scale-95';
          });
          btn.className = 'category-btn shrink-0 flex items-center gap-3 p-2 pr-4 rounded-2xl text-xs sm:text-sm font-extrabold bg-[#FF7A00] text-white border-2 border-[#FF7A00] shadow-md shadow-orange-500/20 transition-all cursor-pointer active:scale-95';
          currentFilterCategory = btn.getAttribute('data-category') || 'all';
          if (currentRubro !== 'all' && currentRubro !== 'tecnologia' && currentRubro !== 'barberia') {
            currentRubro = 'all';
            syncRubroUI();
          }
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      });

      document.querySelectorAll('.store-pill-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilterStore = btn.getAttribute('data-store-pill') || 'all';
          if (currentFilterStore === 'wily') currentRubro = 'tecnologia';
          else if (currentFilterStore === 'barbero') currentRubro = 'barberia';
          else currentRubro = 'all';

          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);
        });
      });

      document.querySelectorAll('.btn-store-quickfilter').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilterStore = btn.getAttribute('data-filter-store') || 'all';
          currentRubro = btn.getAttribute('data-filter-rubro') || 'all';
          currentFilterCategory = 'all';
          currentPage = 1;
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(true);
        });
      });

      const sortSelect = document.getElementById('catalog-sort-select');
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          currentSort = e.target.value || 'relevance';
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      const pageSizeSelect = document.getElementById('catalog-pagesize-select');
      if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', (e) => {
          pageSize = parseInt(e.target.value || '12', 10);
          currentPage = 1;
          filterAndPaginateCatalog(false);
        });
      }

      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentRubro = 'all';
          currentFilterCategory = 'all';
          currentFilterStore = 'all';
          currentSearchQuery = '';
          currentSort = 'relevance';
          currentPage = 1;
          if (globalSearch) globalSearch.value = '';
          if (sortSelect) sortSelect.value = 'relevance';
          syncRubroUI();
          syncStorePillsUI();
          filterAndPaginateCatalog(false);
        });
      }

      const catBar = document.getElementById('categories-bar');
      const scrollLeftBtn = document.getElementById('cat-scroll-left');
      const scrollRightBtn = document.getElementById('cat-scroll-right');
      if (catBar && scrollLeftBtn && scrollRightBtn) {
        scrollLeftBtn.addEventListener('click', () => catBar.scrollBy({ left: -280, behavior: 'smooth' }));
        scrollRightBtn.addEventListener('click', () => catBar.scrollBy({ left: 280, behavior: 'smooth' }));
      }

      const modal = document.getElementById('home-product-modal');
      const modalCard = document.getElementById('home-modal-card');
      const modalStore = document.getElementById('home-modal-store');
      const modalImg = document.getElementById('home-modal-img');
      const modalTitle = document.getElementById('home-modal-title');
      const modalDesc = document.getElementById('home-modal-desc');
      const modalPrice = document.getElementById('home-modal-price');
      const modalPriceBs = document.getElementById('home-modal-price-bs');
      const modalQtyDisplay = document.getElementById('home-qty-display');
      const modalQtyMinus = document.getElementById('home-qty-minus');
      const modalQtyPlus = document.getElementById('home-qty-plus');
      const modalNotes = document.getElementById('home-modal-notes');
      const modalAddBtn = document.getElementById('home-modal-add-btn');
      const modalStoreLink = document.getElementById('home-modal-store-link');
      const closeModalBtn = document.getElementById('home-close-modal');

      let activeProduct = null;
      let activeQty = 1;

      function refreshModalTotals() {
        if (!activeProduct) return;
        const sub = Number(activeProduct.price) * activeQty;
        if (modalPrice) modalPrice.textContent = `$${sub.toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(sub);
        if (modalQtyDisplay) modalQtyDisplay.textContent = String(activeQty);
      }

      function openHomeModal(prod) {
        activeProduct = prod;
        activeQty = 1;
        if (modalNotes) modalNotes.value = '';
        if (modalStore) modalStore.textContent = prod.storeName;
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        if (modalStoreLink) modalStoreLink.href = `/stores/${prod.storeId}`;
        refreshModalTotals();

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeHomeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        activeProduct = null;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeHomeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeHomeModal();
        });
      }
      if (modalQtyMinus) {
        modalQtyMinus.addEventListener('click', () => {
          if (activeQty > 1) {
            activeQty--;
            refreshModalTotals();
          }
        });
      }
      if (modalQtyPlus) {
        modalQtyPlus.addEventListener('click', () => {
          if (activeQty < 99) {
            activeQty++;
            refreshModalTotals();
          }
        });
      }
      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (activeProduct) {
            const notes = modalNotes ? modalNotes.value.trim() : '';
            addToCart(activeProduct, activeQty, notes);
            closeHomeModal();
          }
        });
      }

      allProductNodes.forEach((card) => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          storeName: card.getAttribute('data-store-name'),
          name: card.getAttribute('data-title'),
          desc: card.getAttribute('data-desc'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image')
        };

        const addBtn = card.querySelector('.btn-home-add');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod, 1, '');
            addBtn.textContent = '✓';
            addBtn.classList.add('bg-emerald-600');
            setTimeout(() => {
              addBtn.textContent = '+';
              addBtn.classList.remove('bg-emerald-600');
            }, 800);
          });
        }

        card.addEventListener('click', () => {
          openHomeModal(prod);
        });
      });

      window.addEventListener('traigalo:select-rubro', (e) => {
        const key = e.detail?.rubro || 'all';
        const targetCard = document.querySelector(`.rubro-card[data-rubro-filter="${key}"]`);
        if (targetCard) targetCard.click();
      });

      const urlParams = new URLSearchParams(window.location.search);
      const rubroParam = urlParams.get('rubro');
      if (rubroParam) {
        const targetCard = document.querySelector(`.rubro-card[data-rubro-filter="${rubroParam}"]`);
        if (targetCard) {
          targetCard.click();
        } else {
          filterAndPaginateCatalog(false);
        }
      } else {
        filterAndPaginateCatalog(false);
      }

      updateHomeCartBar();
    })();
    </script>
  </body>
</html>
