---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../adapters/rates';
import '../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
let assetMap: Record<string, string> = {};
let allProducts: any[] = [];

try {
  const assetModule = await import('../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

const EXCLUDED_STORE_SLUGS = ['burger-crave', 'sushi-omakase'];

const NAME_FIXES: Record<string, string> = {
  'Ariculares SZ-771': 'Auriculares SZ-771',
  '5-Sprinng CHEST PULL': '5-Spring Chest Pull',
  'Abdominal musclw': 'Abdominal Muscle Trainer',
  'Aceite de resino': 'Aceite de Ricino',
  'After chave': 'After Shave Profesional',
  'Back pain need hellp': 'Soporte Lumbar Back Pain',
  'Brocha de ljo': 'Brocha de Lujo'
};

function normalizeName(rawName: string): string {
  const trimmed = (rawName || '').trim();
  return NAME_FIXES[trimmed] || trimmed.replace(/\s{2,}/g, ' ');
}

function classifyProductCategory(name: string, storeName: string): string {
  const n = name.toLowerCase();
  const s = storeName.toLowerCase();
  if (n.includes('funda') || n.includes('carcasa') || n.includes('tecno') || n.includes('ufone') || n.includes('phone') || n.includes('móvil') || n.includes('movil')) {
    return 'fundas';
  }
  if (n.includes('gaming') || n.includes('games') || n.includes('mario') || n.includes('batman') || n.includes('iron man') || n.includes('magic q8')) {
    return 'gaming';
  }
  if (n.includes('auricular') || n.includes('audífono') || n.includes('audifono') || n.includes('headset') || n.includes('headphones') || n.includes('stn-28') || s.includes('wily')) {
    return 'audio';
  }
  if (n.includes('training') || n.includes('chest') || n.includes('abdominal') || n.includes('lumbar') || n.includes('back pain')) {
    return 'fitness';
  }
  if (n.includes('cepillo') || n.includes('peine') || n.includes('bigudies')) {
    return 'cepillos';
  }
  if (n.includes('plancha') || n.includes('secador') || n.includes('rizador')) {
    return 'planchas';
  }
  if (n.includes('máquina') || n.includes('maquina') || n.includes('brocha') || n.includes('capa') || n.includes('atomizador') || n.includes('grip') || n.includes('navaja') || n.includes('cuchilla') || n.includes('tijera')) {
    return 'barberia';
  }
  return 'cuidado';
}

try {
  const storesRes = await fetch(`${API_BASE}/stores`);
  if (storesRes.ok) {
    const list = await storesRes.json();
    stores = Array.isArray(list) 
      ? list.filter((s: any) => s.is_open === true && !EXCLUDED_STORE_SLUGS.includes(s.slug)) 
      : [];
  }
} catch {}

stores.sort((a, b) => (a.name.includes('WILY') ? -1 : 1));

for (const store of stores) {
  const isWily = store.name.toUpperCase().includes('WILY');
  store.bannerUrl = isWily ? '/stores/wily-cover.webp' : '/stores/barbero-cover.webp';
  store.badgeUrl = isWily ? '/stores/wily-logo.webp' : '/stores/barbero-logo.webp';
  store.rubroKey = isWily ? 'tecnologia' : 'barberia';
  store.rubroBadge = isWily ? '🎮 Tecnología y Electrónica' : '💈 Barbería y Cuidado Personal';
  store.verticalLabel = isWily ? 'Tecnología, Audio Bluetooth, Cases & Gaming' : 'Insumos de Barbería Profesional, Estética & Cuidado Capilar';
  store.phoneDisplay = isWily ? '+58 424-2143327' : '+58 422-1622984';
  store.addressDisplay = isWily
    ? 'Av. Barlovento Casa Nro 12-42, Sector Higuerote, Miranda'
    : (store.address_line || 'FVMR+PJ2, Higuerote 1231, Miranda, Venezuela');
  store.productCount = 0;

  try {
    const prodRes = await fetch(`${API_BASE}/stores/${store.id}/products`);
    if (prodRes.ok) {
      const items = await prodRes.json();
      if (Array.isArray(items)) {
        store.productCount = items.length;
        const mapped = items.map((it: any, idx: number) => {
          const cleanName = normalizeName(it.name);
          let img = '';
          if (it.attributes?.image_url) {
            img = it.attributes.image_url;
          } else if (it.attributes?.asset_id) {
            img = `${ASSET_BASE}/${it.attributes.asset_id}`;
          } else if (assetMap[it.name]) {
            img = `${ASSET_BASE}/${assetMap[it.name]}`;
          } else if (assetMap[cleanName]) {
            img = `${ASSET_BASE}/${assetMap[cleanName]}`;
          } else {
            img = FALLBACK_PRODUCT_IMAGE;
          }

          const price = Number(it.base_price) || 0;
          const catSlug = classifyProductCategory(cleanName, store.name);
          return {
            id: it.id,
            originalOrder: idx,
            storeId: store.id,
            storeKey: isWily ? 'wily' : 'barbero',
            rubroKey: store.rubroKey,
            name: cleanName,
            desc: it.description || `Disponible en ${store.name} con entrega express garantizada.`,
            storeName: store.name,
            storeBadge: store.badgeUrl,
            category: catSlug,
            price: price,
            priceBs: formatBs(price, bcvRate),
            rating: '4.9',
            time: '15-20 min',
            image: img
          };
        });
        allProducts.push(...mapped);
      }
    }
  } catch {}
}

const storeVerticals = [
  {
    key: 'all',
    title: 'Todos los Comercios',
    subtitle: `${stores.length} tiendas • ${allProducts.length} productos`,
    badge: 'Multi-Rubro',
    icon: '🏬',
    activeCount: stores.length,
    colorClass: 'from-orange-500/10 to-amber-500/5 border-[#FF7A00]',
    iconBg: 'bg-orange-100 text-[#FF7A00]'
  },
  {
    key: 'restaurantes',
    title: 'Comida y Restaurantes',
    subtitle: 'Hamburguesas, Pizzas y Bebidas',
    badge: 'Gastronomía',
    icon: '🍔',
    activeCount: 0,
    colorClass: 'from-rose-500/10 to-orange-500/5 border-gray-100',
    iconBg: 'bg-rose-50 text-rose-600'
  },
  {
    key: 'supermercados',
    title: 'Supermercados',
    subtitle: 'Víveres, Despensa y Hogar',
    badge: 'Mercado',
    icon: '🛒',
    activeCount: 0,
    colorClass: 'from-emerald-500/10 to-teal-500/5 border-gray-100',
    iconBg: 'bg-emerald-50 text-emerald-600'
  },
  {
    key: 'farmacias',
    title: 'Farmacias y Salud',
    subtitle: 'Medicamentos y Primeros Auxilios',
    badge: 'Salud 24/7',
    icon: '💊',
    activeCount: 0,
    colorClass: 'from-cyan-500/10 to-blue-500/5 border-gray-100',
    iconBg: 'bg-cyan-50 text-cyan-600'
  },
  {
    key: 'tecnologia',
    title: 'Tiendas y Tecnología',
    subtitle: '1 tienda activa • 54 artículos',
    badge: 'Abierto Ahora',
    icon: '🎮',
    activeCount: 1,
    colorClass: 'from-blue-500/10 to-indigo-500/5 border-gray-100',
    iconBg: 'bg-blue-50 text-blue-600'
  },
  {
    key: 'barberia',
    title: 'Barbería y Belleza',
    subtitle: '1 tienda activa • 60 artículos',
    badge: 'Abierto Ahora',
    icon: '💈',
    activeCount: 1,
    colorClass: 'from-amber-500/10 to-yellow-500/5 border-gray-100',
    iconBg: 'bg-amber-50 text-amber-600'
  },
  {
    key: 'mascotas',
    title: 'Mascotas y Agro',
    subtitle: 'Alimentos, Collares y Salud Animal',
    badge: 'Pet Shop',
    icon: '🐾',
    activeCount: 0,
    colorClass: 'from-purple-500/10 to-fuchsia-500/5 border-gray-100',
    iconBg: 'bg-purple-50 text-purple-600'
  }
];

const categoryCounts: Record<string, number> = { all: allProducts.length };
for (const p of allProducts) {
  categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1;
}

const curatedCategories = [
  {
    slug: 'all',
    rubro: 'all',
    name: 'Todo el Catálogo',
    image: '/brand-icon.webp?v=3',
    count: categoryCounts['all'] || 0
  },
  {
    slug: 'audio',
    rubro: 'tecnologia',
    name: 'Audio y Cornetas',
    image: 'https://admin.traigalo.org/assets/9e27108f-5090-41bf-9df4-2ee25118a259',
    count: categoryCounts['audio'] || 0
  },
  {
    slug: 'fundas',
    rubro: 'tecnologia',
    name: 'Celulares y Fundas',
    image: 'https://admin.traigalo.org/assets/49b91bdf-f812-477c-b64c-f7dfffeebc43',
    count: categoryCounts['fundas'] || 0
  },
  {
    slug: 'gaming',
    rubro: 'tecnologia',
    name: 'Videojuegos y Consolas',
    image: 'https://admin.traigalo.org/assets/5ce76a26-f596-4b8b-8ad5-e70d04a8aa7f',
    count: categoryCounts['gaming'] || 0
  },
  {
    slug: 'barberia',
    rubro: 'barberia',
    name: 'Máquinas y Barbería',
    image: 'https://admin.traigalo.org/assets/6b679a6d-7862-4587-acb5-cf923e220a56',
    count: categoryCounts['barberia'] || 0
  },
  {
    slug: 'cuidado',
    rubro: 'barberia',
    name: 'Cuidado Capilar y Barba',
    image: 'https://admin.traigalo.org/assets/474ed500-f903-4390-8e83-37aeb906e630',
    count: categoryCounts['cuidado'] || 0
  },
  {
    slug: 'cepillos',
    rubro: 'barberia',
    name: 'Cepillos y Peines',
    image: 'https://admin.traigalo.org/assets/7cb72bd0-634e-4a83-b605-b695ffb50f07',
    count: categoryCounts['cepillos'] || 0
  },
  {
    slug: 'planchas',
    rubro: 'barberia',
    name: 'Planchas y Eléctricos',
    image: 'https://admin.traigalo.org/assets/28becd49-0f22-4587-88e6-e22fb477137d'.replace('4587', '4594'),
    count: categoryCounts['planchas'] || 0
  },
  {
    slug: 'fitness',
    rubro: 'barberia',
    name: 'Cuidado Corporal y Fitness',
    image: 'https://admin.traigalo.org/assets/07db9336-702b-4b75-bacf-16843fa8d4da',
    count: categoryCounts['fitness'] || 0
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo ⚡ | Super-App Multi-Tienda, Delivery y Taxis en Higuerote</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-8">
      
      <section class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#0B132B] via-[#1C2541] to-[#FF5A00] p-6 sm:p-10 shadow-xl shadow-orange-500/10 text-white">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-[11px] font-black uppercase tracking-wider mb-3.5 border border-white/25 shadow-sm">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#10B981] shadow-[0_0_10px_#10B981] shrink-0"></span>
            <span>Super-App Multi-Rubro • Higuerote & Miranda</span>
          </div>
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-2.5">
            Comida, Farmacias, Supermercados y Tiendas en un solo lugar
          </h1>
          <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-5 max-w-xl">
            Explora por categoría de comercio, entra a las tiendas oficiales verificadas de Higuerote o combina artículos de múltiples tiendas en un mismo pedido con entrega express.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="#store-verticals" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs sm:text-sm font-black shadow-lg shadow-orange-600/30 active:scale-95 transition-all">
              <span>Explorar Categorías de Tiendas</span>
              <span>↓</span>
            </a>
            <a href="#stores" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white text-gray-950 hover:bg-gray-100 text-xs sm:text-sm font-black shadow-md active:scale-95 transition-all">
              <span>🏬 Ver Tiendas Oficiales ({stores.length})</span>
            </a>
            <a href="/rides" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/25 text-white text-xs sm:text-sm font-black active:scale-95 transition-all">
              <span>🚗</span>
              <span>Pedir Taxi / Moto</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex absolute right-10 top-1/2 -translate-y-1/2 items-center gap-3">
          <img src="/brand-icon.webp?v=3" alt="Traigalo" class="w-36 h-36 lg:w-44 lg:h-44 object-contain drop-shadow-2xl" />
        </div>
      </section>

      <section id="store-verticals" class="space-y-3.5">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <span class="text-[11px] font-black uppercase tracking-wider text-[#FF7A00] block">Nivel 1 • Módulos del Marketplace</span>
            <h2 class="text-lg sm:text-2xl font-black text-gray-900 tracking-tight">Categorías de Comercios y Servicios</h2>
            <p class="text-xs text-gray-500">Elige qué tipo de comercio buscas hoy: Restaurantes, Supermercados, Farmacias, Tiendas de Tecnología, Barbería o Taxis</p>
          </div>
          <button
            id="btn-clear-rubro"
            type="button"
            class="hidden self-start sm:self-auto px-3.5 py-1.5 rounded-xl bg-orange-50 text-[#FF7A00] hover:bg-orange-100 text-xs font-black transition-all cursor-pointer"
          >
            ✕ Mostrar todos los rubros
          </button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5 sm:gap-3">
          {storeVerticals.map((v, idx) => (
            <button
              type="button"
              data-rubro-filter={v.key}
              data-rubro-title={v.title}
              data-rubro-icon={v.icon}
              class={`rubro-card text-left p-3.5 rounded-3xl bg-white border-2 transition-all cursor-pointer flex flex-col justify-between gap-2.5 hover:shadow-md active:scale-95 ${
                idx === 0
                  ? 'border-[#FF7A00] shadow-md shadow-orange-500/10 ring-2 ring-[#FF7A00]/15'
                  : 'border-gray-100 hover:border-orange-200 shadow-2xs'
              }`}
            >
              <div class="flex items-center justify-between gap-1">
                <div class={`w-11 h-11 rounded-2xl ${v.iconBg} flex items-center justify-center text-2xl shrink-0 shadow-2xs`}>
                  {v.icon}
                </div>
                <span class={`px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider ${
                  v.activeCount > 0
                    ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'bg-gray-100 text-gray-500'
                }`}>
                  {v.activeCount > 0 ? `${v.activeCount} Activo${v.activeCount > 1 ? 's' : ''}` : v.badge}
                </span>
              </div>
              <div>
                <h3 class="text-xs sm:text-sm font-black text-gray-900 leading-snug">{v.title}</h3>
                <p class="text-[10px] text-gray-400 font-semibold mt-0.5 line-clamp-1">{v.subtitle}</p>
              </div>
            </button>
          ))}

          <a
            href="/rides"
            class="p-3.5 rounded-3xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-md hover:shadow-lg transition-all flex flex-col justify-between gap-2.5 active:scale-95"
          >
            <div class="flex items-center justify-between gap-1">
              <div class="w-11 h-11 rounded-2xl bg-white/20 flex items-center justify-center text-2xl shrink-0">
                🚗
              </div>
              <span class="px-2 py-0.5 rounded-full bg-white/20 text-white text-[9px] font-black uppercase tracking-wider">
                En Vivo
              </span>
            </div>
            <div>
              <h3 class="text-xs sm:text-sm font-black text-white leading-snug">Taxis y Envíos</h3>
              <p class="text-[10px] text-blue-100 font-semibold mt-0.5 line-clamp-1">Motos, Carros y Fletes</p>
            </div>
          </a>
        </div>
      </section>

      <section id="stores" class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <span class="text-[11px] font-black uppercase tracking-wider text-[#FF7A00] block">Comercios Afiliados</span>
            <h2 id="stores-section-heading" class="text-lg sm:text-2xl font-black text-gray-900 tracking-tight">Tiendas Oficiales Verificadas</h2>
            <p id="stores-section-subtitle" class="text-xs text-gray-500">Banners y logos oficiales de cada comercio • Entra a su tienda exclusiva o filtra sus productos abajo</p>
          </div>
          <span id="stores-active-badge" class="text-xs font-extrabold text-emerald-700 bg-emerald-50 px-3.5 py-1.5 rounded-full border border-emerald-200 shrink-0">
            ● {stores.length} Tiendas Abiertas Ahora
          </span>
        </div>

        <div id="stores-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {stores.map(store => (
            <div 
              class="store-item bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-md hover:shadow-xl transition-all duration-200 flex flex-col justify-between group"
              data-name={store.name.toLowerCase()}
              data-desc={(store.description || '').toLowerCase()}
              data-rubro={store.rubroKey}
              data-store-key={store.name.toLowerCase().includes('wily') ? 'wily' : 'barbero'}
            >
              <a href={`/stores/${store.id}`} class="block relative h-44 sm:h-52 w-full overflow-hidden bg-gray-900">
                <img
                  src={store.bannerUrl}
                  alt={`Portada oficial de ${store.name}`}
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                />
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                  <span class="px-3 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-wider shadow-md">
                    ● Abierto Ahora
                  </span>
                  <div class="flex items-center gap-1.5">
                    <span class="px-3 py-1 rounded-full bg-white/95 text-gray-900 text-[10px] font-black shadow-md">
                      {store.rubroBadge}
                    </span>
                    <span class="px-3 py-1 rounded-full bg-gray-950/85 backdrop-blur-md text-white text-[10px] font-extrabold shadow-md">
                      {store.productCount} Artículos
                    </span>
                  </div>
                </div>
              </a>

              <div class="px-5 pt-0 pb-5 flex-1 flex flex-col justify-between bg-white">
                <div class="flex items-start gap-4">
                  <a href={`/stores/${store.id}`} class="-mt-8 relative z-10 shrink-0">
                    <img
                      src={store.badgeUrl}
                      alt={`Logo oficial de ${store.name}`}
                      class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl border-4 border-white shadow-lg bg-white object-cover"
                    />
                  </a>
                  <div class="pt-2.5 min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <a href={`/stores/${store.id}`} class="hover:text-[#FF7A00] transition-colors min-w-0">
                        <h3 class="text-lg sm:text-xl font-black text-gray-950 leading-tight truncate">{store.name}</h3>
                      </a>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-50 text-amber-600 text-xs font-black shrink-0 border border-amber-200/60">
                        ★ 4.9
                      </span>
                    </div>
                    <p class="text-xs font-bold text-[#FF7A00] mt-0.5 truncate">{store.verticalLabel}</p>
                    <p class="text-[11px] text-gray-500 font-medium mt-1 truncate">📍 {store.addressDisplay}</p>
                  </div>
                </div>

                <div class="mt-4 pt-3.5 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 text-xs font-bold text-gray-600">
                    <span class="inline-flex items-center gap-1 bg-gray-100 px-2.5 py-1 rounded-lg text-gray-700">⚡ 15-25 min</span>
                    <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-lg font-extrabold">🛵 Envío $1.50</span>
                    <span class="hidden sm:inline-flex items-center gap-1 text-gray-400 text-[11px]">📞 {store.phoneDisplay}</span>
                  </div>

                  <div class="flex items-center gap-2 ml-auto">
                    <button
                      type="button"
                      data-filter-store={store.name.toLowerCase().includes('wily') ? 'wily' : 'barbero'}
                      data-filter-rubro={store.rubroKey}
                      class="btn-store-quickfilter px-3.5 py-2 rounded-xl bg-orange-50 hover:bg-orange-100 text-[#FF7A00] text-xs font-extrabold transition-colors cursor-pointer"
                    >
                      Ver sus {store.productCount} productos ↓
                    </button>
                    <a 
                      href={`/stores/${store.id}`}
