---
import BottomNav from '../../components/BottomNav.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const { id } = Astro.params;
const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let assetMap: Record<string, string> = {};
try {
  const assetModule = await import('../../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

const NAME_FIXES: Record<string, string> = {
  'Ariculares SZ-771': 'Auriculares SZ-771',
  '5-Sprinng CHEST PULL': '5-Spring Chest Pull',
  'Abdominal musclw': 'Abdominal Muscle Trainer',
  'Aceite de resino': 'Aceite de Ricino',
  'After chave': 'After Shave Profesional',
  'Back pain need hellp': 'Soporte Lumbar Back Pain',
  'Brocha de ljo': 'Brocha de Lujo'
};

function normalizeName(rawName: string): string {
  const trimmed = (rawName || '').trim();
  return NAME_FIXES[trimmed] || trimmed.replace(/\s{2,}/g, ' ');
}

function classifyStoreSubcategory(name: string, isWily: boolean): string {
  const n = name.toLowerCase();
  if (isWily) {
    if (n.includes('funda') || n.includes('carcasa') || n.includes('tecno') || n.includes('ufone') || n.includes('phone') || n.includes('móvil') || n.includes('movil')) {
      return 'Fundas y Celulares';
    }
    if (n.includes('gaming') || n.includes('games') || n.includes('mario') || n.includes('batman') || n.includes('iron man') || n.includes('magic q8')) {
      return 'Gaming y Consolas';
    }
    return 'Audífonos y Audio';
  } else {
    if (n.includes('training') || n.includes('chest') || n.includes('abdominal') || n.includes('lumbar') || n.includes('back pain')) {
      return 'Fitness y Salud';
    }
    if (n.includes('cepillo') || n.includes('peine') || n.includes('bigudies')) {
      return 'Cepillos y Peines';
    }
    if (n.includes('máquina') || n.includes('maquina') || n.includes('plancha') || n.includes('secador') || n.includes('brocha') || n.includes('capa') || n.includes('atomizador') || n.includes('grip')) {
      return 'Barbería y Equipos';
    }
    return 'Cuidado Capilar y Barba';
  }
}

let allStores: any[] = [];
let storeData: any = null;
let productsData: any[] = [];
let reviewsData: any[] = [];

try {
  const listRes = await fetch(`${API_BASE}/stores`);
  if (listRes.ok) {
    const raw = await listRes.json();
    if (Array.isArray(raw)) {
      allStores = raw.filter((s: any) => s.slug !== 'burger-crave' && s.slug !== 'sushi-omakase');
      storeData = allStores.find((s: any) => s.id === id || s.slug === id);
    }
  }
} catch {}

if (!storeData) {
  try {
    const storeRes = await fetch(`${API_BASE}/stores/${id}`);
    if (storeRes.ok) {
      storeData = await storeRes.json();
    }
  } catch {}
}

if (!storeData && allStores.length > 0) {
  storeData = allStores[0];
}

const resolvedStoreId = storeData?.id || id || '46a0baf0-4100-465d-934a-f2d14f004ba5';

try {
  const prodRes = await fetch(`${API_BASE}/stores/${resolvedStoreId}/products`);
  if (prodRes.ok) {
    const pData = await prodRes.json();
    if (Array.isArray(pData)) productsData = pData;
  }
} catch {}

try {
  const revRes = await fetch(`${API_BASE}/reviews?store-id=${resolvedStoreId}`);
  if (revRes.ok) {
    const rList = await revRes.json();
    if (Array.isArray(rList)) reviewsData = rList;
  }
} catch {}

const storeName = storeData?.name || 'WILY VIDEO';
const isWily = storeName.toUpperCase().includes('WILY');
const storeCategory = isWily
  ? 'Tecnología, Audio Bluetooth, Gaming y Accesorios Móviles'
  : 'Insumos de Barbería Profesional, Cuidado Capilar y Estética';
const storeCover = isWily ? '/store-wily-cover.svg' : '/store-barbero-cover.svg';
const storeLogo = isWily ? '/store-wily-logo.svg' : '/store-barbero-logo.svg';
const avgRating = reviewsData.length > 0
  ? (reviewsData.reduce((acc, r) => acc + (Number(r.store_rating || r.rating) || 5), 0) / reviewsData.length).toFixed(1)
  : '4.9';
const storeReviewsText = reviewsData.length > 0 ? `${reviewsData.length} reseñas verificadas` : 'Comercio Verificado';
const storeTime = '15-25 min';
const storeFee = '$1.50';
const storeAddress = storeData?.address_line || 'Higuerote, Estado Miranda';

const products = productsData.map((p) => {
  const cleanName = normalizeName(p.name);
  let img = '';
  if (p.attributes?.image_url) {
    img = p.attributes.image_url;
  } else if (p.attributes?.asset_id) {
    img = `${ASSET_BASE}/${p.attributes.asset_id}`;
  } else if (assetMap[p.name]) {
    img = `${ASSET_BASE}/${assetMap[p.name]}`;
  } else if (assetMap[cleanName]) {
    img = `${ASSET_BASE}/${assetMap[cleanName]}`;
  } else {
    img = FALLBACK_PRODUCT_IMAGE;
  }

  const price = Number(p.base_price) || 0;
  const subcat = classifyStoreSubcategory(cleanName, isWily);
  return {
    id: p.id,
    storeId: resolvedStoreId,
    storeName: storeName,
    name: cleanName,
    subcategory: subcat,
    desc: (p.description && p.description.length > 10)
      ? p.description
      : `Artículo original disponible en ${storeName} con garantía y despacho express en tu zona.`,
    price,
    priceBs: formatBs(price, bcvRate),
    image: img
  };
});

const distinctSubcats = [...new Set(products.map(p => p.subcategory))];
const menuCategories = ['Todos los Productos', ...distinctSubcats];
---

<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>{storeName} | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    
    <div class="relative h-64 sm:h-72 w-full bg-gray-950 overflow-hidden flex items-end p-6">
      <img src={storeCover} alt={storeName} class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/25"></div>

      <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
        <div class="flex items-center gap-2">
          <a href="/" class="h-10 px-3.5 rounded-full bg-white/95 backdrop-blur-md flex items-center gap-1.5 text-gray-900 text-xs font-extrabold shadow-md hover:bg-white transition-all active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Marketplace</span>
          </a>

          {allStores.filter((s) => s.id !== resolvedStoreId).map((other) => (
            <a 
              href={`/stores/${other.id}`}
              class="hidden sm:inline-flex h-10 px-3.5 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-md border border-white/20 text-white text-xs font-bold items-center gap-1.5 transition-all"
            >
              <span>Cambiar a {other.name}</span>
              <span>→</span>
            </a>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <div class="px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-[10px] font-black text-gray-800 shadow-sm border border-gray-100">
            BCV: {bcvRate.toFixed(2)} Bs/$
          </div>
          <button 
            id="btn-favorite-store"
            type="button"
            aria-label="Guardar tienda en favoritos"
            class="w-10 h-10 rounded-full bg-white/95 backdrop-blur-md flex items-center justify-center text-gray-700 shadow-md hover:text-rose-500 transition-all cursor-pointer active:scale-90"
          >
            <span id="fav-heart-icon" class="text-base">🤍</span>
          </button>
        </div>
      </div>

      <div class="relative z-10 text-white flex items-end gap-4 w-full max-w-4xl mx-auto">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white p-1 shadow-xl shrink-0 overflow-hidden border-2 border-white/90">
          <img src={storeLogo} alt={storeName} class="w-full h-full object-cover rounded-xl" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-[#FF7A00] text-[10px] font-black uppercase tracking-wider mb-1.5 shadow-xs">
            ★ Tienda Oficial Verificada • {products.length} Artículos
          </div>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight truncate">{storeName}</h1>
          <p class="text-xs text-gray-200 mt-0.5 truncate">{storeCategory}</p>
          <p class="text-[11px] text-gray-300 mt-0.5 truncate">📍 {storeAddress}</p>
        </div>
      </div>
    </div>

    <div class="bg-white border-b border-gray-100 px-4 py-3 shadow-2xs sticky top-0 z-30">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center justify-between sm:justify-start gap-4 text-xs font-bold text-gray-700">
          <div class="flex items-center gap-1">
            <span class="text-amber-500 text-sm">★</span>
            <span>{avgRating}</span>
            <span class="text-gray-400 font-normal">({storeReviewsText})</span>
          </div>
          <div class="w-1 h-1 rounded-full bg-gray-300"></div>
          <div class="flex items-center gap-1">
            <span>⚡</span>
            <span>{storeTime}</span>
          </div>
          <div class="w-1 h-1 rounded-full bg-gray-300"></div>
          <div class="flex items-center gap-1 text-[#FF7A00]">
            <span>🛵</span>
            <span>Envío desde {storeFee}</span>
          </div>
        </div>

        <div class="relative w-full sm:w-64">
          <input 
            id="store-search-input"
            type="text"
            placeholder={`Buscar en ${storeName}...`}
            class="w-full h-9 pl-8 pr-3 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00]"
          />
          <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-6 w-full space-y-8">
      <div>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-3 mb-4" id="store-cat-tabs">
          {menuCategories.map((cat, idx) => (
            <button 
              type="button"
              data-subcat={cat}
              class={`store-tab-btn shrink-0 px-4 py-2 rounded-full text-xs font-extrabold transition-all cursor-pointer active:scale-95 ${
                idx === 0 
                  ? 'bg-[#FF7A00] text-white shadow-md shadow-orange-600/20' 
                  : 'bg-white border border-gray-100 text-gray-600 hover:border-orange-200'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="products-list">
          {products.map(item => (
            <div 
              class="product-card bg-white rounded-3xl p-3.5 border border-gray-100/90 shadow-xs hover:shadow-md transition-all flex gap-3.5 group cursor-pointer"
              data-id={item.id}
              data-store-id={item.storeId}
              data-store-name={item.storeName}
              data-name={item.name}
              data-search={item.name.toLowerCase()}
              data-subcat={item.subcategory}
              data-price={item.price}
              data-image={item.image}
              data-desc={item.desc}
            >
              <div class="flex-1 flex flex-col justify-between min-w-0">
                <div>
                  <span class="text-[9px] font-black uppercase tracking-wider text-[#FF7A00] block mb-0.5">{item.subcategory}</span>
                  <h3 class="text-sm font-extrabold text-gray-900 group-hover:text-[#FF7A00] transition-colors leading-snug line-clamp-2">
                    {item.name}
                  </h3>
                  <p class="text-[11px] text-gray-400 mt-1 line-clamp-2 leading-relaxed">
                    {item.desc}
                  </p>
                </div>

                <div class="mt-3 flex flex-col">
                  <span class="text-sm font-black text-gray-950">
                    ${item.price.toFixed(2)}
                  </span>
                  <span class="text-[10px] text-gray-400 font-semibold tracking-tight">
                    {item.priceBs}
                  </span>
                </div>
              </div>

              <div class="relative w-28 h-28 rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 shrink-0 flex items-center justify-center p-2">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform" 
                  loading="lazy" 
                  onerror={`this.onerror=null; this.src='${FALLBACK_PRODUCT_IMAGE}';`}
                />
                <button 
                  type="button"
                  aria-label={`Añadir ${item.name}`}
                  class="btn-add-product absolute bottom-2 right-2 w-8 h-8 rounded-full bg-[#FF7A00] hover:bg-[#E66E00] active:scale-90 text-white flex items-center justify-center shadow-md shadow-orange-600/30 transition-all z-10 cursor-pointer font-black"
                >
                  +
                </button>
              </div>
            </div>
          ))}
        </div>

        <div id="store-no-results" class="hidden text-center py-10 bg-white rounded-3xl border border-gray-100 mt-4">
          <p class="text-xs font-bold text-gray-500">No encontramos artículos con ese criterio en esta tienda</p>
        </div>
      </div>

      {reviewsData.length > 0 && (
        <section class="bg-white rounded-3xl p-5 border border-gray-100 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-black uppercase tracking-wider text-gray-400">Opiniones de Clientes Verificados</h2>
            <span class="text-xs font-black text-amber-500">★ {avgRating} ({reviewsData.length})</span>
          </div>
          <div class="space-y-2.5 divide-y divide-gray-50">
            {reviewsData.slice(0, 5).map((rev) => (
              <div class="pt-2.5 first:pt-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-extrabold text-gray-900">Compra Verificada</span>
                  <span class="text-xs font-black text-amber-400">{'★'.repeat(Number(rev.store_rating || rev.rating || 5))}</span>
                </div>
                {rev.comment && (
                  <p class="text-xs text-gray-500 mt-1">{rev.comment}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <div id="product-modal" class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div id="modal-card" class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl p-5 shadow-2xl transform translate-y-full sm:translate-y-4 transition-transform duration-200 flex flex-col max-h-[90vh]">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <span class="text-xs font-black uppercase tracking-wider text-[#FF7A00]">{storeName}</span>
          <button id="close-modal-btn" type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 font-black cursor-pointer">
            ✕
          </button>
        </div>
        <div class="overflow-y-auto py-4 space-y-4 flex-1">
          <div class="h-44 w-full rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 flex items-center justify-center p-4">
            <img id="modal-img" src="" alt="" class="w-full h-full object-contain" />
          </div>
          <div>
            <h2 id="modal-title" class="text-base font-extrabold text-gray-900 leading-snug"></h2>
            <p id="modal-desc" class="text-xs text-gray-500 leading-relaxed mt-1"></p>
          </div>

          <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 border border-gray-100">
            <div>
              <span class="text-xs font-bold text-gray-700 block">Cantidad</span>
              <span class="text-[10px] text-gray-400">Unidades a solicitar</span>
            </div>
            <div class="flex items-center gap-3 bg-white px-3 py-1.5 rounded-xl border border-gray-200 shadow-xs">
              <button id="modal-qty-minus" type="button" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-orange-100 text-gray-700 hover:text-[#FF7A00] font-black text-sm flex items-center justify-center transition-colors cursor-pointer">
                -
              </button>
              <span id="modal-qty-display" class="w-6 text-center text-sm font-black text-gray-950">1</span>
              <button id="modal-qty-plus" type="button" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-orange-100 text-gray-700 hover:text-[#FF7A00] font-black text-sm flex items-center justify-center transition-colors cursor-pointer">
                +
              </button>
            </div>
          </div>

          <div>
            <label for="modal-notes" class="block text-xs font-bold text-gray-700 mb-1">
              Especificaciones opcionales
            </label>
            <textarea 
              id="modal-notes" 
              rows="2" 
              maxlength="200"
              placeholder="Ej. Color preferido, modelo de teléfono o indicación para la tienda..." 
              class="w-full p-3 text-xs rounded-xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 resize-none transition-all font-medium text-gray-800"
            ></textarea>
          </div>

          <div class="pt-2 flex items-center justify-between border-t border-gray-100">
            <span class="text-xs text-gray-500 font-bold">Subtotal producto</span>
            <div class="text-right">
              <span id="modal-price" class="text-lg font-black text-[#FF7A00] block"></span>
              <span id="modal-price-bs" class="text-[10px] text-gray-400 font-semibold block"></span>
            </div>
          </div>
        </div>
        <div class="pt-3 border-t border-gray-100 flex items-center gap-3">
          <button id="modal-add-btn" type="button" class="flex-1 h-12 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg shadow-orange-600/30 active:scale-98 transition-all cursor-pointer">
            <span id="modal-add-btn-text">Agregar al Carrito</span>
          </button>
        </div>
      </div>
    </div>

    <div id="cart-bar" class="fixed bottom-14 md:bottom-4 left-0 right-0 z-40 p-4 pointer-events-none transition-all duration-300 opacity-0 translate-y-4">
      <div class="max-w-4xl mx-auto pointer-events-auto">
        <a 
          href="/checkout" 
          class="w-full h-14 rounded-2xl bg-gradient-to-r from-[#FF7A00] to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white font-extrabold text-sm px-6 flex items-center justify-between shadow-xl shadow-orange-600/30 active:scale-98 transition-all"
        >
          <div class="flex items-center gap-2.5">
            <span id="cart-count" class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs">0</span>
            <div>
              <span class="block leading-tight">Ver Carrito</span>
              <span id="cart-stores-label" class="block text-[10px] text-white/85 font-semibold"></span>
            </div>
          </div>
          <div class="flex items-center gap-2 text-right">
            <div>
              <span id="cart-total" class="font-black">$0.00</span>
              <span id="cart-total-bs" class="block text-[10px] text-white/80 font-medium"></span>
            </div>
            <span>→</span>
          </div>
        </a>
      </div>
    </div>

    <BottomNav />

    <script is:inline define:vars={{ bcvRate, resolvedStoreId, storeName }}>
    (() => {
      const CART_STORAGE_KEY = 'traigalo_cart';
      const FAV_STORES_KEY = 'traigalo_fav_stores';

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateCartBar();
      }

      function addToCart(product, quantity = 1, notes = '') {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id && (item.notes || '') === notes);
        if (existing) {
          existing.qty = (existing.qty || 1) + quantity;
          if (!existing.storeName) existing.storeName = product.storeName || storeName;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId || resolvedStoreId,
            storeName: product.storeName || storeName,
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: quantity,
            notes: notes
          });
        }
        saveCart(cart);
      }

      function updateCartBar() {
        const cart = getCart();
        const cartBar = document.getElementById('cart-bar');
        const cartCount = document.getElementById('cart-count');
        const cartStoresLabel = document.getElementById('cart-stores-label');
        const cartTotal = document.getElementById('cart-total');
        const cartTotalBs = document.getElementById('cart-total-bs');
        if (!cartBar || !cartCount || !cartTotal) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);
        const distinctStores = [...new Set(cart.map(i => i.storeName).filter(Boolean))];

        if (totalQty > 0) {
          cartCount.textContent = String(totalQty);
          cartTotal.textContent = `$${totalPrice.toFixed(2)}`;
          if (cartTotalBs) {
            cartTotalBs.textContent = formatBsClient(totalPrice);
          }
          if (cartStoresLabel) {
            cartStoresLabel.textContent = distinctStores.length > 1
              ? `Multi-Tienda (${distinctStores.length} comercios)`
              : (distinctStores[0] || storeName);
          }
          cartBar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.add('opacity-100', 'translate-y-0');
        } else {
          cartBar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      const favBtn = document.getElementById('btn-favorite-store');
      const favIcon = document.getElementById('fav-heart-icon');
      function isStoreFavorited() {
        try {
          const list = JSON.parse(localStorage.getItem(FAV_STORES_KEY) || '[]');
          return list.includes(resolvedStoreId);
        } catch {
          return false;
        }
      }
      function updateFavIcon() {
        if (favIcon) {
          favIcon.textContent = isStoreFavorited() ? '❤️' : '🤍';
        }
      }
      if (favBtn) {
        favBtn.addEventListener('click', () => {
          try {
            let list = JSON.parse(localStorage.getItem(FAV_STORES_KEY) || '[]');
            if (list.includes(resolvedStoreId)) {
              list = list.filter((id) => id !== resolvedStoreId);
            } else {
              list.push(resolvedStoreId);
            }
            localStorage.setItem(FAV_STORES_KEY, JSON.stringify(list));
            updateFavIcon();
          } catch {}
        });
      }
      updateFavIcon();

      let activeSubcat = 'Todos los Productos';
      let storeSearchText = '';

      function filterStoreProducts() {
        const cards = document.querySelectorAll('.product-card');
        const noRes = document.getElementById('store-no-results');
        let visible = 0;

        cards.forEach((card) => {
          const subcat = card.getAttribute('data-subcat') || '';
          const search = card.getAttribute('data-search') || '';
          const matchTab = activeSubcat === 'Todos los Productos' || subcat === activeSubcat;
          const matchSearch = !storeSearchText || search.includes(storeSearchText);

          if (matchTab && matchSearch) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noRes) {
          if (visible === 0) noRes.classList.remove('hidden');
          else noRes.classList.add('hidden');
        }
      }

      document.querySelectorAll('.store-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.store-tab-btn').forEach((b) => {
            b.className = 'store-tab-btn shrink-0 px-4 py-2 rounded-full text-xs font-extrabold bg-white border border-gray-100 text-gray-600 hover:border-orange-200 transition-all cursor-pointer active:scale-95';
          });
          btn.className = 'store-tab-btn shrink-0 px-4 py-2 rounded-full text-xs font-extrabold bg-[#FF7A00] text-white shadow-md shadow-orange-600/20 transition-all cursor-pointer active:scale-95';
          activeSubcat = btn.getAttribute('data-subcat') || 'Todos los Productos';
          filterStoreProducts();
        });
      });

      const storeSearchInput = document.getElementById('store-search-input');
      if (storeSearchInput) {
        storeSearchInput.addEventListener('input', (e) => {
          storeSearchText = e.target.value.trim().toLowerCase();
          filterStoreProducts();
        });
      }

      const modal = document.getElementById('product-modal');
      const modalCard = document.getElementById('modal-card');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');
      const modalPrice = document.getElementById('modal-price');
      const modalPriceBs = document.getElementById('modal-price-bs');
      const modalQtyDisplay = document.getElementById('modal-qty-display');
      const modalQtyMinus = document.getElementById('modal-qty-minus');
      const modalQtyPlus = document.getElementById('modal-qty-plus');
      const modalNotes = document.getElementById('modal-notes');
      const modalAddBtn = document.getElementById('modal-add-btn');
      const closeModalBtn = document.getElementById('close-modal-btn');
      let currentModalProduct = null;
      let modalQuantity = 1;

      function updateModalPrice() {
        if (!currentModalProduct) return;
        const subtotal = Number(currentModalProduct.price) * modalQuantity;
        if (modalPrice) modalPrice.textContent = `$${subtotal.toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(subtotal);
        if (modalQtyDisplay) modalQtyDisplay.textContent = String(modalQuantity);
      }

      if (modalQtyMinus) {
        modalQtyMinus.addEventListener('click', () => {
          if (modalQuantity > 1) {
            modalQuantity--;
            updateModalPrice();
          }
        });
      }

      if (modalQtyPlus) {
        modalQtyPlus.addEventListener('click', () => {
          if (modalQuantity < 99) {
            modalQuantity++;
            updateModalPrice();
          }
        });
      }

      function openModal(prod) {
        currentModalProduct = prod;
        modalQuantity = 1;
        if (modalNotes) modalNotes.value = '';
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        updateModalPrice();

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        currentModalProduct = null;
        modalQuantity = 1;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (currentModalProduct) {
            const notes = modalNotes ? modalNotes.value.trim() : '';
            addToCart(currentModalProduct, modalQuantity, notes);
            closeModal();
          }
        });
      }

      document.querySelectorAll('.product-card').forEach(card => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          storeName: card.getAttribute('data-store-name'),
          name: card.getAttribute('data-name'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image'),
          desc: card.getAttribute('data-desc')
        };

        const addBtn = card.querySelector('.btn-add-product');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod);
            addBtn.textContent = '✓';
            addBtn.classList.add('bg-emerald-600');
            setTimeout(() => {
              addBtn.textContent = '+';
              addBtn.classList.remove('bg-emerald-600');
            }, 900);
          });
        }

        card.addEventListener('click', () => {
          openModal(prod);
        });
      });

      updateCartBar();
    })();
    </script>
  </body>
</html>
