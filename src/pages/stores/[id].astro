---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import { fetchActiveStores, enrichStore } from '../../adapters/stores';
import '../../styles/global.css';
import '../../styles/pages/store.css';

const { id } = Astro.params;
const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';
const FALLBACK_PRODUCT_IMAGE = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='200' height='200'><rect width='200' height='200' rx='28' fill='%23F5F6F8'/><circle cx='100' cy='100' r='52' fill='%23FFF3E0'/><path d='M108 55L76 108h36l-8 42 40-58h-36z' fill='%23FF7A00'/></svg>";

const bcvRate = await getOfficialExchangeRate();

let assetMap: Record<string, string> = {};
try {
  const assetModule = await import('../../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

const NAME_FIXES: Record<string, string> = {
  'Ariculares SZ-771': 'Auriculares SZ-771',
  '5-Sprinng CHEST PULL': '5-Spring Chest Pull',
  'Abdominal musclw': 'Abdominal Muscle Trainer',
  'Aceite de resino': 'Aceite de Ricino',
  'After chave': 'After Shave Profesional',
  'Back pain need hellp': 'Soporte Lumbar Back Pain',
  'Brocha de ljo': 'Brocha de Lujo'
};

function normalizeName(rawName: string): string {
  const trimmed = (rawName || '').trim();
  return NAME_FIXES[trimmed] || trimmed.replace(/\s{2,}/g, ' ');
}

function classifyStoreSubcategory(name: string, rubroKey: string): string {
  const n = name.toLowerCase();
  if (rubroKey === 'tecnologia') {
    if (n.includes('funda') || n.includes('carcasa') || n.includes('tecno') || n.includes('ufone') || n.includes('phone') || n.includes('móvil') || n.includes('movil')) {
      return 'Fundas y Celulares';
    }
    if (n.includes('gaming') || n.includes('games') || n.includes('mario') || n.includes('batman') || n.includes('iron man') || n.includes('magic q8')) {
      return 'Gaming y Consolas';
    }
    return 'Audífonos y Audio';
  }
  if (n.includes('training') || n.includes('chest') || n.includes('abdominal') || n.includes('lumbar') || n.includes('back pain')) {
    return 'Fitness y Salud';
  }
  if (n.includes('cepillo') || n.includes('peine') || n.includes('bigudies')) {
    return 'Cepillos y Peines';
  }
  if (n.includes('plancha') || n.includes('secador') || n.includes('rizador')) {
    return 'Planchas y Eléctricos';
  }
  if (n.includes('máquina') || n.includes('maquina') || n.includes('brocha') || n.includes('capa') || n.includes('atomizador') || n.includes('grip') || n.includes('navaja') || n.includes('cuchilla') || n.includes('tijera')) {
    return 'Barbería y Equipos';
  }
  return 'Cuidado Capilar y Barba';
}

const allStores = await fetchActiveStores();
let storeData: any = allStores.find((s: any) => s.id === id || s.slug === id) || null;

if (!storeData && id) {
  try {
    const storeRes = await fetch(`${API_BASE}/stores/${id}`);
    if (storeRes.ok) {
      storeData = enrichStore(await storeRes.json());
    }
  } catch {}
}

if (!storeData && allStores.length > 0) {
  storeData = allStores[0];
}

const resolvedStoreId = storeData?.id || id || '';

let productsData: any[] = [];
let reviewsData: any[] = [];

if (resolvedStoreId) {
  try {
    const prodRes = await fetch(`${API_BASE}/stores/${resolvedStoreId}/products`);
    if (prodRes.ok) {
      const pData = await prodRes.json();
      if (Array.isArray(pData)) productsData = pData;
    }
  } catch {}

  try {
    const revRes = await fetch(`${API_BASE}/reviews?store-id=${resolvedStoreId}`);
    if (revRes.ok) {
      const rList = await revRes.json();
      if (Array.isArray(rList)) reviewsData = rList;
    }
  } catch {}
}

const storeName = storeData?.name || 'Comercio Oficial';
const storeRubroKey = storeData?.rubroKey || 'tecnologia';
const storeRubroBadge = storeData?.rubroBadge || 'Comercio verificado';
const storeRubroLabel = storeRubroBadge.replace(/^[^\p{L}]+/u, '').trim();
const storeCategory = storeData?.description || 'Comercio Oficial Verificado en Traigalo';
const storeCover = storeData?.cover_url || '/brand-icon.webp';
const storeLogo = storeData?.logo_url || '/brand-icon.webp';
const avgRating = reviewsData.length > 0
  ? (reviewsData.reduce((acc, r) => acc + (Number(r.store_rating || r.rating) || 5), 0) / reviewsData.length).toFixed(1)
  : '4.9';
const storeReviewsText = reviewsData.length > 0 ? `${reviewsData.length} reseñas verificadas` : 'Comercio oficial verificado';
const storeTime = '15 a 25 min';
const storeFee = '$1.50';
const storeAddress = storeData?.address_line || 'Higuerote, Miranda';

const products = productsData.map((p, idx) => {
  const cleanName = normalizeName(p.name);
  let img = '';
  if (p.attributes?.image_url) {
    img = p.attributes.image_url;
  } else if (p.attributes?.asset_id) {
    img = `${ASSET_BASE}/${p.attributes.asset_id}`;
  } else if (assetMap[p.name]) {
    img = `${ASSET_BASE}/${assetMap[p.name]}`;
  } else if (assetMap[cleanName]) {
    img = `${ASSET_BASE}/${assetMap[cleanName]}`;
  } else {
    img = FALLBACK_PRODUCT_IMAGE;
  }

  const price = Number(p.base_price) || 0;
  const subcat = classifyStoreSubcategory(cleanName, storeRubroKey);
  return {
    id: p.id,
    order: idx,
    storeId: resolvedStoreId,
    storeName: storeName,
    name: cleanName,
    subcategory: subcat,
    desc: (p.description && p.description.length > 10)
      ? p.description
      : `Artículo original disponible en ${storeName} con garantía y despacho express en tu zona.`,
    price,
    priceBs: formatBs(price, bcvRate),
    image: img
  };
});

const subcatCounts: Record<string, number> = { 'Todos los Productos': products.length };
for (const p of products) {
  subcatCounts[p.subcategory] = (subcatCounts[p.subcategory] || 0) + 1;
}
const distinctSubcats = [...new Set(products.map(p => p.subcategory))];
const menuCategories = ['Todos los Productos', ...distinctSubcats];
---

<html lang="es" data-rubro={storeRubroKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{storeName} | Tienda en Traigalo</title>
    <meta name="description" content={storeCategory} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://admin.traigalo.org" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page">
      <div class="tg-aura" aria-hidden="true"></div>

      <Header />

      <div class="tg-wrap">
        <section class="tg-shop-hero" aria-labelledby="store-name">
          <div class="tg-shop-cover">
            <img src={storeCover} alt={`Portada de ${storeName}`} width="1280" height="480" fetchpriority="high" onerror="this.remove()" />
          </div>

          <nav class="tg-shop-nav" aria-label="Otras tiendas">
            <a href="/" class="tg-shop-chip tg-glass">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
              </svg>
              <span>Volver al marketplace</span>
            </a>
            {allStores.filter((s) => s.id !== resolvedStoreId).map((other) => (
              <a href={`/stores/${other.id}`} class="tg-shop-chip tg-shop-chip--other tg-glass">
                <span>Ir a {other.name}</span>
              </a>
            ))}
          </nav>

          <div class="tg-shop-panel tg-glass">
            <div class="tg-shop-id">
              <img class="tg-shop-logo" src={storeLogo} alt={`Logo de ${storeName}`} width="88" height="88" onerror="this.onerror=null; this.classList.add('is-broken');" />
              <div class="tg-shop-title">
                <div class="tg-shop-tags">
                  <span class="tg-shop-open">Abierto ahora</span>
                  <span class="tg-filter-pill">{storeRubroLabel}</span>
                </div>
                <h1 id="store-name">{storeName}</h1>
                <p class="tg-shop-desc">{storeCategory}</p>
                <p class="tg-shop-address">{storeAddress}</p>
              </div>
              <button
                id="btn-favorite-store"
                type="button"
                aria-label="Guardar tienda en favoritos"
                aria-pressed="false"
                class="tg-icon-btn tg-shop-fav"
              >
                <span id="fav-heart-icon" class="tg-shop-heart" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10z" />
                  </svg>
                </span>
              </button>
            </div>

            <dl class="tg-store-facts tg-shop-facts">
              <div><dt>Calificación</dt><dd>{avgRating} <span class="tg-shop-muted">({storeReviewsText})</span></dd></div>
              <div><dt>Entrega</dt><dd>{storeTime}</dd></div>
              <div><dt>Envío</dt><dd>{storeFee}</dd></div>
              <div><dt>Productos</dt><dd>{products.length}</dd></div>
              <div><dt>Tasa BCV</dt><dd>{bcvRate.toFixed(2)} Bs/$</dd></div>
            </dl>
          </div>
        </section>
      </div>

      <div class="tg-shop-toolbar">
        <div class="tg-wrap tg-shop-toolbar-inner">
          <div class="tg-cats tg-shop-cats no-scrollbar" id="store-cat-tabs">
            {menuCategories.map((cat, idx) => (
              <button
                type="button"
                data-subcat={cat}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class="store-tab-btn category-btn"
              >
                <span class="tg-cat-name">{cat}</span>
                <span class="cat-count-label">{subcatCounts[cat] || 0}</span>
              </button>
            ))}
          </div>

          <div class="tg-shop-controls">
            <div class="tg-search tg-shop-search">
              <input
                id="store-search-input"
                type="search"
                aria-label={`Buscar en ${storeName}`}
                placeholder={`Buscar en ${storeName}`}
              />
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <select id="store-sort-select" aria-label="Ordenar productos" class="tg-select">
              <option value="default">Destacados</option>
              <option value="price-asc">Precio: menor a mayor</option>
              <option value="price-desc">Precio: mayor a menor</option>
              <option value="name-asc">Nombre de la A a la Z</option>
            </select>
          </div>
        </div>
      </div>

      <main id="store-catalog-top" class="tg-wrap tg-main tg-shop-main">
        <section class="tg-section" aria-labelledby="store-catalog-title">
          <div class="tg-head">
            <div>
              <h2 id="store-catalog-title">Catálogo</h2>
              <p id="store-pagination-status" class="tg-count">
                Mostrando 1 a {Math.min(12, products.length)} de {products.length} productos (página 1 de {Math.max(1, Math.ceil(products.length / 12))})
              </p>
            </div>
            <div class="tg-shop-pagesize">
              <label for="store-pagesize-select">Mostrar</label>
              <select id="store-pagesize-select" class="tg-select">
                <option value="12">12 por página</option>
                <option value="24">24 por página</option>
                <option value="48">48 por página</option>
              </select>
            </div>
          </div>

          <div class="tg-products" id="products-list">
            {products.map((item, idx) => (
              <div
                class={`product-card product-item ${idx >= 12 ? 'hidden' : ''}`}
                data-id={item.id}
                data-order={item.order}
                data-store-id={item.storeId}
                data-store-name={item.storeName}
                data-name={item.name}
                data-search={item.name.toLowerCase()}
                data-subcat={item.subcategory}
                data-price={item.price}
                data-image={item.image}
                data-desc={item.desc}
              >
                <div class="tg-product-img">
                  <img
                    src={item.image}
                    alt={item.name}
                    width="300"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    onerror="this.onerror=null; this.classList.add('is-broken');"
                  />
                </div>
                <div>
                  <span class="tg-shop-subcat">{item.subcategory}</span>
                  <h3 class="tg-product-name">{item.name}</h3>
                  <p class="tg-shop-pdesc">{item.desc}</p>
                </div>
                <div class="tg-product-buy">
                  <div>
                    <span class="tg-price">${item.price.toFixed(2)}</span>
                    <span class="tg-price-bs">{item.priceBs}</span>
                  </div>
                  <button type="button" aria-label={`Agregar ${item.name} al carrito`} class="btn-add-product btn-home-add">+</button>
                </div>
              </div>
            ))}
          </div>

          <div id="store-pagination-bar" class="tg-pagination">
            <span id="store-pagination-summary"></span>
            <div id="store-pagination-buttons" class="tg-page-btns"></div>
          </div>

          <div id="store-no-results" class="hidden tg-empty">
            <h3>No encontramos artículos con ese criterio en {storeName}</h3>
          </div>
        </section>

        {reviewsData.length > 0 && (
          <section class="tg-section tg-shop-reviews" aria-labelledby="store-reviews-title">
            <div class="tg-head">
              <h2 id="store-reviews-title">Opiniones de clientes</h2>
              <p>{avgRating} de 5, {reviewsData.length} reseñas</p>
            </div>
            <ul class="tg-shop-review-list">
              {reviewsData.slice(0, 5).map((rev) => (
                <li>
                  <div class="tg-row">
                    <span class="tg-shop-review-who">Compra verificada</span>
                    <span class="tg-shop-stars" aria-label={`${Number(rev.store_rating || rev.rating || 5)} de 5`}>{'★'.repeat(Number(rev.store_rating || rev.rating || 5))}</span>
                  </div>
                  {rev.comment && <p>{rev.comment}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </main>

      <div id="product-modal" class="tg-modal opacity-0 pointer-events-none" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div id="modal-card" class="tg-modal-card translate-y-full sm:translate-y-4">
          <div class="tg-row">
            <span class="tg-store-chip tg-shop-modal-store">
              <img src={storeLogo} alt="" width="20" height="20" onerror="this.remove()" />
              {storeName}
            </span>
            <button id="close-modal-btn" type="button" class="tg-close" aria-label="Cerrar">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="tg-modal-body">
            <div class="tg-modal-img">
              <img id="modal-img" src="" alt="" />
            </div>
            <div>
              <h2 id="modal-title"></h2>
              <p id="modal-desc" class="tg-modal-desc"></p>
            </div>
            <div class="tg-row tg-divide">
              <div>
                <span class="tg-field-label">Cantidad</span>
                <span class="tg-price-bs">Unidades a solicitar</span>
              </div>
              <div class="tg-qty">
                <button id="modal-qty-minus" type="button" aria-label="Quitar una unidad">-</button>
                <span id="modal-qty-display">1</span>
                <button id="modal-qty-plus" type="button" aria-label="Agregar una unidad">+</button>
              </div>
            </div>
            <div>
              <label for="modal-notes" class="tg-field-label">Especificaciones opcionales</label>
              <textarea
                id="modal-notes"
                rows="2"
                maxlength="200"
                placeholder="Ej. color preferido, modelo de teléfono o indicación para la tienda"
                class="tg-input tg-shop-notes"
              ></textarea>
            </div>
            <div class="tg-row tg-divide">
              <span class="tg-field-label">Subtotal producto</span>
              <div>
                <span id="modal-price" class="tg-modal-price"></span>
                <span id="modal-price-bs" class="tg-price-bs tg-shop-right"></span>
              </div>
            </div>
          </div>
          <div class="tg-modal-foot">
            <button id="modal-add-btn" type="button" class="tg-btn tg-btn--primary">
              <span id="modal-add-btn-text">Agregar al carrito</span>
            </button>
          </div>
        </div>
      </div>

      <div id="cart-bar" class="tg-cartbar opacity-0 translate-y-4 pointer-events-none">
        <a href="/checkout">
          <span class="tg-cart-left">
            <span id="cart-count" class="tg-cart-count">0</span>
            <span>
              Ver carrito
              <small id="cart-stores-label"></small>
            </span>
          </span>
          <span class="tg-cart-total">
            <span id="cart-total">$0.00</span>
            <small id="cart-total-bs"></small>
          </span>
        </a>
      </div>

      <Footer />
      <BottomNav />
    </div>

    <script is:inline define:vars={{ bcvRate, resolvedStoreId, storeName }}>
    (() => {
      const CART_STORAGE_KEY = 'traigalo_cart';
      const FAV_STORES_KEY = 'traigalo_fav_stores';

      let activeSubcat = 'Todos los Productos';
      let storeSearchText = '';
      let storeSort = 'default';
      let currentPage = 1;
      let pageSize = 12;

      const productsListEl = document.getElementById('products-list');
      const allStoreCards = Array.from(document.querySelectorAll('.product-card'));

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateCartBar();
      }

      function addToCart(product, quantity = 1, notes = '') {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id && (item.notes || '') === notes);
        if (existing) {
          existing.qty = (existing.qty || 1) + quantity;
          if (!existing.storeName) existing.storeName = product.storeName || storeName;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId || resolvedStoreId,
            storeName: product.storeName || storeName,
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: quantity,
            notes: notes
          });
        }
        saveCart(cart);
      }

      function updateCartBar() {
        const cart = getCart();
        const cartBar = document.getElementById('cart-bar');
        const cartCount = document.getElementById('cart-count');
        const cartStoresLabel = document.getElementById('cart-stores-label');
        const cartTotal = document.getElementById('cart-total');
        const cartTotalBs = document.getElementById('cart-total-bs');
        if (!cartBar || !cartCount || !cartTotal) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);
        const distinctStores = [...new Set(cart.map(i => i.storeName).filter(Boolean))];

        if (totalQty > 0) {
          cartCount.textContent = String(totalQty);
          cartTotal.textContent = `$${totalPrice.toFixed(2)}`;
          if (cartTotalBs) {
            cartTotalBs.textContent = formatBsClient(totalPrice);
          }
          if (cartStoresLabel) {
            cartStoresLabel.textContent = distinctStores.length > 1
              ? `Multi-Tienda (${distinctStores.length} comercios)`
              : (distinctStores[0] || storeName);
          }
          cartBar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.add('opacity-100', 'translate-y-0');
        } else {
          cartBar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      const favBtn = document.getElementById('btn-favorite-store');
      const favIcon = document.getElementById('fav-heart-icon');
      function isStoreFavorited() {
        try {
          const list = JSON.parse(localStorage.getItem(FAV_STORES_KEY) || '[]');
          return list.includes(resolvedStoreId);
        } catch {
          return false;
        }
      }
      function updateFavIcon() {
        if (favIcon && favBtn) {
          favBtn.setAttribute('aria-pressed', isStoreFavorited() ? 'true' : 'false');
        }
      }
      if (favBtn) {
        favBtn.addEventListener('click', () => {
          try {
            let list = JSON.parse(localStorage.getItem(FAV_STORES_KEY) || '[]');
            if (list.includes(resolvedStoreId)) {
              list = list.filter((id) => id !== resolvedStoreId);
            } else {
              list.push(resolvedStoreId);
            }
            localStorage.setItem(FAV_STORES_KEY, JSON.stringify(list));
            updateFavIcon();
          } catch {}
        });
      }
      updateFavIcon();

      function renderStorePagination(totalItems, totalPages) {
        const bar = document.getElementById('store-pagination-bar');
        const summary = document.getElementById('store-pagination-summary');
        const btnWrap = document.getElementById('store-pagination-buttons');
        if (!bar || !summary || !btnWrap) return;

        if (totalItems === 0) {
          bar.classList.add('hidden');
          return;
        }
        bar.classList.remove('hidden');

        const startIdx = (currentPage - 1) * pageSize + 1;
        const endIdx = Math.min(currentPage * pageSize, totalItems);
        summary.textContent = `Página ${currentPage} de ${totalPages}, mostrando ${startIdx} a ${endIdx} de ${totalItems} productos`;
        btnWrap.innerHTML = '';

        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.textContent = 'Anterior';
        prevBtn.disabled = currentPage <= 1;
        prevBtn.className = 'tg-page-btn';
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            filterAndPaginateStoreProducts(true);
          }
        });
        btnWrap.appendChild(prevBtn);

        for (let p = 1; p <= totalPages; p++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = String(p);
          b.className = 'tg-page-btn';
          if (p === currentPage) b.setAttribute('aria-current', 'page');
          b.addEventListener('click', () => {
            if (currentPage !== p) {
              currentPage = p;
              filterAndPaginateStoreProducts(true);
            }
          });
          btnWrap.appendChild(b);
        }

        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.textContent = 'Siguiente';
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.className = 'tg-page-btn';
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            filterAndPaginateStoreProducts(true);
          }
        });
        btnWrap.appendChild(nextBtn);
      }

      function filterAndPaginateStoreProducts(scrollTop = false) {
        const noRes = document.getElementById('store-no-results');
        const statusEl = document.getElementById('store-pagination-status');

        const matched = allStoreCards.filter((card) => {
          const subcat = card.getAttribute('data-subcat') || '';
          const search = card.getAttribute('data-search') || '';
          const matchTab = activeSubcat === 'Todos los Productos' || subcat === activeSubcat;
          const matchSearch = !storeSearchText || search.includes(storeSearchText);
          return matchTab && matchSearch;
        });

        matched.sort((a, b) => {
          if (storeSort === 'price-asc') {
            return parseFloat(a.getAttribute('data-price') || '0') - parseFloat(b.getAttribute('data-price') || '0');
          }
          if (storeSort === 'price-desc') {
            return parseFloat(b.getAttribute('data-price') || '0') - parseFloat(a.getAttribute('data-price') || '0');
          }
          if (storeSort === 'name-asc') {
            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
          }
          return parseInt(a.getAttribute('data-order') || '0', 10) - parseInt(b.getAttribute('data-order') || '0', 10);
        });

        const totalMatched = matched.length;
        const totalPages = Math.max(1, Math.ceil(totalMatched / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = startIdx + pageSize;
        const visibleSet = new Set(matched.slice(startIdx, endIdx));

        allStoreCards.forEach((c) => c.classList.add('hidden'));
        if (productsListEl) {
          matched.forEach((c) => {
            productsListEl.appendChild(c);
            if (visibleSet.has(c)) c.classList.remove('hidden');
          });
        }

        if (statusEl) {
          if (totalMatched === 0) {
            statusEl.textContent = '0 productos encontrados';
          } else {
            statusEl.textContent = `Mostrando ${startIdx + 1} a ${Math.min(endIdx, totalMatched)} de ${totalMatched} productos (página ${currentPage} de ${totalPages})`;
          }
        }

        if (noRes) {
          if (totalMatched === 0) noRes.classList.remove('hidden');
          else noRes.classList.add('hidden');
        }

        renderStorePagination(totalMatched, totalPages);

        if (scrollTop) {
          const topEl = document.getElementById('store-catalog-top');
          if (topEl) topEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      document.querySelectorAll('.store-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.store-tab-btn').forEach((b) => {
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          activeSubcat = btn.getAttribute('data-subcat') || 'Todos los Productos';
          currentPage = 1;
          filterAndPaginateStoreProducts(false);
        });
      });

      const storeSearchInput = document.getElementById('store-search-input');
      if (storeSearchInput) {
        storeSearchInput.addEventListener('input', (e) => {
          storeSearchText = e.target.value.trim().toLowerCase();
          currentPage = 1;
          filterAndPaginateStoreProducts(false);
        });
      }

      const storeSortSelect = document.getElementById('store-sort-select');
      if (storeSortSelect) {
        storeSortSelect.addEventListener('change', (e) => {
          storeSort = e.target.value || 'default';
          currentPage = 1;
          filterAndPaginateStoreProducts(false);
        });
      }

      const storePageSizeSelect = document.getElementById('store-pagesize-select');
      if (storePageSizeSelect) {
        storePageSizeSelect.addEventListener('change', (e) => {
          pageSize = parseInt(e.target.value || '12', 10);
          currentPage = 1;
          filterAndPaginateStoreProducts(false);
        });
      }

      const modal = document.getElementById('product-modal');
      const modalCard = document.getElementById('modal-card');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');
      const modalPrice = document.getElementById('modal-price');
      const modalPriceBs = document.getElementById('modal-price-bs');
      const modalQtyDisplay = document.getElementById('modal-qty-display');
      const modalQtyMinus = document.getElementById('modal-qty-minus');
      const modalQtyPlus = document.getElementById('modal-qty-plus');
      const modalNotes = document.getElementById('modal-notes');
      const modalAddBtn = document.getElementById('modal-add-btn');
      const closeModalBtn = document.getElementById('close-modal-btn');
      let currentModalProduct = null;
      let modalQuantity = 1;

      function updateModalPrice() {
        if (!currentModalProduct) return;
        const subtotal = Number(currentModalProduct.price) * modalQuantity;
        if (modalPrice) modalPrice.textContent = `$${subtotal.toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(subtotal);
        if (modalQtyDisplay) modalQtyDisplay.textContent = String(modalQuantity);
      }

      if (modalQtyMinus) {
        modalQtyMinus.addEventListener('click', () => {
          if (modalQuantity > 1) {
            modalQuantity--;
            updateModalPrice();
          }
        });
      }

      if (modalQtyPlus) {
        modalQtyPlus.addEventListener('click', () => {
          if (modalQuantity < 99) {
            modalQuantity++;
            updateModalPrice();
          }
        });
      }

      function openModal(prod) {
        currentModalProduct = prod;
        modalQuantity = 1;
        if (modalNotes) modalNotes.value = '';
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        updateModalPrice();

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        currentModalProduct = null;
        modalQuantity = 1;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (currentModalProduct) {
            const notes = modalNotes ? modalNotes.value.trim() : '';
            addToCart(currentModalProduct, modalQuantity, notes);
            closeModal();
          }
        });
      }

      allStoreCards.forEach(card => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          storeName: card.getAttribute('data-store-name'),
          name: card.getAttribute('data-name'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image'),
          desc: card.getAttribute('data-desc')
        };

        const addBtn = card.querySelector('.btn-add-product');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod);
            addBtn.textContent = '✓';
            addBtn.classList.add('is-added');
            setTimeout(() => {
              addBtn.textContent = '+';
              addBtn.classList.remove('is-added');
            }, 900);
          });
        }

        card.addEventListener('click', () => {
          openModal(prod);
        });
      });

      filterAndPaginateStoreProducts(false);
      updateCartBar();
    })();
    </script>
  </body>
</html>
