---
import BottomNav from '../../components/BottomNav.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const { id } = Astro.params;
const API_BASE = 'https://api.traigalo.org/v2';
const ASSET_BASE = 'https://admin.traigalo.org/assets';

const bcvRate = await getOfficialExchangeRate();

let assetMap: Record<string, string> = {};
try {
  const assetModule = await import('../../data/product_assets.json');
  assetMap = assetModule.default || {};
} catch {}

let storeData: any = null;
let productsData: any[] = [];

try {
  const storeRes = await fetch(`${API_BASE}/stores/${id}`);
  if (storeRes.ok) {
    storeData = await storeRes.json();
  }
} catch {}

if (!storeData) {
  try {
    const listRes = await fetch(`${API_BASE}/stores`);
    if (listRes.ok) {
      const stores = await listRes.json();
      storeData = stores.find((s: any) => s.id === id || s.slug === id) || stores[0];
    }
  } catch {}
}

const resolvedStoreId = storeData?.id || id || 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa';

try {
  const prodRes = await fetch(`${API_BASE}/stores/${resolvedStoreId}/products`);
  if (prodRes.ok) {
    productsData = await prodRes.json();
  }
} catch {}

const storeName = storeData?.name || 'Comercio Oficial';
const storeCategory = storeData?.description || 'Tienda verificada en Traigalo';
const storeRating = '4.9';
const storeReviews = '850+ reseñas';
const storeTime = '15-25 min';
const storeFee = '$1.50';
const storeAddress = storeData?.address_line || 'Caracas, Venezuela';

const products = productsData.map((p) => {
  let img = '';
  if (p.attributes?.image_url) {
    img = p.attributes.image_url;
  } else if (p.attributes?.asset_id) {
    img = `${ASSET_BASE}/${p.attributes.asset_id}`;
  } else if (assetMap[p.name]) {
    img = `${ASSET_BASE}/${assetMap[p.name]}`;
  } else {
    img = `${ASSET_BASE}/e20f2cbd-295f-41ad-be33-56517ab5eff2`;
  }

  const price = Number(p.base_price) || 0;
  return {
    id: p.id,
    storeId: resolvedStoreId,
    name: p.name,
    desc: p.description || 'Producto oficial disponible para entrega express en tu ubicación.',
    price,
    priceBs: formatBs(price, bcvRate),
    image: img
  };
});

const menuCategories = ['Todos los Productos', 'Más Populares', 'Promociones'];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>{storeName} | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-28 antialiased selection:bg-[#FF7A00] selection:text-white">
    
    <div class="relative h-64 sm:h-72 w-full bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 overflow-hidden flex items-end p-6">
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/30"></div>

      <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
        <a href="/" class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-gray-900 shadow-md hover:bg-white transition-all active:scale-95">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>

        <div class="flex items-center gap-2">
          <div class="px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-black text-gray-800 shadow-sm border border-gray-100">
            BCV: {bcvRate.toFixed(2)} Bs/$
          </div>
          <button class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-gray-700 shadow-md hover:text-red-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="relative z-10 text-white">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-[#FF7A00] text-[10px] font-black uppercase tracking-wider mb-1.5 shadow-xs">
          ★ Tienda Verificada
        </div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight">{storeName}</h1>
        <p class="text-xs text-gray-200 mt-0.5">{storeCategory}</p>
        <p class="text-[11px] text-gray-300 mt-0.5 truncate max-w-md">📍 {storeAddress}</p>
      </div>
    </div>

    <div class="bg-white border-b border-gray-100 px-4 py-3 shadow-2xs">
      <div class="max-w-4xl mx-auto flex items-center justify-between text-xs font-bold text-gray-700">
        <div class="flex items-center gap-1">
          <span class="text-amber-500 text-sm">★</span>
          <span>{storeRating}</span>
          <span class="text-gray-400 font-normal">({storeReviews})</span>
        </div>
        <div class="w-1 h-1 rounded-full bg-gray-300"></div>
        <div class="flex items-center gap-1">
          <span>⚡</span>
          <span>{storeTime}</span>
        </div>
        <div class="w-1 h-1 rounded-full bg-gray-300"></div>
        <div class="flex items-center gap-1 text-[#FF7A00]">
          <span>🛵</span>
          <span>Envío {storeFee}</span>
        </div>
      </div>
    </div>

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-6 w-full">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-4 mb-4">
        {menuCategories.map((cat, idx) => (
          <button class={`shrink-0 px-4 py-2 rounded-full text-xs font-bold transition-all ${
            idx === 0 
              ? 'bg-[#FF7A00] text-white shadow-md shadow-orange-600/20' 
              : 'bg-white border border-gray-100 text-gray-600 hover:border-gray-200'
          }`}>
            {cat}
          </button>
        ))}
      </div>

      <div class="space-y-4" id="products-list">
        {products.map(item => (
          <div 
            class="product-card bg-white rounded-3xl p-3.5 border border-gray-100/90 shadow-xs hover:shadow-md transition-all flex gap-3.5 group cursor-pointer"
            data-id={item.id}
            data-store-id={item.storeId}
            data-name={item.name}
            data-price={item.price}
            data-image={item.image}
            data-desc={item.desc}
          >
            <div class="flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-sm font-extrabold text-gray-900 group-hover:text-[#FF7A00] transition-colors leading-snug">
                  {item.name}
                </h3>
                <p class="text-[11px] text-gray-400 mt-1 line-clamp-2 leading-relaxed">
                  {item.desc}
                </p>
              </div>

              <div class="mt-3 flex flex-col">
                <span class="text-sm font-black text-gray-950">
                  ${item.price.toFixed(2)}
                </span>
                <span class="text-[10px] text-gray-400 font-semibold tracking-tight">
                  {item.priceBs}
                </span>
              </div>
            </div>

            <div class="relative w-28 h-28 rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 shrink-0 flex items-center justify-center p-2">
              <img 
                src={item.image} 
                alt={item.name} 
                class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform" 
                loading="lazy" 
                onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'64\' height=\'64\' fill=\'none\' stroke=\'%23FF7A00\' stroke-width=\'2\'><rect width=\'60\' height=\'60\' x=\'2\' y=\'2\' rx=\'12\' fill=\'%23FAFAFC\'/><path d=\'M24 32h16M32 24v16\'/></svg>';"
              />
              <button 
                type="button"
                aria-label={`Añadir ${item.name}`}
                class="btn-add-product absolute bottom-2 right-2 w-8 h-8 rounded-full bg-[#FF7A00] hover:bg-[#E66E00] active:scale-90 text-white flex items-center justify-center shadow-md shadow-orange-600/30 transition-all z-10"
              >
                <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <div id="product-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div id="modal-card" class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl p-5 shadow-2xl transform translate-y-full sm:translate-y-4 transition-transform duration-200 flex flex-col max-h-[90vh]">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <span class="text-xs font-black uppercase tracking-wider text-[#FF7A00]">Detalle de Producto</span>
          <button id="close-modal-btn" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 font-black">
            ✕
          </button>
        </div>
        <div class="overflow-y-auto py-4 space-y-3 flex-1">
          <div class="h-48 w-full rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 flex items-center justify-center p-4">
            <img id="modal-img" src="" alt="" class="w-full h-full object-contain" />
          </div>
          <h2 id="modal-title" class="text-base font-extrabold text-gray-900 leading-snug"></h2>
          <p id="modal-desc" class="text-xs text-gray-500 leading-relaxed"></p>
          <div class="pt-2 flex items-center justify-between">
            <span class="text-xs text-gray-400 font-bold">Precio Unitario</span>
            <div class="text-right">
              <span id="modal-price" class="text-lg font-black text-[#FF7A00] block"></span>
              <span id="modal-price-bs" class="text-[10px] text-gray-400 font-semibold block"></span>
            </div>
          </div>
        </div>
        <div class="pt-3 border-t border-gray-100 flex items-center gap-3">
          <button id="modal-add-btn" class="flex-1 h-12 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg shadow-orange-600/30 active:scale-98 transition-all">
            <span>Agregar al Carrito</span>
          </button>
        </div>
      </div>
    </div>

    <div id="cart-bar" class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-gradient-to-t from-white via-white/90 to-transparent pointer-events-none transition-all duration-300 opacity-0 translate-y-4">
      <div class="max-w-4xl mx-auto pointer-events-auto">
        <a 
          href="/checkout" 
          class="w-full h-14 rounded-2xl bg-gradient-to-r from-[#FF7A00] to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white font-extrabold text-sm px-6 flex items-center justify-between shadow-xl shadow-orange-600/30 active:scale-98 transition-all"
        >
          <div class="flex items-center gap-2.5">
            <span id="cart-count" class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs">0</span>
            <span>Ver Carrito</span>
          </div>
          <div class="flex items-center gap-2 text-right">
            <div>
              <span id="cart-total" class="font-black">$0.00</span>
              <span id="cart-total-bs" class="block text-[10px] text-white/80 font-medium"></span>
            </div>
            <span>→</span>
          </div>
        </a>
      </div>
    </div>

    <script is:inline define:vars={{ bcvRate }}>
      const CART_STORAGE_KEY = 'traigalo_cart';

      function getCart() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }

      function formatBsClient(usd) {
        const bs = (usd || 0) * (bcvRate || 896.12);
        const formatted = new Intl.NumberFormat('es-VE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(bs);
        return `~ Bs. ${formatted} @ BCV`;
      }

      function saveCart(cart) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
        } catch {}
        updateCartBar();
      }

      function addToCart(product) {
        const cart = getCart();
        const existing = cart.find(item => item.id === product.id);
        if (existing) {
          existing.qty = (existing.qty || 1) + 1;
        } else {
          cart.push({
            id: product.id,
            storeId: product.storeId,
            name: product.name,
            price: Number(product.price),
            image: product.image,
            qty: 1
          });
        }
        saveCart(cart);
      }

      function updateCartBar() {
        const cart = getCart();
        const cartBar = document.getElementById('cart-bar');
        const cartCount = document.getElementById('cart-count');
        const cartTotal = document.getElementById('cart-total');
        const cartTotalBs = document.getElementById('cart-total-bs');
        if (!cartBar || !cartCount || !cartTotal) return;

        const totalQty = cart.reduce((acc, item) => acc + (item.qty || 1), 0);
        const totalPrice = cart.reduce((acc, item) => acc + (item.price * (item.qty || 1)), 0);

        if (totalQty > 0) {
          cartCount.textContent = String(totalQty);
          cartTotal.textContent = `$${totalPrice.toFixed(2)}`;
          if (cartTotalBs) {
            cartTotalBs.textContent = formatBsClient(totalPrice);
          }
          cartBar.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.add('opacity-100', 'translate-y-0');
        } else {
          cartBar.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          cartBar.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      const modal = document.getElementById('product-modal');
      const modalCard = document.getElementById('modal-card');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');
      const modalPrice = document.getElementById('modal-price');
      const modalPriceBs = document.getElementById('modal-price-bs');
      const modalAddBtn = document.getElementById('modal-add-btn');
      const closeModalBtn = document.getElementById('close-modal-btn');
      let currentModalProduct = null;

      function openModal(prod) {
        currentModalProduct = prod;
        if (modalImg) modalImg.src = prod.image;
        if (modalTitle) modalTitle.textContent = prod.name;
        if (modalDesc) modalDesc.textContent = prod.desc;
        if (modalPrice) modalPrice.textContent = `$${Number(prod.price).toFixed(2)}`;
        if (modalPriceBs) modalPriceBs.textContent = formatBsClient(Number(prod.price));

        if (modal && modalCard) {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100');
          modalCard.classList.remove('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.add('translate-y-0');
        }
      }

      function closeModal() {
        if (modal && modalCard) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100');
          modalCard.classList.add('translate-y-full', 'sm:translate-y-4');
          modalCard.classList.remove('translate-y-0');
        }
        currentModalProduct = null;
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      if (modalAddBtn) {
        modalAddBtn.addEventListener('click', () => {
          if (currentModalProduct) {
            addToCart(currentModalProduct);
            closeModal();
          }
        });
      }

      document.querySelectorAll('.product-card').forEach(card => {
        const prod = {
          id: card.getAttribute('data-id'),
          storeId: card.getAttribute('data-store-id'),
          name: card.getAttribute('data-name'),
          price: parseFloat(card.getAttribute('data-price') || '0'),
          image: card.getAttribute('data-image'),
          desc: card.getAttribute('data-desc')
        };

        const addBtn = card.querySelector('.btn-add-product');
        if (addBtn) {
          addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addToCart(prod);
          });
        }

        card.addEventListener('click', () => {
          openModal(prod);
        });
      });

      updateCartBar();
    </script>
  </body>
</html>
