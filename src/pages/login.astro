---
import '../styles/global.css';
import '../styles/pages/auth.css';
import Logo from '../components/Logo.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión | Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="tg-page auth-page">
      <div class="tg-aura" aria-hidden="true"></div>
      <RoleSwitcher />

      <header class="auth-top">
        <a href="/" class="auth-back tg-glass" aria-label="Volver">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <Logo size="sm" />
        <span class="auth-top-spacer" aria-hidden="true"></span>
      </header>

      <main class="auth-main">
        <div class="auth-intro">
          <span class="auth-badge"><span class="auth-badge-dot" aria-hidden="true"></span><span>Autenticación Segura • Keycloak OIDC</span></span>
          <h1>Iniciar Sesión</h1>
          <p>Accede a tu cuenta para gestionar pedidos, comercios afiliados y entregas</p>
        </div>

        <div class="auth-card">
          <button id="btn-keycloak-sso-redirect" type="button" class="auth-sso">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke-width="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke-width="2" stroke-linecap="round" /></svg>
            <span>Continuar con Keycloak SSO</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <div class="auth-divider"><span>O ingresa tus credenciales</span></div>

          <div id="login-status-box" class="hidden auth-status" role="status" aria-live="polite"></div>

          <div class="auth-field">
            <label for="login-email" class="tg-field-label">Correo Electrónico</label>
            <input type="email" id="login-email" placeholder="nombre@correo.com" autocomplete="email" class="auth-input" />
          </div>

          <div class="auth-field">
            <label for="login-pass" class="tg-field-label">Contraseña</label>
            <input type="password" id="login-pass" placeholder="Tu contraseña" autocomplete="current-password" class="auth-input" />
          </div>

          <button id="btn-login-submit" type="button" class="auth-submit">
            <span>Iniciar Sesión</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <p class="auth-alt">
            ¿No tienes una cuenta aún?
            <a href="/register">Regístrate gratis</a>
          </p>
        </div>
      </main>

      <footer class="auth-foot">
        Traigalo • Identidad OAuth 2.0 / OpenID Connect (<code>auth.traigalo.org</code>)
      </footer>
    </div>

    <script is:inline>
    (() => {
      const KEYCLOAK_ISSUER = 'https://auth.traigalo.org/realms/traigalo';
      const KEYCLOAK_CLIENT_ID = 'traigalo-web';
      const API_BASE = 'https://api.traigalo.org/v2';

      const emailInput = document.getElementById('login-email');
      const passInput = document.getElementById('login-pass');
      const statusBox = document.getElementById('login-status-box');
      const submitBtn = document.getElementById('btn-login-submit');
      const ssoBtn = document.getElementById('btn-keycloak-sso-redirect');

      function showStatus(msg, isError = false) {
        if (!statusBox) return;
        statusBox.textContent = msg;
        statusBox.className = isError
          ? 'p-3 rounded-2xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200'
          : 'p-3 rounded-2xl text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200';
      }

      function decodeJwtPayload(jwtStr) {
        try {
          const base64Url = jwtStr.split('.')[1];
          const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
          return JSON.parse(atob(base64));
        } catch {
          return {};
        }
      }

      function saveSessionAndRedirect(accessToken, refreshToken, userObj) {
        const claims = decodeJwtPayload(accessToken);
        const kcRoles = (claims.realm_access && claims.realm_access.roles) || [];
        let resolvedRole = userObj?.role || 'customer';
        if (kcRoles.includes('vendor')) resolvedRole = 'vendor';
        else if (kcRoles.includes('driver')) resolvedRole = 'driver';
        else if (kcRoles.includes('admin')) resolvedRole = 'admin';

        const email = userObj?.email || claims.email || claims.preferred_username || '';
        const fullName = userObj?.full_name || userObj?.name || claims.name || `${claims.given_name || ''} ${claims.family_name || ''}`.trim() || email.split('@')[0];

        const finalUser = {
          id: userObj?.id || claims.sub || '',
          keycloak_id: claims.sub || userObj?.keycloak_id || '',
          name: fullName,
          email: email,
          role: resolvedRole,
          issuer: claims.iss || KEYCLOAK_ISSUER,
          auth_provider: 'keycloak_oidc'
        };

        localStorage.setItem('traigalo_token', accessToken);
        if (refreshToken) localStorage.setItem('traigalo_refresh_token', refreshToken);
        localStorage.setItem('traigalo_user', JSON.stringify(finalUser));

        if (resolvedRole === 'vendor') {
          window.location.href = '/vendor';
        } else if (resolvedRole === 'driver') {
          window.location.href = '/driver';
        } else if (resolvedRole === 'admin') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/';
        }
      }

      if (ssoBtn) {
        ssoBtn.addEventListener('click', () => {
          const redirectUri = `${window.location.origin}/login`;
          const authUrl = `${KEYCLOAK_ISSUER}/protocol/openid-connect/auth?client_id=${encodeURIComponent(KEYCLOAK_CLIENT_ID)}&response_type=code&scope=${encodeURIComponent('openid profile email')}&redirect_uri=${encodeURIComponent(redirectUri)}`;
          window.location.href = authUrl;
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const oauthCode = urlParams.get('code');
      if (oauthCode) {
        showStatus('Verificando sesión OAuth2 con Keycloak...', false);
        const redirectUri = `${window.location.origin}/login`;
        (async () => {
          try {
            const apiRes = await fetch(`${API_BASE}/auth/login`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ code: oauthCode, redirect_uri: redirectUri })
            });
            if (apiRes.ok) {
              const data = await apiRes.json();
              saveSessionAndRedirect(data.token, data.refresh_token, data.user);
              return;
            }

            const kcRes = await fetch(`${KEYCLOAK_ISSUER}/protocol/openid-connect/token`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({
                client_id: KEYCLOAK_CLIENT_ID,
                grant_type: 'authorization_code',
                code: oauthCode,
                redirect_uri: redirectUri
              })
            });
            if (kcRes.ok) {
              const tok = await kcRes.json();
              saveSessionAndRedirect(tok.access_token, tok.refresh_token, null);
              return;
            }
            showStatus('La sesión expiró. Por favor inicia sesión nuevamente.', true);
          } catch {
            showStatus('Error al verificar sesión con Keycloak.', true);
          }
        })();
      }

      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          const email = emailInput ? emailInput.value.trim() : '';
          const password = passInput ? passInput.value : '';
          if (!email || !password) {
            showStatus('Por favor ingresa tu correo electrónico y contraseña.', true);
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = 'Autenticando...';

          try {
            const res = await fetch(`${API_BASE}/auth/login`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, password })
            });
            if (res.ok) {
              const data = await res.json();
              if (data.token) {
                showStatus('Sesión iniciada correctamente. Redirigiendo...', false);
                saveSessionAndRedirect(data.token, data.refresh_token, data.user);
                return;
              }
            }

            const kcDirect = await fetch(`${KEYCLOAK_ISSUER}/protocol/openid-connect/token`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({
                client_id: KEYCLOAK_CLIENT_ID,
                grant_type: 'password',
                username: email,
                password: password,
                scope: 'openid profile email'
              })
            });

            if (kcDirect.ok) {
              const tok = await kcDirect.json();
              showStatus('Sesión iniciada correctamente. Redirigiendo...', false);
              saveSessionAndRedirect(tok.access_token, tok.refresh_token, null);
              return;
            }

            showStatus('Correo electrónico o contraseña incorrectos.', true);
          } catch {
            showStatus('Error de conexión con el servidor de identidad.', true);
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Iniciar Sesión</span><span>→</span>';
          }
        });
      }
    })();
    </script>
  </body>
</html>
