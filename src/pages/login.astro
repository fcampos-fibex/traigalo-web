---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import RoleSwitcher from '../components/RoleSwitcher.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Iniciar Sesión | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col justify-between antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher />

    <header class="p-4 sm:p-6 flex items-center justify-between max-w-md mx-auto w-full">
      <a href="/" class="w-10 h-10 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-gray-800 shadow-xs hover:border-gray-200 active:scale-95 transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <Logo size="sm" />
      <div class="w-10"></div>
    </header>

    <main class="flex-1 max-w-md mx-auto px-5 py-4 w-full flex flex-col justify-center">
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-black uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Autenticación Segura • Keycloak OIDC</span>
        </div>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight">Iniciar Sesión</h1>
        <p class="text-xs text-gray-500 mt-1">Accede a tu cuenta para gestionar pedidos, comercios afiliados y entregas</p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm space-y-4">
        <button
          id="btn-keycloak-sso-redirect"
          type="button"
          class="w-full py-3.5 px-4 rounded-2xl bg-[#0B132B] hover:bg-[#151E38] text-white font-black text-xs sm:text-sm shadow-md flex items-center justify-center gap-2.5 transition-all active:scale-98 cursor-pointer"
        >
          <span>🔐</span>
          <span>Continuar con Keycloak SSO</span>
          <span>↗</span>
        </button>

        <div class="relative flex py-1 items-center">
          <div class="flex-grow border-t border-gray-100"></div>
          <span class="shrink mx-3 text-[10px] font-black uppercase tracking-wider text-gray-400">O ingresa tus credenciales</span>
          <div class="flex-grow border-t border-gray-100"></div>
        </div>

        <div id="login-status-box" class="hidden p-3 rounded-2xl text-xs font-bold"></div>

        <div>
          <label for="login-email" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Correo Electrónico</label>
          <input 
            type="email" 
            id="login-email" 
            placeholder="nombre@correo.com" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <div>
          <label for="login-pass" class="block text-[11px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Contraseña</label>
          <input 
            type="password" 
            id="login-pass" 
            placeholder="••••••••" 
            class="w-full h-12 px-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
          />
        </div>

        <button 
          id="btn-login-submit"
          type="button" 
          class="w-full h-13 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-black text-sm shadow-lg shadow-orange-600/25 active:scale-98 transition-all flex items-center justify-center gap-2 mt-2 cursor-pointer"
        >
          <span>Iniciar Sesión</span>
          <span>→</span>
        </button>

        <p class="text-center text-xs text-gray-400 pt-2">
          ¿No tienes una cuenta aún? 
          <a href="/register" class="text-[#FF7A00] font-black hover:underline">Regístrate gratis</a>
        </p>
      </div>
    </main>

    <footer class="p-6 text-center text-[11px] text-gray-400">
      Traigalo ⚡ • Identidad OAuth 2.0 / OpenID Connect (<code class="text-gray-600 font-bold">auth.traigalo.org</code>)
    </footer>

    <script is:inline>
    (() => {
      const KEYCLOAK_ISSUER = 'https://auth.traigalo.org/realms/traigalo';
      const KEYCLOAK_CLIENT_ID = 'traigalo-web';
      const API_BASE = 'https://api.traigalo.org/v2';

      const emailInput = document.getElementById('login-email');
      const passInput = document.getElementById('login-pass');
      const statusBox = document.getElementById('login-status-box');
      const submitBtn = document.getElementById('btn-login-submit');
      const ssoBtn = document.getElementById('btn-keycloak-sso-redirect');

      function showStatus(msg, isError = false) {
        if (!statusBox) return;
        statusBox.textContent = msg;
        statusBox.className = isError
          ? 'p-3 rounded-2xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200'
          : 'p-3 rounded-2xl text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
      }

      function decodeJwtPayload(jwtStr) {
        try {
          const base64Url = jwtStr.split('.')[1];
          const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
          return JSON.parse(atob(base64));
        } catch {
          return {};
        }
      }

      function saveSessionAndRedirect(accessToken, refreshToken, userObj) {
        const claims = decodeJwtPayload(accessToken);
        const kcRoles = (claims.realm_access && claims.realm_access.roles) || [];
        let resolvedRole = userObj?.role || 'customer';
        if (kcRoles.includes('vendor')) resolvedRole = 'vendor';
        else if (kcRoles.includes('driver')) resolvedRole = 'driver';
        else if (kcRoles.includes('admin')) resolvedRole = 'admin';

        const email = userObj?.email || claims.email || claims.preferred_username || '';
        const fullName = userObj?.full_name || userObj?.name || claims.name || `${claims.given_name || ''} ${claims.family_name || ''}`.trim() || email.split('@')[0];

        const finalUser = {
          id: userObj?.id || claims.sub || '',
          keycloak_id: claims.sub || userObj?.keycloak_id || '',
          name: fullName,
          email: email,
          role: resolvedRole,
          issuer: claims.iss || KEYCLOAK_ISSUER,
          auth_provider: 'keycloak_oidc'
        };

        localStorage.setItem('traigalo_token', accessToken);
        if (refreshToken) localStorage.setItem('traigalo_refresh_token', refreshToken);
        localStorage.setItem('traigalo_user', JSON.stringify(finalUser));

        if (resolvedRole === 'vendor') {
          window.location.href = '/vendor';
        } else if (resolvedRole === 'driver') {
          window.location.href = '/driver';
        } else if (resolvedRole === 'admin') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/';
        }
      }

      if (ssoBtn) {
        ssoBtn.addEventListener('click', () => {
          const redirectUri = `${window.location.origin}/login`;
          const authUrl = `${KEYCLOAK_ISSUER}/protocol/openid-connect/auth?client_id=${encodeURIComponent(KEYCLOAK_CLIENT_ID)}&response_type=code&scope=${encodeURIComponent('openid profile email')}&redirect_uri=${encodeURIComponent(redirectUri)}`;
          window.location.href = authUrl;
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const oauthCode = urlParams.get('code');
      if (oauthCode) {
        showStatus('Verificando sesión OAuth2 con Keycloak...', false);
        const redirectUri = `${window.location.origin}/login`;
        (async () => {
          try {
            const apiRes = await fetch(`${API_BASE}/auth/login`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ code: oauthCode, redirect_uri: redirectUri })
            });
            if (apiRes.ok) {
              const data = await apiRes.json();
              saveSessionAndRedirect(data.token, data.refresh_token, data.user);
              return;
            }

            const kcRes = await fetch(`${KEYCLOAK_ISSUER}/protocol/openid-connect/token`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({
                client_id: KEYCLOAK_CLIENT_ID,
                grant_type: 'authorization_code',
                code: oauthCode,
                redirect_uri: redirectUri
              })
            });
            if (kcRes.ok) {
              const tok = await kcRes.json();
              saveSessionAndRedirect(tok.access_token, tok.refresh_token, null);
              return;
            }
            showStatus('La sesión expiró. Por favor inicia sesión nuevamente.', true);
          } catch {
            showStatus('Error al verificar sesión con Keycloak.', true);
          }
        })();
      }

      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          const email = emailInput ? emailInput.value.trim() : '';
          const password = passInput ? passInput.value : '';
          if (!email || !password) {
            showStatus('Por favor ingresa tu correo electrónico y contraseña.', true);
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = 'Autenticando...';

          try {
            const res = await fetch(`${API_BASE}/auth/login`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, password })
            });
            if (res.ok) {
              const data = await res.json();
              if (data.token) {
                showStatus('Sesión iniciada correctamente. Redirigiendo...', false);
                saveSessionAndRedirect(data.token, data.refresh_token, data.user);
                return;
              }
            }

            const kcDirect = await fetch(`${KEYCLOAK_ISSUER}/protocol/openid-connect/token`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({
                client_id: KEYCLOAK_CLIENT_ID,
                grant_type: 'password',
                username: email,
                password: password,
                scope: 'openid profile email'
              })
            });

            if (kcDirect.ok) {
              const tok = await kcDirect.json();
              showStatus('Sesión iniciada correctamente. Redirigiendo...', false);
              saveSessionAndRedirect(tok.access_token, tok.refresh_token, null);
              return;
            }

            showStatus('Correo electrónico o contraseña incorrectos.', true);
          } catch {
            showStatus('Error de conexión con el servidor de identidad.', true);
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Iniciar Sesión</span><span>→</span>';
          }
        });
      }
    })();
    </script>
  </body>
</html>
