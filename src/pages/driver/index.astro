---
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import '../../styles/global.css';
import '../../styles/pages/driver.css';
---

<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel de repartidor | Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="dv-body">
    <RoleSwitcher currentRole="driver" />

    <header class="dv-header tg-glass">
      <div class="dv-header-inner">
        <a href="/" class="dv-avatar" aria-label="Ir al inicio">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5.5" cy="17.5" r="3"/><circle cx="18.5" cy="17.5" r="3"/><path d="M8.5 17.5h6l3-7h-4M5.5 17.5l3-6h5"/><path d="M15 6h2.5l1 4.5"/></svg>
        </a>
        <div class="dv-who">
          <h1 id="dv-driver-name" class="dv-name">Repartidor</h1>
          <span id="dv-driver-meta" class="dv-meta">Panel de entregas</span>
        </div>
        <div class="dv-header-end">
          <div class="dv-bcv">
            <span class="dv-label">Tasa BCV</span>
            <span id="dv-bcv-rate" class="dv-num">—</span>
          </div>
          <div id="gps-status-badge" class="dv-gps dv-gps--off" role="status">
            <span id="gps-pulse"></span>
            <span id="gps-text" class="dv-gps-text">Activa tu ubicación para recibir pedidos</span>
          </div>
        </div>
      </div>
    </header>

    <main class="dv-main">
      <p id="dv-error" class="dv-alert hidden" role="alert"></p>

      <section id="dv-active" class="dv-active hidden" aria-labelledby="dv-active-title">
        <div class="dv-active-head">
          <div class="dv-tags">
            <span id="dv-active-title" class="dv-tag dv-tag--accent">
              <span class="dv-live" aria-hidden="true"></span>
              <span id="dv-active-code">Pedido activo</span>
            </span>
            <span id="dv-active-status" class="dv-tag dv-tag--ok"></span>
          </div>
          <div class="dv-amount">
            <span id="dv-active-usd" class="dv-amount-usd dv-num">—</span>
            <span id="dv-active-bs" class="dv-amount-bs dv-num"></span>
          </div>
        </div>

        <ol class="dv-route">
          <li class="dv-stop">
            <span class="dv-step dv-step--pickup" aria-hidden="true">1</span>
            <div class="dv-stop-body">
              <span class="dv-label">Recoger en comercio</span>
              <h4 id="dv-active-store" class="dv-stop-title">—</h4>
              <p id="dv-active-store-addr" class="dv-stop-sub">—</p>
            </div>
          </li>
          <li class="dv-stop">
            <span class="dv-step dv-step--drop" aria-hidden="true">2</span>
            <div class="dv-stop-body">
              <span class="dv-label">Entregar en destino</span>
              <h4 id="dv-active-addr" class="dv-stop-title">—</h4>
              <p id="dv-active-payment" class="dv-stop-sub">—</p>
            </div>
          </li>
        </ol>

        <div class="dv-active-actions">
          <a id="dv-active-map" href="/orders/track" class="dv-btn dv-btn--ghost">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
            <span>Ver en mapa</span>
          </a>
          <button id="dv-active-action" type="button" class="btn-driver-action dv-btn dv-btn--primary hidden"></button>
        </div>
      </section>

      <section class="dv-earn" aria-label="Ganancias de hoy">
        <span class="dv-label dv-label--night">Ganancias de hoy (envíos y propinas)</span>
        <div class="dv-earn-row">
          <h2 id="dv-earn-total" class="dv-earn-total dv-num">—</h2>
          <span id="dv-earn-count" class="dv-earn-count dv-num">Sin entregas hoy</span>
        </div>
        <p id="dv-earn-bs" class="dv-earn-bs dv-num"></p>
        <div class="dv-earn-grid">
          <div>
            <span class="dv-label dv-label--night">Propinas recibidas</span>
            <strong id="dv-tips-usd" class="dv-num">—</strong>
            <span id="dv-tips-bs" class="dv-earn-sub dv-num"></span>
          </div>
          <div>
            <span class="dv-label dv-label--night">Pedidos en curso</span>
            <strong id="dv-inprogress" class="dv-num">—</strong>
          </div>
        </div>
      </section>

      <section class="dv-card" aria-labelledby="dv-available-title">
        <div class="dv-card-head">
          <div>
            <h3 id="dv-available-title" class="dv-card-title">Pedidos disponibles por comercio</h3>
            <p class="dv-card-sub">Pedidos sin repartidor asignado</p>
          </div>
          <span id="dv-available-count" class="dv-count dv-num">—</span>
        </div>
        <div id="dv-available-empty" class="dv-empty">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.9 19.1a10 10 0 0 1 0-14.2M19.1 4.9a10 10 0 0 1 0 14.2M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4"/><circle cx="12" cy="12" r="2"/></svg>
          <p id="dv-available-empty-text" class="dv-empty-title">Cargando pedidos…</p>
        </div>
        <ul id="dv-available-list" class="dv-list"></ul>
      </section>

      <section class="dv-card" aria-labelledby="dv-history-title">
        <h3 id="dv-history-title" class="dv-card-title">Historial de despachos</h3>
        <p id="dv-history-empty" class="dv-card-sub">Sin entregas registradas</p>
        <ul id="dv-history-list" class="dv-history"></ul>
      </section>
    </main>

    <div id="urgent-dispatch-modal" class="dv-modal hidden" role="dialog" aria-modal="true" aria-labelledby="offer-store-name">
      <div class="dv-sheet tg-glass">
        <div class="dv-ring">
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <path class="dv-ring-track" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <path id="countdown-circle" class="dv-ring-bar" stroke-dasharray="100, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <span id="dispatch-countdown" class="dv-ring-num dv-num"></span>
        </div>

        <div class="dv-sheet-head">
          <span class="dv-tag dv-tag--ok">Nueva oferta de pedido</span>
          <h3 id="offer-store-name" class="dv-sheet-title">—</h3>
          <p id="offer-store-dist" class="dv-card-sub">—</p>
        </div>

        <div class="dv-sheet-box">
          <div class="dv-sheet-row">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <div class="dv-stop-body">
              <span class="dv-label">Entrega en</span>
              <p id="offer-delivery-addr" class="dv-stop-title">—</p>
            </div>
          </div>
          <div class="dv-sheet-earn">
            <span class="dv-label">Ganancia neta</span>
            <div class="dv-amount">
              <span id="offer-earnings-usd" class="dv-offer-usd dv-num">—</span>
              <span id="offer-earnings-bs" class="dv-amount-bs dv-num"></span>
            </div>
          </div>
        </div>

        <p id="offer-error" class="dv-alert hidden" role="alert"></p>

        <div class="dv-sheet-actions">
          <button id="btn-accept-offer" type="button" class="dv-btn dv-btn--primary dv-btn--xl">
            <span>Aceptar pedido</span>
          </button>
          <button id="btn-reject-offer" type="button" class="dv-btn dv-btn--text">Rechazar</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const API = 'https://api.traigalo.org/v2';
        const WS_URL = 'wss://api.traigalo.org/v2/drivers/telemetry';
        const AVAILABLE_STATUSES = ['placed', 'accepted_by_store', 'in_kitchen', 'ready_for_pickup'];
        const ACTIVE_STATUSES = ['driver_assigned', 'driver_in_transit', 'in_transit'];
        const STATUS_LABELS = {
          placed: 'Nuevo pedido',
          accepted_by_store: 'Aceptado en tienda',
          in_kitchen: 'Preparando',
          ready_for_pickup: 'Listo en tienda',
          driver_assigned: 'Asignado para retiro',
          driver_in_transit: 'En camino',
          in_transit: 'En camino',
          delivered: 'Entregado',
          cancelled: 'Cancelado'
        };
        const PAYMENT_LABELS = { cash: 'Efectivo', pago_movil: 'Pago móvil', card: 'Tarjeta', zelle: 'Zelle' };
        const DASH = '—';

        const token = readStorage('traigalo_token');
        if (!token) {
          window.location.replace('/login');
          return;
        }
        const claims = decodeJwt(token);
        const user = parseJson(readStorage('traigalo_user'));
        const driverId = claims && typeof claims.sub === 'string' ? claims.sub : null;

        const state = { rate: null, stores: {}, orders: [], assigned: [], offer: null, countdown: null, alarm: null };

        function readStorage(key) {
          try { return window.localStorage.getItem(key); } catch (e) { return null; }
        }

        function parseJson(raw) {
          if (!raw) return null;
          try { return JSON.parse(raw); } catch (e) { return null; }
        }

        function decodeJwt(jwt) {
          const part = String(jwt).split('.')[1];
          if (!part) return null;
          try {
            const b64 = part.replace(/-/g, '+').replace(/_/g, '/');
            const json = decodeURIComponent(atob(b64).split('').map((c) => '%' + c.charCodeAt(0).toString(16).padStart(2, '0')).join(''));
            return JSON.parse(json);
          } catch (e) { return null; }
        }

        function el(id) { return document.getElementById(id); }

        function setText(id, value) {
          const node = el(id);
          if (node) node.textContent = value;
        }

        function show(id, visible) {
          const node = el(id);
          if (node) node.classList.toggle('hidden', !visible);
        }

        function showError(id, message) {
          setText(id, message);
          show(id, Boolean(message));
        }

        function text(value) {
          return value === undefined || value === null || String(value).trim() === '' ? DASH : String(value);
        }

        function num(value) {
          const n = Number(value);
          return Number.isFinite(n) ? n : null;
        }

        function usd(value) {
          const n = num(value);
          return n === null ? DASH : '$' + n.toFixed(2);
        }

        function bs(value) {
          const n = num(value);
          if (n === null || !state.rate) return '';
          return 'Bs. ' + new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n * state.rate);
        }

        function orderCode(order) {
          return '#' + (order.order_number || String(order.id || '').slice(0, 8) || DASH);
        }

        function statusLabel(status) {
          return STATUS_LABELS[status] || text(status);
        }

        function storeName(storeId) {
          const store = state.stores[storeId];
          return store && store.name ? store.name : DASH;
        }

        function storeAddress(storeId) {
          const store = state.stores[storeId];
          return store && store.address_line ? store.address_line : DASH;
        }

        function isToday(iso) {
          if (!iso) return false;
          const d = new Date(iso);
          const now = new Date();
          return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
        }

        function timeOf(iso) {
          if (!iso) return DASH;
          const d = new Date(iso);
          return Number.isNaN(d.getTime()) ? DASH : d.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit' });
        }

        async function api(path, options) {
          const res = await fetch(API + path, {
            ...(options || {}),
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token }
          });
          if (res.status === 401) {
            window.location.replace('/login');
            throw new Error('Sesión expirada');
          }
          if (!res.ok) {
            const body = await res.text().catch(() => '');
            const parsed = parseJson(body);
            const detail = parsed && (parsed.error && (parsed.error.message || parsed.error)) || body;
            throw new Error(detail ? String(detail).trim() : 'Error ' + res.status);
          }
          return res.status === 204 ? null : res.json();
        }

        function unwrap(payload) {
          if (Array.isArray(payload)) return payload;
          if (payload && Array.isArray(payload.data)) return payload.data;
          return [];
        }

        function renderIdentity() {
          const name = (user && (user.name || user.full_name || [user.first_name, user.last_name].filter(Boolean).join(' '))) || (claims && (claims.name || claims.preferred_username)) || 'Repartidor';
          setText('dv-driver-name', name);
          setText('dv-driver-meta', (user && user.email) || (claims && claims.email) || 'Panel de entregas');
        }

        function renderRate() {
          setText('dv-bcv-rate', state.rate ? state.rate.toFixed(2) + ' Bs/$' : DASH);
        }

        function renderActive() {
          const order = state.assigned.find((o) => ACTIVE_STATUSES.includes(o.status));
          show('dv-active', Boolean(order));
          if (!order) return;
          setText('dv-active-code', 'Pedido activo ' + orderCode(order));
          setText('dv-active-status', statusLabel(order.status));
          setText('dv-active-usd', usd(order.total_usd || order.total));
          setText('dv-active-bs', bs(order.total_usd || order.total));
          setText('dv-active-store', storeName(order.store_id));
          setText('dv-active-store-addr', storeAddress(order.store_id));
          setText('dv-active-addr', text(order.delivery_address));
          setText('dv-active-payment', 'Pago: ' + (PAYMENT_LABELS[order.payment_method] || text(order.payment_method)));
          const map = el('dv-active-map');
          if (map) map.setAttribute('href', '/orders/track?id=' + encodeURIComponent(order.id));
          const btn = el('dv-active-action');
          if (!btn) return;
          const delivering = order.status !== 'driver_assigned';
          btn.setAttribute('data-order-id', order.id);
          btn.setAttribute('data-action', delivering ? 'deliver' : 'transit');
          btn.textContent = delivering ? 'Confirmar entrega' : 'Iniciar ruta';
          btn.disabled = false;
          btn.classList.remove('hidden');
        }

        function renderEarnings() {
          const today = state.assigned.filter((o) => o.status === 'delivered' && isToday(o.delivered_at));
          const inProgress = state.assigned.filter((o) => ACTIVE_STATUSES.includes(o.status)).length;
          setText('dv-inprogress', String(inProgress));
          if (today.length === 0) {
            setText('dv-earn-total', '$0.00');
            setText('dv-earn-count', 'Sin entregas hoy');
            setText('dv-earn-bs', '');
            setText('dv-tips-usd', '$0.00');
            setText('dv-tips-bs', '');
            return;
          }
          const tips = today.reduce((sum, o) => sum + (num(o.tip_usd) || 0), 0);
          const fees = today.reduce((sum, o) => sum + (num(o.delivery_fee) || 0), 0);
          setText('dv-earn-total', usd(fees + tips));
          setText('dv-earn-count', today.length + (today.length === 1 ? ' entrega' : ' entregas'));
          setText('dv-earn-bs', bs(fees + tips));
          setText('dv-tips-usd', usd(tips));
          setText('dv-tips-bs', bs(tips));
        }

        function tag(className, value) {
          const span = document.createElement('span');
          span.className = className;
          span.textContent = value;
          return span;
        }

        function renderAvailable() {
          const list = el('dv-available-list');
          if (!list) return;
          const available = state.orders.filter((o) => !o.driver_id && AVAILABLE_STATUSES.includes(o.status));
          setText('dv-available-count', available.length + ' disponibles');
          setText('dv-available-empty-text', 'No hay pedidos disponibles en este momento');
          show('dv-available-empty', available.length === 0);
          list.replaceChildren(...available.map((order) => {
            const li = document.createElement('li');
            li.className = 'dv-offer';
            const body = document.createElement('div');
            body.className = 'dv-offer-body';
            const tags = document.createElement('div');
            tags.className = 'dv-tags';
            tags.append(tag('dv-code dv-num', orderCode(order)), tag('dv-tag dv-tag--accent', storeName(order.store_id)), tag('dv-tag dv-tag--ok', statusLabel(order.status)));
            const addr = document.createElement('p');
            addr.className = 'dv-addr';
            addr.append(tag('', text(order.delivery_address)));
            const price = document.createElement('div');
            price.className = 'dv-price';
            price.append(tag('dv-num', usd(order.total_usd || order.total)), tag('dv-price-bs dv-num', bs(order.total_usd || order.total)));
            body.append(tags, addr, price);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-driver-action dv-btn dv-btn--primary dv-btn--accept';
            btn.setAttribute('data-action', 'assign_driver');
            btn.setAttribute('data-order-id', order.id);
            btn.textContent = 'Aceptar pedido';
            li.append(body, btn);
            return li;
          }));
        }

        function renderHistory() {
          const list = el('dv-history-list');
          if (!list) return;
          show('dv-history-empty', state.assigned.length === 0);
          list.replaceChildren(...state.assigned.map((order) => {
            const li = document.createElement('li');
            li.className = 'dv-hist';
            const icon = tag('dv-hist-icon' + (order.status === 'delivered' ? ' dv-hist-icon--done' : ''), order.status === 'delivered' ? '✓' : '•');
            icon.setAttribute('aria-hidden', 'true');
            const body = document.createElement('div');
            body.className = 'dv-hist-body';
            const title = document.createElement('h4');
            title.className = 'dv-stop-title';
            title.textContent = orderCode(order) + ' · ' + storeName(order.store_id);
            const sub = document.createElement('p');
            sub.className = 'dv-stop-sub';
            sub.textContent = text(order.delivery_address);
            const meta = tag('dv-hist-meta dv-num', timeOf(order.delivered_at || order.placed_at) + ' · ' + statusLabel(order.status));
            body.append(title, sub, meta);
            const amount = document.createElement('div');
            amount.className = 'dv-amount';
            amount.append(tag('dv-num dv-hist-usd', usd(order.total_usd || order.total)), tag('dv-amount-bs dv-num', bs(order.total_usd || order.total)));
            li.append(icon, body, amount);
            return li;
          }));
        }

        function renderAll() {
          renderRate();
          renderActive();
          renderEarnings();
          renderAvailable();
          renderHistory();
        }

        async function loadRate() {
          const data = await api('/rates');
          const rate = num(data && (data.rate || (data.data && data.data.rate)));
          state.rate = rate && rate > 0 ? rate : null;
        }

        async function loadStores() {
          const data = await api('/stores?size=100');
          state.stores = unwrap(data).reduce((acc, s) => ({ ...acc, [s.id]: { name: s.name, address_line: s.address_line } }), {});
        }

        async function loadOrders() {
          const [open, mine] = await Promise.all([
            api('/orders?size=50'),
            driverId ? api('/orders?driver-id=' + encodeURIComponent(driverId) + '&size=50') : Promise.resolve([])
          ]);
          state.orders = unwrap(open);
          state.assigned = unwrap(mine).filter((o) => o && o.driver_id === driverId);
        }

        async function refresh() {
          const results = await Promise.allSettled([loadRate(), loadStores(), loadOrders()]);
          const failed = results.filter((r) => r.status === 'rejected').map((r) => r.reason && r.reason.message);
          showError('dv-error', failed.length ? 'No se pudo cargar parte del panel: ' + failed.join(' · ') : '');
          renderAll();
        }

        async function runOrderAction(btn) {
          const orderId = btn.getAttribute('data-order-id');
          const action = btn.getAttribute('data-action');
          if (!orderId || !action || !driverId) return;
          const label = btn.textContent;
          btn.disabled = true;
          btn.textContent = 'Procesando…';
          try {
            await api('/orders/' + encodeURIComponent(orderId) + '/actions', {
              method: 'POST',
              body: JSON.stringify({ action, driver_id: driverId })
            });
            showError('dv-error', '');
            await refresh();
          } catch (err) {
            showError('dv-error', 'No se pudo completar la acción: ' + err.message);
            btn.disabled = false;
            btn.textContent = label;
          }
        }

        document.addEventListener('click', (event) => {
          const btn = event.target instanceof Element ? event.target.closest('.btn-driver-action') : null;
          if (btn && !btn.disabled) runOrderAction(btn);
        });

        function playArpeggio() {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          const ctx = new Ctx();
          const now = ctx.currentTime;
          [440, 554.37, 659.25, 880].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            const start = now + idx * 0.08;
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, start);
            gain.gain.setValueAtTime(0.3, start);
            gain.gain.exponentialRampToValueAtTime(0.01, start + 0.15);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.15);
          });
        }

        function stopTimers() {
          if (state.alarm) clearInterval(state.alarm);
          if (state.countdown) clearInterval(state.countdown);
          state.alarm = null;
          state.countdown = null;
        }

        function closeOffer() {
          show('urgent-dispatch-modal', false);
          showError('offer-error', '');
          stopTimers();
          state.offer = null;
        }

        function openOffer(offer) {
          state.offer = offer;
          const order = state.orders.find((o) => o.id === offer.order_id);
          const earnings = num(offer.earnings_usd);
          setText('offer-store-name', text(offer.store_name));
          setText('offer-store-dist', order ? 'Pedido ' + orderCode(order) : 'Pedido ' + text(String(offer.order_id || '').slice(0, 8)));
          setText('offer-delivery-addr', text(order && order.delivery_address));
          setText('offer-earnings-usd', usd(earnings));
          setText('offer-earnings-bs', earnings !== null && state.rate ? '~ ' + bs(earnings) + ' @ BCV' : '');
          showError('offer-error', '');
          const accept = el('btn-accept-offer');
          if (accept) { accept.disabled = false; accept.textContent = 'Aceptar pedido'; }
          show('urgent-dispatch-modal', true);
          stopTimers();
          playArpeggio();
          state.alarm = setInterval(playArpeggio, 1200);
          const total = num(offer.expires_in);
          const circle = el('countdown-circle');
          if (!total || total <= 0) {
            setText('dispatch-countdown', '');
            return;
          }
          let left = total;
          setText('dispatch-countdown', String(left));
          if (circle) circle.setAttribute('stroke-dasharray', '100, 100');
          state.countdown = setInterval(() => {
            left -= 1;
            setText('dispatch-countdown', String(Math.max(left, 0)));
            if (circle) circle.setAttribute('stroke-dasharray', (Math.max(left, 0) / total) * 100 + ', 100');
            if (left <= 0) closeOffer();
          }, 1000);
        }

        async function offerAction(action) {
          const offer = state.offer;
          if (!offer || !offer.offer_id) return;
          await api('/dispatch/offers/' + encodeURIComponent(offer.offer_id) + '/actions', {
            method: 'POST',
            body: JSON.stringify({ action })
          });
        }

        const acceptBtn = el('btn-accept-offer');
        if (acceptBtn) {
          acceptBtn.addEventListener('click', async () => {
            acceptBtn.disabled = true;
            acceptBtn.textContent = 'Aceptando…';
            try {
              await offerAction('accept');
              closeOffer();
              await refresh();
            } catch (err) {
              stopTimers();
              showError('offer-error', 'No se pudo aceptar la oferta: ' + err.message);
              acceptBtn.disabled = false;
              acceptBtn.textContent = 'Aceptar pedido';
            }
          });
        }

        const rejectBtn = el('btn-reject-offer');
        if (rejectBtn) {
          rejectBtn.addEventListener('click', async () => {
            try {
              await offerAction('reject');
              closeOffer();
            } catch (err) {
              showError('offer-error', 'No se pudo rechazar la oferta: ' + err.message);
            }
          });
        }

        function connectTelemetry() {
          if (!driverId) return;
          const ws = new WebSocket(WS_URL);
          ws.addEventListener('message', (event) => {
            const data = parseJson(event.data);
            if (!data || data.event !== 'dispatch_offer' || data.driver_id !== driverId) return;
            openOffer(data);
          });
          ws.addEventListener('close', () => setTimeout(connectTelemetry, 5000));
        }

        function setGps(active, message) {
          const badge = el('gps-status-badge');
          if (badge) badge.classList.toggle('dv-gps--off', !active);
          setText('gps-text', message);
        }

        async function sendLocation(coords) {
          try {
            await api('/drivers/locations', {
              method: 'POST',
              body: JSON.stringify({ driver_id: driverId, latitude: coords.latitude, longitude: coords.longitude })
            });
            setGps(true, 'GPS transmitiendo');
          } catch (err) {
            setGps(false, 'Ubicación no enviada: ' + err.message);
          }
        }

        function startGps() {
          if (!driverId) {
            setGps(false, 'Sesión sin identificador de repartidor');
            return;
          }
          if (!('geolocation' in navigator)) {
            setGps(false, 'Activa tu ubicación para recibir pedidos');
            return;
          }
          navigator.geolocation.watchPosition(
            (pos) => sendLocation(pos.coords),
            () => setGps(false, 'Activa tu ubicación para recibir pedidos'),
            { enableHighAccuracy: true, maximumAge: 10000, timeout: 15000 }
          );
        }

        renderIdentity();
        if (!driverId) showError('dv-error', 'Tu sesión no contiene un identificador de repartidor válido. Inicia sesión de nuevo.');
        refresh();
        connectTelemetry();
        startGps();
      })();
    </script>
  </body>
</html>
