---
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import '../../styles/global.css';

const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();

const driverId = '33333333-3333-3333-3333-333333333333';
const driver = {
  id: driverId,
  name: 'Carlos Mendoza',
  vehicle: 'Yamaha FZ • Placa: AB1-23C',
  rating: '4.9 ★',
  todayEarningsUSD: 52.40,
  todayDeliveries: 8,
  todayTipsUSD: 6.50,
  onlineTime: '4h 15m'
};

const earningsBs = formatBs(driver.todayEarningsUSD, bcvRate);
const tipsBs = formatBs(driver.todayTipsUSD, bcvRate);

let allOrders: any[] = [];
try {
  const res = await fetch(`${API_BASE}/orders?size=30`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) allOrders = data;
  }
} catch {}

const availableOrders = allOrders.filter(
  (o) => o && (o.status === 'placed' || o.status === 'accepted_by_store' || o.status === 'preparing' || o.status === 'ready_for_pickup')
);

let assignedOrders: any[] = [];
try {
  const assignedRes = await fetch(`${API_BASE}/orders?driver-id=${driverId}&size=10`);
  if (assignedRes.ok) {
    const data = await assignedRes.json();
    if (Array.isArray(data)) assignedOrders = data;
  }
} catch {}

if (assignedOrders.length === 0) {
  assignedOrders = allOrders.filter(
    (o) => o && (o.status === 'driver_assigned' || o.status === 'driver_in_transit' || o.status === 'in_transit' || o.status === 'delivered')
  );
}

const currentActiveOrder = assignedOrders.find(
  (o) => o && (o.status === 'driver_assigned' || o.status === 'driver_in_transit' || o.status === 'in_transit')
) || null;

function formatDriverStatus(st: string): string {
  if (st === 'driver_assigned') return 'Asignado p/ Retiro';
  if (st === 'driver_in_transit' || st === 'in_transit') return 'En Camino';
  if (st === 'delivered') return 'Entregado';
  if (st === 'ready_for_pickup') return 'Listo en Tienda';
  if (st === 'preparing') return 'Preparando';
  if (st === 'accepted_by_store') return 'Aceptado en Tienda';
  if (st === 'placed') return 'Nuevo Pedido';
  return st;
}
---

<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Panel de Repartidor | Traigalo ⚡</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAFAFC] text-[#1A1D20] min-h-screen flex flex-col pb-16 antialiased selection:bg-[#FF7A00] selection:text-white">
    <RoleSwitcher currentRole="driver" />

    <header class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40 px-4 py-3.5">
      <div class="max-w-2xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-400 to-[#FF7A00] flex items-center justify-center text-xl shadow-xs text-white font-black">
            🛵
          </a>
          <div>
            <h1 class="text-sm font-extrabold text-gray-900 leading-tight">{driver.name}</h1>
            <span class="text-[10px] font-bold text-amber-500">{driver.rating} • {driver.vehicle}</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div class="text-right hidden sm:block">
            <span class="text-[10px] text-gray-400 block font-semibold">Tasa BCV</span>
            <span class="text-xs font-black text-gray-800">{bcvRate.toFixed(2)} Bs/$</span>
          </div>
          <div id="gps-status-badge" class="flex items-center gap-2 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-full cursor-pointer">
            <span id="gps-pulse" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="gps-text" class="text-xs font-extrabold text-emerald-800">GPS Activo</span>
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-5 w-full space-y-4">
      
      <section class="bg-gradient-to-r from-[#FF7A00] to-[#FF9432] rounded-3xl p-5 text-white shadow-lg shadow-orange-500/15">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-orange-100">Ganancias Acumuladas Hoy</span>
        <div class="flex items-baseline justify-between mt-1 mb-1">
          <h2 class="text-3xl font-black tracking-tight">${driver.todayEarningsUSD.toFixed(2)}</h2>
          <span class="text-xs font-bold text-white bg-white/20 px-2.5 py-1 rounded-xl backdrop-blur-md">
            {driver.todayDeliveries} Entregas
          </span>
        </div>
        <p class="text-[11px] text-orange-100 font-semibold mb-3">{earningsBs}</p>

        <div class="grid grid-cols-2 gap-2 pt-3 border-t border-white/20 text-xs">
          <div>
            <span class="text-orange-100 text-[10px] block">Propinas recibidas</span>
            <strong class="font-black text-sm">${driver.todayTipsUSD.toFixed(2)}</strong>
            <span class="text-[9px] text-orange-100/90 block">{tipsBs}</span>
          </div>
          <div>
            <span class="text-orange-100 text-[10px] block">Tiempo en ruta</span>
            <strong class="font-black text-sm">{driver.onlineTime}</strong>
            <span class="text-[9px] text-orange-100/90 block">Eficiencia: 99.4%</span>
          </div>
        </div>
      </section>

      {currentActiveOrder && (
        <section class="bg-white rounded-3xl p-5 border-2 border-orange-600/40 shadow-md relative overflow-hidden">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-orange-100 text-[#FF7A00] font-extrabold text-[10px] uppercase tracking-wider">
                ● Pedido Activo #{currentActiveOrder.order_number || currentActiveOrder.id.slice(0, 8)}
              </span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-black text-[10px]">
                {formatDriverStatus(currentActiveOrder.status)}
              </span>
            </div>
            <div class="text-right">
              <span class="text-sm font-black text-[#FF7A00]">
                ${Number(currentActiveOrder.total).toFixed(2)}
              </span>
              <span class="text-[9px] text-gray-400 block font-semibold">
                {formatBs(Number(currentActiveOrder.total), bcvRate)}
              </span>
            </div>
          </div>

          <div class="space-y-3.5 my-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-orange-50 text-[#FF7A00] font-bold text-xs flex items-center justify-center shrink-0 border border-orange-100">
                1
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold text-gray-400 uppercase">Recoger en Comercio Oficial</span>
                <h4 class="text-xs font-black text-gray-900 truncate">
                  {currentActiveOrder.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f' ? '💈 El Sitio del Barbero' : '🎧 WILY VIDEO'}
                </h4>
                <p class="text-[11px] text-gray-500 truncate">Higuerote, Estado Miranda</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 font-bold text-xs flex items-center justify-center shrink-0 border border-emerald-100">
                2
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold text-gray-400 uppercase">Entregar en Destino</span>
                <h4 class="text-xs font-bold text-gray-900 truncate">{currentActiveOrder.delivery_address || 'Av. Andrés Eloy Blanco, Higuerote'}</h4>
                <p class="text-[11px] text-gray-500 truncate">Entrega Express Prioritaria</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5 pt-2">
            <a 
              href={`/orders/track?id=${currentActiveOrder.id}`}
              class="h-12 rounded-2xl bg-gray-50 hover:bg-gray-100 border border-gray-100 text-gray-800 font-bold text-xs flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>🗺️</span>
              <span>Ver en Mapa</span>
            </a>

            {currentActiveOrder.status === 'driver_assigned' && (
              <button 
                data-action="transit"
                data-order-id={currentActiveOrder.id}
                class="btn-driver-action h-12 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-extrabold text-xs shadow-md shadow-orange-600/20 flex items-center justify-center gap-1.5 transition-all active:scale-95 cursor-pointer"
              >
                <span>🚀</span>
                <span>Iniciar Ruta</span>
              </button>
            )}

            {(currentActiveOrder.status === 'in_transit' || currentActiveOrder.status === 'driver_in_transit') && (
              <button 
                data-action="deliver"
                data-order-id={currentActiveOrder.id}
                class="btn-driver-action h-12 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs shadow-md shadow-emerald-600/20 flex items-center justify-center gap-1.5 transition-all active:scale-95 cursor-pointer"
              >
                <span>✓</span>
                <span>Confirmar Entrega</span>
              </button>
            )}
          </div>
        </section>
      )}

      <section class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-extrabold text-gray-900">Pedidos Disponibles por Comercio</h3>
            <p class="text-xs text-gray-400">Acepta un pedido de WILY VIDEO o El Sitio del Barbero</p>
          </div>
          <span class="text-xs font-black text-[#FF7A00] bg-orange-50 px-2.5 py-1 rounded-full">
            {availableOrders.length} disponibles
          </span>
        </div>

        {availableOrders.length === 0 ? (
          <div class="text-center py-8 text-gray-400 text-xs">
            <span class="text-2xl block mb-1">📡</span>
            <p class="font-bold text-gray-600">Buscando nuevas órdenes en tu zona...</p>
            <p class="text-[11px] text-gray-400 mt-1">Mantente con la aplicación abierta</p>
          </div>
        ) : (
          <div class="space-y-3">
            {availableOrders.map((ord) => {
              const totalUSD = Number(ord.total) || 0;
              const totalBsFormatted = formatBs(totalUSD, bcvRate);
              const isBarberoStore = ord.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f';
              const sName = isBarberoStore ? '💈 El Sitio del Barbero' : '🎧 WILY VIDEO';
              return (
                <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-center justify-between gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-xs font-black text-gray-900 font-mono">#{ord.order_number || ord.id.slice(0, 8)}</span>
                      <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${isBarberoStore ? 'bg-amber-50 text-amber-800' : 'bg-blue-50 text-blue-700'}`}>{sName}</span>
                      <span class="text-[9px] font-black text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">{formatDriverStatus(ord.status)}</span>
                    </div>
                    <p class="text-xs text-gray-600 font-medium truncate mt-1">📍 {ord.delivery_address || 'Higuerote, Miranda'}</p>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-black text-gray-900">${totalUSD.toFixed(2)}</span>
                      <span class="text-[10px] font-bold text-gray-400">{totalBsFormatted}</span>
                    </div>
                  </div>

                  <button 
                    data-action="assign_driver"
                    data-order-id={ord.id}
                    class="btn-driver-action shrink-0 px-4 py-2.5 rounded-xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs font-black shadow-sm active:scale-95 transition-all cursor-pointer"
                  >
                    Aceptar Pedido
                  </button>
                </div>
              );
            })}
          </div>
        )}
      </section>

      <section class="bg-white rounded-3xl p-5 border border-gray-100 shadow-xs">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400 mb-3">Historial de Despachos</h3>
        
        <div class="space-y-3">
          {assignedOrders.map(ord => {
            const sName = ord.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f' ? 'El Sitio del Barbero' : 'WILY VIDEO';
            return (
              <div class="flex items-center justify-between py-2.5 border-b border-gray-50 last:border-0 last:pb-0 text-xs">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class={`w-8 h-8 rounded-full font-bold text-xs flex items-center justify-center shrink-0 ${
                    ord.status === 'delivered' ? 'bg-emerald-50 text-emerald-600' : 'bg-orange-50 text-[#FF7A00]'
                  }`}>
                    {ord.status === 'delivered' ? '✓' : '🛵'}
                  </span>
                  <div class="min-w-0">
                    <h4 class="font-bold text-gray-900 leading-tight truncate">#{ord.order_number || ord.id.slice(0, 8)} • {sName}</h4>
                    <p class="text-[11px] text-gray-500 truncate">{ord.delivery_address || 'Higuerote, Miranda'}</p>
                    <span class="text-[10px] text-gray-400 font-semibold">{new Date(ord.placed_at || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} • <strong class="text-gray-600">{formatDriverStatus(ord.status)}</strong></span>
                  </div>
                </div>
                <div class="text-right shrink-0 ml-2">
                  <span class="font-black text-gray-900">${Number(ord.total).toFixed(2)}</span>
                  <span class="block text-[9px] text-gray-400 font-semibold">{formatBs(Number(ord.total), bcvRate)}</span>
                </div>
              </div>
            );
          })}
        </div>
      </section>

    </main>

    <div id="urgent-dispatch-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center space-y-4 border-2 border-emerald-500 animate-pulse">
        <div class="relative w-20 h-20 mx-auto flex items-center justify-center">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
            <path
              class="text-gray-100"
              stroke-width="3.5"
              stroke="currentColor"
              fill="none"
              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
            />
            <path
              id="countdown-circle"
              class="text-emerald-500 transition-all duration-1000 ease-linear"
              stroke-dasharray="100, 100"
              stroke-width="3.5"
              stroke-linecap="round"
              stroke="currentColor"
              fill="none"
              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
            />
          </svg>
          <span id="dispatch-countdown" class="absolute text-xl font-black text-gray-900">45</span>
        </div>

        <div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase tracking-wider">
            ¡Nueva Oferta de Pedido!
          </span>
          <h3 id="offer-store-name" class="text-base font-black text-gray-900 mt-2">WILY VIDEO</h3>
          <p id="offer-store-dist" class="text-xs text-gray-500 font-semibold mt-0.5">Retiro a 0.8 km de tu ubicación</p>
        </div>

        <div class="p-3 bg-gray-50 rounded-2xl border border-gray-100 text-left space-y-1.5 text-xs">
          <div class="flex items-start gap-2">
            <span class="text-sm">📍</span>
            <div class="flex-1 min-w-0">
              <span class="text-[9px] text-gray-400 font-black uppercase block">Entrega en</span>
              <p id="offer-delivery-addr" class="font-bold text-gray-800 truncate">Av. Andrés Eloy Blanco, Higuerote</p>
            </div>
          </div>
          <div class="pt-2 border-t border-gray-100 flex items-center justify-between">
            <span class="text-[10px] text-gray-400 font-black uppercase">Ganancia Neta</span>
            <div class="text-right">
              <span id="offer-earnings-usd" class="text-base font-black text-emerald-600 block">$3.50</span>
              <span id="offer-earnings-bs" class="text-[9px] text-gray-400 font-semibold block">~ Bs. 3.136,43 @ BCV</span>
            </div>
          </div>
        </div>

        <div class="space-y-2 pt-2">
          <button 
            id="btn-accept-offer"
            type="button" 
            class="w-full h-14 rounded-2xl bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white font-black text-base shadow-lg shadow-emerald-500/30 flex items-center justify-center gap-2 cursor-pointer transition-all"
          >
            <span>ACEPTAR PEDIDO</span>
            <span>✓</span>
          </button>
          <button 
            id="btn-reject-offer"
            type="button" 
            class="w-full py-2.5 text-xs font-bold text-gray-400 hover:text-rose-500 cursor-pointer transition-colors"
          >
            Rechazar
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ driverId, bcvRate }}>
      (() => {
        const API_ORDERS = 'https://api.traigalo.org/v2/orders';
        const API_LOCATIONS = 'https://api.traigalo.org/v2/drivers/locations';
        const API_DISPATCH = 'https://api.traigalo.org/v2/dispatch';

        let dispatchCountdownTimer = null;
        let alertSoundInterval = null;
        let currentOffer = null;

        function playUrgentArpeggio() {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;

            const notes = [440, 554.37, 659.25, 880];
            notes.forEach((freq, idx) => {
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(freq, now + (idx * 0.08));

              gain.gain.setValueAtTime(0.3, now + (idx * 0.08));
              gain.gain.exponentialRampToValueAtTime(0.01, now + (idx * 0.08) + 0.15);

              osc.connect(gain);
              gain.connect(ctx.destination);

              osc.start(now + (idx * 0.08));
              osc.stop(now + (idx * 0.08) + 0.15);
            });
          } catch {}
        }

        function startUrgentAlertAudio() {
          playUrgentArpeggio();
          if (!alertSoundInterval) {
            alertSoundInterval = setInterval(playUrgentArpeggio, 1200);
          }
        }

        function stopUrgentAlertAudio() {
          if (alertSoundInterval) {
            clearInterval(alertSoundInterval);
            alertSoundInterval = null;
          }
        }

        function showDispatchOfferModal(offer) {
          currentOffer = offer;
          const modal = document.getElementById('urgent-dispatch-modal');
          const countdownEl = document.getElementById('dispatch-countdown');
          const circle = document.getElementById('countdown-circle');
          const storeNameEl = document.getElementById('offer-store-name');
          const storeDistEl = document.getElementById('offer-store-dist');
          const addrEl = document.getElementById('offer-delivery-addr');
          const earnUsdEl = document.getElementById('offer-earnings-usd');
          const earnBsEl = document.getElementById('offer-earnings-bs');

          const resolvedStoreName = offer.store_name || (offer.store_id === '03577774-2f0b-4b68-bb11-5c91628dbd5f' ? 'El Sitio del Barbero' : 'WILY VIDEO');
          if (storeNameEl) storeNameEl.textContent = resolvedStoreName;
          if (storeDistEl) storeDistEl.textContent = `Retiro a ${offer.pickup_distance || '0.8 km'} de tu ubicación`;
          if (addrEl) addrEl.textContent = offer.delivery_address || 'Av. Andrés Eloy Blanco, Higuerote';

          const earningsUSD = Number(offer.earnings_usd || 3.50);
          const earningsBS = earningsUSD * (bcvRate || 896.12);
          if (earnUsdEl) earnUsdEl.textContent = `$${earningsUSD.toFixed(2)}`;
          if (earnBsEl) {
            earnBsEl.textContent = `~ Bs. ${new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2 }).format(earningsBS)} @ BCV`;
          }

          if (modal) modal.classList.remove('hidden');
          startUrgentAlertAudio();

          let timeLeft = 45;
          if (countdownEl) countdownEl.textContent = String(timeLeft);
          if (circle) circle.setAttribute('stroke-dasharray', '100, 100');

          if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
          dispatchCountdownTimer = setInterval(() => {
            timeLeft--;
            if (countdownEl) countdownEl.textContent = String(timeLeft);
            if (circle) {
              const pct = (timeLeft / 45) * 100;
              circle.setAttribute('stroke-dasharray', `${pct}, 100`);
            }

            if (timeLeft <= 0) {
              closeDispatchOfferModal();
            }
          }, 1000);
        }

        function closeDispatchOfferModal() {
          const modal = document.getElementById('urgent-dispatch-modal');
          if (modal) modal.classList.add('hidden');
          stopUrgentAlertAudio();
          if (dispatchCountdownTimer) {
            clearInterval(dispatchCountdownTimer);
            dispatchCountdownTimer = null;
          }
          currentOffer = null;
        }

        const acceptOfferBtn = document.getElementById('btn-accept-offer');
        if (acceptOfferBtn) {
          acceptOfferBtn.addEventListener('click', async () => {
            if (!currentOffer) return;
            acceptOfferBtn.disabled = true;
            acceptOfferBtn.textContent = 'Aceptando...';

            try {
              const offerId = currentOffer.id || currentOffer.offer_id || currentOffer.order_id;
              const res = await fetch(`${API_DISPATCH}/offers/${offerId}/actions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'accept', driver_id: driverId })
              });

              if (!res.ok) {
                await fetch(`${API_ORDERS}/${offerId}/actions`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'assign_driver', driver_id: driverId })
                });
              }

              closeDispatchOfferModal();
              window.location.reload();
            } catch (err) {
              closeDispatchOfferModal();
              window.location.reload();
            }
          });
        }

        const rejectOfferBtn = document.getElementById('btn-reject-offer');
        if (rejectOfferBtn) {
          rejectOfferBtn.addEventListener('click', async () => {
            if (currentOffer) {
              const offerId = currentOffer.id || currentOffer.offer_id || currentOffer.order_id;
              await fetch(`${API_DISPATCH}/offers/${offerId}/actions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'reject', driver_id: driverId })
              }).catch(() => {});
            }
            closeDispatchOfferModal();
          });
        }

        function initDriverWebSocket() {
          let ws = null;
          try {
            ws = new WebSocket(`wss://ws.traigalo.org/ws?driver_id=${encodeURIComponent(driverId)}`);
          } catch {}

          if (ws) {
            ws.onmessage = (event) => {
              try {
                const data = JSON.parse(event.data);
                if (data.event === 'dispatch_offer' || data.type === 'dispatch_offer' || data.type === 'driver_offer') {
                  showDispatchOfferModal(data.payload || data);
                }
              } catch {}
            };
          }
        }

        initDriverWebSocket();

        async function triggerDriverAction(orderId, actionName) {
          try {
            const res = await fetch(`${API_ORDERS}/${orderId}/actions`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                action: actionName,
                driver_id: driverId 
              })
            });

            if (!res.ok) {
              throw new Error(`Error en servidor: ${res.status}`);
            }

            window.location.reload();
          } catch (err) {
            alert(`No se pudo ejecutar la acción: ${err.message}`);
          }
        }

        document.querySelectorAll('.btn-driver-action').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const orderId = btn.getAttribute('data-order-id');
            const action = btn.getAttribute('data-action');
            if (orderId && action) {
              btn.disabled = true;
              btn.textContent = 'Procesando...';
              await triggerDriverAction(orderId, action);
            }
          });
        });

        function sendLocationUpdate(lat, lng, heading = 0, speed = 0) {
          fetch(API_LOCATIONS, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              driver_id: driverId,
              latitude: lat,
              longitude: lng,
              heading: heading || 0,
              speed: speed || 0
            })
          }).catch(() => {});
        }

        function startGpsTracking() {
          const gpsPulse = document.getElementById('gps-pulse');
          const gpsText = document.getElementById('gps-text');

          if ('geolocation' in navigator) {
            navigator.geolocation.watchPosition(
              (pos) => {
                const { latitude, longitude, heading, speed } = pos.coords;
                sendLocationUpdate(latitude, longitude, heading || 0, speed || 0);
                if (gpsText) gpsText.textContent = 'GPS Transmitiendo';
                if (gpsPulse) gpsPulse.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-ping';
              },
              () => {
                simulateGpsMovement();
              },
              { enableHighAccuracy: true, maximumAge: 10000, timeout: 5000 }
            );
          } else {
            simulateGpsMovement();
          }
        }

        let simStep = 0;
        function simulateGpsMovement() {
          const baseLat = 10.4852;
          const baseLng = -66.0975;
          sendLocationUpdate(baseLat, baseLng, 90.0, 25.0);
          setInterval(() => {
            simStep = (simStep + 1) % 100;
            const lat = baseLat + (Math.sin(simStep * 0.1) * 0.002);
            const lng = baseLng + (Math.cos(simStep * 0.1) * 0.002);
            sendLocationUpdate(lat, lng, 90.0, 25.0);
          }, 5000);
        }

        function playDriverAlertTone() {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;

            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(523.25, now);
            osc.frequency.setValueAtTime(659.25, now + 0.1);
            osc.frequency.setValueAtTime(783.99, now + 0.2);
            osc.frequency.setValueAtTime(1046.50, now + 0.3);

            gain.gain.setValueAtTime(0.25, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start(now);
            osc.stop(now + 0.5);
          } catch {}
        }

        window.addEventListener('load', () => {
          const hasOrders = document.querySelector('.btn-driver-action') !== null;
          if (hasOrders) {
            playDriverAlertTone();
          }
        });

        startGpsTracking();
      })();
    </script>
  </body>
</html>
