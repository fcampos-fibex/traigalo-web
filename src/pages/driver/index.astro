---
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate, formatBs } from '../../adapters/rates';
import { fetchStoresMap } from '../../adapters/stores';
import '../../styles/global.css';
import '../../styles/pages/driver.css';

const API_BASE = 'https://api.traigalo.org/v2';
const bcvRate = await getOfficialExchangeRate();
const storesMap = await fetchStoresMap();

const driverId = '33333333-3333-3333-3333-333333333333';
const driver = {
  id: driverId,
  name: 'Carlos Mendoza',
  vehicle: 'Yamaha FZ • Placa: AB1-23C',
  rating: '4.9 ★',
  todayEarningsUSD: 52.40,
  todayDeliveries: 8,
  todayTipsUSD: 6.50,
  onlineTime: '4h 15m'
};

const earningsBs = formatBs(driver.todayEarningsUSD, bcvRate);
const tipsBs = formatBs(driver.todayTipsUSD, bcvRate);

let allOrders: any[] = [];
try {
  const res = await fetch(`${API_BASE}/orders?size=30`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) allOrders = data;
  }
} catch {}

const availableOrders = allOrders.filter(
  (o) => o && (o.status === 'placed' || o.status === 'accepted_by_store' || o.status === 'preparing' || o.status === 'ready_for_pickup')
);

let assignedOrders: any[] = [];
try {
  const assignedRes = await fetch(`${API_BASE}/orders?driver-id=${driverId}&size=10`);
  if (assignedRes.ok) {
    const data = await assignedRes.json();
    if (Array.isArray(data)) assignedOrders = data;
  }
} catch {}

if (assignedOrders.length === 0) {
  assignedOrders = allOrders.filter(
    (o) => o && (o.status === 'driver_assigned' || o.status === 'driver_in_transit' || o.status === 'in_transit' || o.status === 'delivered')
  );
}

const currentActiveOrder = assignedOrders.find(
  (o) => o && (o.status === 'driver_assigned' || o.status === 'driver_in_transit' || o.status === 'in_transit')
) || null;

function formatDriverStatus(st: string): string {
  if (st === 'driver_assigned') return 'Asignado p/ Retiro';
  if (st === 'driver_in_transit' || st === 'in_transit') return 'En Camino';
  if (st === 'delivered') return 'Entregado';
  if (st === 'ready_for_pickup') return 'Listo en Tienda';
  if (st === 'preparing') return 'Preparando';
  if (st === 'accepted_by_store') return 'Aceptado en Tienda';
  if (st === 'placed') return 'Nuevo Pedido';
  return st;
}
---

<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Panel de repartidor | Traigalo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="dv-body">
    <RoleSwitcher currentRole="driver" />

    <header class="dv-header tg-glass">
      <div class="dv-header-inner">
        <a href="/" class="dv-avatar" aria-label="Ir al inicio">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5.5" cy="17.5" r="3"/><circle cx="18.5" cy="17.5" r="3"/><path d="M8.5 17.5h6l3-7h-4M5.5 17.5l3-6h5"/><path d="M15 6h2.5l1 4.5"/></svg>
        </a>
        <div class="dv-who">
          <h1 class="dv-name">{driver.name}</h1>
          <span class="dv-meta">{driver.rating} · {driver.vehicle}</span>
        </div>
        <div class="dv-header-end">
          <div class="dv-bcv">
            <span class="dv-label">Tasa BCV</span>
            <span class="dv-num">{bcvRate.toFixed(2)} Bs/$</span>
          </div>
          <div id="gps-status-badge" class="dv-gps" role="status">
            <span id="gps-pulse" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="gps-text" class="dv-gps-text">GPS Activo</span>
          </div>
        </div>
      </div>
    </header>

    <main class="dv-main">

      {currentActiveOrder && (
        <section class="dv-active" aria-labelledby="dv-active-title">
          <div class="dv-active-head">
            <div class="dv-tags">
              <span id="dv-active-title" class="dv-tag dv-tag--accent">
                <span class="dv-live" aria-hidden="true"></span>
                Pedido activo #{currentActiveOrder.order_number || currentActiveOrder.id.slice(0, 8)}
              </span>
              <span class="dv-tag dv-tag--ok">{formatDriverStatus(currentActiveOrder.status)}</span>
            </div>
            <div class="dv-amount">
              <span class="dv-amount-usd dv-num">${Number(currentActiveOrder.total).toFixed(2)}</span>
              <span class="dv-amount-bs dv-num">{formatBs(Number(currentActiveOrder.total), bcvRate)}</span>
            </div>
          </div>

          <ol class="dv-route">
            <li class="dv-stop">
              <span class="dv-step dv-step--pickup" aria-hidden="true">1</span>
              <div class="dv-stop-body">
                <span class="dv-label">Recoger en comercio oficial</span>
                <h4 class="dv-stop-title">{storesMap[currentActiveOrder.store_id]?.name || 'Comercio Oficial'}</h4>
                <p class="dv-stop-sub">{storesMap[currentActiveOrder.store_id]?.address_line || 'Higuerote, Estado Miranda'}</p>
              </div>
            </li>
            <li class="dv-stop">
              <span class="dv-step dv-step--drop" aria-hidden="true">2</span>
              <div class="dv-stop-body">
                <span class="dv-label">Entregar en destino</span>
                <h4 class="dv-stop-title">{currentActiveOrder.delivery_address || 'Av. Andrés Eloy Blanco, Higuerote'}</h4>
                <p class="dv-stop-sub">Entrega express prioritaria</p>
              </div>
            </li>
          </ol>

          <div class="dv-active-actions">
            <a href={`/orders/track?id=${currentActiveOrder.id}`} class="dv-btn dv-btn--ghost">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
              <span>Ver en mapa</span>
            </a>

            {currentActiveOrder.status === 'driver_assigned' && (
              <button data-action="transit" data-order-id={currentActiveOrder.id} type="button" class="btn-driver-action dv-btn dv-btn--primary">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 14 0M13 6l6 6-6 6"/></svg>
                <span>Iniciar ruta</span>
              </button>
            )}

            {(currentActiveOrder.status === 'in_transit' || currentActiveOrder.status === 'driver_in_transit') && (
              <button data-action="deliver" data-order-id={currentActiveOrder.id} type="button" class="btn-driver-action dv-btn dv-btn--success">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
                <span>Confirmar entrega</span>
              </button>
            )}
          </div>
        </section>
      )}

      <section class="dv-earn" aria-label="Ganancias de hoy">
        <span class="dv-label dv-label--night">Ganancias acumuladas hoy</span>
        <div class="dv-earn-row">
          <h2 class="dv-earn-total dv-num">${driver.todayEarningsUSD.toFixed(2)}</h2>
          <span class="dv-earn-count dv-num">{driver.todayDeliveries} entregas</span>
        </div>
        <p class="dv-earn-bs dv-num">{earningsBs}</p>
        <div class="dv-earn-grid">
          <div>
            <span class="dv-label dv-label--night">Propinas recibidas</span>
            <strong class="dv-num">${driver.todayTipsUSD.toFixed(2)}</strong>
            <span class="dv-earn-sub dv-num">{tipsBs}</span>
          </div>
          <div>
            <span class="dv-label dv-label--night">Tiempo en ruta</span>
            <strong class="dv-num">{driver.onlineTime}</strong>
            <span class="dv-earn-sub dv-num">Eficiencia: 99.4%</span>
          </div>
        </div>
      </section>

      <section class="dv-card" aria-labelledby="dv-available-title">
        <div class="dv-card-head">
          <div>
            <h3 id="dv-available-title" class="dv-card-title">Pedidos disponibles por comercio</h3>
            <p class="dv-card-sub">Acepta órdenes activas de comercios verificados en tu zona</p>
          </div>
          <span class="dv-count dv-num">{availableOrders.length} disponibles</span>
        </div>

        {availableOrders.length === 0 ? (
          <div class="dv-empty">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.9 19.1a10 10 0 0 1 0-14.2M19.1 4.9a10 10 0 0 1 0 14.2M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4"/><circle cx="12" cy="12" r="2"/></svg>
            <p class="dv-empty-title">Buscando nuevas órdenes en tu zona...</p>
            <p class="dv-card-sub">Mantente con la aplicación abierta</p>
          </div>
        ) : (
          <ul class="dv-list">
            {availableOrders.map((ord) => {
              const totalUSD = Number(ord.total) || 0;
              const totalBsFormatted = formatBs(totalUSD, bcvRate);
              const sName = storesMap[ord.store_id]?.name || 'Comercio Oficial';
              return (
                <li class="dv-offer">
                  <div class="dv-offer-body">
                    <div class="dv-tags">
                      <span class="dv-code dv-num">#{ord.order_number || ord.id.slice(0, 8)}</span>
                      <span class="dv-tag dv-tag--accent">{sName}</span>
                      <span class="dv-tag dv-tag--ok">{formatDriverStatus(ord.status)}</span>
                    </div>
                    <p class="dv-addr">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                      <span>{ord.delivery_address || 'Higuerote, Miranda'}</span>
                    </p>
                    <div class="dv-price">
                      <span class="dv-num">${totalUSD.toFixed(2)}</span>
                      <span class="dv-price-bs dv-num">{totalBsFormatted}</span>
                    </div>
                  </div>
                  <button data-action="assign_driver" data-order-id={ord.id} type="button" class="btn-driver-action dv-btn dv-btn--primary dv-btn--accept">
                    Aceptar pedido
                  </button>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <section class="dv-card" aria-labelledby="dv-history-title">
        <h3 id="dv-history-title" class="dv-card-title">Historial de despachos</h3>
        <ul class="dv-history">
          {assignedOrders.map(ord => {
            const sName = storesMap[ord.store_id]?.name || 'Comercio Oficial';
            const done = ord.status === 'delivered';
            return (
              <li class="dv-hist">
                <span class={`dv-hist-icon ${done ? 'dv-hist-icon--done' : ''}`} aria-hidden="true">
                  {done ? (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17.5" r="3"/><circle cx="18.5" cy="17.5" r="3"/><path d="M8.5 17.5h6l3-7h-4M5.5 17.5l3-6h5"/></svg>
                  )}
                </span>
                <div class="dv-hist-body">
                  <h4 class="dv-stop-title">#{ord.order_number || ord.id.slice(0, 8)} · {sName}</h4>
                  <p class="dv-stop-sub">{ord.delivery_address || 'Higuerote, Miranda'}</p>
                  <span class="dv-hist-meta dv-num">{new Date(ord.placed_at || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} · <strong>{formatDriverStatus(ord.status)}</strong></span>
                </div>
                <div class="dv-amount">
                  <span class="dv-num dv-hist-usd">${Number(ord.total).toFixed(2)}</span>
                  <span class="dv-amount-bs dv-num">{formatBs(Number(ord.total), bcvRate)}</span>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

    </main>

    <div id="urgent-dispatch-modal" class="dv-modal hidden" role="dialog" aria-modal="true" aria-labelledby="offer-store-name">
      <div class="dv-sheet tg-glass">
        <div class="dv-ring">
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <path class="dv-ring-track" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <path id="countdown-circle" class="dv-ring-bar" stroke-dasharray="100, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          </svg>
          <span id="dispatch-countdown" class="dv-ring-num dv-num">45</span>
        </div>

        <div class="dv-sheet-head">
          <span class="dv-tag dv-tag--ok">Nueva oferta de pedido</span>
          <h3 id="offer-store-name" class="dv-sheet-title">Comercio Oficial</h3>
          <p id="offer-store-dist" class="dv-card-sub">Retiro a 0.8 km de tu ubicación</p>
        </div>

        <div class="dv-sheet-box">
          <div class="dv-sheet-row">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <div class="dv-stop-body">
              <span class="dv-label">Entrega en</span>
              <p id="offer-delivery-addr" class="dv-stop-title">Av. Andrés Eloy Blanco, Higuerote</p>
            </div>
          </div>
          <div class="dv-sheet-earn">
            <span class="dv-label">Ganancia neta</span>
            <div class="dv-amount">
              <span id="offer-earnings-usd" class="dv-offer-usd dv-num">$3.50</span>
              <span id="offer-earnings-bs" class="dv-amount-bs dv-num">~ Bs. 3.136,43 @ BCV</span>
            </div>
          </div>
        </div>

        <div class="dv-sheet-actions">
          <button id="btn-accept-offer" type="button" class="dv-btn dv-btn--success dv-btn--xl">
            <span>Aceptar pedido</span>
          </button>
          <button id="btn-reject-offer" type="button" class="dv-btn dv-btn--text">Rechazar</button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ driverId, bcvRate, storesMap }}>
      (() => {
        const API_ORDERS = 'https://api.traigalo.org/v2/orders';
        const API_LOCATIONS = 'https://api.traigalo.org/v2/drivers/locations';
        const API_DISPATCH = 'https://api.traigalo.org/v2/dispatch';

        let dispatchCountdownTimer = null;
        let alertSoundInterval = null;
        let currentOffer = null;

        function playUrgentArpeggio() {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;

            const notes = [440, 554.37, 659.25, 880];
            notes.forEach((freq, idx) => {
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(freq, now + (idx * 0.08));

              gain.gain.setValueAtTime(0.3, now + (idx * 0.08));
              gain.gain.exponentialRampToValueAtTime(0.01, now + (idx * 0.08) + 0.15);

              osc.connect(gain);
              gain.connect(ctx.destination);

              osc.start(now + (idx * 0.08));
              osc.stop(now + (idx * 0.08) + 0.15);
            });
          } catch {}
        }

        function startUrgentAlertAudio() {
          playUrgentArpeggio();
          if (!alertSoundInterval) {
            alertSoundInterval = setInterval(playUrgentArpeggio, 1200);
          }
        }

        function stopUrgentAlertAudio() {
          if (alertSoundInterval) {
            clearInterval(alertSoundInterval);
            alertSoundInterval = null;
          }
        }

        function showDispatchOfferModal(offer) {
          currentOffer = offer;
          const modal = document.getElementById('urgent-dispatch-modal');
          const countdownEl = document.getElementById('dispatch-countdown');
          const circle = document.getElementById('countdown-circle');
          const storeNameEl = document.getElementById('offer-store-name');
          const storeDistEl = document.getElementById('offer-store-dist');
          const addrEl = document.getElementById('offer-delivery-addr');
          const earnUsdEl = document.getElementById('offer-earnings-usd');
          const earnBsEl = document.getElementById('offer-earnings-bs');

          const resolvedStoreName = offer.store_name || (storesMap && storesMap[offer.store_id] && storesMap[offer.store_id].name) || 'Comercio Oficial';
          if (storeNameEl) storeNameEl.textContent = resolvedStoreName;
          if (storeDistEl) storeDistEl.textContent = `Retiro a ${offer.pickup_distance || '0.8 km'} de tu ubicación`;
          if (addrEl) addrEl.textContent = offer.delivery_address || 'Av. Andrés Eloy Blanco, Higuerote';

          const earningsUSD = Number(offer.earnings_usd || 3.50);
          const earningsBS = earningsUSD * (bcvRate || 896.12);
          if (earnUsdEl) earnUsdEl.textContent = `$${earningsUSD.toFixed(2)}`;
          if (earnBsEl) {
            earnBsEl.textContent = `~ Bs. ${new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2 }).format(earningsBS)} @ BCV`;
          }

          if (modal) modal.classList.remove('hidden');
          startUrgentAlertAudio();

          let timeLeft = 45;
          if (countdownEl) countdownEl.textContent = String(timeLeft);
          if (circle) circle.setAttribute('stroke-dasharray', '100, 100');

          if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
          dispatchCountdownTimer = setInterval(() => {
            timeLeft--;
            if (countdownEl) countdownEl.textContent = String(timeLeft);
            if (circle) {
              const pct = (timeLeft / 45) * 100;
              circle.setAttribute('stroke-dasharray', `${pct}, 100`);
            }

            if (timeLeft <= 0) {
              closeDispatchOfferModal();
            }
          }, 1000);
        }

        function closeDispatchOfferModal() {
          const modal = document.getElementById('urgent-dispatch-modal');
          if (modal) modal.classList.add('hidden');
          stopUrgentAlertAudio();
          if (dispatchCountdownTimer) {
            clearInterval(dispatchCountdownTimer);
            dispatchCountdownTimer = null;
          }
          currentOffer = null;
        }

        const acceptOfferBtn = document.getElementById('btn-accept-offer');
        if (acceptOfferBtn) {
          acceptOfferBtn.addEventListener('click', async () => {
            if (!currentOffer) return;
            acceptOfferBtn.disabled = true;
            acceptOfferBtn.textContent = 'Aceptando...';

            try {
              const offerId = currentOffer.id || currentOffer.offer_id || currentOffer.order_id;
              const res = await fetch(`${API_DISPATCH}/offers/${offerId}/actions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'accept', driver_id: driverId })
              });

              if (!res.ok) {
                await fetch(`${API_ORDERS}/${offerId}/actions`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'assign_driver', driver_id: driverId })
                });
              }

              closeDispatchOfferModal();
              window.location.reload();
            } catch (err) {
              closeDispatchOfferModal();
              window.location.reload();
            }
          });
        }

        const rejectOfferBtn = document.getElementById('btn-reject-offer');
        if (rejectOfferBtn) {
          rejectOfferBtn.addEventListener('click', async () => {
            if (currentOffer) {
              const offerId = currentOffer.id || currentOffer.offer_id || currentOffer.order_id;
              await fetch(`${API_DISPATCH}/offers/${offerId}/actions`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'reject', driver_id: driverId })
              }).catch(() => {});
            }
            closeDispatchOfferModal();
          });
        }

        function initDriverWebSocket() {
          let ws = null;
          try {
            ws = new WebSocket(`wss://ws.traigalo.org/ws?driver_id=${encodeURIComponent(driverId)}`);
          } catch {}

          if (ws) {
            ws.onmessage = (event) => {
              try {
                const data = JSON.parse(event.data);
                if (data.event === 'dispatch_offer' || data.type === 'dispatch_offer' || data.type === 'driver_offer') {
                  showDispatchOfferModal(data.payload || data);
                }
              } catch {}
            };
          }
        }

        initDriverWebSocket();

        async function triggerDriverAction(orderId, actionName) {
          try {
            const res = await fetch(`${API_ORDERS}/${orderId}/actions`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                action: actionName,
                driver_id: driverId 
              })
            });

            if (!res.ok) {
              throw new Error(`Error en servidor: ${res.status}`);
            }

            window.location.reload();
          } catch (err) {
            alert(`No se pudo ejecutar la acción: ${err.message}`);
          }
        }

        document.querySelectorAll('.btn-driver-action').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const orderId = btn.getAttribute('data-order-id');
            const action = btn.getAttribute('data-action');
            if (orderId && action) {
              btn.disabled = true;
              btn.textContent = 'Procesando...';
              await triggerDriverAction(orderId, action);
            }
          });
        });

        function sendLocationUpdate(lat, lng, heading = 0, speed = 0) {
          fetch(API_LOCATIONS, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              driver_id: driverId,
              latitude: lat,
              longitude: lng,
              heading: heading || 0,
              speed: speed || 0
            })
          }).catch(() => {});
        }

        function startGpsTracking() {
          const gpsPulse = document.getElementById('gps-pulse');
          const gpsText = document.getElementById('gps-text');

          if ('geolocation' in navigator) {
            navigator.geolocation.watchPosition(
              (pos) => {
                const { latitude, longitude, heading, speed } = pos.coords;
                sendLocationUpdate(latitude, longitude, heading || 0, speed || 0);
                if (gpsText) gpsText.textContent = 'GPS Transmitiendo';
                if (gpsPulse) gpsPulse.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-ping';
              },
              () => {
                simulateGpsMovement();
              },
              { enableHighAccuracy: true, maximumAge: 10000, timeout: 5000 }
            );
          } else {
            simulateGpsMovement();
          }
        }

        let simStep = 0;
        function simulateGpsMovement() {
          const baseLat = 10.4852;
          const baseLng = -66.0975;
          sendLocationUpdate(baseLat, baseLng, 90.0, 25.0);
          setInterval(() => {
            simStep = (simStep + 1) % 100;
            const lat = baseLat + (Math.sin(simStep * 0.1) * 0.002);
            const lng = baseLng + (Math.cos(simStep * 0.1) * 0.002);
            sendLocationUpdate(lat, lng, 90.0, 25.0);
          }, 5000);
        }

        function playDriverAlertTone() {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;

            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(523.25, now);
            osc.frequency.setValueAtTime(659.25, now + 0.1);
            osc.frequency.setValueAtTime(783.99, now + 0.2);
            osc.frequency.setValueAtTime(1046.50, now + 0.3);

            gain.gain.setValueAtTime(0.25, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start(now);
            osc.stop(now + 0.5);
          } catch {}
        }

        window.addEventListener('load', () => {
          const hasOrders = document.querySelector('.btn-driver-action') !== null;
          if (hasOrders) {
            playDriverAlertTone();
          }
        });

        startGpsTracking();
      })();
    </script>
  </body>
</html>
