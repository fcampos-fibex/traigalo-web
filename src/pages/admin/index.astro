---
import "../../styles/global.css";
import "../../styles/pages/admin.css";
import RoleSwitcher from "../../components/RoleSwitcher.astro";
import { getOfficialExchangeRate, formatBs } from "../../adapters/rates";

const API_BASE = "https://api.traigalo.org/v2";
const DIRECTUS_URL = "https://admin.traigalo.org";
const bcvRate = await getOfficialExchangeRate();

let stores: any[] = [];
try {
  const sRes = await fetch(`${API_BASE}/stores`);
  if (sRes.ok) {
    stores = await sRes.json();
  }
} catch {}

let orders: any[] = [];
try {
  const oRes = await fetch(`${API_BASE}/orders?size=100`);
  if (oRes.ok) {
    orders = await oRes.json();
  }
} catch {}

const totalGMV_USD = orders.reduce((acc, o) => acc + (Number(o.total) || 0), 0);
const totalGMV_BS = formatBs(totalGMV_USD, bcvRate);

const activeOrders = orders.filter(
  (o) => o.status !== "delivered" && o.status !== "cancelled"
).length;

const deliveredOrders = orders.filter((o) => o.status === "delivered").length;
const totalStoresCount = stores.length;
const liveDriversCount = orders.filter((o) => o.driver_id).length || 1;

const liveIncidents = [
  { id: "INC-102", type: "Retraso Tráfico", orderId: "TRG-7809", driver: "Manuel Díaz", time: "Hace 5m", severity: "medium" },
  { id: "INC-101", type: "Rechazo de Repartidor", orderId: "TRG-7811", driver: "Auto-reasignando", time: "Hace 8m", severity: "high" }
];
const usd = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const sortedIncidents = [...liveIncidents].sort((a, b) => (a.severity === "high" ? -1 : 0) - (b.severity === "high" ? -1 : 0));
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Traigalo Ops | Centro de Comando</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="adm-body">
    <RoleSwitcher currentRole="admin" />

    <header class="adm-bar tg-glass">
      <div class="adm-bar-inner">
        <div class="adm-brand">
          <span class="adm-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          </span>
          <div>
            <h1 class="adm-title">Traigalo control center <span class="adm-live" aria-label="En línea"></span></h1>
            <p class="adm-meta">Cluster: us-east-1 · Swarm v2</p>
          </div>
        </div>
        <a href={DIRECTUS_URL} target="_blank" rel="noopener noreferrer" class="tg-btn tg-btn--quiet tg-btn--sm adm-ext">
          <span>Directus CMS</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
    </header>

    <main class="adm-main">
      <section class="adm-panel adm-alerts" aria-labelledby="adm-alerts-title">
        <div class="adm-panel-head">
          <h2 id="adm-alerts-title" class="adm-panel-title"><span class="adm-dot adm-dot--error" aria-hidden="true"></span>Alertas de telemetría y SLA</h2>
          <span class="adm-badge adm-badge--error">{liveIncidents.length} activas</span>
        </div>
        <ul class="adm-incidents">
          {sortedIncidents.map((inc) => (
            <li class={`adm-incident adm-incident--${inc.severity}`}>
              <div class="adm-incident-body">
                <div class="adm-incident-top">
                  <span class="adm-mono adm-strong">{inc.orderId}</span>
                  <span class={`adm-badge ${inc.severity === 'high' ? 'adm-badge--error' : 'adm-badge--warn'}`}>{inc.type}</span>
                </div>
                <p class="adm-sub">{inc.driver} · <span class="adm-faint">{inc.time}</span></p>
              </div>
              <button type="button" class="tg-btn tg-btn--primary tg-btn--sm">Intervenir</button>
            </li>
          ))}
        </ul>
      </section>

      <section class="adm-panel adm-gmv" aria-labelledby="adm-gmv-title">
        <div class="adm-panel-head">
          <h2 id="adm-gmv-title" class="adm-label">Volumen bruto (GMV hoy)</h2>
          <span class="adm-badge adm-badge--success adm-num">Tasa: {bcvRate.toFixed(2)} Bs/$</span>
        </div>
        <p class="adm-gmv-usd adm-num">${usd(totalGMV_USD)}</p>
        <p class="adm-gmv-bs adm-num">{totalGMV_BS}</p>
        <dl class="adm-gmv-foot">
          <div><dt>Órdenes registradas</dt><dd class="adm-num">{orders.length}</dd></div>
          <div><dt>Entregadas</dt><dd class="adm-num">{deliveredOrders}</dd></div>
        </dl>
      </section>

      <section class="adm-kpis" aria-label="Indicadores">
        <div class="adm-kpi">
          <span class="adm-label">En despacho</span>
          <p class="adm-kpi-value adm-num">{activeOrders}</p>
          <span class="adm-kpi-note adm-kpi-note--accent">En tiempo real</span>
        </div>
        <div class="adm-kpi">
          <span class="adm-label">Repartidores</span>
          <p class="adm-kpi-value adm-kpi-value--success adm-num">{liveDriversCount}</p>
          <span class="adm-kpi-note">Redis GEO</span>
        </div>
        <div class="adm-kpi">
          <span class="adm-label">Comercios</span>
          <p class="adm-kpi-value adm-num">{totalStoresCount}</p>
          <span class="adm-kpi-note adm-kpi-note--success">100% online</span>
        </div>
      </section>

      <section class="adm-panel" aria-labelledby="adm-stores-title">
        <div class="adm-panel-head">
          <h2 id="adm-stores-title" class="adm-panel-title">Comercios aliados en vivo</h2>
          <span class="adm-badge adm-num">{totalStoresCount}</span>
        </div>
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead>
              <tr><th scope="col">#</th><th scope="col">Comercio</th><th scope="col">Dirección</th><th scope="col">Estado</th></tr>
            </thead>
            <tbody>
              {stores.map((store, idx) => (
                <tr>
                  <td class="adm-mono adm-num adm-faint">0{idx + 1}</td>
                  <td class="adm-strong">{store.name}</td>
                  <td class="adm-sub adm-addr">{store.address_line || 'Caracas, Venezuela'}</td>
                  <td><span class="adm-status"><span class="adm-dot adm-dot--success" aria-hidden="true"></span>Activo</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>
