---
import "../../styles/global.css";
import RoleSwitcher from "../../components/RoleSwitcher.astro";

const metrics = {
  activeOrders: 142,
  liveDrivers: 68,
  activeStores: 34,
  gmvToday: 12480.50,
  slaCompliance: "99.2%"
};

const liveIncidents = [
  { id: "INC-102", type: "Retraso Tráfico", orderId: "TRG-7809", driver: "Manuel Díaz", time: "Hace 5m", severity: "medium" },
  { id: "INC-101", type: "Rechazo de Repartidor", orderId: "TRG-7811", driver: "Auto-reasignando", time: "Hace 8m", severity: "high" }
];

const topVendors = [
  { name: "Burger Crave", orders: 48, status: "Operativo", rating: 4.9 },
  { name: "Sushi Omakase Roll", orders: 32, status: "Operativo", rating: 4.8 },
  { name: "Pizzeria Napolitana", orders: 27, status: "Alta Demanda", rating: 4.7 }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Traigalo Ops | Centro de Comando</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0D1117] text-[#E6EDF3] font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#FF7A00] selection:text-white pb-28">
    <RoleSwitcher currentRole="admin" />

    <header class="sticky top-0 z-30 bg-[#161B22]/90 backdrop-blur-md border-b border-gray-800 px-5 py-4">
      <div class="max-w-md mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-[#FF7A00] to-rose-500 flex items-center justify-center text-white shadow-lg shadow-orange-500/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-sm font-black tracking-wide text-white uppercase">Traigalo Control Center</h1>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            </div>
            <p class="text-[11px] text-gray-400 font-mono">Cluster: us-east-1 • Swarm v2</p>
          </div>
        </div>

        <a href="http://ec2-44-217-190-140.compute-1.amazonaws.com:8055" target="_blank" class="px-3 py-1.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-xs font-bold text-gray-200 border border-gray-700 flex items-center gap-1.5 transition-all">
          <span>Directus CMS</span>
          <svg class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </header>

    <main class="max-w-md mx-auto px-5 pt-4 space-y-4">
      <div class="bg-gradient-to-br from-[#1F242C] to-[#161B22] rounded-3xl p-5 border border-gray-800 shadow-xl relative overflow-hidden">
        <div class="flex items-center justify-between pb-3 border-b border-gray-800/80">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Volumen Bruto (GMV Hoy)</span>
          <span class="text-xs font-black text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded-lg">+22.4%</span>
        </div>
        <div class="mt-3 flex items-baseline justify-between">
          <span class="text-3xl font-black text-white">${metrics.gmvToday.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
          <span class="text-xs text-gray-400 font-medium">SLA: <strong class="text-white">{metrics.slaCompliance}</strong></span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div class="bg-[#161B22] rounded-2xl p-3 border border-gray-800 text-center">
          <span class="text-[10px] font-bold text-gray-400 uppercase">En Despacho</span>
          <p class="text-xl font-black text-white mt-0.5">{metrics.activeOrders}</p>
          <span class="text-[10px] text-[#FF7A00] font-semibold">Tiempo: 21m</span>
        </div>
        <div class="bg-[#161B22] rounded-2xl p-3 border border-gray-800 text-center">
          <span class="text-[10px] font-bold text-gray-400 uppercase">Repartidores</span>
          <p class="text-xl font-black text-emerald-400 mt-0.5">{metrics.liveDrivers}</p>
          <span class="text-[10px] text-gray-400 font-semibold">Redis GEO</span>
        </div>
        <div class="bg-[#161B22] rounded-2xl p-3 border border-gray-800 text-center">
          <span class="text-[10px] font-bold text-gray-400 uppercase">Comercios</span>
          <p class="text-xl font-black text-white mt-0.5">{metrics.activeStores}</p>
          <span class="text-[10px] text-emerald-400 font-semibold">100% online</span>
        </div>
      </div>

      <div class="bg-[#161B22] rounded-3xl p-5 border border-gray-800 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-extrabold text-white uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Alertas de Telemetría y SLA
          </h3>
          <span class="text-[10px] font-bold bg-rose-950 text-rose-400 px-2 py-0.5 rounded-full border border-rose-800/60">2 activas</span>
        </div>

        <div class="space-y-2">
          {liveIncidents.map((inc) => (
            <div class="p-3 rounded-2xl bg-[#0D1117] border border-gray-800/80 flex items-center justify-between">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-white">{inc.orderId}</span>
                  <span class={`text-[10px] font-bold px-1.5 py-0.2 rounded ${inc.severity === 'high' ? 'bg-rose-900/60 text-rose-300' : 'bg-amber-900/60 text-amber-300'}`}>
                    {inc.type}
                  </span>
                </div>
                <p class="text-[11px] text-gray-400">{inc.driver} • <span class="text-gray-500">{inc.time}</span></p>
              </div>
              <button class="px-3 py-1.5 bg-[#FF7A00] hover:bg-[#E66E00] text-white text-[11px] font-extrabold rounded-xl shadow-sm">
                Intervenir
              </button>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-[#161B22] rounded-3xl p-5 border border-gray-800 space-y-3">
        <h3 class="text-xs font-extrabold text-white uppercase tracking-wider">Top Comercios Activos</h3>
        <div class="space-y-2.5">
          {topVendors.map((vendor, idx) => (
            <div class="flex items-center justify-between p-3 rounded-2xl bg-[#0D1117] border border-gray-800/60">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-lg bg-gray-800 text-gray-300 text-xs font-black flex items-center justify-center font-mono">
                  0{idx + 1}
                </span>
                <div>
                  <p class="text-xs font-bold text-white">{vendor.name}</p>
                  <p class="text-[11px] text-gray-400">{vendor.orders} despachos completados</p>
                </div>
              </div>
              <div class="flex items-center gap-1.5 text-xs font-extrabold text-amber-400">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span>{vendor.rating}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>
