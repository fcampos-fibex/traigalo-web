---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate } from '../../adapters/rates';
import '../../styles/global.css';
import '../../styles/pages/rides.css';

const bcvRate = await getOfficialExchangeRate();
const bcvFormatted = bcvRate.toFixed(2);
---

<!doctype html>
<html lang="es" data-rubro="rides">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Traigalo Rides | Taxis, Motos y Movilidad en Higuerote y Miranda</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta name="description" content="Movilidad urbana confiable e inteligente con Traigalo Rides. Tarifa transparente en USD y Bs a tasa BCV oficial." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
      #rides-map {
        width: 100%;
        height: 100%;
      }
      .driver-car-marker {
        transition: transform 0.08s linear;
        transform-origin: center center;
      }
    </style>
  </head>
  <body class="rd-body" data-bcv-rate={bcvRate}>
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="rd-main">
      <section class="rd-stage" aria-label="Mapa del viaje">
        <div id="rides-map"></div>

        <div class="rd-stage-top">
          <div class="rd-chip">
            <span id="rides-ws-indicator" class="rd-dot"></span>
            <span id="rides-ws-status">Toca el mapa para marcar tu destino</span>
          </div>
          <div class="rd-chip rd-chip--rate">
            <span class="rd-chip-muted">Tasa oficial BCV:</span>
            <strong>{bcvFormatted} Bs/$</strong>
          </div>
        </div>

        <div id="searching-overlay" class="rd-searching hidden">
          <div class="rd-spinner" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
          </div>
          <h4 class="rd-searching-title">Buscando conductores cercanos...</h4>
          <p class="rd-searching-copy">Buscando una unidad disponible cerca de ti.</p>
          <div class="rd-progress"><span></span></div>
        </div>

        <div class="rd-stage-bottom">
          <div class="rd-route-pill">
            <div>
              <span class="rd-route-label">Origen</span>
              <span id="label-origin" class="rd-route-value">Origen</span>
            </div>
            <svg class="rd-route-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <div>
              <span class="rd-route-label">Destino</span>
              <span id="label-dest" class="rd-route-value">Destino</span>
            </div>
          </div>
          <button id="btn-recenter" class="rd-icon-btn" title="Centrar mapa" aria-label="Centrar mapa">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          </button>
        </div>
      </section>

      <section class="rd-sheet tg-glass" aria-label="Solicitar carrera">
        <span class="rd-grabber" aria-hidden="true"></span>

        <header class="rd-sheet-head">
          <span class="rd-eyebrow"><span class="rd-dot rd-dot--module"></span>Traigalo Mobility • Higuerote & Miranda</span>
          <h1 class="rd-title">Viaja seguro, rápido y a tasa oficial</h1>
        </header>

        <div class="rd-block">
          <div class="rd-block-head">
            <h2 class="rd-h2">¿A dónde te llevamos?</h2>
            <span class="rd-tag">Tarifa GPS</span>
          </div>

          <div class="rd-route">
            <label class="rd-field">
              <span class="rd-pin rd-pin--a" aria-hidden="true"></span>
              <input id="ride-origin" type="text" value="" placeholder="Punto de partida" aria-label="Punto de partida" />
            </label>
            <span class="rd-route-line" aria-hidden="true"></span>
            <label class="rd-field">
              <span class="rd-pin rd-pin--b" aria-hidden="true"></span>
              <input id="ride-destination" type="text" value="" placeholder="¿Cuál es tu destino? Toca el mapa" aria-label="Destino" />
            </label>
          </div>

          <div class="rd-metrics">
            <span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg>
              Distancia: <strong id="ride-km">—</strong>
            </span>
          </div>
        </div>

        <div class="rd-block">
          <h3 class="rd-h3">Selecciona tu categoría</h3>

          <div class="rd-vehicles" id="vehicle-selector">
            <div data-type="moto" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17" r="3"/><circle cx="18.5" cy="17" r="3"/><path d="M8.5 17h6l3-6h-4l-2-4H9M14 7h3"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Moto Express <span class="rd-badge rd-badge--ok">Más rápido</span></div>
                <p class="rd-v-meta">1 pasajero • Ideal para traslado rápido</p>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">—</div>
                <div class="fare-bs"></div>
              </div>
            </div>

            <div data-type="auto" class="vehicle-card active" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16v-3l2-5h14l2 5v3z"/><circle cx="7" cy="16.5" r="1.8"/><circle cx="17" cy="16.5" r="1.8"/><path d="M5 13h14"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Auto Traigalo <span class="rd-badge rd-badge--module">Popular</span></div>
                <p class="rd-v-meta">4 pasajeros • A/C garantizado</p>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">—</div>
                <div class="fare-bs"></div>
              </div>
            </div>

            <div data-type="comfort" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16v-4l3-5h11l4 5h2v4z"/><circle cx="7" cy="16.5" r="1.8"/><circle cx="17" cy="16.5" r="1.8"/><path d="M10 7v5"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Traigalo Comfort XL <span class="rd-badge">Premium</span></div>
                <p class="rd-v-meta">Camioneta SUV espaciosa • Equipaje</p>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">—</div>
                <div class="fare-bs"></div>
              </div>
            </div>

            <div data-type="flete" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Envíos y fletes</div>
                <p class="rd-v-meta">Carga mediana • Encomiendas express</p>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">—</div>
                <div class="fare-bs"></div>
              </div>
            </div>
          </div>
        </div>

        <button id="btn-request-ride" class="tg-btn tg-btn--primary rd-cta">
          <span>Solicitar carrera ahora</span>
        </button>

        <div id="driver-standby-card" class="rd-card rd-standby">
          <div class="rd-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
          </div>
          <div class="rd-card-body">
            <h4 class="rd-card-title">Conductores listos para tu carrera</h4>
            <p class="rd-card-copy">Selecciona tu categoría y presiona <strong>Solicitar carrera ahora</strong> para asignar tu unidad.</p>
          </div>
          <span id="drivers-online" class="rd-badge rd-badge--ok" hidden></span>
        </div>

        <div class="rd-safe">
          <div class="rd-card-icon rd-card-icon--night" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="rd-card-body">
            <h5 class="rd-safe-title">Traigalo seguro 100%</h5>
            <p class="rd-safe-copy">Comparte tu viaje y ten a mano el número de emergencias.</p>
          </div>
          <a href="tel:911" class="tg-btn tg-btn--sm tg-btn--quiet rd-safe-link">Emergencias 911</a>
        </div>
      </section>
    </main>

    <Footer />
    <BottomNav />

    <script is:inline>
      (() => {
        const API = 'https://api.traigalo.org/v2';
        const FARES = {
          moto: { apiType: 'moto', base: 1.5, perKm: 0.5 },
          auto: { apiType: 'standard', base: 2.5, perKm: 0.8 },
          comfort: { apiType: 'comfort', base: 4.0, perKm: 1.2 },
          flete: { apiType: 'cargo', base: 5.0, perKm: 1.5 }
        };
        const fmtBs = new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        let bcvRate = 0;
        let currentKm = 0;
        let selectedType = 'auto';
        let pickupPos = null;
        let dropoffPos = null;
        let ridesMap = null;
        let pickupMarker = null;
        let dropoffMarker = null;
        let carMarker = null;
        let rideLine = null;
        let rideWs = null;

        const originInput = document.getElementById('ride-origin');
        const destInput = document.getElementById('ride-destination');
        const kmEl = document.getElementById('ride-km');
        const labelOrigin = document.getElementById('label-origin');
        const labelDest = document.getElementById('label-dest');
        const wsStatus = document.getElementById('rides-ws-status');
        const onlineBadge = document.getElementById('drivers-online');
        const requestBtn = document.getElementById('btn-request-ride');
        const searchOverlay = document.getElementById('searching-overlay');
        const vehicleCards = document.querySelectorAll('.vehicle-card');

        function setStatus(text) {
          if (wsStatus) wsStatus.textContent = text;
        }

        function distanceKm(a, b) {
          const rad = (d) => (d * Math.PI) / 180;
          const dLat = rad(b.lat - a.lat);
          const dLng = rad(b.lng - a.lng);
          const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
          return 6371 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
        }

        function fareFor(type, km) {
          const cfg = FARES[type] || FARES.auto;
          return Math.round(Math.max(cfg.base, cfg.base + km * cfg.perKm) * 100) / 100;
        }

        function updateFares() {
          const ready = Boolean(pickupPos && dropoffPos);
          vehicleCards.forEach((card) => {
            const usdEl = card.querySelector('.fare-usd');
            const bsEl = card.querySelector('.fare-bs');
            if (!ready) {
              if (usdEl) usdEl.textContent = '—';
              if (bsEl) bsEl.textContent = '';
              return;
            }
            const usd = fareFor(card.getAttribute('data-type'), currentKm);
            if (usdEl) usdEl.textContent = `$${usd.toFixed(2)}`;
            if (bsEl) bsEl.textContent = bcvRate > 0 ? `~ Bs. ${fmtBs.format(usd * bcvRate)}` : '';
          });
          if (requestBtn) requestBtn.toggleAttribute('disabled', !ready);
        }

        function updateTrip() {
          currentKm = pickupPos && dropoffPos ? Math.round(distanceKm(pickupPos, dropoffPos) * 10) / 10 : 0;
          if (kmEl) kmEl.textContent = currentKm > 0 ? `${currentKm} km` : '—';
          if (labelOrigin) labelOrigin.textContent = (originInput && originInput.value.split(',')[0]) || 'Origen';
          if (labelDest) labelDest.textContent = (destInput && destInput.value.split(',')[0]) || 'Destino';
          if (rideLine) rideLine.setLatLngs(pickupPos && dropoffPos ? [[pickupPos.lat, pickupPos.lng], [dropoffPos.lat, dropoffPos.lng]] : []);
          updateFares();
        }

        vehicleCards.forEach((card) => {
          card.addEventListener('click', () => {
            vehicleCards.forEach((c) => c.classList.remove('active'));
            card.classList.add('active');
            selectedType = card.getAttribute('data-type');
          });
        });

        if (originInput) originInput.addEventListener('input', updateTrip);
        if (destInput) destInput.addEventListener('input', updateTrip);

        function readSavedLocation() {
          try {
            const raw = JSON.parse(localStorage.getItem('traigalo_location') || 'null');
            const lat = Number(raw && raw.latitude);
            const lng = Number(raw && raw.longitude);
            if (lat && lng) return { lat, lng, address: raw.address || '' };
          } catch {}
          return null;
        }

        async function loadRate() {
          try {
            const res = await fetch(`${API}/rates`);
            if (!res.ok) return;
            const data = await res.json();
            const rate = Number(data && data.rate);
            if (rate > 0) {
              bcvRate = rate;
              updateFares();
            }
          } catch {}
        }

        async function loadDriversOnline(pos) {
          if (!onlineBadge || !pos) return;
          try {
            const res = await fetch(`${API}/drivers/locations/nearby?latitude=${pos.lat}&longitude=${pos.lng}&radius-km=10`);
            if (!res.ok) return;
            const list = await res.json();
            const count = Array.isArray(list) ? list.length : 0;
            onlineBadge.textContent = count === 1 ? '1 en línea' : `${count} en línea`;
            onlineBadge.hidden = false;
          } catch {}
        }

        function pinIcon(label, cls) {
          return L.divIcon({ className: '', html: `<div class="rd-map-pin ${cls}">${label}</div>`, iconSize: [32, 32], iconAnchor: [16, 16] });
        }

        function setPickup(pos) {
          pickupPos = pos;
          if (!ridesMap) return;
          if (pickupMarker) pickupMarker.setLatLng([pos.lat, pos.lng]);
          else pickupMarker = L.marker([pos.lat, pos.lng], { icon: pinIcon('A', 'rd-map-pin--a') }).addTo(ridesMap);
        }

        function setDropoff(pos) {
          dropoffPos = pos;
          if (!ridesMap) return;
          if (dropoffMarker) dropoffMarker.setLatLng([pos.lat, pos.lng]);
          else dropoffMarker = L.marker([pos.lat, pos.lng], { icon: pinIcon('B', 'rd-map-pin--b') }).addTo(ridesMap);
        }

        function initRidesMap() {
          const mapEl = document.getElementById('rides-map');
          if (!mapEl || typeof L === 'undefined') return;
          const saved = readSavedLocation();
          const center = saved || { lat: 10.4842, lng: -66.099 };
          ridesMap = L.map(mapEl, { zoomControl: false, attributionControl: false }).setView([center.lat, center.lng], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(ridesMap);
          rideLine = L.polyline([], { color: '#F2801F', weight: 4, opacity: 0.85, dashArray: '8, 8' }).addTo(ridesMap);

          if (saved) {
            setPickup(saved);
            if (originInput && !originInput.value) originInput.value = saved.address;
            loadDriversOnline(saved);
          } else {
            setStatus('Toca el mapa para marcar tu punto de partida');
          }

          ridesMap.on('click', (e) => {
            const pos = { lat: e.latlng.lat, lng: e.latlng.lng };
            if (!pickupPos) {
              setPickup(pos);
              loadDriversOnline(pos);
              setStatus('Ahora toca el mapa para marcar tu destino');
            } else {
              setDropoff(pos);
              setStatus('Destino marcado. Elige tu categoría');
            }
            updateTrip();
          });

          const recenterBtn = document.getElementById('btn-recenter');
          if (recenterBtn) {
            recenterBtn.addEventListener('click', () => {
              const target = pickupPos || center;
              ridesMap.setView([target.lat, target.lng], 15);
            });
          }
          updateTrip();
        }

        function showCar(lat, lng) {
          if (!ridesMap) return;
          if (carMarker) carMarker.setLatLng([lat, lng]);
          else carMarker = L.marker([lat, lng], { icon: pinIcon('', 'rd-map-pin--car') }).addTo(ridesMap);
        }

        function connectRideWebSocket(rideId) {
          try {
            rideWs = new WebSocket(`wss://ws.traigalo.org/ws?ride_id=${encodeURIComponent(rideId)}`);
          } catch {
            return;
          }
          rideWs.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);
              const lat = Number(data.lat || data.latitude);
              const lng = Number(data.lng || data.longitude);
              if (lat && lng) {
                showCar(lat, lng);
                setStatus('Conductor en camino');
              }
            } catch {}
          };
        }

        function resetRequestButton(label) {
          if (!requestBtn) return;
          requestBtn.removeAttribute('disabled');
          requestBtn.textContent = label;
        }

        if (requestBtn) {
          requestBtn.addEventListener('click', async () => {
            if (!pickupPos || !dropoffPos) return;
            const token = localStorage.getItem('traigalo_token');
            if (!token) {
              window.location.href = '/login';
              return;
            }
            if (searchOverlay) searchOverlay.classList.remove('hidden');
            requestBtn.setAttribute('disabled', 'true');
            requestBtn.textContent = 'Creando solicitud…';

            const payload = {
              vehicle_type: (FARES[selectedType] || FARES.auto).apiType,
              pickup_latitude: pickupPos.lat,
              pickup_longitude: pickupPos.lng,
              pickup_address: originInput ? originInput.value.trim() : '',
              dropoff_latitude: dropoffPos.lat,
              dropoff_longitude: dropoffPos.lng,
              dropoff_address: destInput ? destInput.value.trim() : ''
            };

            try {
              const res = await fetch(`${API}/rides`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
                body: JSON.stringify(payload)
              });
              if (searchOverlay) searchOverlay.classList.add('hidden');
              if (!res.ok) {
                setStatus('No se pudo crear la solicitud. Intenta de nuevo');
                resetRequestButton('Solicitar carrera ahora');
                return;
              }
              const ride = await res.json();
              const fare = Number(ride.fare_usd);
              setStatus(fare > 0 ? `Solicitud creada, tarifa $${fare.toFixed(2)}, buscando conductor` : 'Solicitud creada, buscando conductor');
              requestBtn.textContent = 'Buscando conductor…';
              if (ride.id) connectRideWebSocket(ride.id);
            } catch {
              if (searchOverlay) searchOverlay.classList.add('hidden');
              setStatus('Sin conexión. Intenta de nuevo');
              resetRequestButton('Solicitar carrera ahora');
            }
          });
        }

        loadRate();
        if (document.readyState === 'complete') initRidesMap();
        else window.addEventListener('load', initRidesMap);
      })();
    </script>
  </body>
</html>
