---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import RoleSwitcher from '../../components/RoleSwitcher.astro';
import { getOfficialExchangeRate } from '../../adapters/rates';
import '../../styles/global.css';
import '../../styles/pages/rides.css';

const bcvRate = await getOfficialExchangeRate();
const bcvFormatted = bcvRate.toFixed(2);
---

<!doctype html>
<html lang="es" data-rubro="rides">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Traigalo Rides | Taxis, Motos y Movilidad en Higuerote y Miranda</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/icon-192.png?v=3" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5A00" />
    <meta name="description" content="Movilidad urbana confiable e inteligente con Traigalo Rides. Tarifa transparente en USD y Bs a tasa BCV oficial." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
      #rides-map {
        width: 100%;
        height: 100%;
      }
      .driver-car-marker {
        transition: transform 0.08s linear;
        transform-origin: center center;
      }
    </style>
  </head>
  <body class="rd-body" data-bcv-rate={bcvRate}>
    <RoleSwitcher currentRole="client" />
    <Header />

    <main class="rd-main">
      <section class="rd-stage" aria-label="Mapa del viaje">
        <div id="rides-map"></div>

        <div class="rd-stage-top">
          <div class="rd-chip">
            <span id="rides-ws-indicator" class="rd-dot"></span>
            <span id="rides-ws-status">Unidades Verificadas en Zona</span>
          </div>
          <div class="rd-chip rd-chip--rate">
            <span class="rd-chip-muted">Tasa oficial BCV:</span>
            <strong>{bcvFormatted} Bs/$</strong>
          </div>
        </div>

        <div id="searching-overlay" class="rd-searching hidden">
          <div class="rd-spinner" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
          </div>
          <h4 class="rd-searching-title">Buscando conductores cercanos...</h4>
          <p class="rd-searching-copy">Contactando unidades verificadas en Higuerote y Carenero.</p>
          <div class="rd-progress"><span></span></div>
        </div>

        <div class="rd-stage-bottom">
          <div class="rd-route-pill">
            <div>
              <span class="rd-route-label">Origen</span>
              <span id="label-origin" class="rd-route-value">Higuerote</span>
            </div>
            <svg class="rd-route-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <div>
              <span class="rd-route-label">Destino</span>
              <span id="label-dest" class="rd-route-value">Carenero</span>
            </div>
          </div>
          <button id="btn-recenter" class="rd-icon-btn" title="Centrar mapa" aria-label="Centrar mapa">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          </button>
        </div>
      </section>

      <section class="rd-sheet tg-glass" aria-label="Solicitar carrera">
        <span class="rd-grabber" aria-hidden="true"></span>

        <header class="rd-sheet-head">
          <span class="rd-eyebrow"><span class="rd-dot rd-dot--module"></span>Traigalo Mobility • Higuerote & Miranda</span>
          <h1 class="rd-title">Viaja seguro, rápido y a tasa oficial</h1>
        </header>

        <div class="rd-block">
          <div class="rd-block-head">
            <h2 class="rd-h2">¿A dónde te llevamos?</h2>
            <span class="rd-tag">Tarifa GPS</span>
          </div>

          <div class="rd-route">
            <label class="rd-field">
              <span class="rd-pin rd-pin--a" aria-hidden="true"></span>
              <input id="ride-origin" type="text" value="Av. Andrés Eloy Blanco, Higuerote" placeholder="Punto de partida..." aria-label="Punto de partida" />
            </label>
            <span class="rd-route-line" aria-hidden="true"></span>
            <label class="rd-field">
              <span class="rd-pin rd-pin--b" aria-hidden="true"></span>
              <input id="ride-destination" type="text" value="Bahía de Carenero / Puerto Totumo" placeholder="¿Cuál es tu destino?" aria-label="Destino" />
            </label>
          </div>

          <div class="rd-metrics">
            <span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg>
              Distancia estimada: <strong id="ride-km">3.4 km</strong>
            </span>
            <span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/></svg>
              Tiempo: <strong id="ride-min">8 min</strong>
            </span>
          </div>
        </div>

        <div class="rd-block">
          <h3 class="rd-h3">Selecciona tu categoría</h3>

          <div class="rd-vehicles" id="vehicle-selector">
            <div data-type="moto" data-base="1.5" data-km="0.5" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17" r="3"/><circle cx="18.5" cy="17" r="3"/><path d="M8.5 17h6l3-6h-4l-2-4H9M14 7h3"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Moto Express <span class="rd-badge rd-badge--ok">Más rápido</span></div>
                <p class="rd-v-meta">1 pasajero • Ideal para traslado rápido</p>
                <span class="rd-v-eta">Llegada en 3 min</span>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">$3.20</div>
                <div class="fare-bs">~ Bs. 2,867.58</div>
              </div>
            </div>

            <div data-type="auto" data-base="2.8" data-km="0.8" class="vehicle-card active" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16v-3l2-5h14l2 5v3z"/><circle cx="7" cy="16.5" r="1.8"/><circle cx="17" cy="16.5" r="1.8"/><path d="M5 13h14"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Auto Traigalo <span class="rd-badge rd-badge--module">Popular</span></div>
                <p class="rd-v-meta">4 pasajeros • A/C garantizado</p>
                <span class="rd-v-eta">Llegada en 5 min</span>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">$5.52</div>
                <div class="fare-bs">~ Bs. 4,946.58</div>
              </div>
            </div>

            <div data-type="comfort" data-base="4.5" data-km="1.2" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16v-4l3-5h11l4 5h2v4z"/><circle cx="7" cy="16.5" r="1.8"/><circle cx="17" cy="16.5" r="1.8"/><path d="M10 7v5"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Traigalo Comfort XL <span class="rd-badge">Premium</span></div>
                <p class="rd-v-meta">Camioneta SUV espaciosa • Equipaje</p>
                <span class="rd-v-eta">Llegada en 7 min</span>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">$8.58</div>
                <div class="fare-bs">~ Bs. 7,688.71</div>
              </div>
            </div>

            <div data-type="flete" data-base="5.0" data-km="1.0" class="vehicle-card" tabindex="0" role="button">
              <div class="rd-v-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg>
              </div>
              <div class="rd-v-body">
                <div class="rd-v-name">Envíos y fletes</div>
                <p class="rd-v-meta">Carga mediana • Encomiendas express</p>
                <span class="rd-v-eta">Llegada en 8 min</span>
              </div>
              <div class="rd-v-price">
                <div class="fare-usd">$8.40</div>
                <div class="fare-bs">~ Bs. 7,527.41</div>
              </div>
            </div>
          </div>
        </div>

        <button id="btn-request-ride" class="tg-btn tg-btn--primary rd-cta">
          <span>Solicitar carrera ahora</span>
        </button>

        <div id="driver-standby-card" class="rd-card rd-standby">
          <div class="rd-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
          </div>
          <div class="rd-card-body">
            <h4 class="rd-card-title">Conductores listos para tu carrera</h4>
            <p class="rd-card-copy">Selecciona tu categoría y presiona <strong>Solicitar carrera ahora</strong> para asignar tu unidad.</p>
          </div>
          <span class="rd-badge rd-badge--ok">6 en línea</span>
        </div>

        <div id="driver-card" class="rd-card rd-driver hidden">
          <div class="rd-driver-row">
            <div class="rd-avatar">
              CR
              <span class="rd-avatar-dot" title="Conductor en línea"></span>
            </div>
            <div class="rd-card-body">
              <div class="rd-driver-name">
                <h4 class="rd-card-title">Carlos R. Mendoza</h4>
                <span class="rd-badge rd-badge--star">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.6 7 .7-5.3 4.8 1.6 7L12 17.5 5.7 21l1.6-7L2 9.3l7-.7z"/></svg>
                  4.95
                </span>
              </div>
              <p class="rd-card-copy">Toyota Corolla Blanco (2018)</p>
              <div class="rd-driver-meta">
                <span class="rd-plate">AB123CD</span>
                <span class="rd-assigned">• Conductor asignado</span>
              </div>
            </div>
            <div class="rd-eta">
              <span class="rd-route-label">Llegada</span>
              <strong>4 min</strong>
            </div>
          </div>

          <div class="rd-driver-actions">
            <button id="btn-share-trip" class="tg-btn tg-btn--sm rd-act rd-act--share">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1-5A8 8 0 1 1 21 12z"/></svg>
              <span>Compartir viaje</span>
            </button>
            <button id="btn-sos" class="tg-btn tg-btn--sm rd-act rd-act--sos">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20z"/><path d="M12 10v4M12 17h.01"/></svg>
              <span>Botón SOS 911</span>
            </button>
          </div>
        </div>

        <div class="rd-safe">
          <div class="rd-card-icon rd-card-icon--night" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="rd-card-body">
            <h5 class="rd-safe-title">Traigalo seguro 100%</h5>
            <p class="rd-safe-copy">Conductores verificados con antecedentes penales y monitoreo telemático en vivo.</p>
          </div>
          <a href="https://wa.me/584120000000" target="_blank" class="tg-btn tg-btn--sm tg-btn--quiet rd-safe-link">Soporte 24/7</a>
        </div>
      </section>
    </main>

    <Footer />
    <BottomNav />

    <script is:inline>
      (() => {
        const body = document.body;
        const bcvRate = parseFloat(body.getAttribute('data-bcv-rate')) || 896.12;

        let currentKm = 3.4;
        let selectedType = 'auto';

        const ratesConfig = {
          moto: { base: 1.5, perKm: 0.5 },
          auto: { base: 2.8, perKm: 0.8 },
          comfort: { base: 4.5, perKm: 1.2 },
          flete: { base: 5.0, perKm: 1.0 }
        };

        function updateFares() {
          const cards = document.querySelectorAll('.vehicle-card');
          cards.forEach(card => {
            const type = card.getAttribute('data-type');
            const cfg = ratesConfig[type];
            if (!cfg) return;

            const totalUsd = cfg.base + (cfg.perKm * currentKm);
            const totalBs = totalUsd * bcvRate;

            const usdEl = card.querySelector('.fare-usd');
            const bsEl = card.querySelector('.fare-bs');

            if (usdEl) usdEl.textContent = `$${totalUsd.toFixed(2)}`;
            if (bsEl) {
              const formatted = new Intl.NumberFormat('es-VE', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              }).format(totalBs);
              bsEl.textContent = `~ Bs. ${formatted}`;
            }
          });
        }

        const vehicleCards = document.querySelectorAll('.vehicle-card');
        vehicleCards.forEach(card => {
          card.addEventListener('click', () => {
            vehicleCards.forEach(c => {
              c.classList.remove('border-[#FF5A00]', 'shadow-md', 'shadow-orange-500/10', 'active');
              c.classList.add('border-transparent', 'shadow-sm');
              const u = c.querySelector('.fare-usd');
              if (u) u.classList.remove('text-[#FF5A00]');
            });

            card.classList.remove('border-transparent', 'shadow-sm');
            card.classList.add('border-[#FF5A00]', 'shadow-md', 'shadow-orange-500/10', 'active');
            const usd = card.querySelector('.fare-usd');
            if (usd) usd.classList.add('text-[#FF5A00]');
            selectedType = card.getAttribute('data-type');
          });
        });

        const originInput = document.getElementById('ride-origin');
        const destInput = document.getElementById('ride-destination');
        const kmEl = document.getElementById('ride-km');
        const minEl = document.getElementById('ride-min');
        const labelOrigin = document.getElementById('label-origin');
        const labelDest = document.getElementById('label-dest');

        function recalculateTrip() {
          const oLen = (originInput ? originInput.value.length : 0);
          const dLen = (destInput ? destInput.value.length : 0);
          const pseudoKm = Math.max(2.1, Math.min(22.5, ((oLen + dLen) % 12) + 2.4));
          currentKm = parseFloat(pseudoKm.toFixed(1));
          const pseudoMin = Math.round(currentKm * 2.4);

          if (kmEl) kmEl.textContent = `${currentKm} km`;
          if (minEl) minEl.textContent = `${pseudoMin} min`;
          if (labelOrigin && originInput) labelOrigin.textContent = originInput.value.split(',')[0] || 'Origen';
          if (labelDest && destInput) labelDest.textContent = destInput.value.split(',')[0] || 'Destino';
          updateFares();
        }

        if (originInput) originInput.addEventListener('input', recalculateTrip);
        if (destInput) destInput.addEventListener('input', recalculateTrip);

        let ridesMap = null;
        let carMarker = null;
        let ridePolyline = null;
        let pickupPos = { lat: 10.4852, lng: -66.0965 };
        let dropoffPos = { lat: 10.4910, lng: -66.1015 };
        let currentCarPos = { lat: 10.4865, lng: -66.0998 };
        let targetCarPos = { lat: 10.4865, lng: -66.0998 };
        let carBearing = 0;
        let targetBearing = 0;
        let activeRideId = null;
        let rideWs = null;

        function calculateBearing(startLat, startLng, destLat, destLng) {
          const startLatRad = (startLat * Math.PI) / 180;
          const startLngRad = (startLng * Math.PI) / 180;
          const destLatRad = (destLat * Math.PI) / 180;
          const destLngRad = (destLng * Math.PI) / 180;

          const y = Math.sin(destLngRad - startLngRad) * Math.cos(destLatRad);
          const x =
            Math.cos(startLatRad) * Math.sin(destLatRad) -
            Math.sin(startLatRad) * Math.cos(destLatRad) * Math.cos(destLngRad - startLngRad);
          const brng = (Math.atan2(y, x) * 180) / Math.PI;
          return (brng + 360) % 360;
        }

        function updateCarRotation(bearing) {
          const el = document.getElementById('rides-car-svg-container');
          if (el) {
            el.style.transform = `rotate(${bearing}deg)`;
          }
        }

        function animateCarApproaching() {
          if (carMarker) {
            const latDiff = (targetCarPos.lat - currentCarPos.lat) * 0.08;
            const lngDiff = (targetCarPos.lng - currentCarPos.lng) * 0.08;

            currentCarPos.lat += latDiff;
            currentCarPos.lng += lngDiff;

            carMarker.setLatLng([currentCarPos.lat, currentCarPos.lng]);

            let diffBearing = (targetBearing - carBearing + 540) % 360 - 180;
            carBearing = (carBearing + diffBearing * 0.1 + 360) % 360;
            updateCarRotation(carBearing);

            if (ridePolyline) {
              ridePolyline.setLatLngs([
                [currentCarPos.lat, currentCarPos.lng],
                [pickupPos.lat, pickupPos.lng],
                [dropoffPos.lat, dropoffPos.lng]
              ]);
            }
          }
          requestAnimationFrame(animateCarApproaching);
        }

        function initRidesMap() {
          const mapEl = document.getElementById('rides-map');
          if (!mapEl || typeof L === 'undefined') return;

          ridesMap = L.map(mapEl, {
            zoomControl: false,
            attributionControl: false
          }).setView([pickupPos.lat, pickupPos.lng], 15);

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19
          }).addTo(ridesMap);

          const pickupIcon = L.divIcon({
            className: '',
            html: '<div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center text-sm shadow-lg border-2 border-white font-black">A</div>',
            iconSize: [32, 32],
            iconAnchor: [16, 16]
          });

          const dropoffIcon = L.divIcon({
            className: '',
            html: '<div class="w-8 h-8 rounded-full bg-[#FF5A00] text-white flex items-center justify-center text-sm shadow-lg border-2 border-white font-black">B</div>',
            iconSize: [32, 32],
            iconAnchor: [16, 16]
          });

          const carIcon = L.divIcon({
            className: 'driver-car-marker',
            html: `
              <div id="rides-car-svg-container" class="relative w-12 h-12 flex items-center justify-center transition-transform duration-75">
                <div class="absolute inset-0 rounded-full bg-blue-500/25 animate-ping"></div>
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 shadow-xl border-2 border-white flex items-center justify-center text-white text-xl">
                  🚗
                </div>
              </div>
            `,
            iconSize: [48, 48],
            iconAnchor: [24, 24]
          });

          L.marker([pickupPos.lat, pickupPos.lng], { icon: pickupIcon }).addTo(ridesMap);
          L.marker([dropoffPos.lat, dropoffPos.lng], { icon: dropoffIcon }).addTo(ridesMap);
          carMarker = L.marker([currentCarPos.lat, currentCarPos.lng], { icon: carIcon }).addTo(ridesMap);

          ridePolyline = L.polyline([
            [currentCarPos.lat, currentCarPos.lng],
            [pickupPos.lat, pickupPos.lng],
            [dropoffPos.lat, dropoffPos.lng]
          ], {
            color: '#FF5A00',
            weight: 4,
            opacity: 0.85,
            dashArray: '8, 8'
          }).addTo(ridesMap);

          requestAnimationFrame(animateCarApproaching);

          const recenterBtn = document.getElementById('btn-recenter');
          if (recenterBtn) {
            recenterBtn.addEventListener('click', () => {
              ridesMap.setView([currentCarPos.lat, currentCarPos.lng], 15);
            });
          }
        }

        function connectRideWebSocket(rideId) {
          const wsStatus = document.getElementById('rides-ws-status');
          const wsIndicator = document.getElementById('rides-ws-indicator');

          try {
            rideWs = new WebSocket(`wss://ws.traigalo.org/ws?ride_id=${encodeURIComponent(rideId)}`);
          } catch {
            simulateApproachingCar();
            return;
          }

          rideWs.onopen = () => {
            if (wsStatus) wsStatus.textContent = 'Conductor Conectado (En Vivo)';
            if (wsIndicator) wsIndicator.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-ping';
          };

          rideWs.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);
              const lat = Number(data.lat || data.latitude);
              const lng = Number(data.lng || data.longitude);
              if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
                targetBearing = calculateBearing(currentCarPos.lat, currentCarPos.lng, lat, lng);
                targetCarPos = { lat, lng };
              }
            } catch {}
          };

          rideWs.onerror = () => {
            simulateApproachingCar();
          };

          rideWs.onclose = () => {
            simulateApproachingCar();
          };
        }

        function simulateApproachingCar() {
          let step = 0;
          const startLat = 10.4865;
          const startLng = -66.0998;
          const interval = setInterval(() => {
            step++;
            const factor = Math.min(1, step / 30);
            const nextLat = startLat + (pickupPos.lat - startLat) * factor;
            const nextLng = startLng + (pickupPos.lng - startLng) * factor;
            targetBearing = calculateBearing(currentCarPos.lat, currentCarPos.lng, nextLat, nextLng);
            targetCarPos = { lat: nextLat, lng: nextLng };

            if (factor >= 1) {
              clearInterval(interval);
              const wsStatus = document.getElementById('rides-ws-status');
              if (wsStatus) wsStatus.textContent = '¡Conductor en el Punto de Recogida!';
            }
          }, 800);
        }

        const requestBtn = document.getElementById('btn-request-ride');
        const searchOverlay = document.getElementById('searching-overlay');
        const driverCard = document.getElementById('driver-card');
        const standbyCard = document.getElementById('driver-standby-card');

        if (requestBtn) {
          requestBtn.addEventListener('click', async () => {
            if (searchOverlay) searchOverlay.classList.remove('hidden');
            requestBtn.setAttribute('disabled', 'true');
            requestBtn.textContent = 'Creando Solicitud...';

            const cfg = ratesConfig[selectedType] || ratesConfig.auto;
            const fareUsd = cfg.base + (cfg.perKm * currentKm);
            const fareBs = fareUsd * bcvRate;

            const payload = {
              customer_id: '44444444-4444-4444-4444-444444444444',
              vehicle_type: selectedType,
              origin_address: originInput ? originInput.value : 'Av. Andrés Eloy Blanco, Higuerote',
              destination_address: destInput ? destInput.value : 'Bahía de Carenero, Higuerote',
              origin_latitude: pickupPos.lat,
              origin_longitude: pickupPos.lng,
              destination_latitude: dropoffPos.lat,
              destination_longitude: dropoffPos.lng,
              distance_km: currentKm,
              fare_usd: parseFloat(fareUsd.toFixed(2)),
              fare_bs: parseFloat(fareBs.toFixed(2)),
              rate_bcv: bcvRate
            };

            try {
              const res = await fetch('https://api.traigalo.org/v2/rides', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });

              if (res.ok) {
                const rideData = await res.json();
                activeRideId = rideData.id || `RD-${Date.now()}`;
              } else {
                activeRideId = `RD-${Date.now()}`;
              }
            } catch {
              activeRideId = `RD-${Date.now()}`;
            }

            requestBtn.textContent = 'Asignando Conductor...';

            setTimeout(() => {
              if (searchOverlay) searchOverlay.classList.add('hidden');
              if (standbyCard) standbyCard.classList.add('hidden');
              if (driverCard) {
                driverCard.classList.remove('hidden');
                driverCard.classList.add('ring-2', 'ring-[#FF5A00]');
                setTimeout(() => driverCard.classList.remove('ring-2', 'ring-[#FF5A00]'), 1500);
              }
              requestBtn.removeAttribute('disabled');
              requestBtn.innerHTML = '<span>✓ Carrera Asignada • En Camino</span>';
              requestBtn.classList.remove('from-[#FF5A00]', 'to-[#FF7A00]');
              requestBtn.classList.add('from-emerald-600', 'to-emerald-500');

              connectRideWebSocket(activeRideId);
            }, 1800);
          });
        }

        const shareBtn = document.getElementById('btn-share-trip');
        if (shareBtn) {
          shareBtn.addEventListener('click', () => {
            const origin = originInput ? originInput.value : 'Origen';
            const dest = destInput ? destInput.value : 'Destino';
            const text = encodeURIComponent(`Hola, voy en un viaje de Traigalo Rides 🚗. Desde: ${origin} hasta: ${dest}. Conductor: Carlos R. Mendoza (Toyota Corolla AB123CD). Sígueme en vivo.`);
            window.open(`https://wa.me/?text=${text}`, '_blank');
          });
        }

        const sosBtn = document.getElementById('btn-sos');
        if (sosBtn) {
          sosBtn.addEventListener('click', () => {
            if (confirm('¿Deseas emitir alerta SOS inmediata a las autoridades y soporte de Traigalo?')) {
              alert('Alerta SOS activada. Tu ubicación GPS en tiempo real ha sido enviada al centro de monitoreo.');
            }
          });
        }

        updateFares();

        if (document.readyState === 'complete') {
          initRidesMap();
        } else {
          window.addEventListener('load', initRidesMap);
        }
      })();
    </script>
  </body>
</html>
