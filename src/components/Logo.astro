---
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { variant = 'dark', size = 'md', showText = true } = Astro.props;

const heightClasses = {
  sm: 'h-9',
  md: 'h-11',
  lg: 'h-14'
};

const iconSizes = {
  sm: 'w-9 h-9',
  md: 'w-11 h-11',
  lg: 'w-14 h-14'
};

const textSizes = {
  sm: 'text-xl',
  md: 'text-2xl',
  lg: 'text-3xl'
};
---

<div class={`inline-flex items-center gap-2.5 select-none ${heightClasses[size]}`}>
  <div class={`${iconSizes[size]} shrink-0 relative group transition-transform duration-300 hover:scale-105 drop-shadow-md`}>
    <img 
      src="/brand-icon.webp" 
      alt="Traigalo Logo" 
      class="w-full h-full object-contain"
      width="56"
      height="56"
      loading="eager"
    />
  </div>

  {showText && (
    <div class="flex items-center">
      <span class={`font-black tracking-tight font-sans ${textSizes[size]} ${variant === 'light' ? 'text-white' : 'text-[#0B0D10]'}`}>
        Traigalo
      </span>
      <span class="inline-block ml-1 text-base text-[#FF5A00] animate-pulse">⚡</span>
    </div>
  )}
</div>