---
---

<div id="location-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-200">
  <div id="location-modal-card" class="bg-white w-full sm:max-w-xl rounded-t-3xl sm:rounded-3xl shadow-2xl transform translate-y-full sm:translate-y-4 transition-transform duration-200 flex flex-col h-[88vh] sm:h-[680px] overflow-hidden">
    
    <div class="px-5 pt-4 pb-3 border-b border-gray-100 bg-white z-20 shrink-0 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-orange-50 text-[#FF7A00] flex items-center justify-center text-sm font-black">
            📍
          </div>
          <div>
            <h3 class="text-sm font-black text-gray-900 leading-tight">Ubicación de Entrega</h3>
            <p class="text-[10px] text-gray-400 font-medium">Busca tu dirección o mueve el pin en el mapa</p>
          </div>
        </div>
        <button id="close-location-modal" type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 font-black cursor-pointer active:scale-95 transition-all">
          ✕
        </button>
      </div>

      <div class="relative">
        <input 
          id="location-search-input"
          type="text"
          placeholder="Buscar calle, urbanización, sector o ciudad..."
          autocomplete="off"
          class="w-full h-10 pl-9 pr-20 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold text-gray-900 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/15 transition-all"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button 
          id="btn-search-location"
          type="button"
          class="absolute right-1.5 top-1.5 h-7 px-2.5 rounded-lg bg-[#FF7A00] hover:bg-[#E66E00] text-white text-[10px] font-black transition-colors cursor-pointer"
        >
          Buscar
        </button>
        <div id="location-search-results" class="hidden absolute left-0 right-0 top-11 bg-white rounded-2xl shadow-xl border border-gray-100 max-h-48 overflow-y-auto z-30 divide-y divide-gray-50"></div>
      </div>
    </div>

    <div class="relative flex-1 w-full bg-gray-100 overflow-hidden">
      <div id="location-map" class="w-full h-full"></div>

      <div class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center">
        <div class="relative -translate-y-6 flex flex-col items-center">
          <div id="floating-pin" class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#FF7A00] to-amber-500 text-white flex items-center justify-center text-xl shadow-xl shadow-orange-500/40 border-2 border-white transform transition-transform duration-150">
            📍
          </div>
          <div id="pin-shadow" class="w-4 h-1.5 bg-black/30 rounded-full blur-[1px] mt-1 transition-all duration-150"></div>
        </div>
      </div>

      <button 
        id="btn-recenter-gps"
        type="button"
        class="absolute bottom-4 right-4 z-20 px-3.5 h-10 rounded-2xl bg-white shadow-lg border border-gray-100 flex items-center gap-1.5 text-xs font-extrabold text-gray-800 hover:text-[#FF7A00] active:scale-95 transition-all cursor-pointer"
        title="Usar mi ubicación actual"
      >
        <svg class="w-4 h-4 text-[#FF7A00] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z" />
        </svg>
        <span>Usar mi GPS</span>
      </button>
    </div>

    <div class="p-5 bg-white border-t border-gray-100 space-y-3 shrink-0 z-10">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-2xl bg-orange-50 text-[#FF7A00] flex items-center justify-center text-base shrink-0 mt-0.5">
          🏠
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-[9px] font-black uppercase tracking-wider text-gray-400 block">Dirección Detectada</span>
          <p id="location-address-preview" class="text-xs font-bold text-gray-900 truncate">
            Av. Andrés Eloy Blanco, Higuerote
          </p>
          <span id="location-coords-preview" class="text-[10px] text-gray-400 font-mono block mt-0.5">
            10.4842, -66.0990
          </span>
        </div>
      </div>

      <button 
        id="btn-confirm-location"
        type="button"
        class="w-full h-13 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white font-black text-sm shadow-xl shadow-orange-600/25 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Confirmar ubicación de entrega</span>
        <span>→</span>
      </button>
    </div>

  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline>
(() => {
  let locationMap = null;
  let currentLat = 10.4842;
  let currentLng = -66.0990;
  let currentAddress = "Av. Andrés Eloy Blanco, Higuerote";
  let isMapMoving = false;
  let geocodeTimeout = null;

  function initLeafletMap() {
    if (locationMap) return;
    const mapContainer = document.getElementById("location-map");
    if (!mapContainer || typeof L === "undefined") return;

    locationMap = L.map(mapContainer, {
      zoomControl: false,
      attributionControl: false
    }).setView([currentLat, currentLng], 16);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19
    }).addTo(locationMap);

    locationMap.on("movestart", () => {
      isMapMoving = true;
      const pin = document.getElementById("floating-pin");
      const shadow = document.getElementById("pin-shadow");
      if (pin) pin.classList.add("-translate-y-2", "scale-105");
      if (shadow) shadow.classList.add("scale-75", "opacity-50");
    });

    locationMap.on("moveend", () => {
      isMapMoving = false;
      const pin = document.getElementById("floating-pin");
      const shadow = document.getElementById("pin-shadow");
      if (pin) pin.classList.remove("-translate-y-2", "scale-105");
      if (shadow) shadow.classList.remove("scale-75", "opacity-50");

      const center = locationMap.getCenter();
      currentLat = center.lat;
      currentLng = center.lng;

      const coordsEl = document.getElementById("location-coords-preview");
      if (coordsEl) coordsEl.textContent = `${currentLat.toFixed(4)}, ${currentLng.toFixed(4)}`;

      if (geocodeTimeout) clearTimeout(geocodeTimeout);
      geocodeTimeout = setTimeout(() => {
        reverseGeocode(currentLat, currentLng);
      }, 400);
    });
  }

  async function reverseGeocode(lat, lon) {
    const previewEl = document.getElementById("location-address-preview");
    if (previewEl) previewEl.textContent = "Localizando calle y zona...";

    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&addressdetails=1`);
      if (res.ok) {
        const data = await res.json();
        const a = data.address || {};
        const road = a.road || a.pedestrian || a.suburb || a.neighbourhood || a.quarter || "";
        const city = a.city || a.town || a.municipality || a.county || a.state || "Miranda";
        const formatted = road ? `${road}, ${city}` : (data.display_name ? data.display_name.split(",").slice(0, 2).join(",") : `${lat.toFixed(4)}, ${lon.toFixed(4)}`);
        currentAddress = formatted;
        if (previewEl) previewEl.textContent = formatted;
        return;
      }
    } catch {}

    currentAddress = `Punto GPS (${lat.toFixed(4)}, ${lon.toFixed(4)})`;
    if (previewEl) previewEl.textContent = currentAddress;
  }

  async function searchAddressByText(query) {
    const resultsBox = document.getElementById("location-search-results");
    if (!resultsBox || !query || query.trim().length < 3) {
      if (resultsBox) resultsBox.classList.add("hidden");
      return;
    }

    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=ve&limit=5`);
      if (!res.ok) return;
      const items = await res.json();
      if (!Array.isArray(items) || items.length === 0) {
        resultsBox.innerHTML = `<div class="p-3 text-xs text-gray-400 text-center">Sin resultados en Venezuela</div>`;
        resultsBox.classList.remove("hidden");
        return;
      }

      resultsBox.innerHTML = items.map((item) => `
        <button type="button" data-lat="${item.lat}" data-lon="${item.lon}" data-name="${item.display_name.split(',').slice(0, 3).join(',')}" class="search-result-item w-full text-left px-3.5 py-2.5 hover:bg-orange-50 transition-colors flex items-start gap-2 cursor-pointer">
          <span class="text-[#FF7A00] text-xs mt-0.5">📍</span>
          <span class="text-xs font-semibold text-gray-800 line-clamp-2">${item.display_name}</span>
        </button>
      `).join("");
      resultsBox.classList.remove("hidden");

      resultsBox.querySelectorAll(".search-result-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          const lat = parseFloat(btn.getAttribute("data-lat"));
          const lon = parseFloat(btn.getAttribute("data-lon"));
          const name = btn.getAttribute("data-name") || "";
          resultsBox.classList.add("hidden");
          if (!isNaN(lat) && !isNaN(lon)) {
            currentLat = lat;
            currentLng = lon;
            currentAddress = name;
            const previewEl = document.getElementById("location-address-preview");
            if (previewEl && name) previewEl.textContent = name;
            if (locationMap) {
              locationMap.flyTo([lat, lon], 16, { animate: true, duration: 0.8 });
            }
          }
        });
      });
    } catch {}
  }

  const searchInput = document.getElementById("location-search-input");
  const searchBtn = document.getElementById("btn-search-location");
  let searchTimer = null;

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      if (searchTimer) clearTimeout(searchTimer);
      const q = e.target.value;
      searchTimer = setTimeout(() => searchAddressByText(q), 350);
    });
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        searchAddressByText(searchInput.value);
      }
    });
  }

  if (searchBtn && searchInput) {
    searchBtn.addEventListener("click", () => {
      searchAddressByText(searchInput.value);
    });
  }

  window.openLocationModal = function() {
    const modal = document.getElementById("location-modal");
    const card = document.getElementById("location-modal-card");

    const saved = localStorage.getItem("traigalo_location");
    if (saved) {
      try {
        const loc = JSON.parse(saved);
        if (loc.latitude && loc.longitude) {
          currentLat = loc.latitude;
          currentLng = loc.longitude;
          currentAddress = loc.address || currentAddress;
        }
      } catch {}
    } else if ("geolocation" in navigator) {
      navigator.geolocation.getCurrentPosition((pos) => {
        currentLat = pos.coords.latitude;
        currentLng = pos.coords.longitude;
        if (locationMap) {
          locationMap.setView([currentLat, currentLng], 16);
        }
        reverseGeocode(currentLat, currentLng);
      }, () => {}, { timeout: 5000 });
    }

    if (modal && card) {
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100");
      card.classList.remove("translate-y-full", "sm:translate-y-4");
      card.classList.add("translate-y-0");
    }

    setTimeout(() => {
      initLeafletMap();
      if (locationMap) {
        locationMap.invalidateSize();
        locationMap.setView([currentLat, currentLng], 16);
      }
      reverseGeocode(currentLat, currentLng);
    }, 150);
  };

  window.closeLocationModal = function() {
    const modal = document.getElementById("location-modal");
    const card = document.getElementById("location-modal-card");
    const resultsBox = document.getElementById("location-search-results");
    if (resultsBox) resultsBox.classList.add("hidden");
    if (modal && card) {
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.classList.remove("opacity-100");
      card.classList.add("translate-y-full", "sm:translate-y-4");
      card.classList.remove("translate-y-0");
    }
  };

  const closeBtn = document.getElementById("close-location-modal");
  if (closeBtn) closeBtn.addEventListener("click", window.closeLocationModal);

  const modalEl = document.getElementById("location-modal");
  if (modalEl) {
    modalEl.addEventListener("click", (e) => {
      if (e.target === modalEl) window.closeLocationModal();
    });
  }

  const recenterBtn = document.getElementById("btn-recenter-gps");
  if (recenterBtn) {
    recenterBtn.addEventListener("click", () => {
      if ("geolocation" in navigator) {
        navigator.geolocation.getCurrentPosition((pos) => {
          currentLat = pos.coords.latitude;
          currentLng = pos.coords.longitude;
          if (locationMap) {
            locationMap.flyTo([currentLat, currentLng], 17, { animate: true, duration: 1 });
          }
        }, () => {
          alert("No pudimos obtener tu ubicación GPS. Puedes buscar tu calle o arrastrar el pin en el mapa.");
        }, { enableHighAccuracy: true });
      }
    });
  }

  const confirmBtn = document.getElementById("btn-confirm-location");
  if (confirmBtn) {
    confirmBtn.addEventListener("click", () => {
      const locationData = {
        address: currentAddress,
        latitude: currentLat,
        longitude: currentLng
      };

      localStorage.setItem("traigalo_location", JSON.stringify(locationData));
      localStorage.setItem("traigalo_address", currentAddress);

      window.dispatchEvent(new CustomEvent("traigalo:location-changed", {
        detail: locationData
      }));

      window.closeLocationModal();
    });
  }
})();
</script>
