---
import { getOfficialExchangeRate } from '../adapters/rates';
import Logo from './Logo.astro';
import LocationModal from './LocationModal.astro';

const bcvRate = await getOfficialExchangeRate();
const bcvFormatted = bcvRate.toFixed(2);
---

<header class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2">
          <Logo size="sm" />
        </a>

        <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>

        <a href="/rides" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-black shadow-sm shadow-blue-500/20 active:scale-95 transition-all">
          <span>🚗</span>
          <span class="hidden sm:inline">Pedir Taxi / Viajes</span>
          <span class="sm:hidden">Viajes</span>
        </a>

        <div class="h-6 w-px bg-gray-200 hidden lg:block"></div>

        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-orange-50 text-[#FF7A00] flex items-center justify-center text-sm shadow-xs shrink-0">
            📍
          </div>
          <div class="flex flex-col">
            <span class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider leading-tight">Entregar en</span>
            <div id="address-selector-trigger" class="flex items-center gap-1 cursor-pointer group">
              <span id="header-user-address" class="text-xs sm:text-sm font-bold text-gray-900 group-hover:text-[#FF7A00] transition-colors truncate max-w-[140px] sm:max-w-none">
                Seleccionar ubicación de entrega
              </span>
              <svg class="w-3.5 h-3.5 text-[#FF7A00] transform group-hover:translate-y-0.5 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-[10px] sm:text-xs font-extrabold shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Tasa BCV: {bcvFormatted} Bs/$</span>
        </div>

        <div class="relative" id="user-menu-container">
          <div id="unauth-actions" class="flex items-center gap-2">
            <a 
              href="/login" 
              class="px-3.5 py-1.5 rounded-2xl bg-gray-50 hover:bg-gray-100 border border-gray-100 text-gray-800 text-xs font-extrabold transition-all"
            >
              Iniciar Sesión
            </a>
            <a 
              href="/register" 
              class="hidden sm:inline-flex px-3.5 py-1.5 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white text-xs font-black shadow-sm transition-all"
            >
              Registro
            </a>
          </div>

          <div id="auth-actions" class="hidden items-center gap-2">
            <button 
              id="user-profile-trigger"
              type="button"
              class="flex items-center gap-2 p-1 pl-2.5 rounded-full bg-gray-50 border border-gray-100 hover:border-gray-200 transition-all cursor-pointer"
            >
              <span id="user-display-name" class="text-xs font-black text-gray-900 max-w-[100px] truncate">Usuario</span>
              <div id="user-avatar-badge" class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#FF7A00] to-amber-400 text-white font-black text-xs flex items-center justify-center shadow-sm">
                U
              </div>
            </button>

            <div 
              id="user-dropdown" 
              class="hidden absolute right-0 top-12 w-48 bg-white rounded-2xl shadow-xl border border-gray-100 p-2 z-50 transition-all duration-150"
            >
              <div class="px-3 py-2 border-b border-gray-50">
                <p id="dropdown-user-name" class="text-xs font-black text-gray-900 truncate">Usuario</p>
                <p id="dropdown-user-email" class="text-[10px] text-gray-400 truncate">usuario@traigalo.org</p>
              </div>

              <div class="py-1 space-y-0.5 text-xs font-bold text-gray-700">
                <a href="/orders" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-orange-50 hover:text-[#FF7A00] transition-colors">
                  <span>📦</span>
                  <span>Mis Pedidos</span>
                </a>
                <a href="/favorites" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-orange-50 hover:text-[#FF7A00] transition-colors">
                  <span>❤️</span>
                  <span>Favoritos</span>
                </a>
                <a href="/profile" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-orange-50 hover:text-[#FF7A00] transition-colors">
                  <span>👤</span>
                  <span>Mi Perfil</span>
                </a>
              </div>

              <div class="pt-1 border-t border-gray-50">
                <button 
                  id="btn-logout"
                  type="button" 
                  class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold text-rose-600 hover:bg-rose-50 transition-colors text-left cursor-pointer"
                >
                  <span>🚪</span>
                  <span>Cerrar Sesión</span>
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="mt-3.5 flex items-center gap-2.5">
      <div class="relative flex-1">
        <input 
          id="global-search-input"
          type="text" 
          placeholder="Buscar tiendas, productos, tecnología, comida..." 
          class="w-full h-11 pl-10 pr-4 bg-gray-50 border border-gray-100 rounded-2xl text-xs font-medium text-gray-800 placeholder-gray-400 focus:outline-none focus:bg-white focus:border-[#FF7A00] focus:ring-2 focus:ring-[#FF7A00]/20 transition-all"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <button id="global-filter-btn" class="w-11 h-11 rounded-2xl bg-[#FF7A00] hover:bg-[#E66E00] text-white flex items-center justify-center shadow-md shadow-orange-600/20 transition-all shrink-0 active:scale-95 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
      </button>
    </div>

  </div>
</header>

<LocationModal />

<script is:inline>
(() => {
  function setupUserMenu() {
    const unauthEl = document.getElementById('unauth-actions');
    const authEl = document.getElementById('auth-actions');
    const nameEl = document.getElementById('user-display-name');
    const avatarBadge = document.getElementById('user-avatar-badge');
    const dropNameEl = document.getElementById('dropdown-user-name');
    const dropEmailEl = document.getElementById('dropdown-user-email');
    const trigger = document.getElementById('user-profile-trigger');
    const dropdown = document.getElementById('user-dropdown');
    const logoutBtn = document.getElementById('btn-logout');

    const token = localStorage.getItem('traigalo_token');
    const rawUser = localStorage.getItem('traigalo_user');

    if (token && rawUser) {
      try {
        const user = JSON.parse(rawUser);
        if (unauthEl) unauthEl.classList.add('hidden');
        if (authEl) {
          authEl.classList.remove('hidden');
          authEl.classList.add('flex');
        }
        const displayName = user.name || 'Usuario';
        if (nameEl) nameEl.textContent = displayName;
        if (dropNameEl) dropNameEl.textContent = displayName;
        if (dropEmailEl) dropEmailEl.textContent = user.email || 'usuario@traigalo.org';
        if (avatarBadge) {
          const initials = displayName
            .split(' ')
            .map(w => w[0])
            .slice(0, 2)
            .join('')
            .toUpperCase() || 'U';
          avatarBadge.textContent = initials;
        }
      } catch {
        localStorage.removeItem('traigalo_token');
        localStorage.removeItem('traigalo_user');
      }
    } else {
      if (unauthEl) unauthEl.classList.remove('hidden');
      if (authEl) {
        authEl.classList.add('hidden');
        authEl.classList.remove('flex');
      }
    }

    if (trigger && dropdown) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('traigalo_token');
        localStorage.removeItem('traigalo_user');
        window.location.reload();
      });
    }
  }

  function setupAddressGeo() {
    const addressEl = document.getElementById('header-user-address');
    const trigger = document.getElementById('address-selector-trigger');

    const updateDisplay = (addr) => {
      if (addressEl) {
        addressEl.textContent = addr || 'Seleccionar ubicación de entrega';
      }
    };

    const saved = localStorage.getItem('traigalo_location');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.address) updateDisplay(parsed.address);
      } catch {
        updateDisplay(localStorage.getItem('traigalo_address'));
      }
    } else {
      updateDisplay(localStorage.getItem('traigalo_address'));
    }

    if (trigger) {
      trigger.addEventListener('click', () => {
        if (typeof window.openLocationModal === 'function') {
          window.openLocationModal();
        }
      });
    }

    window.addEventListener('traigalo:location-changed', (e) => {
      if (e.detail && e.detail.address) {
        updateDisplay(e.detail.address);
      }
    });
  }

  const filterBtn = document.getElementById('global-filter-btn');
  if (filterBtn) {
    filterBtn.addEventListener('click', () => {
      const catBar = document.getElementById('categories-bar') || document.getElementById('stores');
      if (catBar) {
        catBar.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  setupUserMenu();
  setupAddressGeo();
})();
</script>
