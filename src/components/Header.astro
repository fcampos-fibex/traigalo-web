---
import { getOfficialExchangeRate } from '../adapters/rates';
import Logo from './Logo.astro';
import LocationModal from './LocationModal.astro';

const bcvRate = await getOfficialExchangeRate();
const bcvFormatted = bcvRate.toFixed(2);
---

<header class="tg-header">
  <div class="tg-wrap">
    <div class="tg-bar tg-glass">
      <a href="/" class="tg-logo" aria-label="Traigalo, inicio">
        <Logo size="sm" />
      </a>

      <button id="address-selector-trigger" type="button" class="tg-zone" aria-label="Cambiar dirección de entrega">
        <small>Entregar en</small>
        <span id="header-user-address">Seleccionar ubicación de entrega</span>
      </button>

      <div class="tg-search">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        <input
          id="global-search-input"
          type="search"
          aria-label="Buscar en Traigalo"
          placeholder="Busca comida, medicinas, productos o tiendas"
        />
      </div>

      <span class="tg-bcv" title="Tasa oficial del BCV">BCV {bcvFormatted} Bs/$</span>

      <button id="global-filter-btn" type="button" class="tg-icon-btn" aria-label="Ver categorías">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M7 12h10M10 18h4" /></svg>
      </button>

      <div class="tg-user" id="user-menu-container">
        <div id="unauth-actions" class="tg-auth">
          <a href="/login" class="tg-btn tg-btn--quiet tg-btn--sm">Iniciar sesión</a>
          <a href="/register" class="tg-btn tg-btn--primary tg-btn--sm hidden sm:inline-flex">Registro</a>
        </div>

        <div id="auth-actions" class="hidden">
          <button id="user-profile-trigger" type="button" class="tg-user-trigger" aria-haspopup="menu">
            <span id="user-display-name" class="hidden sm:inline">Usuario</span>
            <span id="user-avatar-badge" class="tg-avatar">U</span>
          </button>

          <div id="user-dropdown" class="hidden tg-menu tg-glass" role="menu">
            <div class="tg-menu-head">
              <p id="dropdown-user-name">Usuario</p>
              <p id="dropdown-user-email">usuario@traigalo.org</p>
            </div>
            <a href="/orders" role="menuitem">Mis pedidos</a>
            <a href="/favorites" role="menuitem">Favoritos</a>
            <a href="/profile" role="menuitem">Mi perfil</a>
            <button id="btn-logout" type="button" class="tg-danger" role="menuitem">Cerrar sesión</button>
          </div>
        </div>
      </div>
    </div>

    <nav aria-label="Servicios de Traigalo" class="tg-modules tg-glass no-scrollbar">
      <a href="/?rubro=all#store-verticals" data-header-rubro="all" class="header-rubro-link">Inicio</a>
      <a href="/?rubro=restaurantes#store-verticals" data-header-rubro="restaurantes" class="header-rubro-link">Comida</a>
      <a href="/?rubro=supermercados#store-verticals" data-header-rubro="supermercados" class="header-rubro-link">Mercado</a>
      <a href="/?rubro=farmacias#store-verticals" data-header-rubro="farmacias" class="header-rubro-link">Farmacia</a>
      <a href="/?rubro=tecnologia#store-verticals" data-header-rubro="tecnologia" class="header-rubro-link">Tecnología</a>
      <a href="/?rubro=barberia#store-verticals" data-header-rubro="barberia" class="header-rubro-link">Belleza</a>
      <a href="/?rubro=mascotas#store-verticals" data-header-rubro="mascotas" class="header-rubro-link">Mascotas</a>
      <a href="/rides" class="tg-module-link">Envíos y taxi</a>
    </nav>
  </div>
</header>

<LocationModal />

<script is:inline>
(() => {
  function setupUserMenu() {
    const unauthEl = document.getElementById('unauth-actions');
    const authEl = document.getElementById('auth-actions');
    const nameEl = document.getElementById('user-display-name');
    const avatarBadge = document.getElementById('user-avatar-badge');
    const dropNameEl = document.getElementById('dropdown-user-name');
    const dropEmailEl = document.getElementById('dropdown-user-email');
    const trigger = document.getElementById('user-profile-trigger');
    const dropdown = document.getElementById('user-dropdown');
    const logoutBtn = document.getElementById('btn-logout');

    const token = localStorage.getItem('traigalo_token');
    const rawUser = localStorage.getItem('traigalo_user');

    if (token && rawUser) {
      try {
        const user = JSON.parse(rawUser);
        if (unauthEl) unauthEl.classList.add('hidden');
        if (authEl) {
          authEl.classList.remove('hidden');
          authEl.classList.add('flex');
        }
        const displayName = user.name || 'Usuario';
        if (nameEl) nameEl.textContent = displayName;
        if (dropNameEl) dropNameEl.textContent = displayName;
        if (dropEmailEl) dropEmailEl.textContent = user.email || 'usuario@traigalo.org';
        if (avatarBadge) {
          const initials = displayName
            .split(' ')
            .map(w => w[0])
            .slice(0, 2)
            .join('')
            .toUpperCase() || 'U';
          avatarBadge.textContent = initials;
        }
      } catch {
        localStorage.removeItem('traigalo_token');
        localStorage.removeItem('traigalo_user');
      }
    } else {
      if (unauthEl) unauthEl.classList.remove('hidden');
      if (authEl) {
        authEl.classList.add('hidden');
        authEl.classList.remove('flex');
      }
    }

    if (trigger && dropdown) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('traigalo_token');
        localStorage.removeItem('traigalo_user');
        window.location.reload();
      });
    }
  }

  function setupAddressGeo() {
    const addressEl = document.getElementById('header-user-address');
    const trigger = document.getElementById('address-selector-trigger');

    const updateDisplay = (addr) => {
      if (addressEl) {
        addressEl.textContent = addr || 'Seleccionar ubicación de entrega';
      }
    };

    const saved = localStorage.getItem('traigalo_location');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.address) updateDisplay(parsed.address);
      } catch {
        updateDisplay(localStorage.getItem('traigalo_address'));
      }
    } else {
      updateDisplay(localStorage.getItem('traigalo_address'));
    }

    if (trigger) {
      trigger.addEventListener('click', () => {
        if (typeof window.openLocationModal === 'function') {
          window.openLocationModal();
        }
      });
    }

    window.addEventListener('traigalo:location-changed', (e) => {
      if (e.detail && e.detail.address) {
        updateDisplay(e.detail.address);
      }
    });
  }

  const filterBtn = document.getElementById('global-filter-btn');
  if (filterBtn) {
    filterBtn.addEventListener('click', () => {
      const catBar = document.getElementById('store-verticals') || document.getElementById('categories-bar') || document.getElementById('stores');
      if (catBar) {
        catBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  document.querySelectorAll('.header-rubro-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const rubro = link.getAttribute('data-header-rubro') || 'all';
      if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('traigalo:select-rubro', { detail: { rubro } }));
      }
    });
  });

  function syncModuleNav(rubro) {
    document.querySelectorAll('.header-rubro-link').forEach((link) => {
      const isHome = window.location.pathname === '/' || window.location.pathname === '';
      const active = isHome && link.getAttribute('data-header-rubro') === rubro;
      if (active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }
  window.addEventListener('traigalo:rubro-changed', (e) => syncModuleNav(e.detail?.rubro || 'all'));
  syncModuleNav(new URLSearchParams(window.location.search).get('rubro') || 'all');

  setupUserMenu();
  setupAddressGeo();
})();
</script>
