---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="tg-footer">
  <div class="tg-wrap">
    <div class="tg-footer-grid">
      <div>
        <Logo variant="light" size="md" />
        <p style="margin-top: var(--space-md)">
          Tu super-app de entregas express, comercios oficiales, tecnología, cuidado personal y movilidad urbana en tiempo real.
        </p>
      </div>

      <div>
        <h2>Explorar</h2>
        <ul>
          <li><a href="/">Tiendas y catálogo</a></li>
          <li><a href="/rides">Traigalo Rides (taxis y motos)</a></li>
          <li><a href="/favorites">Mis favoritos</a></li>
          <li><a href="/orders">Rastreo de pedidos</a></li>
        </ul>
      </div>

      <div>
        <h2>Aliados y flota</h2>
        <ul>
          <li><a href="/vendor">Portal para comercios</a></li>
          <li><a href="/driver">Panel de repartidores</a></li>
          <li><a href="/register">Registrar mi negocio</a></li>
        </ul>
      </div>

      <div>
        <h2>Pagos y cobertura</h2>
        <p>Precios duales actualizados automáticamente a la tasa oficial del Banco Central de Venezuela (BCV).</p>
        <p style="margin-top: var(--space-xs)">Pago móvil, efectivo y tarjetas.</p>
      </div>
    </div>

    <div class="tg-footer-base">
      <span>© {currentYear} Traigalo Corp C.A. Todos los derechos reservados.</span>
      <nav aria-label="Cuenta y ayuda">
        <a href="/login">Mi cuenta</a>
        <a href="/orders">Ayuda en línea</a>
      </nav>
    </div>
  </div>
</footer>
