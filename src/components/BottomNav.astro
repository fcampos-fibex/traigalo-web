---
const currentPath = Astro.url.pathname;
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-t border-gray-100/80 px-6 py-2.5 flex items-center justify-between shadow-lg shadow-gray-200/50">
  <a href="/" class={`flex flex-col items-center gap-1 transition-all ${currentPath === '/' ? 'text-[#FF5A00] scale-105 font-bold' : 'text-gray-400 hover:text-gray-600'}`}>
    <svg class="w-6 h-6" fill={currentPath === '/' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    <span class="text-[10px] tracking-tight">Delivery</span>
  </a>

  <a href="/rides" class={`flex flex-col items-center gap-1 transition-all ${currentPath.startsWith('/rides') ? 'text-blue-600 scale-105 font-bold' : 'text-gray-400 hover:text-blue-600'}`}>
    <div class="relative">
      <span class="text-xl leading-none">🚗</span>
    </div>
    <span class="text-[10px] font-semibold tracking-tight">Taxis</span>
  </a>

  <a href="/favorites" class={`flex flex-col items-center gap-1 transition-all ${currentPath === '/favorites' ? 'text-[#FF5A00] scale-105 font-bold' : 'text-gray-400 hover:text-gray-600'}`}>
    <svg class="w-6 h-6" fill={currentPath === '/favorites' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
    <span class="text-[10px] font-medium tracking-tight">Favoritos</span>
  </a>

  <a href="/orders" class={`flex flex-col items-center gap-1 relative transition-all ${currentPath.includes('/orders') ? 'text-[#FF5A00] scale-105 font-bold' : 'text-gray-400 hover:text-gray-600'}`}>
    <div class="relative">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
    </div>
    <span class="text-[10px] tracking-tight">Pedidos</span>
  </a>

  <a href="/profile" class={`flex flex-col items-center gap-1 transition-all ${currentPath === '/profile' ? 'text-[#FF5A00] scale-105 font-bold' : 'text-gray-400 hover:text-[#FF5A00]'}`}>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    <span class="text-[10px] font-medium tracking-tight">Perfil</span>
  </a>
</nav>
