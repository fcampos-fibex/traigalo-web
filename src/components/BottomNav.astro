---
const currentPath = Astro.url.pathname;
const isCurrent = (match: boolean) => (match ? 'page' : undefined);
---

<nav class="tg-dock tg-glass" aria-label="Navegación principal">
  <a href="/" aria-current={isCurrent(currentPath === '/')}>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 11l9-7 9 7v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z" /></svg>
    <span>Inicio</span>
  </a>
  <a href="/rides" aria-current={isCurrent(currentPath.startsWith('/rides'))}>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 16l1.5-5.5A2 2 0 018.4 9h7.2a2 2 0 011.9 1.5L19 16M4 16h16v3H4zM7 19v1M17 19v1" /></svg>
    <span>Taxis</span>
  </a>
  <a href="/favorites" aria-current={isCurrent(currentPath === '/favorites')}>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
    <span>Favoritos</span>
  </a>
  <a href="/orders" aria-current={isCurrent(currentPath.includes('/orders'))}>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
    <span>Pedidos</span>
  </a>
  <a href="/profile" aria-current={isCurrent(currentPath === '/profile')}>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
    <span>Perfil</span>
  </a>
</nav>
